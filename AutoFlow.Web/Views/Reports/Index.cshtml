<script>
(function () {
    const labels = @Html.Raw(JsonSerializer.Serialize(Model.ChartLabels));
    const values = @Html.Raw(JsonSerializer.Serialize(Model.ChartValues));
    const rows = @Html.Raw(JsonSerializer.Serialize(Model.ReportRows.Select(r => new { date = r.Date?.ToString("MMM dd, yyyy"), reference = r.Reference, customer = r.Customer, vehicle = r.Vehicle, amount = r.Amount, status = r.Status, secondary = r.SecondaryLabel })));
    const canvas = document.getElementById('reportChart');
    const search = document.getElementById('analyticsSearch');
    const body = document.getElementById('analyticsRows');
    const pagination = document.getElementById('analyticsPagination');
    const summary = document.getElementById('analyticsSummary');
    const pageSize = 10;
    let currentPage = 1;

    function money(v) { return '₱' + Number(v || 0).toLocaleString('en-PH', { minimumFractionDigits: 0, maximumFractionDigits: 0 }); }

    function drawChart() {
        if (!canvas) return;
        const rect = canvas.getBoundingClientRect();
        const ratio = window.devicePixelRatio || 1;
        const width = Math.max(320, rect.width);
        const height = Math.max(230, rect.height);
        canvas.width = width * ratio;
        canvas.height = height * ratio;
        const ctx = canvas.getContext('2d');
        ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
        ctx.clearRect(0, 0, width, height);
        const pad = { left: 48, right: 14, top: 14, bottom: 32 };
        const plotW = width - pad.left - pad.right;
        const plotH = height - pad.top - pad.bottom;
        const nums = values.map(Number);
        const maxValue = Math.max(1, ...nums);
        const yMax = Math.ceil(maxValue * 1.15) || 1;
        ctx.font = '8px Arial'; ctx.textAlign = 'right'; ctx.textBaseline = 'middle'; ctx.lineWidth = 1;
        for (let i = 0; i <= 5; i++) {
            const y = pad.top + plotH - plotH * i / 5;
            ctx.strokeStyle = '#edf0f4'; ctx.beginPath(); ctx.moveTo(pad.left, y); ctx.lineTo(width - pad.right, y); ctx.stroke();
            ctx.fillStyle = '#98a0af'; ctx.fillText(money(yMax * i / 5), pad.left - 8, y);
        }
        if (!nums.length) return;
        const points = nums.map((v, i) => ({ x: labels.length <= 1 ? pad.left + plotW / 2 : pad.left + plotW * i / (labels.length - 1), y: pad.top + plotH - plotH * v / yMax }));
        ctx.beginPath(); ctx.moveTo(points[0].x, pad.top + plotH); points.forEach(p => ctx.lineTo(p.x, p.y)); ctx.lineTo(points[points.length - 1].x, pad.top + plotH); ctx.closePath(); ctx.fillStyle = 'rgba(112,67,245,.08)'; ctx.fill();
        ctx.beginPath(); points.forEach((p,i) => i ? ctx.lineTo(p.x,p.y) : ctx.moveTo(p.x,p.y)); ctx.strokeStyle = '#7043f5'; ctx.lineWidth = 2; ctx.stroke();
        points.forEach(p => { ctx.beginPath(); ctx.arc(p.x,p.y,2.4,0,Math.PI*2); ctx.fillStyle='#7043f5'; ctx.fill(); });
        const stride = Math.max(1, Math.ceil(labels.length / (width < 600 ? 6 : 10)));
        ctx.font='8px Arial'; ctx.fillStyle='#98a0af'; ctx.textAlign='center'; ctx.textBaseline='top';
        labels.forEach((label,i) => { if (i % stride === 0 || i === labels.length - 1) ctx.fillText(label, points[i].x, pad.top + plotH + 9); });
    }

    function statusClass(status) { return String(status || '').toLowerCase().replace(/\s+/g, '-'); }
    function renderTable() {
        const term = String(search?.value || '').trim().toLowerCase();
        const filtered = rows.filter(r => [r.date,r.reference,r.customer,r.vehicle,r.status,r.secondary].join(' ').toLowerCase().includes(term));
        const pages = Math.max(1, Math.ceil(filtered.length / pageSize));
        currentPage = Math.min(currentPage, pages);
        const start = (currentPage - 1) * pageSize;
        const visible = filtered.slice(start, start + pageSize);
        body.innerHTML = visible.length ? visible.map(r => `<tr><td>${r.date || '—'}</td><td><div class="analytics-primary">${r.reference || '—'}</div><div class="analytics-secondary">${r.secondary || ''}</div></td><td>${r.customer || '—'}</td><td>${r.vehicle || '—'}</td><td class="analytics-amount">${money(r.amount)}</td><td>${r.status ? `<span class="analytics-status ${statusClass(r.status)}">${r.status}</span>` : '—'}</td></tr>`).join('') : '<tr><td colspan="6" style="text-align:center;padding:28px;color:#9aa1af;">No records match the current filters.</td></tr>';
        summary.textContent = filtered.length ? `Showing ${start + 1}–${Math.min(start + pageSize, filtered.length)} of ${filtered.length} records` : 'Showing 0 records';
        pagination.innerHTML = '';
        const prev=document.createElement('button'); prev.className='analytics-page'; prev.innerHTML='<i class="bi bi-chevron-left"></i>'; prev.disabled=currentPage===1; prev.onclick=()=>{currentPage--;renderTable();}; pagination.appendChild(prev);
        for(let p=1;p<=pages;p++){ if(p>7) break; const b=document.createElement('button'); b.className='analytics-page'+(p===currentPage?' active':''); b.textContent=p; b.onclick=()=>{currentPage=p;renderTable();}; pagination.appendChild(b); }
        const next=document.createElement('button'); next.className='analytics-page'; next.innerHTML='<i class="bi bi-chevron-right"></i>'; next.disabled=currentPage===pages; next.onclick=()=>{currentPage++;renderTable();}; pagination.appendChild(next);
    }

    drawChart(); window.addEventListener('resize', drawChart); search?.addEventListener('input',()=>{currentPage=1;renderTable();}); renderTable();
})();
</script>



