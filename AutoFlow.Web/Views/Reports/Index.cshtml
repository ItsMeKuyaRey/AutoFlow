@using System.Text.Json
@model AutoFlow.Web.ViewModels.ReportsViewModel

@{
    ViewData["Title"] = "Reports & Analytics";
}

<style>
    .reports-page {
        max-width: 1500px;
        margin: 0 auto;
    }

    .reports-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        color: #8b92a3;
        font-size: 12px;
        font-weight: 650;
    }

    .reports-breadcrumb .current {
        color: #7544f5;
    }

    .reports-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 25px;
    }

    .reports-title {
        margin: 0;
        color: #171b26;
        font-size: 30px;
        font-weight: 800;
        letter-spacing: -0.8px;
    }

    .reports-subtitle {
        margin: 7px 0 0;
        color: #858c9d;
        font-size: 13px;
    }

    .reports-header-meta {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #687082;
        font-size: 12px;
        font-weight: 650;
    }

    .live-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #18b981;
        box-shadow: 0 0 0 4px #e8faf3;
    }

    .report-selector {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 22px;
        padding: 7px;
        background: #ffffff;
        border: 1px solid #e5e8ee;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(24, 31, 45, 0.025);
    }

    .report-selector-label {
        padding: 0 10px;
        color: #858c9d;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.6px;
    }

    .report-tab {
        padding: 9px 13px;
        border-radius: 8px;
        color: #697184;
        font-size: 12px;
        font-weight: 700;
        transition: all 0.18s ease;
    }

    .report-tab:hover {
        background: #f5f2ff;
        color: #7544f5;
    }

    .report-tab.active {
        background: #7544f5;
        color: #ffffff;
        box-shadow: 0 5px 14px rgba(117, 68, 245, 0.2);
    }

    .report-summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 22px;
    }

    .report-summary-card {
        min-height: 125px;
        padding: 19px;
        background: #ffffff;
        border: 1px solid #e5e8ee;
        border-radius: 13px;
        box-shadow: 0 2px 8px rgba(24, 31, 45, 0.025);
    }

    .report-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .report-card-icon {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #f0ebff;
        color: #7544f5;
        font-size: 16px;
        font-weight: 800;
    }

    .report-card-label {
        margin-top: 14px;
        color: #777f91;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }

    .report-card-value {
        margin-top: 5px;
        color: #171b26;
        font-size: 24px;
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    .report-card-note {
        margin-top: 4px;
        color: #9aa1af;
        font-size: 10px;
    }

    .reports-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.45fr) minmax(330px, 0.85fr);
        gap: 18px;
        margin-bottom: 18px;
    }

    .report-panel {
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e5e8ee;
        border-radius: 13px;
        box-shadow: 0 2px 8px rgba(24, 31, 45, 0.025);
    }

    .report-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 19px 20px;
        border-bottom: 1px solid #edf0f4;
    }

    .report-panel-title {
        margin: 0;
        color: #1b2030;
        font-size: 15px;
        font-weight: 800;
    }

    .report-panel-subtitle {
        margin-top: 4px;
        color: #9299a8;
        font-size: 11px;
    }

    .report-panel-badge {
        padding: 5px 8px;
        border-radius: 6px;
        background: #f1edff;
        color: #7544f5;
        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .report-table-wrap {
        overflow-x: auto;
    }

    .report-table {
        width: 100%;
        border-collapse: collapse;
    }

    .report-table th {
        padding: 11px 20px;
        background: #fafbfc;
        color: #8a91a0;
        font-size: 9px;
        font-weight: 800;
        text-align: left;
        text-transform: uppercase;
        letter-spacing: 0.65px;
        white-space: nowrap;
    }

    .report-table td {
        padding: 13px 20px;
        border-top: 1px solid #eef0f4;
        color: #3e4656;
        font-size: 12px;
        vertical-align: middle;
    }

    .report-table tr:hover td {
        background: #fcfbff;
    }

    .report-primary {
        color: #1c2230;
        font-weight: 750;
    }

    .report-secondary {
        margin-top: 3px;
        color: #959cab;
        font-size: 10px;
    }

    .report-amount {
        color: #1c2230;
        font-weight: 800;
        white-space: nowrap;
    }

    .report-status {
        display: inline-flex;
        align-items: center;
        padding: 4px 7px;
        border-radius: 5px;
        background: #f1edff;
        color: #7544f5;
        font-size: 8px;
        font-weight: 800;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .report-status.completed,
    .report-status.paid {
        background: #e9faf3;
        color: #14966a;
    }

    .report-status.pending,
    .report-status.open,
    .report-status.scheduled {
        background: #fff5e8;
        color: #c97916;
    }

    .report-status.cancelled,
    .report-status.outofstock {
        background: #fff0f1;
        color: #dc5962;
    }

    .report-status.lowstock {
        background: #fff7e8;
        color: #c47b17;
    }

    .empty-report {
        padding: 38px 20px;
        text-align: center;
    }

    .empty-report-icon {
        width: 40px;
        height: 40px;
        margin: 0 auto 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: #f3efff;
        color: #7544f5;
        font-size: 17px;
    }

    .empty-report-title {
        color: #4d5565;
        font-size: 12px;
        font-weight: 750;
    }

    .empty-report-text {
        margin-top: 4px;
        color: #a0a6b2;
        font-size: 10px;
    }

    .report-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 12px 20px;
        border-top: 1px solid #edf0f4;
        color: #969dac;
        font-size: 10px;
    }

    .report-footer strong {
        color: #7544f5;
    }

    .inventory-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 18px;
    }

    .report-metric-list {
        padding: 4px 0;
    }

    .report-metric-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 13px 20px;
        border-bottom: 1px solid #eef0f4;
    }

    .report-metric-row:last-child {
        border-bottom: 0;
    }

    .metric-label {
        color: #5f6777;
        font-size: 11px;
        font-weight: 650;
    }

    .metric-value {
        color: #1c2230;
        font-size: 13px;
        font-weight: 800;
    }

    .report-note {
        margin-top: 18px;
        padding: 13px 15px;
        border: 1px solid #e9e3ff;
        border-radius: 9px;
        background: #faf8ff;
        color: #77708c;
        font-size: 10px;
        line-height: 1.55;
    }

    .report-note strong {
        color: #7544f5;
    }

    @@media (max-width: 1150px) {
        .report-summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .reports-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 720px) {
        .reports-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .report-selector {
            overflow-x: auto;
        }

        .report-selector-label {
            display: none;
        }

        .report-tab {
            white-space: nowrap;
        }

        .report-summary-grid {
            grid-template-columns: 1fr;
        }

        .inventory-grid {
            grid-template-columns: 1fr;
        }

        .report-panel-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .report-table th,
        .report-table td {
            padding-left: 13px;
            padding-right: 13px;
        }
    }


    /* Analytics layer: added without removing the existing report sections below. */
    .analytics-filter-card { background:#fff; border:1px solid #e5e8ee; border-radius:13px; padding:18px; margin-bottom:18px; box-shadow:0 2px 8px rgba(24,31,45,.025); }
    .analytics-filter-grid { display:grid; grid-template-columns:minmax(220px,1fr) minmax(300px,1.35fr) auto; gap:14px; align-items:end; }
    .analytics-field label { display:block; margin:0 0 6px; color:#858c9d; font-size:9px; font-weight:800; text-transform:uppercase; letter-spacing:.6px; }
    .analytics-control { width:100%; height:38px; border:1px solid #e1e5ec; border-radius:8px; background:#fff; color:#3d4656; padding:0 10px; font-size:11px; outline:none; }
    .analytics-control:focus { border-color:#9c82ef; box-shadow:0 0 0 3px rgba(117,68,245,.08); }
    .analytics-date-range { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
    .analytics-button { height:38px; padding:0 15px; border:1px solid #7544f5; border-radius:8px; background:#7544f5; color:#fff; font-size:10px; font-weight:800; cursor:pointer; white-space:nowrap; }
    .analytics-button:hover { background:#6838e7; }
    .analytics-button.secondary { background:#fff; color:#626b7a; border-color:#dfe3ea; text-decoration:none; display:inline-flex; align-items:center; justify-content:center; }
    .analytics-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:18px; margin:0 0 14px; }
    .analytics-heading h2 { margin:0; color:#202532; font-size:17px; font-weight:800; }
    .analytics-heading p { margin:3px 0 0; color:#8c94a4; font-size:10px; }
    .analytics-live { color:#687082; font-size:10px; font-weight:700; display:flex; align-items:center; gap:6px; }
    .analytics-live-dot { width:6px; height:6px; border-radius:50%; background:#18b981; box-shadow:0 0 0 4px #e8faf3; }
    .analytics-grid { display:grid; grid-template-columns:minmax(0,1.55fr) minmax(300px,.85fr); gap:16px; margin-bottom:16px; }
    .analytics-panel { background:#fff; border:1px solid #e2e6ed; border-radius:11px; overflow:hidden; box-shadow:0 2px 7px rgba(24,32,51,.025); }
    .analytics-panel-head { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:13px 16px; border-bottom:1px solid #edf0f4; }
    .analytics-panel-title { margin:0; color:#202532; font-size:12px; font-weight:800; }
    .analytics-panel-subtitle { margin:3px 0 0; color:#9aa1af; font-size:8px; }
    .analytics-badge { padding:4px 6px; border-radius:5px; background:#f1edff; color:#7043f5; font-size:7px; font-weight:800; text-transform:uppercase; letter-spacing:.45px; }
    .analytics-chart-wrap { height:300px; padding:12px 14px 10px; position:relative; }
    #reportChart { width:100%; height:100%; display:block; }
    .analytics-summary { padding:17px; }
    .analytics-summary-kicker { color:#8b93a2; font-size:8px; font-weight:800; text-transform:uppercase; letter-spacing:.55px; }
    .analytics-summary-total { margin-top:5px; color:#202633; font-size:25px; font-weight:850; letter-spacing:-.5px; }
    .analytics-summary-note { margin-top:4px; color:#16a16f; font-size:8px; font-weight:700; }
    .analytics-summary-list { list-style:none; padding:0; margin:18px 0 0; }
    .analytics-summary-row { display:flex; justify-content:space-between; gap:10px; padding:9px 0; border-bottom:1px solid #eef0f4; color:#697284; font-size:9px; }
    .analytics-summary-row:last-child { border-bottom:0; }
    .analytics-summary-row strong { color:#252b39; font-size:9px; }
    .analytics-summary-foot { margin-top:8px; padding-top:10px; border-top:1px solid #eef0f4; color:#9aa1af; font-size:8px; line-height:1.45; }
    .analytics-table-panel { margin-bottom:18px; }
    .analytics-table-tools { display:flex; align-items:center; gap:8px; }
    .analytics-table-search { width:150px; height:29px; border:1px solid #e0e4eb; border-radius:7px; padding:0 9px; font-size:8px; color:#3e4655; outline:none; }
    .analytics-table-search:focus { border-color:#9c82ef; box-shadow:0 0 0 3px rgba(117,68,245,.07); }
    .analytics-table-wrap { overflow-x:auto; }
    .analytics-table { width:100%; min-width:760px; border-collapse:collapse; }
    .analytics-table th { padding:9px 12px; background:#fafbfc; color:#939baa; font-size:7px; font-weight:800; text-align:left; text-transform:uppercase; letter-spacing:.55px; white-space:nowrap; }
    .analytics-table td { padding:10px 12px; border-top:1px solid #eef0f4; color:#4c5565; font-size:9px; vertical-align:middle; }
    .analytics-table tbody tr:hover td { background:#fcfbff; }
    .analytics-primary { color:#222837; font-size:9px; font-weight:800; }
    .analytics-secondary { margin-top:2px; color:#9aa1af; font-size:8px; }
    .analytics-amount { color:#202634; font-weight:800; white-space:nowrap; }
    .analytics-status { display:inline-flex; padding:3px 6px; border-radius:5px; background:#f1edff; color:#7043f5; font-size:7px; font-weight:800; white-space:nowrap; }
    .analytics-status.completed,.analytics-status.paid,.analytics-status.confirmed { background:#e7f9f0; color:#14956a; }
    .analytics-status.pending,.analytics-status.open,.analytics-status.scheduled,.analytics-status.low-stock { background:#fff4e5; color:#bd7417; }
    .analytics-status.cancelled,.analytics-status.out-of-stock { background:#fff0f1; color:#d85761; }
    .analytics-table-footer { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:9px 12px; border-top:1px solid #edf0f4; color:#929aaa; font-size:8px; }
    .analytics-pagination { display:flex; gap:4px; }
    .analytics-page { width:24px; height:24px; border:1px solid #e1e5eb; border-radius:5px; background:#fff; color:#6e7686; font-size:8px; cursor:pointer; }
    .analytics-page.active { border-color:#7043f5; background:#7043f5; color:#fff; }
    .analytics-page:disabled { opacity:.45; cursor:default; }
    @@media (max-width: 900px) { .analytics-grid{grid-template-columns:1fr;} .analytics-filter-grid{grid-template-columns:1fr;} }


    /* Reports & Analytics: readable Sales tab */
    .reports-page .report-selector .report-tab {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        min-width: 64px !important;
        min-height: 34px !important;
        color: #7544f5 !important;
        background: transparent !important;
        opacity: 1 !important;
        visibility: visible !important;
        text-indent: 0 !important;
        font-size: 12px !important;
        font-weight: 800 !important;
        white-space: nowrap !important;
    }

    .reports-page .report-selector .report-tab.active {
        color: #ffffff !important;
        background: #7544f5 !important;
        border-radius: 8px !important;
        opacity: 1 !important;
        visibility: visible !important;
    }

    .reports-page .report-selector .report-tab:hover {
        color: #7544f5 !important;
        background: #f5f2ff !important;
    }

    .reports-page .analytics-summary-total {
        color: #202633 !important;
        background: transparent !important;
        opacity: 1 !important;
        visibility: visible !important;
    }

</style>

<div class="reports-page">

    <div class="reports-breadcrumb">
        <span>Analytics</span>
        <span>/</span>
        <span class="current">Reports & Analytics</span>
    </div>

    <div class="reports-header">

        <div>
            <h1 class="reports-title">
                Reports & Analytics
            </h1>

            <p class="reports-subtitle">
                Monitor sales, repairs, appointments, billing, and inventory performance.
            </p>
        </div>

        <div class="reports-header-meta">
            <span class="live-dot"></span>
            Live database information
        </div>

    </div>

    <!-- Report categories -->

    <div class="report-selector">

        <div class="report-selector-label">
            Reports
        </div>

        <a href="#sales" class="report-tab active">
            Sales
        </a>

        <a href="#billing" class="report-tab">
            Billing
        </a>

        <a href="#repairs" class="report-tab">
            Repair Jobs
        </a>

        <a href="#appointments" class="report-tab">
            Appointments
        </a>

        <a href="#inventory" class="report-tab">
            Inventory
        </a>

    </div>

    <form class="analytics-filter-card" asp-action="Index" method="get">
        <div class="analytics-filter-grid">
            <div class="analytics-field">
                <label for="analyticsReport">Select Report</label>
                <select id="analyticsReport" name="report" class="analytics-control">
                    @foreach (var type in (ViewBag.ReportTypes as string[] ?? Array.Empty<string>()))
                    {
                        <option value="@type" selected="@(string.Equals(type, Model.SelectedReport, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@type</option>
                    }
                </select>
            </div>
            <div class="analytics-field">
                <label>Date Range</label>
                <div class="analytics-date-range">
                    <input class="analytics-control" type="date" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" aria-label="Start date" />
                    <input class="analytics-control" type="date" name="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" aria-label="End date" />
                </div>
            </div>
            <div class="analytics-field" style="display:flex;gap:7px;">
                <a class="analytics-button secondary" asp-action="Index">Clear</a>
                <button class="analytics-button" type="submit"><i class="bi bi-bar-chart-line me-1"></i>Generate Report</button>
            </div>
        </div>
    </form>

    <div class="analytics-heading">
        <div>
            <h2>@Model.SelectedReport</h2>
            <p>@Model.ChartSubtitle</p>
        </div>
        <div class="analytics-live"><span class="analytics-live-dot"></span>Live database information</div>
    </div>

    <div class="analytics-grid">
        <section class="analytics-panel">
            <div class="analytics-panel-head">
                <div>
                    <h3 class="analytics-panel-title">@Model.ChartTitle</h3>
                    <div class="analytics-panel-subtitle">@Model.ReportDescription</div>
                </div>
                <span class="analytics-badge">ANALYTICS</span>
            </div>
            <div class="analytics-chart-wrap">
                <canvas id="reportChart" aria-label="@Model.ChartTitle chart"></canvas>
            </div>
        </section>

        <section class="analytics-panel">
            <div class="analytics-panel-head">
                <div>
                    <h3 class="analytics-panel-title">Revenue Summary</h3>
                    <div class="analytics-panel-subtitle">Current report selection</div>
                </div>
                <span class="analytics-badge">SUMMARY</span>
            </div>
            <div class="analytics-summary">
                <div class="analytics-summary-kicker">@Model.SummaryLabel</div>
                <div class="analytics-summary-total">@(Model.SelectedReport.Contains("Sales", StringComparison.OrdinalIgnoreCase) || Model.SelectedReport.Contains("Payment", StringComparison.OrdinalIgnoreCase) ? $"₱{Model.ReportTotal:N2}" : Model.ReportTotal.ToString("N0"))</div>
                <div class="analytics-summary-note">Based on selected date range</div>
                <ul class="analytics-summary-list">
                    <li class="analytics-summary-row"><span>Total Records</span><strong>@Model.ReportTransactionCount.ToString("N0")</strong></li>
                    <li class="analytics-summary-row"><span>Avg. Ticket</span><strong>@(Model.SelectedReport.Contains("Sales", StringComparison.OrdinalIgnoreCase) ? $"₱{Model.AverageTicket:N2}" : "—")</strong></li>
                    <li class="analytics-summary-row"><span>Labor Revenue</span><strong>@(Model.LaborRevenue > 0 ? $"₱{Model.LaborRevenue:N2}" : "—")</strong></li>
                    <li class="analytics-summary-row"><span>Parts Revenue</span><strong>@(Model.PartsRevenue > 0 ? $"₱{Model.PartsRevenue:N2}" : "—")</strong></li>
                </ul>
                <div class="analytics-summary-foot">Values are calculated from existing AutoFlow records; reports are not stored as separate transactions.</div>
            </div>
        </section>
    </div>

    <section class="analytics-panel analytics-table-panel">
        <div class="analytics-panel-head">
            <div>
                <h3 class="analytics-panel-title">Transaction Breakdown</h3>
                <div class="analytics-panel-subtitle">Detailed records included in the selected report.</div>
            </div>
            <div class="analytics-table-tools"><input id="analyticsSearch" class="analytics-table-search" type="search" placeholder="Filter rows..." aria-label="Filter report rows" /></div>
        </div>
        <div class="analytics-table-wrap">
            <table class="analytics-table">
                <thead><tr><th>Date</th><th>Reference</th><th>Customer</th><th>Vehicle</th><th>Sales / Revenue</th><th>Status</th></tr></thead>
                <tbody id="analyticsRows"></tbody>
            </table>
        </div>
        <div class="analytics-table-footer"><span id="analyticsSummary">Showing 0 records</span><div id="analyticsPagination" class="analytics-pagination"></div></div>
    </section>

    <!-- Summary -->

    <div class="report-summary-grid">

        <div class="report-summary-card">

            <div class="report-card-top">
                <div class="report-card-icon">
                    ₱
                </div>
            </div>

            <div class="report-card-label">
                Sales Today
            </div>

            <div class="report-card-value">
                ₱@Model.TotalSalesToday.ToString("N2")
            </div>

            <div class="report-card-note">
                Based on today's issued invoices
            </div>

        </div>

        <div class="report-summary-card">

            <div class="report-card-top">
