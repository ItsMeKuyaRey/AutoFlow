@model AutoFlow.Web.ViewModels.ReportsViewModel

@{
    ViewData["Title"] = "Reports & Analytics";
}

<style>
    .reports-page {
        max-width: 1500px;
        margin: 0 auto;
    }

    .reports-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        color: #8b92a3;
        font-size: 12px;
        font-weight: 650;
    }

    .reports-breadcrumb .current {
        color: #7544f5;
    }

    .reports-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 25px;
    }

    .reports-title {
        margin: 0;
        color: #171b26;
        font-size: 30px;
        font-weight: 800;
        letter-spacing: -0.8px;
    }

    .reports-subtitle {
        margin: 7px 0 0;
        color: #858c9d;
        font-size: 13px;
    }

    .reports-header-meta {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #687082;
        font-size: 12px;
        font-weight: 650;
    }

    .live-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #18b981;
        box-shadow: 0 0 0 4px #e8faf3;
    }

    .report-selector {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 22px;
        padding: 7px;
        background: #ffffff;
        border: 1px solid #e5e8ee;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(24, 31, 45, 0.025);
    }

    .report-selector-label {
        padding: 0 10px;
        color: #858c9d;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.6px;
    }

    .report-tab {
        padding: 9px 13px;
        border-radius: 8px;
        color: #697184;
        font-size: 12px;
        font-weight: 700;
        transition: all 0.18s ease;
    }

    .report-tab:hover {
        background: #f5f2ff;
        color: #7544f5;
    }

    .report-tab.active {
        background: #7544f5;
        color: #ffffff;
        box-shadow: 0 5px 14px rgba(117, 68, 245, 0.2);
    }

    .report-summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 22px;
    }

    .report-summary-card {
        min-height: 125px;
        padding: 19px;
        background: #ffffff;
        border: 1px solid #e5e8ee;
        border-radius: 13px;
        box-shadow: 0 2px 8px rgba(24, 31, 45, 0.025);
    }

    .report-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .report-card-icon {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #f0ebff;
        color: #7544f5;
        font-size: 16px;
        font-weight: 800;
    }

    .report-card-label {
        margin-top: 14px;
        color: #777f91;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }

    .report-card-value {
        margin-top: 5px;
        color: #171b26;
        font-size: 24px;
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    .report-card-note {
        margin-top: 4px;
        color: #9aa1af;
        font-size: 10px;
    }

    .reports-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.45fr) minmax(330px, 0.85fr);
        gap: 18px;
        margin-bottom: 18px;
    }

    .report-panel {
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e5e8ee;
        border-radius: 13px;
        box-shadow: 0 2px 8px rgba(24, 31, 45, 0.025);
    }

    .report-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 19px 20px;
        border-bottom: 1px solid #edf0f4;
    }

    .report-panel-title {
        margin: 0;
        color: #1b2030;
        font-size: 15px;
        font-weight: 800;
    }

    .report-panel-subtitle {
        margin-top: 4px;
        color: #9299a8;
        font-size: 11px;
    }

    .report-panel-badge {
        padding: 5px 8px;
        border-radius: 6px;
        background: #f1edff;
        color: #7544f5;
        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .report-table-wrap {
        overflow-x: auto;
    }

    .report-table {
        width: 100%;
        border-collapse: collapse;
    }

    .report-table th {
        padding: 11px 20px;
        background: #fafbfc;
        color: #8a91a0;
        font-size: 9px;
        font-weight: 800;
        text-align: left;
        text-transform: uppercase;
        letter-spacing: 0.65px;
        white-space: nowrap;
    }

    .report-table td {
        padding: 13px 20px;
        border-top: 1px solid #eef0f4;
        color: #3e4656;
        font-size: 12px;
        vertical-align: middle;
    }

    .report-table tr:hover td {
        background: #fcfbff;
    }

    .report-primary {
        color: #1c2230;
        font-weight: 750;
    }

    .report-secondary {
        margin-top: 3px;
        color: #959cab;
        font-size: 10px;
    }

    .report-amount {
        color: #1c2230;
        font-weight: 800;
        white-space: nowrap;
    }

    .report-status {
        display: inline-flex;
        align-items: center;
        padding: 4px 7px;
        border-radius: 5px;
        background: #f1edff;
        color: #7544f5;
        font-size: 8px;
        font-weight: 800;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .report-status.completed,
    .report-status.paid {
        background: #e9faf3;
        color: #14966a;
    }

    .report-status.pending,
    .report-status.open,
    .report-status.scheduled {
        background: #fff5e8;
        color: #c97916;
    }

    .report-status.cancelled,
    .report-status.outofstock {
        background: #fff0f1;
        color: #dc5962;
    }

    .report-status.lowstock {
        background: #fff7e8;
        color: #c47b17;
    }

    .empty-report {
        padding: 38px 20px;
        text-align: center;
    }

    .empty-report-icon {
        width: 40px;
        height: 40px;
        margin: 0 auto 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: #f3efff;
        color: #7544f5;
        font-size: 17px;
    }

    .empty-report-title {
        color: #4d5565;
        font-size: 12px;
        font-weight: 750;
    }

    .empty-report-text {
        margin-top: 4px;
        color: #a0a6b2;
        font-size: 10px;
    }

    .report-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 12px 20px;
        border-top: 1px solid #edf0f4;
        color: #969dac;
        font-size: 10px;
    }

    .report-footer strong {
        color: #7544f5;
    }

    .inventory-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 18px;
    }

    .report-metric-list {
        padding: 4px 0;
    }

    .report-metric-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 13px 20px;
        border-bottom: 1px solid #eef0f4;
    }

    .report-metric-row:last-child {
        border-bottom: 0;
    }

    .metric-label {
        color: #5f6777;
        font-size: 11px;
        font-weight: 650;
    }

    .metric-value {
        color: #1c2230;
        font-size: 13px;
        font-weight: 800;
    }

    .report-note {
        margin-top: 18px;
        padding: 13px 15px;
        border: 1px solid #e9e3ff;
        border-radius: 9px;
        background: #faf8ff;
        color: #77708c;
        font-size: 10px;
        line-height: 1.55;
    }

    .report-note strong {
        color: #7544f5;
    }

    @@media (max-width: 1150px) {
        .report-summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .reports-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 720px) {
        .reports-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .report-selector {
            overflow-x: auto;
        }

        .report-selector-label {
            display: none;
        }

        .report-tab {
            white-space: nowrap;
        }

        .report-summary-grid {
            grid-template-columns: 1fr;
        }

        .inventory-grid {
            grid-template-columns: 1fr;
        }

        .report-panel-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .report-table th,
        .report-table td {
            padding-left: 13px;
            padding-right: 13px;
        }
    }
</style>

<div class="reports-page">

    <div class="reports-breadcrumb">
        <span>Analytics</span>
        <span>/</span>
        <span class="current">Reports & Analytics</span>
    </div>

    <div class="reports-header">

        <div>
            <h1 class="reports-title">
                Reports & Analytics
            </h1>

            <p class="reports-subtitle">
                Monitor sales, repairs, appointments, billing, and inventory performance.
            </p>
        </div>

        <div class="reports-header-meta">
            <span class="live-dot"></span>
            Live database information
        </div>

    </div>

    <!-- Report categories -->

    <div class="report-selector">

        <div class="report-selector-label">
            Reports
        </div>

        <a href="#sales" class="report-tab active">
            Sales
        </a>

        <a href="#billing" class="report-tab">
            Billing
        </a>

        <a href="#repairs" class="report-tab">
            Repair Jobs
        </a>

        <a href="#appointments" class="report-tab">
            Appointments
        </a>

        <a href="#inventory" class="report-tab">
            Inventory
        </a>

    </div>

    <!-- Summary -->

    <div class="report-summary-grid">

        <div class="report-summary-card">

            <div class="report-card-top">
                <div class="report-card-icon">
                    ₱
                </div>
            </div>

            <div class="report-card-label">
                Sales Today
            </div>

            <div class="report-card-value">
                ₱@Model.TotalSalesToday.ToString("N2")
            </div>

            <div class="report-card-note">
                Based on today's issued invoices
            </div>

        </div>

        <div class="report-summary-card">

            <div class="report-card-top">
                <div class="report-card-icon">
                    ₱
                </div>
            </div>

            <div class="report-card-label">
                Sales This Month
            </div>

            <div class="report-card-value">
                ₱@Model.TotalSalesThisMonth.ToString("N2")
            </div>

            <div class="report-card-note">
                Current calendar month
            </div>

        </div>

        <div class="report-summary-card">

            <div class="report-card-top">
                <div class="report-card-icon">
                    !
                </div>
            </div>

            <div class="report-card-label">
                Outstanding Payments
            </div>

            <div class="report-card-value">
                ₱@Model.OutstandingPayments.ToString("N2")
            </div>

            <div class="report-card-note">
                Remaining unpaid invoice balance
            </div>

        </div>

        <div class="report-summary-card">

            <div class="report-card-top">
                <div class="report-card-icon">
                    ✓
                </div>
            </div>

            <div class="report-card-label">
                Completed Repairs
            </div>

            <div class="report-card-value">
                @Model.CompletedRepairs
            </div>

            <div class="report-card-note">
                Completed repair job orders
            </div>

        </div>

    </div>

    <!-- Sales -->

    <div id="sales" class="reports-grid">

        <section class="report-panel">

            <div class="report-panel-header">

                <div>
                    <h2 class="report-panel-title">
                        Daily Sales
                    </h2>

                    <div class="report-panel-subtitle">
                        Revenue generated from issued billing records.
                    </div>
                </div>

                <span class="report-panel-badge">
                    Daily
                </span>

            </div>

            @if (Model.DailySales.Any())
            {
                <div class="report-table-wrap">

                    <table class="report-table">

                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Invoices</th>
                                <th>Total Sales</th>
                            </tr>
                        </thead>

                        <tbody>

                        @foreach (var row in Model.DailySales)
                        {
                            <tr>

                                <td>
                                    <div class="report-primary">
                                        @row.Label
                                    </div>
                                </td>

                                <td>
                                    @row.Count
                                </td>

                                <td class="report-amount">
                                    ₱@row.Amount.ToString("N2")
                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-report">

                    <div class="empty-report-icon">
                        ₱
                    </div>

                    <div class="empty-report-title">
                        No sales recorded today
                    </div>

                    <div class="empty-report-text">
                        Daily sales will appear here when billing records are issued.
                    </div>

                </div>
            }

        </section>

        <section class="report-panel">

            <div class="report-panel-header">

                <div>
                    <h2 class="report-panel-title">
                        Monthly Sales
                    </h2>

                    <div class="report-panel-subtitle">
                        Current month's billing performance.
                    </div>
                </div>

                <span class="report-panel-badge">
                    Monthly
                </span>

            </div>

            @if (Model.MonthlySales.Any())
            {
                <div class="report-table-wrap">
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th>Period</th>
                                <th>Invoices</th>
                                <th>Revenue</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Model.MonthlySales)
                        {
                            <tr>
                                <td>
                                    <div class="report-primary">@row.Label</div>
                                </td>
                                <td>@row.Count</td>
                                <td class="report-amount">₱@row.Amount.ToString("N2")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-report">
                    <div class="empty-report-icon">₱</div>
                    <div class="empty-report-title">No monthly sales recorded</div>
                    <div class="empty-report-text">
                        Monthly sales will appear here when billing records are issued.
                    </div>
                </div>
            }

        </section>

    </div>

    <!-- Billing -->

    <div id="billing" class="reports-grid">

        <section class="report-panel">

            <div class="report-panel-header">
                <div>
                    <h2 class="report-panel-title">Billing &amp; Payments</h2>
                    <div class="report-panel-subtitle">
                        Current billing and payment position from recorded invoices.
                    </div>
                </div>

                <span class="report-panel-badge">Financial</span>
            </div>

            <div class="report-metric-list">

                <div class="report-metric-row">
                    <span class="metric-label">Sales Today</span>
                    <span class="metric-value">₱@Model.TotalSalesToday.ToString("N2")</span>
                </div>

                <div class="report-metric-row">
                    <span class="metric-label">Sales This Month</span>
                    <span class="metric-value">₱@Model.TotalSalesThisMonth.ToString("N2")</span>
                </div>

                <div class="report-metric-row">
                    <span class="metric-label">Outstanding Payments</span>
                    <span class="metric-value">₱@Model.OutstandingPayments.ToString("N2")</span>
                </div>

            </div>

            <div class="report-footer">
                <span>Based on existing billing records</span>
                <strong>Live</strong>
            </div>

        </section>

        <section class="report-panel">

            <div class="report-panel-header">
                <div>
                    <h2 class="report-panel-title">Payment Position</h2>
                    <div class="report-panel-subtitle">
                        Unpaid balances remain visible for management monitoring.
                    </div>
                </div>

                <span class="report-panel-badge">Monitor</span>
            </div>

            <div class="empty-report">
                <div class="empty-report-icon">₱</div>
                <div class="empty-report-title">
                    Outstanding balance: ₱@Model.OutstandingPayments.ToString("N2")
                </div>
                <div class="empty-report-text">
                    Review individual billing records from Billing &amp; Payments for payment details.
                </div>
            </div>

        </section>

    </div>

    <!-- Repair Jobs -->

    <div id="repairs" class="reports-grid">

        <section class="report-panel">

            <div class="report-panel-header">
                <div>
                    <h2 class="report-panel-title">Completed Repair Jobs</h2>
                    <div class="report-panel-subtitle">
                        Recently completed repair job orders.
                    </div>
                </div>

                <span class="report-panel-badge">Completed</span>
            </div>

            @if (Model.CompletedRepairRows.Any())
            {
                <div class="report-table-wrap">
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th>Job Order</th>
                                <th>Customer</th>
                                <th>Total Cost</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Model.CompletedRepairRows)
                        {
                            <tr>
                                <td>
                                    <div class="report-primary">@row.Label</div>
                                </td>
                                <td>
                                    <div class="report-primary">@row.SecondaryLabel</div>
                                </td>
                                <td class="report-amount">₱@row.Amount.ToString("N2")</td>
                                <td>@row.Date?.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-report">
                    <div class="empty-report-icon">✓</div>
                    <div class="empty-report-title">No completed repair jobs</div>
                    <div class="empty-report-text">
                        Completed repair jobs will appear here after job orders are marked completed.
                    </div>
                </div>
            }

        </section>

        <section class="report-panel">

            <div class="report-panel-header">
                <div>
                    <h2 class="report-panel-title">Active Repair Jobs</h2>
                    <div class="report-panel-subtitle">
                        Repair jobs currently in progress.
                    </div>
                </div>

                <span class="report-panel-badge">Active</span>
            </div>

            @if (Model.ActiveRepairRows.Any())
            {
                <div class="report-table-wrap">
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th>Job Order</th>
                                <th>Customer</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Model.ActiveRepairRows)
                        {
                            <tr>
                                <td>
                                    <div class="report-primary">@row.Label</div>
                                </td>
                                <td>
                                    <div class="report-primary">@row.SecondaryLabel</div>
                                </td>
                                <td>
                                    <span class="report-status @row.Status.Replace(" ", "").ToLowerInvariant()">
                                        @row.Status
                                    </span>
                                </td>
                                <td>@row.Date?.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-report">
                    <div class="empty-report-icon">✓</div>
                    <div class="empty-report-title">No active repair jobs</div>
                    <div class="empty-report-text">
                        Active repair jobs will appear here when work is in progress.
                    </div>
                </div>
            }

        </section>

    </div>

    <!-- Appointments -->

    <div id="appointments" class="reports-grid">

        <section class="report-panel">

            <div class="report-panel-header">
                <div>
                    <h2 class="report-panel-title">Appointment Activity</h2>
                    <div class="report-panel-subtitle">
                        Recently scheduled service appointments.
                    </div>
                </div>

                <span class="report-panel-badge">Recent</span>
            </div>

            @if (Model.AppointmentRows.Any())
            {
                <div class="report-table-wrap">
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th>Vehicle</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Model.AppointmentRows)
                        {
                            <tr>
                                <td>
                                    <div class="report-primary">@row.Label</div>
                                </td>
                                <td>
                                    <div class="report-primary">@row.SecondaryLabel</div>
                                </td>
                                <td>
                                    <span class="report-status @row.Status.Replace(" ", "").ToLowerInvariant()">
                                        @row.Status
                                    </span>
                                </td>
                                <td>@row.Date?.ToString("MMM dd, yyyy h:mm tt")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-report">
                    <div class="empty-report-icon">□</div>
                    <div class="empty-report-title">No appointments recorded</div>
                    <div class="empty-report-text">
                        Appointment activity will appear here when service appointments are created.
                    </div>
                </div>
            }

        </section>

        <section class="report-panel">

            <div class="report-panel-header">
                <div>
                    <h2 class="report-panel-title">Appointment Summary</h2>
                    <div class="report-panel-subtitle">
                        Total appointment records currently stored.
                    </div>
                </div>

                <span class="report-panel-badge">Summary</span>
            </div>

            <div class="report-metric-list">
                <div class="report-metric-row">
                    <span class="metric-label">Total Appointments</span>
                    <span class="metric-value">@Model.TotalAppointments</span>
                </div>
            </div>

            <div class="report-note">
                <strong>Operational view:</strong>
                Appointment reporting uses the existing Service Appointment Scheduling records.
            </div>

        </section>

    </div>

    <!-- Inventory -->

    <div id="inventory" class="inventory-grid">

        <section class="report-panel">

            <div class="report-panel-header">
                <div>
                    <h2 class="report-panel-title">Parts Inventory Summary</h2>
                    <div class="report-panel-subtitle">
                        Current parts and stock condition.
                    </div>
                </div>

                <span class="report-panel-badge">Inventory</span>
            </div>

            <div class="report-metric-list">

                <div class="report-metric-row">
                    <span class="metric-label">Total Parts</span>
                    <span class="metric-value">@Model.TotalParts</span>
                </div>

                <div class="report-metric-row">
                    <span class="metric-label">Low Stock Parts</span>
                    <span class="metric-value">@Model.LowStockParts</span>
                </div>

            </div>

            <div class="report-footer">
                <span>Low stock threshold: 5 units or fewer</span>
                <strong>Live</strong>
            </div>

        </section>

        <section class="report-panel">

            <div class="report-panel-header">
                <div>
                    <h2 class="report-panel-title">Low Stock Parts</h2>
                    <div class="report-panel-subtitle">
                        Parts requiring inventory attention.
                    </div>
                </div>

                <span class="report-panel-badge">Attention</span>
            </div>

            @if (Model.LowStockPartRows.Any())
            {
                <div class="report-table-wrap">
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th>Part</th>
                                <th>Part Number</th>
                                <th>Stock</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Model.LowStockPartRows)
                        {
                            <tr>
                                <td>
                                    <div class="report-primary">@row.Label</div>
                                </td>
                                <td>
                                    <div class="report-secondary">@row.SecondaryLabel</div>
                                </td>
                                <td>@row.Count</td>
                                <td>
                                    <span class="report-status @(row.Status == "Out of Stock" ? "outofstock" : "lowstock")">
                                        @row.Status
                                    </span>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-report">
                    <div class="empty-report-icon">✓</div>
                    <div class="empty-report-title">No low stock parts</div>
                    <div class="empty-report-text">
                        Parts with five or fewer units will appear here.
                    </div>
                </div>
            }

        </section>

    </div>

    <div class="report-note">
        <strong>AutoFlow Reports:</strong>
        This workspace summarizes information already stored in AutoFlow modules.
        Report values are calculated from the current database records and are intended
        to support operational and management monitoring.
    </div>

</div>
