@model AutoFlow.Web.Models.Customer

@{
    ViewData["Title"] = "Customer Details";
    var initials = $"{(Model.FirstName?.FirstOrDefault().ToString() ?? "")}{(Model.LastName?.FirstOrDefault().ToString() ?? "")}".ToUpper();
}

<div class="page-header">
    <div>
        <h1>Customer Details</h1>
        <p>View customer profile and information.</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="af-button af-button-primary">Edit</a>
        <a asp-action="Index" class="af-button af-button-secondary">Back to List</a>
    </div>
</div>

<div class="af-card" style="max-width: 720px; padding: 28px;">
    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="avatar avatar-blue" style="width: 48px; height: 48px; font-size: 16px;">@initials</div>
        <div>
            <h2 class="mb-0" style="font-size: 20px;">@Model.FirstName @Model.LastName</h2>
            <small class="text-muted">ID: AF-@Model.CustomerId.ToString("D5")</small>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label text-muted small">Phone</label>
            <div class="fw-semibold">@(string.IsNullOrEmpty(Model.Phone) ? "—" : Model.Phone)</div>
        </div>
        <div class="col-md-6">
            <label class="form-label text-muted small">Email</label>
            <div class="fw-semibold">@(string.IsNullOrEmpty(Model.Email) ? "—" : Model.Email)</div>
        </div>
        <div class="col-12">
            <label class="form-label text-muted small">Address</label>
            <div class="fw-semibold">@(string.IsNullOrEmpty(Model.Address) ? "—" : Model.Address)</div>
        </div>
        <div class="col-md-6">
            <label class="form-label text-muted small">Created</label>
            <div class="fw-semibold">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</div>
        </div>
        <div class="col-md-6">
            <label class="form-label text-muted small">Last Updated</label>
            <div class="fw-semibold">@Model.UpdatedAt.ToString("MMM dd, yyyy HH:mm")</div>
        </div>
    </div>
</div>