@model IEnumerable<AutoFlow.Web.Models.Customer>

@{
    ViewData["Title"] = "Archived Customers";
    var customers = Model.ToList();
}

<style>
    .customer-archive-history {
        max-width: 1180px;
        margin: 0 auto;
    }

    .customer-archive-history-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 22px;
    }

    .customer-archive-history-back {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 8px;
        color: #7c3aed;
        text-decoration: none;
        font-size: 10px;
        font-weight: 800;
    }

    .customer-archive-history-back:hover {
        color: #5b21b6;
    }

    .customer-archive-eyebrow {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 7px;
        color: #7c3aed;
        font-size: 8px;
        font-weight: 850;
        letter-spacing: .12em;
    }

    .customer-archive-eyebrow-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #7c3aed;
    }

    .customer-archive-history-title {
        margin: 0;
        color: #111827;
        font-size: 25px;
        font-weight: 900;
        letter-spacing: -.035em;
    }

    .customer-archive-history-subtitle {
        margin: 6px 0 0;
        color: #8b95a7;
        font-size: 10px;
    }

    .customer-archive-history-count {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 12px;
        border: 1px solid #e6e9ee;
        border-radius: 9px;
        background: #fff;
        color: #657084;
        font-size: 9px;
        font-weight: 800;
    }

    .customer-archive-history-count strong {
        color: #7c3aed;
        font-size: 12px;
    }

    .customer-archive-history-card {
        overflow: hidden;
        border: 1px solid #e5e8ed;
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 8px 28px rgba(15,23,42,.035);
    }

    .customer-archive-history-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 13px 17px;
        border-bottom: 1px solid #edf0f4;
        background: #fbfcfe;
    }

    .customer-archive-history-toolbar span {
        color: #8d97a8;
        font-size: 9px;
    }

    .customer-archive-history-table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .customer-archive-history-table {
        width: 100%;
        min-width: 820px;
        border-collapse: collapse;
    }

    .customer-archive-history-table th {
        height: 42px;
        padding: 0 16px;
        background: #fafbfc;
        border-bottom: 1px solid #e5e8ed;
        color: #98a1b0;
        font-size: 8px;
        font-weight: 850;
        letter-spacing: .08em;
        text-align: left;
        text-transform: uppercase;
    }

    .customer-archive-history-table td {
        padding: 13px 16px;
        border-bottom: 1px solid #f0f2f5;
        color: #526073;
        font-size: 10px;
        vertical-align: middle;
    }

    .customer-archive-history-table tr:last-child td {
        border-bottom: 0;
    }

    .customer-archive-history-table tbody tr:hover {
        background: #faf9ff;
    }

    .customer-archive-person {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .customer-archive-person-avatar {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        background: #f0ebff;
        color: #7c3aed;
        display: grid;
        place-items: center;
        font-size: 9px;
        font-weight: 850;
    }

    .customer-archive-person strong {
        display: block;
        color: #1f2937;
        font-size: 10px;
        font-weight: 850;
    }

    .customer-archive-person span {
        display: block;
        margin-top: 3px;
        color: #9aa3b2;
        font-size: 8px;
    }

    .customer-archive-contact span {
        display: block;
        margin-bottom: 3px;
        color: #657084;
        font-size: 9px;
    }

    .customer-archive-contact span:last-child {
        margin-bottom: 0;
        color: #9aa3b2;
    }

    .customer-archive-status {
        display: inline-flex;
        padding: 5px 8px;
        border-radius: 999px;
        background: #fff1f0;
        color: #d95548;
        font-size: 8px;
        font-weight: 850;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .customer-archive-date {
        margin-top: 5px;
        color: #9aa3b2;
        font-size: 8px;
    }

    .customer-archive-row-actions {
        display: flex;
        justify-content: flex-end;
        gap: 6px;
    }

    .customer-archive-row-button {
        height: 29px;
        padding: 0 9px;
        border: 1px solid #e1e5eb;
        border-radius: 7px;
        background: #fff;
        color: #657084;
        font-size: 8px;
        font-weight: 800;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .customer-archive-row-button:hover {
        border-color: #c4b5fd;
        color: #7c3aed;
    }

    .customer-archive-row-button.restore {
        border-color: #ccefe1;
        background: #f4fffa;
        color: #059669;
    }

    .customer-archive-row-button.restore:hover {
        background: #ecfdf5;
    }

    .customer-archive-empty {
        padding: 70px 20px;
        text-align: center;
    }

    .customer-archive-empty-icon {
        width: 50px;
        height: 50px;
        margin: 0 auto 14px;
        border-radius: 13px;
        background: #ecfdf5;
        color: #059669;
        display: grid;
        place-items: center;
        font-size: 19px;
    }

    .customer-archive-empty h2 {
        margin: 0;
        color: #263143;
        font-size: 14px;
        font-weight: 850;
    }

    .customer-archive-empty p {
        margin: 6px 0 18px;
        color: #9aa3b2;
        font-size: 9px;
    }

    .customer-archive-empty-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 34px;
        padding: 0 13px;
        border-radius: 8px;
        background: #7c3aed;
        color: #fff;
        text-decoration: none;
        font-size: 9px;
        font-weight: 800;
    }

    @@media (max-width: 700px) {
        .customer-archive-history-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .customer-archive-history-count {
            align-self: flex-start;
        }
    }

    /* AutoFlow customer archive-history overlay */
    .customer-archive-history-page {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        min-height: 100vh;
        margin: 0;
        background: transparent;
        overflow: hidden;
        z-index: 5000;
    }

    .customer-archive-history-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(15, 23, 42, .22);
        backdrop-filter: blur(2px);
    }

    .customer-archive-history-drawer {
        position: absolute;
        top: 0;
        right: 0;
        width: min(780px, 100%);
        height: 100vh;
        max-height: 100vh;
        overflow-y: auto;
        box-sizing: border-box;
        background: #fff;
        border-left: 1px solid #e5e7eb;
        box-shadow: -18px 0 45px rgba(15, 23, 42, .12);
        animation: afCustomerDrawerIn .20s ease-out;
    }

    .customer-archive-history {
        max-width: none;
        min-height: 100%;
        margin: 0;
        padding: 26px 28px 30px;
        box-sizing: border-box;
    }

    .customer-archive-history-header {
        align-items: flex-start;
    }

    @@keyframes afCustomerDrawerIn {
        from { transform: translateX(28px); opacity: .94; }
        to { transform: translateX(0); opacity: 1; }
    }

    @@media (max-width: 700px) {
        .customer-archive-history-drawer {
            width: 100%;
            border-left: 0;
        }

        .customer-archive-history {
            padding-left: 20px;
            padding-right: 20px;
        }
    }

    .customer-archive-person-avatar { overflow:hidden; }
    .customer-archive-person-avatar img { width:100%; height:100%; object-fit:contain; display:block; background:#fff; }
</style>
<div class="customer-archive-history-page">

    <div class="customer-archive-history-backdrop"></div>

    <aside class="customer-archive-history-drawer">



        <div class="customer-archive-history">

            <div class="customer-archive-history-header">

                <div>

                    <a asp-action="Index"
                       class="customer-archive-history-back">
                        ← Back to Customers
                    </a>

                    <div class="customer-archive-eyebrow">
                        <span class="customer-archive-eyebrow-dot"></span>
                        CUSTOMER HISTORY
                    </div>

                    <h1 class="customer-archive-history-title">
                        Archived Customers
                    </h1>

                    <p class="customer-archive-history-subtitle">
                        Preserved customer records that are no longer active.
                    </p>

                </div>

                <div class="customer-archive-history-count">
                    Archived
                    <strong>@customers.Count</strong>
                </div>

            </div>

            <div class="customer-archive-history-card">

                @if (customers.Any())
                {
                    <div class="customer-archive-history-toolbar">
                        <span>
                            Historical customer records
                        </span>

                        <span>
                            Restoration remains available
                        </span>
                    </div>

                    <div class="customer-archive-history-table-wrap">

                        <table class="customer-archive-history-table">

                            <thead>
                                <tr>
                                    <th>Customer</th>
                                    <th>Contact</th>
                                    <th>Address</th>
                                    <th>Archive Status</th>
                                    <th style="text-align:right;">Actions</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var customer in customers)
                                {
                                    var firstInitial =
                                        string.IsNullOrWhiteSpace(customer.FirstName)
                                            ? "?"
                                            : customer.FirstName.Substring(0, 1);

                                    var lastInitial =
                                        string.IsNullOrWhiteSpace(customer.LastName)
                                            ? ""
                                            : customer.LastName.Substring(0, 1);

                                    <tr>

                                        <td>
                                            <div class="customer-archive-person">

                                                <div class="customer-archive-person-avatar">
                                                    @if (!string.IsNullOrWhiteSpace(customer.ImageUrl))
                                                    {
                                                        <img src="@customer.ImageUrl"
                                                             alt="@customer.FirstName @customer.LastName" />
                                                    }
                                                    else
                                                    {
                                                        @firstInitial@lastInitial
                                                    }
                                                </div>

                                                <div>
                                                    <strong>
                                                        @customer.FirstName @customer.LastName
                                                    </strong>

                                                    <span>
                                                        ID #@customer.CustomerId
                                                    </span>
                                                </div>

                                            </div>
                                        </td>

                                        <td>
                                            <div class="customer-archive-contact">

                                                <span>
                                                    @(string.IsNullOrWhiteSpace(customer.Phone)
                                                        ? "No phone"
                                                        : customer.Phone)
                                                </span>

                                                <span>
                                                    @(string.IsNullOrWhiteSpace(customer.Email)
                                                        ? "No email"
                                                        : customer.Email)
                                                </span>

                                            </div>
                                        </td>

                                        <td>
                                            @(string.IsNullOrWhiteSpace(customer.Address)
                                                ? "Not provided"
                                                : customer.Address)
                                        </td>

                                        <td>

                                            <span class="customer-archive-status">
                                                Archived
                                            </span>

                                            <div class="customer-archive-date">
                                                @customer.UpdatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                                            </div>

                                        </td>

                                        <td>

                                            <div class="customer-archive-row-actions">

                                                <a asp-action="ArchivedDetails"
                                                   asp-route-id="@customer.CustomerId"
                                                   class="customer-archive-row-button">
                                                    View
                                                </a>

                                                <form asp-action="Restore"
                                                      method="post"
                                                      style="margin:0;">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@customer.CustomerId" />

                                                    <button type="submit"
                                                            class="customer-archive-row-button restore">
                                                        Restore
                                                    </button>

                                                </form>

                                            </div>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="customer-archive-empty">

                        <div class="customer-archive-empty-icon">
                            ✓
                        </div>

                        <h2>No Archived Customers</h2>

                        <p>
                            All customer records are currently active.
                        </p>

                        <a asp-action="Index"
                           class="customer-archive-empty-button">
                            Back to Customers
                        </a>

                    </div>
                }

            </div>

        </div>
    </aside>

</div>
