@model AutoFlow.Web.Models.Customer

@{
    ViewData["Title"] = "Delete Customer";
}

<div class="page-header">
    <div>
        <h1>Delete Customer</h1>
        <p>Are you sure you want to delete this customer?</p>
    </div>
</div>

<div class="af-card" style="max-width: 620px; padding: 28px;">
    <div class="alert alert-warning mb-4">
        This action cannot be undone. All related vehicles and history may also be affected depending on database rules.
    </div>

    <dl class="row mb-4">
        <dt class="col-sm-4 text-muted">Name</dt>
        <dd class="col-sm-8 fw-semibold">@Model.FirstName @Model.LastName</dd>

        <dt class="col-sm-4 text-muted">Phone</dt>
        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Phone) ? "—" : Model.Phone)</dd>

        <dt class="col-sm-4 text-muted">Email</dt>
        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Email) ? "—" : Model.Email)</dd>

        <dt class="col-sm-4 text-muted">Address</dt>
        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Address) ? "—" : Model.Address)</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="CustomerId" />
        <div class="d-flex gap-2">
            <button type="submit" class="af-button" style="background:#dc2626; color:white;">Delete Customer</button>
            <a asp-action="Index" class="af-button af-button-secondary">Cancel</a>
        </div>
    </form>
</div>