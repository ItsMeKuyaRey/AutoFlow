@model AutoFlow.Web.Models.Customer

@{
    ViewData["Title"] = "Archive Customer";
}

<div class="customer-archive-page">

    <div class="customer-archive-card">

        <div class="customer-archive-icon">
            📦
        </div>

        <span class="customer-status-badge active">
            Active Customer
        </span>

        <h1>Archive Customer?</h1>

        <p class="customer-archive-message">
            You are about to archive
            <strong>
                @Model.FirstName @Model.LastName
            </strong>.
            This customer will be removed from the active customer list,
            but their records and history will be preserved.
        </p>

        <div class="customer-archive-summary">

            <div>
                <span>Customer ID</span>
                <strong>#@Model.CustomerId</strong>
            </div>

            <div>
                <span>Phone</span>
                <strong>
                    @(string.IsNullOrWhiteSpace(Model.Phone)
                        ? "Not provided"
                        : Model.Phone)
                </strong>
            </div>

            <div>
                <span>Email</span>
                <strong>
                    @(string.IsNullOrWhiteSpace(Model.Email)
                        ? "Not provided"
                        : Model.Email)
                </strong>
            </div>

        </div>

        <form asp-action="Delete"
              method="post"
              class="customer-archive-actions">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="id"
                   value="@Model.CustomerId" />

            <a asp-action="Index"
               class="customer-cancel-button">
                Cancel
            </a>

            <button type="submit"
                    class="customer-danger-button">
                Archive Customer
            </button>

        </form>

    </div>

</div>