@model AutoFlow.Web.Models.Customer

@{
    ViewData["Title"] = "Edit Customer";
}

<div class="customer-form-page">

    <div class="customer-form-header">

        <div>
            <a asp-action="Index" class="customer-back-link">
                <span>←</span> Back to Customers
            </a>

            <h1>Edit Customer</h1>
            <p>Update the customer's information below.</p>
        </div>

    </div>

    <form asp-action="Edit"
          asp-route-id="@Model.CustomerId"
          method="post"
          class="customer-form-card">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="CustomerId" />

        <div asp-validation-summary="ModelOnly"
             class="customer-validation">
        </div>

        <div class="customer-form-section">
            <div class="customer-form-section-heading">
                <h2>Basic Information</h2>
                <p>Enter the customer's name.</p>
            </div>

            <div class="customer-form-row">

                <div class="customer-field">
                    <label asp-for="FirstName">
                        First Name
                    </label>

                    <input asp-for="FirstName"
                           placeholder="Enter first name" />

                    <span asp-validation-for="FirstName"
                          class="customer-field-error">
                    </span>
                </div>

                <div class="customer-field">
                    <label asp-for="LastName">
                        Last Name
                    </label>

                    <input asp-for="LastName"
                           placeholder="Enter last name" />

                    <span asp-validation-for="LastName"
                          class="customer-field-error">
                    </span>
                </div>

            </div>
        </div>

        <div class="customer-form-section">

            <div class="customer-form-section-heading">
                <h2>Contact Information</h2>
                <p>Keep the customer's contact details up to date.</p>
            </div>

            <div class="customer-form-row">

                <div class="customer-field">
                    <label asp-for="Phone">
                        Phone
                    </label>

                    <input asp-for="Phone"
                           placeholder="Enter phone number" />

                    <span asp-validation-for="Phone"
                          class="customer-field-error">
                    </span>
                </div>

                <div class="customer-field">
                    <label asp-for="Email">
                        Email
                    </label>

                    <input asp-for="Email"
                           placeholder="Enter email address" />

                    <span asp-validation-for="Email"
                          class="customer-field-error">
                    </span>
                </div>

            </div>

            <div class="customer-field">
                <label asp-for="Address">
                    Address
                </label>

                <textarea asp-for="Address"
                          rows="4"
                          placeholder="Enter customer address"></textarea>

                <span asp-validation-for="Address"
                      class="customer-field-error">
                </span>
            </div>

        </div>

        <div class="customer-form-footer">

            <a asp-action="Index"
               class="customer-cancel-button">
                Cancel
            </a>

            <button type="submit"
                    class="customer-primary-button">
                Save Changes
            </button>

        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}