@model AutoFlow.Web.Models.Customer

@{
    ViewData["Title"] = "Add Customer";
}

<style>
    .customer-drawer-page {
        position: relative;
        min-height: calc(100vh - 120px);
        margin: -20px -24px;
        background: #f5f7fb;
        overflow: hidden;
    }

    .customer-drawer-backdrop {
        position: absolute;
        inset: 0;
        background:
            linear-gradient(90deg, rgba(245,247,251,.82), rgba(245,247,251,.58)),
            #f5f7fb;
    }

    .customer-drawer-shell {
        position: relative;
        min-height: calc(100vh - 120px);
    }

    .customer-drawer {
        position: absolute;
        top: 0;
        right: 0;
        width: min(560px, 100%);
        min-height: calc(100vh - 120px);
        background: #fff;
        border-left: 1px solid #e5e7eb;
        box-shadow: -18px 0 45px rgba(15, 23, 42, .10);
        display: flex;
        flex-direction: column;
        z-index: 2;
    }

    .customer-drawer-header {
        padding: 25px 28px 22px;
        border-bottom: 1px solid #edf0f4;
    }

    .customer-drawer-title-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
    }

    .customer-drawer-title {
        margin: 0;
        color: #111827;
        font-size: 20px;
        font-weight: 850;
        letter-spacing: -.02em;
    }

    .customer-drawer-subtitle {
        margin: 7px 0 0;
        color: #8b95a7;
        font-size: 11px;
        line-height: 1.6;
    }

    .customer-drawer-close {
        color: #8b95a7;
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
        padding-top: 3px;
    }

    .customer-drawer-close:hover {
        color: #7c3aed;
    }

    .customer-drawer-body {
        flex: 1;
        overflow-y: auto;
        padding: 26px 28px 30px;
    }

    .customer-drawer-section {
        margin-bottom: 26px;
    }

    .customer-drawer-section:last-child {
        margin-bottom: 0;
    }

    .customer-drawer-section-heading {
        margin-bottom: 14px;
    }

    .customer-drawer-section-heading h2 {
        margin: 0;
        color: #172033;
        font-size: 12px;
        font-weight: 850;
    }

    .customer-drawer-section-heading p {
        margin: 4px 0 0;
        color: #9aa3b2;
        font-size: 10px;
    }

    .customer-drawer-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .customer-drawer-field {
        margin-bottom: 14px;
    }

    .customer-drawer-field.full {
        grid-column: 1 / -1;
    }

    .customer-drawer-field label {
        display: block;
        margin-bottom: 7px;
        color: #697386;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    .customer-drawer-field input,
    .customer-drawer-field textarea {
        width: 100%;
        border: 1px solid #e2e6ed;
        border-radius: 8px;
        background: #fff;
        color: #172033;
        font-size: 11px;
        padding: 11px 12px;
        outline: none;
        transition: .18s ease;
        box-sizing: border-box;
    }

    .customer-drawer-field input {
        height: 40px;
    }

    .customer-drawer-field textarea {
        min-height: 92px;
        resize: vertical;
    }

    .customer-drawer-field input:focus,
    .customer-drawer-field textarea:focus {
        border-color: #8b5cf6;
        box-shadow: 0 0 0 3px rgba(124, 58, 237, .08);
    }

    .customer-drawer-field-error {
        display: block;
        margin-top: 5px;
        color: #dc2626;
        font-size: 9px;
    }

    .customer-drawer-validation {
        margin-bottom: 20px;
        padding: 11px 13px;
        border: 1px solid #fecaca;
        border-radius: 8px;
        background: #fff7f7;
        color: #b91c1c;
        font-size: 10px;
    }

    .customer-drawer-footer {
        display: flex;
        justify-content: flex-end;
        gap: 9px;
        padding: 17px 28px;
        border-top: 1px solid #edf0f4;
        background: #fff;
    }

    .customer-drawer-btn {
        min-width: 112px;
        height: 38px;
        padding: 0 15px;
        border-radius: 8px;
        font-size: 10px;
        font-weight: 800;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid transparent;
        box-sizing: border-box;
    }

    .customer-drawer-btn-secondary {
        border-color: #e1e5eb;
        background: #fff;
        color: #5f6b7c;
    }

    .customer-drawer-btn-secondary:hover {
        background: #f8fafc;
        color: #172033;
    }

    .customer-drawer-btn-primary {
        border-color: #7c3aed;
        background: #7c3aed;
        color: #fff;
        box-shadow: 0 7px 18px rgba(124, 58, 237, .18);
    }

    .customer-drawer-btn-primary:hover {
        background: #6d28d9;
    }

    .customer-drawer-icon {
        width: 40px;
        height: 40px;
        margin-bottom: 18px;
        border-radius: 11px;
        background: #f1eaff;
        color: #7c3aed;
        display: grid;
        place-items: center;
        font-size: 18px;
    }

    @@media (max-width: 700px) {
        .customer-drawer {
            width: 100%;
            border-left: 0;
        }

        .customer-drawer-grid {
            grid-template-columns: 1fr;
        }

        .customer-drawer-field.full {
            grid-column: auto;
        }

        .customer-drawer-header,
        .customer-drawer-body,
        .customer-drawer-footer {
            padding-left: 20px;
            padding-right: 20px;
        }
    }

    /* AutoFlow customer overlay */
    .customer-drawer-page {
        position: fixed !important;
        inset: 0 !important;
        width: 100vw !important;
        height: 100vh !important;
        min-height: 100vh !important;
        margin: 0 !important;
        background: transparent !important;
        overflow: hidden !important;
        z-index: 5000 !important;
    }

    .customer-drawer-backdrop {
        position: absolute !important;
        inset: 0 !important;
        background: rgba(15, 23, 42, .22) !important;
        backdrop-filter: blur(2px);
    }

    .customer-drawer-shell {
        position: relative !important;
        width: 100% !important;
        height: 100% !important;
        min-height: 100vh !important;
    }

    .customer-drawer {
        position: absolute !important;
        top: 0 !important;
        right: 0 !important;
        height: 100vh !important;
        min-height: 100vh !important;
        max-height: 100vh !important;
        animation: afCustomerDrawerIn .20s ease-out;
    }

    @@keyframes afCustomerDrawerIn {
        from { transform: translateX(28px); opacity: .94; }
        to { transform: translateX(0); opacity: 1; }
    }

    .af-image-picker { display:flex; align-items:center; gap:16px; padding:14px; border:1px solid #e8eaf0; border-radius:14px; background:#fafbfc; }
    .af-image-preview { width:76px; height:76px; flex:0 0 76px; border-radius:16px; overflow:hidden; background:#f1eaff; display:grid; place-items:center; border:1px solid #e6defe; }
    .af-image-preview img { width:100%; height:100%; object-fit:contain; display:block; background:#fff; }
    .af-image-preview-empty { color:#7c3aed; font-size:24px; display:grid; place-items:center; width:100%; height:100%; }
    .af-image-picker-controls { min-width:0; display:flex; flex-direction:column; gap:5px; }
    .af-image-picker-button { display:inline-flex; align-items:center; justify-content:center; gap:7px; width:max-content; padding:8px 11px; border-radius:8px; background:#7c3aed; color:#fff; font-size:11px; font-weight:800; cursor:pointer; }
    .af-image-picker-button:hover { background:#6d28d9; }
    .af-image-selected { color:#344054; font-size:11px; font-weight:750; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:280px; }
    .af-image-picker-controls small { color:#98a1b2; font-size:10px; }

</style>

<div class="customer-drawer-page">

    <div class="customer-drawer-backdrop"></div>

    <div class="customer-drawer-shell">

        <aside class="customer-drawer">

            <div class="customer-drawer-header">
                <div class="customer-drawer-title-row">
                    <div>
                        <h1 class="customer-drawer-title">Add Customer</h1>
                        <p class="customer-drawer-subtitle">
                            Create a new customer record for the AutoFlow system.
                        </p>
                    </div>

                    <a asp-action="Index"
                       class="customer-drawer-close">
                        Cancel
                    </a>
                </div>
            </div>

            <form asp-action="Create"
                  method="post"
                  enctype="multipart/form-data"
                  class="d-flex flex-column flex-grow-1">

                @Html.AntiForgeryToken()

                <div class="customer-drawer-body">

                    <div class="customer-drawer-icon">
                        <i class="bi bi-person-plus"></i>
                    </div>

                    <div asp-validation-summary="ModelOnly"
                         class="customer-drawer-validation">
                    </div>

                    <section class="customer-drawer-section">

                        <div class="customer-drawer-section-heading">
                            <h2>Personal Information</h2>
                            <p>Basic identification information for the customer.</p>
                        </div>

                        <div class="customer-drawer-grid">

                            <div class="customer-drawer-field">
                                <label asp-for="FirstName">First Name</label>

                                <input asp-for="FirstName"
                                       placeholder="Enter first name"
                                       autocomplete="given-name" />

                                <span asp-validation-for="FirstName"
                                      class="customer-drawer-field-error">
                                </span>
                            </div>

                            <div class="customer-drawer-field">
                                <label asp-for="LastName">Last Name</label>

                                <input asp-for="LastName"
                                       placeholder="Enter last name"
                                       autocomplete="family-name" />

                                <span asp-validation-for="LastName"
                                      class="customer-drawer-field-error">
                                </span>
                            </div>

                        </div>

                    </section>

                    <section class="customer-drawer-section">

                        <div class="customer-drawer-section-heading">
                            <h2>Profile Image</h2>
                            <p>Choose an image for this customer's profile.</p>
                        </div>

                        <div class="af-image-picker" id="customerCreateImagePicker">
                            <div class="af-image-preview" id="customerCreateImagePreview">
                                <div class="af-image-preview-empty"><i class="bi bi-person"></i></div>
                            </div>
                            <div class="af-image-picker-controls">
                                <label for="customerCreateProfileImage" class="af-image-picker-button"><i class="bi bi-image"></i> Choose Image</label>
                                <input id="customerCreateProfileImage" name="profileImage" type="file" accept="image/png,image/jpeg,image/webp,image/gif" hidden />
                                <div class="af-image-selected" id="customerCreateImageStatus">No image selected</div>
                                <small>PNG, JPG, WEBP or GIF · Max 5 MB</small>
                            </div>
                        </div>
                    </section>

                    <section class="customer-drawer-section">

                        <div class="customer-drawer-section-heading">
                            <h2>Contact Information</h2>
                            <p>How AutoFlow can reach the customer.</p>
                        </div>

                        <div class="customer-drawer-grid">

                            <div class="customer-drawer-field">
                                <label asp-for="Phone">Phone Number</label>

                                <input asp-for="Phone"
                                       placeholder="Enter phone number"
                                       autocomplete="tel" />

                                <span asp-validation-for="Phone"
                                      class="customer-drawer-field-error">
                                </span>
                            </div>

                            <div class="customer-drawer-field">
                                <label asp-for="Email">Email Address</label>

                                <input asp-for="Email"
                                       type="email"
                                       placeholder="customer@example.com"
                                       autocomplete="email" />

                                <span asp-validation-for="Email"
                                      class="customer-drawer-field-error">
                                </span>
                            </div>

                            <div class="customer-drawer-field full">
                                <label asp-for="Address">Home Address</label>

                                <textarea asp-for="Address"
                                          placeholder="Enter complete customer address"
                                          autocomplete="street-address"></textarea>

                                <span asp-validation-for="Address"
                                      class="customer-drawer-field-error">
                                </span>
                            </div>

                        </div>

                    </section>

                </div>

                <div class="customer-drawer-footer">

                    <a asp-action="Index"
                       class="customer-drawer-btn customer-drawer-btn-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="customer-drawer-btn customer-drawer-btn-primary">
                        Create Customer
                    </button>

                </div>

            </form>

        </aside>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
<script>
(function(){
    const input=document.getElementById('customerCreateProfileImage');
    const preview=document.getElementById('customerCreateImagePreview');
    const status=document.getElementById('customerCreateImageStatus');
    if(!input||!preview||!status)return;
    input.addEventListener('change',function(){
        const file=this.files&&this.files[0];
        if(!file){preview.innerHTML='<div class="af-image-preview-empty"><i class="bi bi-person"></i></div>';status.textContent='No image selected';return;}
        status.textContent=file.name;
        const reader=new FileReader();
        reader.onload=e=>preview.innerHTML='<img src="'+e.target.result+'" alt="Selected customer image" />';
        reader.readAsDataURL(file);
    });
})();
</script>
