@using System.Security.Claims

@{
    Layout = null;

    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    var userRole =
        User.FindFirst(ClaimTypes.Role)?.Value ?? "";

    // Role checks
    var isAdministrator =
        string.Equals(
            userRole,
            "Administrator",
            StringComparison.OrdinalIgnoreCase);

    var isServiceAdvisor =
        string.Equals(
            userRole,
            "ServiceAdvisor",
            StringComparison.OrdinalIgnoreCase);

    var isTechnician =
        string.Equals(
            userRole,
            "Technician",
            StringComparison.OrdinalIgnoreCase);

    var isCashier =
        string.Equals(
            userRole,
            "Cashier",
            StringComparison.OrdinalIgnoreCase);

    // User display information
    var displayName = "AutoFlow User";
    var roleDisplay = "Authorized User";
    var initials = "AF";

    if (isAdministrator)
    {
        displayName = "Main Administrator";
        roleDisplay = "System Manager";
        initials = "AD";
    }
    else if (isServiceAdvisor)
    {
        displayName = "Service Advisor";
        roleDisplay = "Service Advisor";
        initials = "SA";
    }
    else if (isTechnician)
    {
        displayName = "Technician / Mechanic";
        roleDisplay = "Technician / Mechanic";
        initials = "TM";
    }
    else if (isCashier)
    {
        displayName = "Cashier";
        roleDisplay = "Cashier";
        initials = "CA";
    }

    // Active navigation
    var dashboardActive =
        string.Equals(
            currentController,
            "Home",
            StringComparison.OrdinalIgnoreCase);

    var customersActive =
        string.Equals(
            currentController,
            "Customers",
            StringComparison.OrdinalIgnoreCase);

    var vehiclesActive =
        string.Equals(
            currentController,
            "Vehicles",
            StringComparison.OrdinalIgnoreCase);

    var appointmentsActive =
        string.Equals(
            currentController,
            "Appointments",
            StringComparison.OrdinalIgnoreCase);

    var jobOrdersActive =
        string.Equals(
            currentController,
            "JobOrders",
            StringComparison.OrdinalIgnoreCase);

    var partsActive =
        string.Equals(
            currentController,
            "Parts",
            StringComparison.OrdinalIgnoreCase);

    var suppliersActive =
        string.Equals(
            currentController,
            "Suppliers",
            StringComparison.OrdinalIgnoreCase);

    var billingsActive =
        string.Equals(
            currentController,
            "Billings",
            StringComparison.OrdinalIgnoreCase);

    var customerFollowUpsActive =
        string.Equals(
            currentController,
            "CustomerFollowUps",
            StringComparison.OrdinalIgnoreCase);

    var serviceRecordsActive =
        string.Equals(
            currentController,
            "ServiceRecords",
            StringComparison.OrdinalIgnoreCase);
    var reportsActive =
        string.Equals(
            currentController,
            "Reports",
            StringComparison.OrdinalIgnoreCase);

    var userAccountsActive =
        string.Equals(
            currentController,
            "UserAccounts",
            StringComparison.OrdinalIgnoreCase);

    var systemSettingsActive =
        string.Equals(
            currentController,
            "SystemSettings",
            StringComparison.OrdinalIgnoreCase);            
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @(ViewData["Title"]?.ToString() ?? "AutoFlow")
        - AutoFlow
    </title>

    <meta name="description"
          content="AutoFlow Automotive ERP & CRM System" />

    <!-- Site CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- AutoFlow layout CSS -->
    <style>

        /* Root */

        :root {
            --af-sidebar: #121824;
            --af-sidebar-hover: #1b2331;
            --af-purple: #7544f5;
            --af-purple-dark: #6336d8;
            --af-purple-light: #eee8ff;
            --af-background: #f7f8fb;
            --af-white: #ffffff;
            --af-text: #171b26;
            --af-muted: #858c9d;
            --af-border: #e6e9ef;
        }

        /* Global */

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            min-height: 100%;
            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                Helvetica,
                Arial,
                sans-serif;
            background: var(--af-background);
            color: var(--af-text);
        }

        body {
            min-height: 100vh;
        }

        a {
            text-decoration: none;
        }

        /* Application */

        .af-app {
            width: 100%;
            min-height: 100vh;
            display: flex;
        }

        /* Sidebar */

        .af-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: 310px;
            display: flex;
            flex-direction: column;
            background: var(--af-sidebar);
            color: #ffffff;
            z-index: 1000;
            overflow-y: auto;
            overflow-x: hidden;
            border-right:
                1px solid rgba(255, 255, 255, 0.05);
        }

        /* Brand */

        .af-brand {
            min-height: 78px;
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 19px 24px;
            border-bottom:
                1px solid rgba(255, 255, 255, 0.08);
        }

        .af-brand-icon {
            width: 112px;
            height: 54px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: transparent;
            border-radius: 0;
            overflow: hidden;
        }

        .af-brand-icon img {
            display: block;
            width: 100%;
            height: auto;
            max-height: 54px;
            object-fit: contain;
        }

        .af-brand-text {
            min-width: 0;
        }

        .af-brand-title {
            margin: 0;
            color: #ffffff;
            font-size: 19px;
            font-weight: 800;
            line-height: 1.1;
            letter-spacing: -0.4px;
        }

        .af-brand-subtitle {
            margin-top: 3px;
            color: #858c9c;
            font-size: 11px;
            font-weight: 600;
        }

        /* Navigation */

        .af-navigation {
            flex: 1;
            padding: 24px 15px 18px;
        }

        .af-section {
            margin-bottom: 23px;
        }

        .af-section-title {
            padding: 0 21px;
            margin-bottom: 8px;
            color: #707889;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .af-nav-item {
            width: 100%;
            min-height: 44px;
            display: flex;
            align-items: center;
            gap: 0;
            margin: 3px 0;
            padding: 10px 16px;
            border-radius: 9px;
            color: #c7ccd6;
            font-size: 14px;
            font-weight: 600;
            transition:
                background 0.18s ease,
                color 0.18s ease,
                transform 0.18s ease;
        }

        .af-nav-item:hover {
            background:
                rgba(255, 255, 255, 0.055);
            color: #ffffff;
            transform: translateX(1px);
        }

        .af-nav-item.active {
            background:
                linear-gradient(
                    90deg,
                    #6335d5,
                    #7542ef
                );
            color: #ffffff;
            box-shadow:
                0 6px 17px
                rgba(117, 68, 245, 0.22);
        }

        .af-nav-icon {
            width: 25px;
            flex-shrink: 0;
            margin-right: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: currentColor;
            font-size: 15px;
        }

        .af-nav-label {
            flex: 1;
            min-width: 0;
        }

        .af-view-badge {
            flex-shrink: 0;
            margin-left: 7px;
            padding: 3px 6px;
            border-radius: 5px;
            background:
                rgba(255, 255, 255, 0.08);
            color: #9da5b5;
            font-size: 8px;
            font-weight: 800;
            letter-spacing: 0.4px;
        }

        .af-nav-item.active .af-view-badge {
            background:
                rgba(255, 255, 255, 0.14);
            color: #ffffff;
        }

        /* User panel */

        .af-user-panel {
            padding: 15px 15px 18px;
            border-top:
                1px solid rgba(255, 255, 255, 0.08);
        }

        .af-user {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 8px 8px 12px;
        }

        .af-avatar {
            width: 41px;
            height: 41px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background:
                linear-gradient(
                    135deg,
                    #8d5cff,
                    #6035dc
                );
            color: #ffffff;
            font-size: 12px;
            font-weight: 800;
        }

        .af-user-info {
            min-width: 0;
            flex: 1;
        }

        .af-user-name {
            color: #ffffff;
            font-size: 13px;
            font-weight: 750;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .af-user-role {
            margin-top: 3px;
            color: #858d9d;
            font-size: 11px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Logout */

        .af-logout-form {
            margin: 0;
        }

        .af-logout-button {
            width: 100%;
            min-height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 0;
            border-radius: 8px;
            background:
                rgba(255, 255, 255, 0.045);
            color: #aab1be;
            font-family: inherit;
            font-size: 13px;
            font-weight: 650;
            cursor: pointer;
            transition:
                background 0.18s ease,
                color 0.18s ease;
        }

        .af-logout-button:hover {
            background:
                rgba(255, 255, 255, 0.095);
            color: #ffffff;
        }

        /* Main */

        .af-main {
            width:
                calc(100% - 310px);
            min-height: 100vh;
            margin-left: 310px;
            display: flex;
            flex-direction: column;
        }

        /* Top bar */

        .af-topbar {
            min-height: 78px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            padding: 0 34px;
            background: #ffffff;
            border-bottom:
                1px solid var(--af-border);
            position: sticky;
            top: 0;
            z-index: 900;
        }

        .af-search {
            width:
                min(490px, 50vw);
            height: 42px;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 14px;
            border:
                1px solid #e1e4ea;
            border-radius: 10px;
            background: #fafbfc;
            color: #969dac;
            font-size: 13px;
        }

        .af-search-icon {
            font-size: 18px;
            line-height: 1;
        }

        .af-top-actions {
            display: flex;
            align-items: center;
            gap: 11px;
        }

        .af-top-button {
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            border:
                1px solid #e3e6ec;
            border-radius: 10px;
            background: #ffffff;
            color: #626a79;
            font-size: 17px;
        }

        .af-notification {
            position: relative;
        }

        .af-notification-dot {
            position: absolute;
            top: 9px;
            right: 9px;
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--af-purple);
        }

        .af-top-divider {
            width: 1px;
            height: 32px;
            margin: 0 6px;
            background: #e3e6eb;
        }

        .af-profile {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .af-profile-text {
            text-align: right;
        }

        .af-profile-name {
            color: #171b26;
            font-size: 13px;
            font-weight: 750;
        }

        .af-profile-role {
            margin-top: 2px;
            color: #858c9d;
            font-size: 11px;
        }

        .af-profile-avatar {
            width: 43px;
            height: 43px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background: var(--af-purple-light);
            color: #6b3ee8;
            font-size: 12px;
            font-weight: 800;
        }

        /* Content */

        .af-content {
            flex: 1;
            min-width: 0;
            padding: 34px;
        }

        /* Footer */

        .af-footer {
            min-height: 58px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            padding: 0 34px;
            background: #ffffff;
            border-top:
                1px solid var(--af-border);
            color: #9299a8;
            font-size: 11px;
        }

        .af-footer-links {
            display: flex;
            align-items: center;
            gap: 25px;
        }

        .af-footer-links a {
            color: #9299a8;
            text-decoration: none;
            transition:
                color 0.18s ease;
        }

        .af-footer-links a:hover {
            color: var(--af-purple);
        }

        /* Tablet */

        @@media (max-width: 1100px) {

            .af-sidebar {
                width: 255px;
            }

            .af-main {
                width:
                    calc(100% - 255px);
                margin-left: 255px;
            }

            .af-brand {
                padding-left: 18px;
                padding-right: 18px;
            }

            .af-navigation {
                padding-left: 10px;
                padding-right: 10px;
            }

            .af-nav-item {
                padding-left: 13px;
                padding-right: 13px;
            }

            .af-topbar {
                padding-left: 24px;
                padding-right: 24px;
            }

            .af-content {
                padding: 24px;
            }

            .af-footer {
                padding-left: 24px;
                padding-right: 24px;
            }
        }

        /* Mobile */

        @@media (max-width: 820px) {

            .af-sidebar {
                width: 245px;
                transform: translateX(-100%);
                transition:
                    transform 0.25s ease;
            }

            .af-main {
                width: 100%;
                margin-left: 0;
            }

            .af-topbar {
                min-height: 68px;
                padding: 0 18px;
            }

            .af-content {
                padding: 22px 18px;
            }

            .af-profile-text {
                display: none;
            }

            .af-footer {
                padding: 15px 18px;
                flex-direction: column;
                justify-content: center;
                text-align: center;
            }

            .af-search {
                width: 100%;
            }
        }

        /* Small mobile */

        @@media (max-width: 520px) {

            .af-search {
                display: none;
            }

            .af-topbar {
                justify-content: flex-end;
            }

            .af-top-button {
                width: 38px;
                height: 38px;
            }

            .af-profile-avatar {
                width: 38px;
                height: 38px;
            }

            .af-content {
                padding: 18px 14px;
            }

            .af-footer-links {
                flex-wrap: wrap;
                justify-content: center;
                gap: 14px;
            }
        }

    </style>

    @RenderSection(
        "Styles",
        required: false)

</head>

<body>

<div class="af-app">

    <!-- Sidebar -->

    <aside class="af-sidebar">

        <!-- Brand -->

        <div class="af-brand">

            <div class="af-brand-icon">
                <img src="~/images/autoFlow-logo.png"
                     alt="AutoFlow" />
            </div>

            <div class="af-brand-text">

                <div class="af-brand-title">
                    AutoFlow
                </div>

                <div class="af-brand-subtitle">
                    Enterprise ERP
                </div>

            </div>

        </div>

        <!-- Navigation -->

        <nav class="af-navigation">

            <!-- Command Center -->

            <div class="af-section">

                <div class="af-section-title">
                    Command Center
                </div>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="af-nav-item @(dashboardActive ? "active" : "")">

                    <span class="af-nav-icon">
                        ◢
                    </span>

                    <span class="af-nav-label">
                        Dashboard
                    </span>

                </a>

            </div>

            <!-- Operations -->

            <div class="af-section">

                <div class="af-section-title">
                    Operations
                </div>

                <!-- Customer Management -->

                @if (
                    isAdministrator ||
                    isServiceAdvisor ||
                    isTechnician)
                {
                    <a asp-controller="Customers"
                       asp-action="Index"
                       class="af-nav-item @(customersActive ? "active" : "")">

                        <span class="af-nav-icon">
                            ♟
                        </span>

                        <span class="af-nav-label">
                            Customer Management
                        </span>

                        @if (isTechnician)
                        {
                            <span class="af-view-badge">
                                VIEW
                            </span>
                        }

                    </a>
                }

                <!-- Vehicle Records -->

                @if (
                    isAdministrator ||
                    isServiceAdvisor ||
                    isTechnician)
                {
                    <a asp-controller="Vehicles"
                       asp-action="Index"
                       class="af-nav-item @(vehiclesActive ? "active" : "")">

                        <span class="af-nav-icon">
                            🚗
                        </span>

                        <span class="af-nav-label">
                            Vehicle Records
                        </span>

                        @if (isTechnician)
                        {
                            <span class="af-view-badge">
                                VIEW
                            </span>
                        }

                    </a>
                }

                <!-- Service Appointments -->

                @if (
                    isAdministrator ||
                    isServiceAdvisor)
                {
                    <a asp-controller="Appointments"
                       asp-action="Index"
                       class="af-nav-item @(appointmentsActive ? "active" : "")">

                        <span class="af-nav-icon">
                            ▣
                        </span>

                        <span class="af-nav-label">
                            Service Appointments
                        </span>

                    </a>
                }

                <!-- Repair Job Orders -->

                @if (
                    isAdministrator ||
                    isServiceAdvisor ||
                    isTechnician ||
                    isCashier)
                {
                    <a asp-controller="JobOrders"
                       asp-action="Index"
                       class="af-nav-item @(jobOrdersActive ? "active" : "")">

                        <span class="af-nav-icon">
                            🔧
                        </span>

                        <span class="af-nav-label">
                            Repair Job Orders
                        </span>

                        @if (isCashier)
                        {
                            <span class="af-view-badge">
                                VIEW
                            </span>
                        }

                    </a>
                }

                <!-- Parts Inventory -->

                @if (
                    isAdministrator ||
                    isTechnician ||
                    isCashier)
                {
                    <a asp-controller="Parts"
                       asp-action="Index"
                       class="af-nav-item @(partsActive ? "active" : "")">

                        <span class="af-nav-icon">
                            ▣
                        </span>

                        <span class="af-nav-label">
                            Parts Inventory
                        </span>

                    </a>
                }

                <!-- Supplier Management -->

                @if (
                    isAdministrator ||
                    isCashier)
                {
                    <a asp-controller="Suppliers"
                       asp-action="Index"
                       class="af-nav-item @(suppliersActive ? "active" : "")">

                        <span class="af-nav-icon">
                            🚚
                        </span>

                        <span class="af-nav-label">
                            Supplier Management
                        </span>

                    </a>
                }

            </div>

            <!-- CRM & Financials -->

            <div class="af-section">

                <div class="af-section-title">
                    CRM & Financials
                </div>

                <!-- Billing & Payments -->

                @if (
                    isAdministrator ||
                    isServiceAdvisor ||
                    isCashier)
                {
                    <a asp-controller="Billings"
                       asp-action="Index"
                       class="af-nav-item @(billingsActive ? "active" : "")">

                        <span class="af-nav-icon">
                            ▤
                        </span>

                        <span class="af-nav-label">
                            Billing & Payments
                        </span>

                    </a>
                }

                <!-- Customer Follow-ups CRM -->

                @if (
                    isAdministrator ||
                    isServiceAdvisor)
                {
                    <a asp-controller="CustomerFollowUps"
                       asp-action="Index"
                       class="af-nav-item @(customerFollowUpsActive ? "active" : "")">

                        <span class="af-nav-icon">
                            ☁
                        </span>

                        <span class="af-nav-label">
                            Customer Follow-ups CRM
                        </span>

                    </a>
                }

                <!-- Service History -->

                @if (
                    isAdministrator ||
                    isServiceAdvisor ||
                    isTechnician)
                {
                    <a asp-controller="ServiceRecords"
                       asp-action="Index"
                       class="af-nav-item @(serviceRecordsActive ? "active" : "")">

                        <span class="af-nav-icon">
                            ↶
                        </span>

                        <span class="af-nav-label">
                            Service History
                        </span>

                        @if (
                            isServiceAdvisor ||
                            isTechnician)
                        {
                            <span class="af-view-badge">
                                VIEW
                            </span>
                        }

                    </a>
                }

                <!-- Reports -->

                @if (
                    isAdministrator ||
                    isServiceAdvisor ||
                    isCashier)
                {
                    <a asp-controller="Reports"
                    asp-action="Index"
                    class="af-nav-item @(reportsActive ? "active" : "")">

                        <span class="af-nav-icon">
                            ◔
                        </span>

                        <span class="af-nav-label">
                            Reports
                        </span>

                        @if (
                            isServiceAdvisor ||
                            isCashier)
                        {
                            <span class="af-view-badge">
                                VIEW
                            </span>
                        }

                    </a>
                }

            </div>

            <!-- Settings -->

            @if (isAdministrator)
            {
                <div class="af-section">

                    <div class="af-section-title">
                        Settings
                    </div>

                    <!-- Manage User Accounts -->

                    <a asp-controller="UserAccounts"
                    asp-action="Index"
                    class="af-nav-item @(userAccountsActive ? "active" : "")">

                        <span class="af-nav-icon">
                            ♙
                        </span>

                        <span class="af-nav-label">
                            Manage User Accounts
                        </span>

                    </a>

                    <!-- System Settings -->

                    <a asp-controller="SystemSettings"
                    asp-action="Index"
                    class="af-nav-item @(systemSettingsActive ? "active" : "")">

                        <span class="af-nav-icon">
                            ⚙
                        </span>

                        <span class="af-nav-label">
                            System Settings
                        </span>

                    </a>

                </div>
            }

        </nav>

        <!-- User account -->

        <div class="af-user-panel">

            <div class="af-user">

                <div class="af-avatar">
                    @initials
                </div>

                <div class="af-user-info">

                    <div class="af-user-name">
                        @displayName
                    </div>

                    <div class="af-user-role">
                        @roleDisplay
                    </div>

                </div>

            </div>

            <!-- Logout -->

            <form asp-controller="Auth"
                  asp-action="Logout"
                  method="post"
                  class="af-logout-form">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="af-logout-button">

                    ↪ &nbsp; Sign out of AutoFlow

                </button>

            </form>

        </div>

    </aside>

    <!-- Main application -->

    <main class="af-main">

        <!-- Top bar -->

        <header class="af-topbar">

            <!-- Search -->

            <div class="af-search">

                <span class="af-search-icon">
                    ⌕
                </span>

                <span>
                    Search AutoFlow... (Cmd + K)
                </span>

            </div>

            <!-- Top actions -->

            <div class="af-top-actions">

                <!-- Quick action -->

                <div class="af-top-button"
                     title="Quick Actions">

                    ⚡

                </div>

                <!-- Notifications -->

                <div class="af-top-button af-notification"
                     title="Notifications">

                    ♟

                    <span class="af-notification-dot"></span>

                </div>

                <div class="af-top-divider"></div>

                <!-- Profile -->

                <div class="af-profile">

                    <div class="af-profile-text">

                        <div class="af-profile-name">
                            @displayName
                        </div>

                        <div class="af-profile-role">
                            @roleDisplay
                        </div>

                    </div>

                    <div class="af-profile-avatar">
                        @initials
                    </div>

                </div>

            </div>

        </header>

        <!-- Page body -->

        <section class="af-content">

            @RenderBody()

        </section>

        <!-- Footer -->

        <footer class="af-footer">

            <div>

                © 2026 AutoFlow Enterprise ERP
                — Automated Repair Shop Operations

            </div>

            <div class="af-footer-links">

                <a href="#">
                    System Status
                </a>

                <a href="#">
                    Support Center
                </a>

                <a href="#">
                    API Documentation
                </a>

            </div>

        </footer>

    </main>

</div>

<!-- Page scripts -->

@await RenderSectionAsync(
    "Scripts",
    required: false)

</body>

</html>