<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - AutoFlow</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/AutoFlow.Web.styles.css"
          asp-append-version="true" />
</head>

<body>

    <div class="app-shell">

        <!-- SIDEBAR -->
        <aside class="app-sidebar">

            <div class="sidebar-brand">
                <div class="brand-icon">
                    AF
                </div>

                <div>
                    <div class="brand-name">AutoFlow</div>
                    <div class="brand-subtitle">Automotive ERP</div>
                </div>
            </div>

            <nav class="sidebar-navigation">

                <div class="nav-section-title">
                    MAIN
                </div>

                <a class="sidebar-link"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="sidebar-icon">⌂</span>
                    <span>Dashboard</span>
                </a>

                <a class="sidebar-link"
                   href="#">
                    <span class="sidebar-icon">👥</span>
                    <span>Customers</span>
                </a>

                <a class="sidebar-link"
                   href="#">
                    <span class="sidebar-icon">🚗</span>
                    <span>Vehicles</span>
                </a>

                <div class="nav-section-title">
                    OPERATIONS
                </div>

                <a class="sidebar-link" href="#">
                    <span class="sidebar-icon">📅</span>
                    <span>Appointments</span>
                </a>

                <a class="sidebar-link" href="#">
                    <span class="sidebar-icon">🔧</span>
                    <span>Repair Jobs</span>
                </a>

                <a class="sidebar-link" href="#">
                    <span class="sidebar-icon">📦</span>
                    <span>Parts Inventory</span>
                </a>

                <a class="sidebar-link" href="#">
                    <span class="sidebar-icon">🏭</span>
                    <span>Suppliers</span>
                </a>

                <div class="nav-section-title">
                    BUSINESS
                </div>

                <a class="sidebar-link" href="#">
                    <span class="sidebar-icon">💳</span>
                    <span>Billing & Payments</span>
                </a>

                <a class="sidebar-link" href="#">
                    <span class="sidebar-icon">💬</span>
                    <span>Customer CRM</span>
                </a>

                <a class="sidebar-link" href="#">
                    <span class="sidebar-icon">📋</span>
                    <span>Service History</span>
                </a>

                <a class="sidebar-link" href="#">
                    <span class="sidebar-icon">📊</span>
                    <span>Reports</span>
                </a>

            </nav>

            <div class="sidebar-footer">
                <div class="user-card">
                    <div class="user-avatar">
                        KR
                    </div>

                    <div class="user-info">
                        <strong>Administrator</strong>
                        <small>AutoFlow Admin</small>
                    </div>
                </div>
            </div>

        </aside>


        <!-- MAIN APPLICATION -->
        <div class="app-main">

            <!-- TOPBAR -->
            <header class="app-topbar">

                <div>
                    <button class="mobile-menu-button"
                            type="button"
                            aria-label="Toggle navigation">
                        ☰
                    </button>

                    <span class="topbar-title">
                        @ViewData["Title"]
                    </span>
                </div>

                <div class="topbar-actions">

                    <button class="topbar-icon-button"
                            type="button"
                            title="Notifications">
                        🔔
                    </button>

                    <div class="topbar-user">
                        <div class="user-avatar">
                            KR
                        </div>

                        <div>
                            <strong>Administrator</strong>
                            <small>Admin</small>
                        </div>
                    </div>

                </div>

            </header>


            <!-- PAGE CONTENT -->
            <main class="app-content">

                @RenderBody()

            </main>


            <!-- FOOTER -->
            <footer class="app-footer">
                <span>
                    © 2026 AutoFlow
                </span>

                <span>
                    Automotive ERP & CRM
                </span>
            </footer>

        </div>

    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>