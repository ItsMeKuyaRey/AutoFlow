<!-- AutoFlow profile / appearance behavior -->
<script>
(function () {
    "use strict";

    /* ========================================================
       AutoFlow - Permanent white action buttons
       ======================================================== */

    /*
       These actions keep their CURRENT background/border.
       Only their text and icons are permanently white.
    */
    function applyPermanentWhiteActions() {
        document.querySelectorAll("button, a").forEach(element => {
            const text = (element.textContent || "")
                .replace(/\s+/g, " ")
                .trim()
                .toLowerCase();

            if (!text) return;

            const isSupplier =
                text.includes("add supplier");

            const isService =
                text.includes("new service record") ||
                text.includes("newservice record") ||
                text.includes("new service history") ||
                text.includes("newservice history");

            const isFollowUp =
                text.includes("new follow-up") ||
                text.includes("new follow up");

            if (isSupplier || isService || isFollowUp) {
                element.classList.add("af-permanent-white-action");
            }
        });
    }

    applyPermanentWhiteActions();



    const body = document.body;
    const root = document.documentElement;
    const currentRole = body.dataset.afCurrentRole || "";
    const roleImageFallback = body.dataset.afRoleImage || "";
    const roleInitials = body.dataset.afRoleInitials || "AF";

    const colors = {
        purple: ["#7544f5", "#6336d8", "#eee8ff", "rgba(117,68,245,.28)"] ,
        blue: ["#2563eb", "#1d4ed8", "#dbeafe", "rgba(37,99,235,.28)"],
        cyan: ["#0891b2", "#0e7490", "#cffafe", "rgba(8,145,178,.28)"],
        emerald: ["#059669", "#047857", "#d1fae5", "rgba(5,150,105,.28)"],
        rose: ["#e11d48", "#be123c", "#ffe4e6", "rgba(225,29,72,.28)"],
        amber: ["#d97706", "#b45309", "#fef3c7", "rgba(217,119,6,.28)"],
        indigo: ["#4f46e5", "#4338ca", "#e0e7ff", "rgba(79,70,229,.28)"],
        slate: ["#475569", "#334155", "#e2e8f0", "rgba(71,85,105,.28)"]
    };

    const roleKey = (currentRole || "AuthorizedUser")
        .replace(/[^a-zA-Z0-9_-]/g, "_");

    const colorStorageKey = "autoflow.appearance.color";
    const modeStorageKey = "autoflow.appearance.mode";
    const imageStorageKey = "autoflow.profile.image." + roleKey;

    const overlay = document.getElementById("afProfileBackdrop");
    const drawer = document.getElementById("afProfileDrawer");
    const trigger = document.getElementById("afProfileTrigger");
    const closeButton = document.getElementById("afProfileClose");
    const imageInput = document.getElementById("afRoleImageInput");
    const removeImageButton = document.getElementById("afRemoveRoleImage");
    const drawerAvatar = document.getElementById("afDrawerRoleAvatar");
    const topAvatar = document.getElementById("afCurrentRoleAvatar");

    function getSavedImage() {
        try {
            return localStorage.getItem(imageStorageKey) || roleImageFallback || "";
        } catch (_) {
            return roleImageFallback || "";
        }
    }

    function setAvatar(element, image) {
        if (!element) return;

        element.innerHTML = "";

        if (image) {
            const img = document.createElement("img");
            img.src = image;
            img.alt = "Current role profile picture";
            element.appendChild(img);
        } else {
            element.textContent = roleInitials;
        }
    }

    function renderImage() {
        const image = getSavedImage();

        setAvatar(topAvatar, image);
        setAvatar(drawerAvatar, image);

        // Keep the selected profile image consistent everywhere
        document.querySelectorAll(
            ".af-role-avatar-image, .af-role-profile-image"
        ).forEach(img => {
            if (image) {
                img.src = image;
            } else if (roleImageFallback) {
                img.src = roleImageFallback;
            }
        });
    }

    function applyColor(name, save) {
        const color = colors[name] || colors.purple;

        root.style.setProperty("--af-accent", color[0]);
        root.style.setProperty("--af-accent-dark", color[1]);
        root.style.setProperty("--af-accent-light", color[2]);
        root.style.setProperty("--af-accent-border", color[3]);
        root.style.setProperty("--af-purple", color[0]);
        root.style.setProperty("--af-purple-dark", color[1]);
        root.style.setProperty("--af-purple-light", color[2]);

        document.querySelectorAll(".af-color-option").forEach(option => {
            option.classList.toggle("active", option.dataset.color === name);
        });

        if (save) {
            try { localStorage.setItem(colorStorageKey, name); } catch (_) { }
        }
    }

    function applyMode(mode, save) {
        const value = mode === "dark" ? "dark" : "light";

        root.dataset.afTheme = value;
        body.classList.toggle("af-dark", value === "dark");

        document.querySelectorAll(".af-theme-option").forEach(option => {
            option.classList.toggle("active", option.dataset.theme === value);
        });

        if (save) {
            try { localStorage.setItem(modeStorageKey, value); } catch (_) { }
        }
    }

    function openDrawer() {
        if (!drawer || !overlay) return;

        renderImage();
        drawer.classList.add("open");
        overlay.classList.add("open");
        drawer.setAttribute("aria-hidden", "false");
        overlay.setAttribute("aria-hidden", "false");
        trigger?.setAttribute("aria-expanded", "true");
        body.style.overflow = "hidden";

        setTimeout(() => closeButton?.focus(), 50);
    }

    function closeDrawer() {
        if (!drawer || !overlay) return;

        drawer.classList.remove("open");
        overlay.classList.remove("open");
        drawer.setAttribute("aria-hidden", "true");
        overlay.setAttribute("aria-hidden", "true");
        trigger?.setAttribute("aria-expanded", "false");
        body.style.overflow = "";
    }

    trigger?.addEventListener("click", openDrawer);
    closeButton?.addEventListener("click", closeDrawer);
    overlay?.addEventListener("click", closeDrawer);

    document.addEventListener("keydown", event => {
        if (event.key === "Escape" && drawer?.classList.contains("open")) {
            closeDrawer();
        }
    });

    imageInput?.addEventListener("change", () => {
        const file = imageInput.files?.[0];
        if (!file) return;

        if (!file.type.startsWith("image/")) {
            alert("Please choose an image file.");
            imageInput.value = "";
            return;
        }

        if (file.size > 5 * 1024 * 1024) {
            alert("Please choose an image smaller than 5 MB.");
            imageInput.value = "";
            return;
        }

        const reader = new FileReader();

        reader.onload = () => {
            try {
                localStorage.setItem(imageStorageKey, reader.result);
                renderImage();
            } catch (_) {
                alert("The image is too large for browser storage. Please choose a smaller image.");
            }
        };

        reader.readAsDataURL(file);
        imageInput.value = "";
    });

    removeImageButton?.addEventListener("click", () => {
        try { localStorage.removeItem(imageStorageKey); } catch (_) { }
        renderImage();
    });

    document.querySelectorAll(".af-color-option").forEach(option => {
        option.addEventListener("click", () => {
            applyColor(option.dataset.color || "purple", true);
        });
    });

    document.querySelectorAll(".af-theme-option").forEach(option => {
        option.addEventListener("click", () => {
            applyMode(option.dataset.theme || "light", true);
        });
    });

    document.getElementById("afResetAppearance")?.addEventListener("click", () => {
        try {
            localStorage.removeItem(colorStorageKey);
            localStorage.removeItem(modeStorageKey);
            localStorage.removeItem(imageStorageKey);
        } catch (_) { }

        applyColor("purple", false);
        applyMode("light", false);
        renderImage();
    });

    let savedColor = "purple";
    let savedMode = "light";

    try {
        savedColor = localStorage.getItem(colorStorageKey) || "purple";
        savedMode = localStorage.getItem(modeStorageKey) || "light";
    } catch (_) { }

    applyColor(savedColor, false);
    applyMode(savedMode, false);
    renderImage();
})();
</script>

<!-- Page scripts -->

@await RenderSectionAsync(
    "Scripts",
    required: false)





<script>

// AutoFlow Icon-Only Color Picker
(function () {
    const originalApplyColor = window.__afOriginalApplyColor;

    /*
       We do not touch the existing color picker storage.
       We simply make its selected color feed the sidebar/icon
       accent while keeping the application itself violet.
    */

    const colorMap = {
        purple: "#7544f5",
        blue: "#2563eb",
        cyan: "#0891b2",
        emerald: "#059669",
        rose: "#e11d48",
        amber: "#d97706",
        indigo: "#4f46e5",
        slate: "#475569"
    };

    function syncIconColor() {
        let selected = "purple";

        try {
            selected = localStorage.getItem("autoflow.appearance.color") || "purple";
        } catch (_) {}

        const color = colorMap[selected] || colorMap.purple;

        document.documentElement.style.setProperty(
            "--af-icon-accent",
            color
        );

        document.documentElement.style.setProperty(
            "--af-icon-accent-dark",
            color
        );

        /* Keep application accent permanently violet */
        document.documentElement.style.setProperty(
            "--af-fixed-primary",
            "#7544f5"
        );

        document.documentElement.style.setProperty(
            "--af-fixed-primary-dark",
            "#6336d8"
        );
    }

    function fixFixedButtons() {
        document.querySelectorAll("button, a").forEach(function (el) {
            const text = (el.textContent || "")
                .replace(/\s+/g, " ")
                .trim();

            /* Create Invoice = permanent violet + white text */
            if (text === "Create Invoice" || text.includes("Create Invoice")) {
                el.style.setProperty("background", "#7544f5", "important");
                el.style.setProperty("background-color", "#7544f5", "important");
                el.style.setProperty("color", "#ffffff", "important");
                el.style.setProperty("border-color", "#7544f5", "important");

                el.querySelectorAll("*").forEach(function (child) {
                    child.style.setProperty("color", "#ffffff", "important");
                });
            }

            /* New Follow-up = permanent violet + WHITE text */
            if (text === "New Follow-up" || text.includes("New Follow-up")) {
                el.style.setProperty("background", "#7544f5", "important");
                el.style.setProperty("background-color", "#7544f5", "important");
                el.style.setProperty("color", "#ffffff", "important");
                el.style.setProperty("border-color", "#7544f5", "important");

                el.querySelectorAll("*").forEach(function (child) {
                    child.style.setProperty("color", "#ffffff", "important");
                });
            }

            /* Service History button */
            if (
                text === "New Service Record" ||
                text.includes("New Service Record") ||
                text.includes("NewService Record")
            ) {
                el.style.setProperty("background", "#ffffff", "important");
                el.style.setProperty("background-color", "#ffffff", "important");
                el.style.setProperty("color", "#1f2937", "important");
                el.style.setProperty("border-color", "#d9dee8", "important");

                el.querySelectorAll("*").forEach(function (child) {
                    child.style.setProperty("color", "#1f2937", "important");
                });
            }

            /* Supplier button */
            if (text === "Add Supplier" || text.includes("Add Supplier")) {
                el.style.setProperty("background", "#ffffff", "important");
                el.style.setProperty("background-color", "#ffffff", "important");
                el.style.setProperty("color", "#1f2937", "important");
                el.style.setProperty("border-color", "#d9dee8", "important");

                el.querySelectorAll("*").forEach(function (child) {
                    child.style.setProperty("color", "#1f2937", "important");
                });
            }
        });
    }

    syncIconColor();
    fixFixedButtons();

    const observer = new MutationObserver(function () {
        syncIconColor();
        fixFixedButtons();
    });

    observer.observe(document.body, {
        childList: true,
        subtree: true
    });
})();

</script>


<script>
/* AutoFlow fixed primary action buttons */
(function () {

    const fixedPrimaryLabels = [
        "Create Invoice",
        "Add Supplier",
        "New Follow-up",
        "New Service Record",
        "NewService Record"
    ];

    function applyFixedPrimaryButtons() {

        document.querySelectorAll("button, a").forEach(function (el) {

            const text = (el.textContent || "")
                .replace(/\s+/g, " ")
                .trim();

            const matched = fixedPrimaryLabels.some(function (label) {
                return text === label || text.includes(label);
            });

            if (!matched) return;

            el.classList.add("af-fixed-primary-action");

            el.style.setProperty("background", "#7544f5", "important");
            el.style.setProperty("background-color", "#7544f5", "important");
            el.style.setProperty("background-image", "none", "important");
            el.style.setProperty("color", "#ffffff", "important");
            el.style.setProperty("border-color", "#7544f5", "important");
            el.style.setProperty("opacity", "1", "important");
            el.style.setProperty("box-shadow", "none", "important");

            el.querySelectorAll("*").forEach(function (child) {
                child.style.setProperty("color", "#ffffff", "important");
                child.style.setProperty("fill", "#ffffff", "important");
                child.style.setProperty("stroke", "#ffffff", "important");
                child.style.setProperty("opacity", "1", "important");
            });
        });
    }

    applyFixedPrimaryButtons();

    const observer = new MutationObserver(function () {
        applyFixedPrimaryButtons();
    });

    observer.observe(document.body, {
        childList: true,
        subtree: true
    });

})();
</script>



<script>
// AutoFlow FINAL PRIMARY BUTTON LOCK JS
(function () {
    const violet = "#7544f5";

    const labels = [
        "Create Invoice",
        "Add Supplier",
        "New Follow-up",
        "New Service Record",
        "NewService Record"
    ];

    function normalize(text) {
        return (text || "")
            .replace(/\s+/g, " ")
            .replace(/NewService\s+Record/gi, "New Service Record")
            .trim()
            .toLowerCase();
    }

    function lockPrimaryButtons() {
        document.querySelectorAll("button, a").forEach(function (el) {
            const text = normalize(el.textContent);

            const matched =
                labels.some(function (label) {
                    return text === normalize(label);
                }) ||
                el.classList.contains("crm-primary-btn") ||
                el.classList.contains("supplier-primary-button") ||
                el.classList.contains("service-primary-button") ||
                el.classList.contains("billing-primary-button");

            if (!matched) return;

            el.style.setProperty("background", violet, "important");
            el.style.setProperty("background-color", violet, "important");
            el.style.setProperty("background-image", "none", "important");
            el.style.setProperty("color", "#ffffff", "important");
            el.style.setProperty("border-color", violet, "important");
            el.style.setProperty("opacity", "1", "important");
            el.style.setProperty("box-shadow", "none", "important");

            el.querySelectorAll("*").forEach(function (child) {
                child.style.setProperty("color", "#ffffff", "important");
                child.style.setProperty("fill", "#ffffff", "important");
                child.style.setProperty("stroke", "#ffffff", "important");
                child.style.setProperty("opacity", "1", "important");
            });
        });
    }

    lockPrimaryButtons();

    if (document.body) {
        const observer = new MutationObserver(function () {
            lockPrimaryButtons();
        });

        observer.observe(document.body, {
            childList: true,
            subtree: true
        });
    }
})();
</script>



<script>
/* AutoFlow Billing Action Buttons Fix */
(function () {
    const forceBillingActionButtons = function () {

        document.querySelectorAll("button, a").forEach(function (el) {

            const text = (el.textContent || "")
                .replace(/\s+/g, " ")
                .trim();

            if (text !== "Record Payment" && text !== "View") {
                return;
            }

            /*
             * Only affect Billing action buttons.
             * Find the invoice row containing Record Payment / View.
             */
            const row = el.closest("tr");

            if (!row) {
                return;
            }

            const rowText = (row.textContent || "")
                .replace(/\s+/g, " ")
                .trim();

            if (!rowText.includes("INV-")) {
                return;
            }

            el.style.setProperty("background", "#ffffff", "important");
            el.style.setProperty("background-color", "#ffffff", "important");
            el.style.setProperty("background-image", "none", "important");
            el.style.setProperty("color", "#1f2937", "important");
            el.style.setProperty("border", "1px solid #d9dee8", "important");
            el.style.setProperty("box-shadow", "none", "important");
            el.style.setProperty("opacity", "1", "important");

            el.querySelectorAll("*").forEach(function (child) {
                child.style.setProperty("color", "#1f2937", "important");
                child.style.setProperty("fill", "currentColor", "important");
                child.style.setProperty("stroke", "currentColor", "important");
                child.style.setProperty("opacity", "1", "important");
            });
        });
    };

    forceBillingActionButtons();

    const observer = new MutationObserver(function () {
        forceBillingActionButtons();
    });

    observer.observe(document.body, {
        childList: true,
        subtree: true
    });
})();
</script>


<script>

// AutoFlow profile change toast
(function () {
    let toastTimer = null;

    function showProfileToast() {
        let toast = document.getElementById("afProfileToast");

        if (!toast) {
            toast = document.createElement("div");
            toast.id = "afProfileToast";
            toast.className = "af-profile-toast";
            toast.innerHTML =
                '<span class="af-profile-toast-icon">✓</span>' +
                '<span>Profile picture changed successfully.</span>';

            document.body.appendChild(toast);
        }

        toast.classList.add("show");

        if (toastTimer) {
            clearTimeout(toastTimer);
        }

        toastTimer = setTimeout(function () {
            toast.classList.remove("show");
        }, 3200);
    }

    const input = document.getElementById("afRoleImageInput");

    if (input) {
        input.addEventListener("change", function () {
            const file = input.files && input.files[0];

            if (!file) {
                return;
            }

            if (!file.type.startsWith("image/")) {
                return;
            }

            setTimeout(showProfileToast, 150);
        });
    }
})();

</script>
