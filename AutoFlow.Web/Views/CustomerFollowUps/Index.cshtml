<script>
(function () {
    window.toggleCrmMenu = function (button) {
        document.querySelectorAll('.crm-menu-popover.open').forEach(function (menu) {
            if (menu !== button.nextElementSibling) menu.classList.remove('open');
        });
        button.nextElementSibling.classList.toggle('open');
    };

    document.addEventListener('click', function (event) {
        if (!event.target.closest('.crm-menu')) {
            document.querySelectorAll('.crm-menu-popover.open').forEach(function (menu) { menu.classList.remove('open'); });
        }
    });

    window.closeCrmDrawer = function (event) {
        if (event.target.classList.contains('crm-drawer-backdrop')) {
            var close = document.querySelector('.crm-drawer-close');
            if (close) close.click();
        }
    };

    var customer = document.getElementById('drawerCustomer');
    var vehicle = document.getElementById('drawerVehicle');
    var linkedProfiles = document.getElementById('crmLinkedProfiles');
    var linkedCustomerImage = document.getElementById('crmLinkedCustomerImage');
    var linkedCustomerName = document.getElementById('crmLinkedCustomerName');
    var linkedVehicleImage = document.getElementById('crmLinkedVehicleImage');
    var linkedVehicleName = document.getElementById('crmLinkedVehicleName');
    var linkedVehiclePlate = document.getElementById('crmLinkedVehiclePlate');

    function setPreviewImage(container, url, fallbackClass) {
        if (!container) return;
        container.innerHTML = '';
        if (url) {
            var img = document.createElement('img');
            img.src = url;
            img.alt = '';
            container.appendChild(img);
        } else {
            var icon = document.createElement('i');
            icon.className = fallbackClass;
            container.appendChild(icon);
        }
    }

    function updateLinkedPreview(vehicleItems) {
        if (!linkedProfiles || !customer || !vehicle) return;
        var customerId = customer.value;
        var vehicleId = vehicle.value;
        if (!customerId || !vehicleId) { linkedProfiles.hidden = true; return; }
        var selectedVehicle = (vehicleItems || []).find(function (item) { return String(item.id) === String(vehicleId); });
        var customerOption = customer.options[customer.selectedIndex];
        linkedCustomerName.textContent = customerOption ? customerOption.textContent : '—';
        linkedVehicleName.textContent = selectedVehicle ? (selectedVehicle.make + ' ' + selectedVehicle.model).trim() : '—';
        linkedVehiclePlate.textContent = selectedVehicle ? selectedVehicle.plateNumber : '—';
        setPreviewImage(linkedVehicleImage, selectedVehicle && selectedVehicle.imageUrl, 'bi bi-car-front-fill');
        linkedProfiles.hidden = false;
        fetch('@Url.Action("CustomerProfile", "CustomerFollowUps")?customerId=' + encodeURIComponent(customerId))
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (profile) {
                if (!profile) return;
                linkedCustomerName.textContent = profile.name || linkedCustomerName.textContent;
                setPreviewImage(linkedCustomerImage, profile.imageUrl, 'bi bi-person-fill');
            })
            .catch(function () { setPreviewImage(linkedCustomerImage, null, 'bi bi-person-fill'); });
    }

    function resetSelect(select, placeholder) {
        if (!select) return;
        select.innerHTML = '';
        var option = document.createElement('option');
        option.value = '';
        option.textContent = placeholder;
        select.appendChild(option);
    }

    function loadVehicles(customerId, selectedId) {
        if (!vehicle) return;
        resetSelect(vehicle, 'Select vehicle...');
        if (!customerId) return;
        fetch('@Url.Action("VehiclesForCustomer", "CustomerFollowUps")?customerId=' + encodeURIComponent(customerId))
            .then(function (r) { return r.ok ? r.json() : []; })
            .then(function (items) {
                items.forEach(function (item) {
                    var option = document.createElement('option');
                    option.value = item.id;
                    option.textContent = item.text;
                    if (String(item.id) === String(selectedId || '')) option.selected = true;
                    vehicle.appendChild(option);
                });
                updateLinkedPreview(items);
            })
            .catch(function () { resetSelect(vehicle, 'No active vehicles available'); updateLinkedPreview([]); });
    }

    if (customer && vehicle) {
        customer.addEventListener('change', function () {
            loadVehicles(customer.value, '');
        });

        vehicle.addEventListener('change', function () {
            loadVehicles(customer.value, vehicle.value);
        });

        var selectedVehicle = vehicle.getAttribute('data-selected') || '';
        if (customer.value) {
            loadVehicles(customer.value, selectedVehicle);
        }
    }
})();

    function openArchivedFollowUpsDrawer() {
        var backdrop = document.getElementById('archivedFollowUpsBackdrop');
        if (!backdrop) return;
        backdrop.classList.add('open');
        backdrop.setAttribute('aria-hidden', 'false');
        document.body.classList.add('crm-archive-open');
    }

    function closeArchivedFollowUpsDrawer() {
        var backdrop = document.getElementById('archivedFollowUpsBackdrop');
        if (!backdrop) return;
        backdrop.classList.remove('open');
        backdrop.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('crm-archive-open');
    }

    document.addEventListener('click', function (event) {
        var backdrop = document.getElementById('archivedFollowUpsBackdrop');
        if (backdrop && event.target === backdrop) closeArchivedFollowUpsDrawer();
    });

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
            closeArchivedFollowUpsDrawer();
        }
    });
</script>
