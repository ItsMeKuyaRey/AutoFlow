@model IEnumerable<AutoFlow.Web.Models.CustomerFollowUp>

@{
    ViewData["Title"] = "Customer Follow-ups";

    var search = ViewBag.Search as string ?? string.Empty;
    var status = ViewBag.Status as string ?? string.Empty;
    var followUpType = ViewBag.FollowUpType as string ?? string.Empty;

    var statuses = ViewBag.Statuses as IEnumerable<string>
                   ?? Array.Empty<string>();

    var followUpTypes = ViewBag.FollowUpTypes as IEnumerable<string>
                        ?? Array.Empty<string>();
}

<div class="page-container">

    <!-- Page Header -->
    <div class="page-header">
        <div>
            <div class="breadcrumb">
                <a asp-controller="Home" asp-action="Index">Dashboard</a>
                <i class="bi bi-chevron-right"></i>
                <span>Customer Follow-ups</span>
            </div>

            <div class="page-title-row">
                <div class="title-icon">
                    <i class="bi bi-person-lines-fill"></i>
                </div>

                <div>
                    <h1>Customer Follow-ups</h1>
                    <p>Manage customer communication, service follow-ups, and CRM activities.</p>
                </div>
            </div>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            New Follow-up
        </a>
    </div>

    <!-- Summary Cards -->
    <div class="summary-grid">
        <div class="summary-card">
            <div class="summary-icon purple">
                <i class="bi bi-list-check"></i>
            </div>

            <div>
                <span class="summary-label">Total Follow-ups</span>
                <strong>@Model.Count()</strong>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon orange">
                <i class="bi bi-clock-history"></i>
            </div>

            <div>
                <span class="summary-label">Pending</span>
                <strong>
                    @Model.Count(x =>
                        string.Equals(x.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                </strong>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon green">
                <i class="bi bi-check-circle"></i>
            </div>

            <div>
                <span class="summary-label">Completed</span>
                <strong>
                    @Model.Count(x =>
                        string.Equals(x.Status, "Completed", StringComparison.OrdinalIgnoreCase))
                </strong>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon blue">
                <i class="bi bi-calendar-event"></i>
            </div>

            <div>
                <span class="summary-label">Scheduled Next</span>
                <strong>
                    @Model.Count(x => x.NextFollowUpDate.HasValue)
                </strong>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="filter-card">
        <form asp-action="Index" method="get">

            <div class="filter-main">

                <div class="search-box">
                    <i class="bi bi-search"></i>

                    <input type="text"
                           name="search"
                           value="@search"
                           placeholder="Search customer, vehicle, subject, notes..." />

                    @if (!string.IsNullOrWhiteSpace(search))
                    {
                        <a asp-action="Index"
                           asp-route-status="@status"
                           asp-route-followUpType="@followUpType"
                           class="clear-search"
                           title="Clear search">
                            <i class="bi bi-x-circle"></i>
                        </a>
                    }
                </div>

                <div class="filter-field">
                    <label for="status">Status</label>

                    <select id="status"
                            name="status"
                            class="form-select">
                        <option value="">All Statuses</option>

                        @foreach (var item in statuses)
                        {
                            <option value="@item"
                                    selected="@(string.Equals(status, item, StringComparison.OrdinalIgnoreCase))">
                                @item
                            </option>
                        }
                    </select>
                </div>

                <div class="filter-field">
                    <label for="followUpType">Follow-up Type</label>

                    <select id="followUpType"
                            name="followUpType"
                            class="form-select">
                        <option value="">All Types</option>

                        @foreach (var item in followUpTypes)
                        {
                            <option value="@item"
                                    selected="@(string.Equals(followUpType, item, StringComparison.OrdinalIgnoreCase))">
                                @item
                            </option>
                        }
                    </select>
                </div>

                <button type="submit" class="btn btn-primary filter-btn">
                    <i class="bi bi-funnel"></i>
                    Apply
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(search) ||
                 !string.IsNullOrWhiteSpace(status) ||
                 !string.IsNullOrWhiteSpace(followUpType))
            {
                <div class="active-filters">
                    <span class="active-label">
                        <i class="bi bi-funnel-fill"></i>
                        Active filters:
                    </span>

                    @if (!string.IsNullOrWhiteSpace(search))
                    {
                        <span class="filter-chip">
                            Search: "@search"
                        </span>
                    }

                    @if (!string.IsNullOrWhiteSpace(status))
                    {
                        <span class="filter-chip">
                            Status: @status
                        </span>
                    }

                    @if (!string.IsNullOrWhiteSpace(followUpType))
                    {
                        <span class="filter-chip">
                            Type: @followUpType
                        </span>
                    }

                    <a asp-action="Index" class="clear-filters">
                        Clear all
                    </a>
                </div>
            }
        </form>
    </div>

    <!-- Follow-up Table -->
    <div class="table-card">

        <div class="table-header">
            <div>
                <h2>Follow-up Records</h2>
                <p>
                    Showing <strong>@Model.Count()</strong>
                    follow-up@(Model.Count() == 1 ? "" : "s")
                </p>
            </div>

            <div class="table-header-action">
                <a asp-action="Create" class="btn btn-light">
                    <i class="bi bi-plus-lg"></i>
                    Add Follow-up
                </a>
            </div>
        </div>

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="followup-table">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Vehicle</th>
                            <th>Follow-up</th>
                            <th>Schedule</th>
                            <th>Status</th>
                            <th class="actions-column">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            var customerName = item.Customer != null
                                ? $"{item.Customer.FirstName} {item.Customer.LastName}".Trim()
                                : "Unknown Customer";

                            var vehicleName = item.Vehicle != null
                                ? $"{item.Vehicle.Make} {item.Vehicle.Model}".Trim()
                                : "Unknown Vehicle";

                            var statusClass = item.Status switch
                            {
                                "Completed" => "status-completed",
                                "Cancelled" => "status-cancelled",
                                "Overdue" => "status-overdue",
                                _ => "status-pending"
                            };

                            <tr>
                                <!-- Customer -->
                                <td>
                                    <div class="customer-cell">
                                        <div class="avatar">
                                            @{
                                                var initials = customerName == "Unknown Customer"
                                                    ? "UC"
                                                    : string.Concat(
                                                        customerName
                                                            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                                            .Take(2)
                                                            .Select(x => x[0])
                                                    ).ToUpper();
                                            }

                                            @initials
                                        </div>

                                        <div class="cell-content">
                                            <span class="primary-text">
                                                @customerName
                                            </span>

                                            @if (item.Customer != null &&
                                                 !string.IsNullOrWhiteSpace(item.Customer.Phone))
                                            {
                                                <span class="secondary-text">
                                                    @item.Customer.Phone
                                                </span>
                                            }
                                            else if (item.Customer != null &&
                                                     !string.IsNullOrWhiteSpace(item.Customer.Email))
                                            {
                                                <span class="secondary-text">
                                                    @item.Customer.Email
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <!-- Vehicle -->
                                <td>
                                    <div class="vehicle-cell">
                                        <div class="vehicle-icon">
                                            <i class="bi bi-car-front"></i>
                                        </div>

                                        <div class="cell-content">
                                            <span class="primary-text">
                                                @vehicleName
                                            </span>

                                            @if (item.Vehicle != null)
                                            {
                                                <span class="secondary-text">
                                                    @item.Vehicle.PlateNumber
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <!-- Follow-up -->
                                <td>
                                    <div class="followup-cell">
                                        <span class="type-badge">
                                            @item.FollowUpType
                                        </span>

                                        <span class="subject-text">
                                            @item.Subject
                                        </span>

                                        @if (!string.IsNullOrWhiteSpace(item.Notes))
                                        {
                                            <span class="secondary-text notes-preview">
                                                @item.Notes
                                            </span>
                                        }
                                    </div>
                                </td>

                                <!-- Schedule -->
                                <td>
                                    <div class="schedule-cell">
                                        <div class="schedule-date">
                                            <i class="bi bi-calendar3"></i>

                                            <span>
                                                @item.FollowUpDate.ToString("MMM dd, yyyy")
                                            </span>
                                        </div>

                                        <span class="secondary-text">
                                            @item.FollowUpDate.ToString("hh:mm tt")
                                        </span>

                                        @if (item.NextFollowUpDate.HasValue)
                                        {
                                            <span class="next-date">
                                                <i class="bi bi-arrow-right"></i>
                                                Next:
                                                @item.NextFollowUpDate.Value.ToString("MMM dd")
                                            </span>
                                        }
                                    </div>
                                </td>

                                <!-- Status -->
                                <td>
                                    <span class="status-badge @statusClass">
                                        <span class="status-dot"></span>
                                        @item.Status
                                    </span>
                                </td>

                                <!-- Actions -->
                                <td>
                                    <div class="action-buttons">

                                        <a asp-action="Details"
                                           asp-route-id="@item.FollowUpId"
                                           class="action-btn"
                                           title="View details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.FollowUpId"
                                           class="action-btn"
                                           title="Edit follow-up">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.FollowUpId"
                                           class="action-btn action-delete"
                                           title="Delete follow-up">
                                            <i class="bi bi-trash3"></i>
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="bi bi-person-lines-fill"></i>
                </div>

                <h3>
                    @(string.IsNullOrWhiteSpace(search) &&
                      string.IsNullOrWhiteSpace(status) &&
                      string.IsNullOrWhiteSpace(followUpType)
                        ? "No follow-ups yet"
                        : "No follow-ups found")
                </h3>

                <p>
                    @(string.IsNullOrWhiteSpace(search) &&
                      string.IsNullOrWhiteSpace(status) &&
                      string.IsNullOrWhiteSpace(followUpType)
                        ? "Create your first customer follow-up to start managing CRM activities."
                        : "Try changing your search or filter criteria.")
                </p>

                @if (string.IsNullOrWhiteSpace(search) &&
                     string.IsNullOrWhiteSpace(status) &&
                     string.IsNullOrWhiteSpace(followUpType))
                {
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-lg"></i>
                        Create Follow-up
                    </a>
                }
                else
                {
                    <a asp-action="Index" class="btn btn-light">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        Clear Filters
                    </a>
                }
            </div>
        }
    </div>
</div>

<style>
    .page-container {
        max-width: 1500px;
        margin: 0 auto;
        padding: 28px 32px 40px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 24px;
        margin-bottom: 24px;
    }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
        color: #8b93a7;
        font-size: 13px;
        font-weight: 500;
    }

    .breadcrumb a {
        color: #6d5dfc;
        text-decoration: none;
    }

    .breadcrumb a:hover {
        text-decoration: underline;
    }

    .breadcrumb i {
        font-size: 10px;
    }

    .page-title-row {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .title-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f0edff;
        color: #6d5dfc;
        font-size: 22px;
        flex-shrink: 0;
    }

    .page-title-row h1 {
        margin: 0;
        color: #172033;
        font-size: 28px;
        font-weight: 700;
        letter-spacing: -.4px;
    }

    .page-title-row p {
        margin: 4px 0 0;
        color: #7b8498;
        font-size: 14px;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: 0 16px;
        border-radius: 9px;
        border: 1px solid transparent;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: all .2s ease;
        cursor: pointer;
    }

    .btn-primary {
        background: #6d5dfc;
        border-color: #6d5dfc;
        color: #fff;
    }

    .btn-primary:hover {
        background: #5d4ce8;
        border-color: #5d4ce8;
        color: #fff;
        transform: translateY(-1px);
    }

    .btn-light {
        background: #fff;
        border-color: #e5e8ef;
        color: #465064;
    }

    .btn-light:hover {
        background: #f8f9fc;
        color: #293246;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 20px;
    }

    .summary-card {
        display: flex;
        align-items: center;
        gap: 14px;
        background: #fff;
        border: 1px solid #e8eaf0;
        border-radius: 12px;
        padding: 17px 18px;
        box-shadow: 0 2px 8px rgba(25, 32, 56, .03);
    }

    .summary-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }

    .summary-icon.purple {
        background: #f0edff;
        color: #6d5dfc;
    }

    .summary-icon.orange {
        background: #fff5df;
        color: #c28314;
    }

    .summary-icon.green {
        background: #eaf8f0;
        color: #238653;
    }

    .summary-icon.blue {
        background: #edf5ff;
        color: #3d78c7;
    }

    .summary-label {
        display: block;
        color: #8c94a6;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .45px;
        margin-bottom: 4px;
    }

    .summary-card strong {
        display: block;
        color: #20283a;
        font-size: 21px;
        line-height: 1;
        font-weight: 700;
    }

    .filter-card {
        background: #fff;
        border: 1px solid #e8eaf0;
        border-radius: 12px;
        padding: 18px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(25, 32, 56, .03);
    }

    .filter-main {
        display: grid;
        grid-template-columns: minmax(250px, 1.7fr) minmax(150px, .8fr) minmax(180px, 1fr) auto;
        align-items: end;
        gap: 14px;
    }

    .search-box {
        position: relative;
        display: flex;
        align-items: center;
    }

    .search-box > i {
        position: absolute;
        left: 14px;
        color: #9299aa;
        font-size: 15px;
        pointer-events: none;
    }

    .search-box input {
        width: 100%;
        height: 42px;
        border: 1px solid #e1e4eb;
        border-radius: 9px;
        outline: none;
        padding: 0 40px 0 40px;
        color: #30394b;
        font-size: 13px;
        background: #fff;
    }

    .search-box input:focus {
        border-color: #8d82ff;
        box-shadow: 0 0 0 3px rgba(109, 93, 252, .09);
    }

    .clear-search {
        position: absolute;
        right: 12px;
        color: #a1a7b5;
        text-decoration: none;
        font-size: 14px;
    }

    .clear-search:hover {
        color: #6d5dfc;
    }

    .filter-field label {
        display: block;
        color: #697285;
        font-size: 11px;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .form-select {
        width: 100%;
        height: 42px;
        border: 1px solid #e1e4eb;
        border-radius: 9px;
        padding: 0 34px 0 12px;
        color: #30394b;
        font-size: 13px;
        background-color: #fff;
        outline: none;
    }

    .form-select:focus {
        border-color: #8d82ff;
        box-shadow: 0 0 0 3px rgba(109, 93, 252, .09);
    }

    .filter-btn {
        height: 42px;
        white-space: nowrap;
    }

    .active-filters {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        padding-top: 14px;
        margin-top: 14px;
        border-top: 1px solid #f0f1f5;
    }

    .active-label {
        color: #858d9e;
        font-size: 12px;
        font-weight: 600;
    }

    .active-label i {
        color: #6d5dfc;
        margin-right: 4px;
    }

    .filter-chip {
        display: inline-flex;
        align-items: center;
        padding: 5px 9px;
        border-radius: 6px;
        background: #f3f1ff;
        color: #6254df;
        font-size: 11px;
        font-weight: 600;
    }

    .clear-filters {
        color: #d04c5b;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        margin-left: 4px;
    }

    .clear-filters:hover {
        text-decoration: underline;
    }

    .table-card {
        background: #fff;
        border: 1px solid #e8eaf0;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(25, 32, 56, .03);
    }

    .table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding: 20px 22px;
        border-bottom: 1px solid #eef0f4;
    }

    .table-header h2 {
        margin: 0;
        color: #20283a;
        font-size: 15px;
        font-weight: 700;
    }

    .table-header p {
        margin: 4px 0 0;
        color: #8a92a4;
        font-size: 12px;
    }

    .table-header p strong {
        color: #596276;
    }

    .table-header-action .btn {
        min-height: 38px;
    }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
    }

    .followup-table {
        width: 100%;
        min-width: 1050px;
        border-collapse: collapse;
    }

    .followup-table th {
        padding: 13px 18px;
        background: #fafbfc;
        color: #8b93a5;
        border-bottom: 1px solid #eceef3;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .55px;
        text-align: left;
        white-space: nowrap;
    }

    .followup-table td {
        padding: 15px 18px;
        border-bottom: 1px solid #f0f1f5;
        vertical-align: middle;
    }

    .followup-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .followup-table tbody tr {
        transition: background .15s ease;
    }

    .followup-table tbody tr:hover {
        background: #fcfcff;
    }

    .customer-cell,
    .vehicle-cell {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 190px;
    }

    .avatar {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f0edff;
        color: #6656e8;
        font-size: 11px;
        font-weight: 700;
        flex-shrink: 0;
    }

    .vehicle-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f4f6fa;
        color: #657086;
        font-size: 15px;
        flex-shrink: 0;
    }

    .cell-content {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .primary-text {
        display: block;
        color: #293244;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }

    .secondary-text {
        display: block;
        max-width: 210px;
        color: #8b93a4;
        font-size: 11px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .followup-cell {
        min-width: 200px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 5px;
    }

    .type-badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 8px;
        border-radius: 5px;
        background: #f3f1ff;
        color: #6656e8;
        font-size: 10px;
        font-weight: 600;
    }

    .subject-text {
        color: #30394b;
        font-size: 13px;
        font-weight: 600;
        max-width: 230px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .notes-preview {
        max-width: 230px;
    }

    .schedule-cell {
        min-width: 145px;
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .schedule-date {
        display: flex;
        align-items: center;
        gap: 7px;
        color: #30394b;
        font-size: 12px;
        font-weight: 600;
    }

    .schedule-date i {
        color: #6d5dfc;
        font-size: 13px;
    }

    .next-date {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin-top: 3px;
        color: #6b7285;
        font-size: 10px;
        font-weight: 600;
    }

    .next-date i {
        color: #6d5dfc;
        font-size: 9px;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }

    .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: currentColor;
    }

    .status-pending {
        background: #fff6df;
        color: #b77900;
    }

