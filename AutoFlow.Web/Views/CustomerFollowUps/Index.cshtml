@using Microsoft.AspNetCore.Mvc.Rendering
@model IEnumerable<AutoFlow.Web.Models.CustomerFollowUp>

@{
    ViewData["Title"] = "Customer Follow-ups CRM";

    var search = ViewBag.Search as string ?? string.Empty;
    var status = ViewBag.Status as string ?? string.Empty;
    var followUpType = ViewBag.FollowUpType as string ?? string.Empty;
    var open = ViewBag.Open as string ?? string.Empty;
    var openId = ViewBag.OpenId as int?;
    var drawer = ViewBag.DrawerFollowUp as AutoFlow.Web.Models.CustomerFollowUp;
    var archivedFollowUps = ViewBag.ArchivedFollowUps as IEnumerable<AutoFlow.Web.Models.CustomerFollowUp> ?? Array.Empty<AutoFlow.Web.Models.CustomerFollowUp>();
    var archivedCount = (int?)ViewBag.ArchivedCount ?? archivedFollowUps.Count();

    var statuses = ViewBag.Statuses as IEnumerable<SelectListItem> ?? Array.Empty<SelectListItem>();
    var followUpTypes = ViewBag.FollowUpTypes as IEnumerable<SelectListItem> ?? Array.Empty<SelectListItem>();
    var customerOptions = ViewBag.CustomerId as IEnumerable<SelectListItem> ?? Array.Empty<SelectListItem>();
    var vehicleOptions = ViewBag.VehicleId as IEnumerable<SelectListItem> ?? Array.Empty<SelectListItem>();

    var totalCount = (int?)ViewBag.TotalCount ?? 0;
    var page = (int?)ViewBag.Page ?? 1;
    var pageCount = (int?)ViewBag.PageCount ?? 1;
    var pageSize = (int?)ViewBag.PageSize ?? 10;
    var showingFrom = totalCount == 0 ? 0 : ((page - 1) * pageSize) + 1;
    var showingTo = Math.Min(page * pageSize, totalCount);

    string QueryUrl(int targetPage = 1, string? targetOpen = null, int? targetId = null) =>
        Url.Action("Index", "CustomerFollowUps", new
        {
            search = string.IsNullOrWhiteSpace(search) ? null : search,
            status = string.IsNullOrWhiteSpace(status) ? null : status,
            followUpType = string.IsNullOrWhiteSpace(followUpType) ? null : followUpType,
            page = targetPage,
            open = string.IsNullOrWhiteSpace(targetOpen) ? null : targetOpen,
            id = targetId
        }) ?? Url.Action("Index", "CustomerFollowUps") ?? "/CustomerFollowUps/Index";
}

<div class="crm-page">
    <div class="crm-header">
        <div>
            <div class="crm-breadcrumb">
                <a asp-controller="Home" asp-action="Index">CRM</a>
                <span>›</span>
                <span>Follow-ups</span>
            </div>
            <h1>Customer Follow-ups CRM</h1>
            <p>Manage customer follow-ups and maintain service relationships.</p>
        </div>

        <div class="crm-header-actions">
            <button type="button" class="crm-archive-btn" onclick="openArchivedFollowUpsDrawer()">
                <i class="bi bi-archive"></i>
                Archived
                <span>@archivedCount</span>
            </button>
            <a class="crm-primary-btn" href="@QueryUrl(1, "create")">
                <i class="bi bi-plus-lg"></i>
                New Follow-up
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="crm-alert success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@successMessage</span>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="crm-alert error">
            <i class="bi bi-exclamation-circle-fill"></i>
            <span>@errorMessage</span>
        </div>
    }

    <div class="crm-summary-grid">
        <div class="crm-summary-card">
            <div class="crm-summary-icon purple"><i class="bi bi-calendar-event"></i></div>
            <div><span>Due Today</span><strong>@ViewBag.DueTodayCount</strong><small>records</small></div>
        </div>
        <div class="crm-summary-card">
            <div class="crm-summary-icon green"><i class="bi bi-graph-up-arrow"></i></div>
            <div><span>Upcoming</span><strong>@ViewBag.UpcomingCount</strong><small>scheduled</small></div>
        </div>
        <div class="crm-summary-card">
            <div class="crm-summary-icon red"><i class="bi bi-arrow-counterclockwise"></i></div>
            <div><span>Overdue</span><strong>@ViewBag.OverdueCount</strong><small>pending</small></div>
        </div>
    </div>

    <div class="crm-filter-card">
        <form asp-action="Index" method="get">
            <div class="crm-filter-row">
                <div class="crm-search">
                    <i class="bi bi-search"></i>
                    <input name="search" value="@search" placeholder="Search customer, subject, or follow-up..." aria-label="Search follow-ups" />
                </div>

                <select name="followUpType" class="crm-select" aria-label="Follow-up type">
                    <option value="">Follow-up Type</option>
                    @foreach (var item in followUpTypes)
                    {
                        @if (item.Selected)
                        {
                            <option value="@item.Value" selected="selected">@item.Text</option>
                        }
                        else
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>

                <select name="status" class="crm-select" aria-label="Status">
                    <option value="">Status</option>
                    @foreach (var item in statuses)
                    {
                        @if (item.Selected)
                        {
                            <option value="@item.Value" selected="selected">@item.Text</option>
                        }
                        else
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>

                <button type="submit" class="crm-filter-btn"><i class="bi bi-funnel"></i> Apply</button>

                @if (!string.IsNullOrWhiteSpace(search) || !string.IsNullOrWhiteSpace(status) || !string.IsNullOrWhiteSpace(followUpType))
                {
                    <a class="crm-clear" href="@Url.Action("Index", "CustomerFollowUps")">Clear Filters</a>
                }
            </div>
        </form>
    </div>

    <div class="crm-table-card">
        <div class="crm-table-heading">
            <div>
                <h2>Follow-up Records</h2>
                <p>Showing @showingFrom–@showingTo of @totalCount records</p>
            </div>
        </div>

        @if (Model.Any())
        {
            <div class="crm-table-scroll">
                <table class="crm-table">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Vehicle</th>
                            <th>Follow-up Type</th>
                            <th>Subject</th>
                            <th>Follow-up Date</th>
                            <th>Status</th>
                            <th>Next Follow-up</th>
                            <th class="crm-actions-col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        var customerName = item.Customer == null
                            ? "Unknown Customer"
                            : $"{item.Customer.FirstName} {item.Customer.LastName}".Trim();
                        var vehicleName = item.Vehicle == null
                            ? "Unknown Vehicle"
                            : $"{item.Vehicle.Make} {item.Vehicle.Model}".Trim();
                        var initials = string.Concat(customerName
                            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                            .Take(2)
                            .Select(x => x[0])).ToUpperInvariant();
                        if (string.IsNullOrWhiteSpace(initials)) initials = "UC";
                        var statusClass = item.Status switch
                        {
                            "Completed" => "completed",
                            "Cancelled" => "cancelled",
                            _ => "pending"
                        };

                        <tr class="@(item.Status.Equals("Archived", StringComparison.OrdinalIgnoreCase) ? "crm-row-archived" : "")">
                            <td>
                                <div class="crm-person">
                                    <div class="crm-avatar">
                                        @if (!string.IsNullOrWhiteSpace(item.Customer?.ImageUrl))
                                        {
                                            <img src="@item.Customer.ImageUrl" alt="@customerName" loading="lazy" />
                                        }
                                        else
                                        {
                                            @initials
                                        }
                                    </div>
                                    <div>
                                        <strong>@customerName</strong>
                                        <span>@(item.Customer?.Phone ?? item.Customer?.Email ?? "No contact information")</span>
                                        @if (item.Status.Equals("Archived", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="crm-archived-label"><i class="bi bi-archive"></i> Archived</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="crm-vehicle">
                                    <div class="crm-vehicle-icon">
                                        @if (!string.IsNullOrWhiteSpace(item.Vehicle?.ImageUrl))
                                        {
                                            <img src="@item.Vehicle.ImageUrl" alt="@vehicleName" loading="lazy" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-car-front-fill"></i>
                                        }
                                    </div>
                                    <div><strong>@vehicleName</strong><span>@(item.Vehicle?.PlateNumber ?? "—")</span></div>
                                </div>
                            </td>
                            <td><span class="crm-type">@item.FollowUpType</span></td>
                            <td><span class="crm-subject" title="@item.Subject">@item.Subject</span></td>
                            <td>
                                <div class="crm-date">
                                    <strong>@item.FollowUpDate.ToString("MMM d, yyyy")</strong>
                                    <span>@item.FollowUpDate.ToString("h:mm tt")</span>
                                </div>
                            </td>
                            <td>
                                @if (item.Status.Equals("Archived", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="crm-status archived"><i></i>Archived</span>
                                }
                                else
                                {
                                    <span class="crm-status @statusClass"><i></i>@item.Status</span>
                                }
                            </td>
                            <td>
                                @if (item.NextFollowUpDate.HasValue)
                                {
                                    <div class="crm-next-date">@item.NextFollowUpDate.Value.ToString("MMM d, yyyy")</div>
                                }
                                else
                                {
                                    <span class="crm-dash">—</span>
                                }
                            </td>
                            <td class="crm-actions-col">
                                <div class="crm-actions">
                                    <a href="@QueryUrl(page, "details", item.FollowUpId)" class="crm-action view" title="View details" aria-label="View details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="@QueryUrl(page, "edit", item.FollowUpId)" class="crm-action edit" title="Edit follow-up" aria-label="Edit follow-up">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (item.Status.Equals("Archived", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <form asp-action="Restore" method="post" class="crm-inline-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.FollowUpId" />
                                            <button type="submit" class="crm-action restore" title="Restore follow-up" aria-label="Restore follow-up">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Delete" method="post" class="crm-inline-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.FollowUpId" />
                                            <button type="submit" class="crm-action archive" title="Archive follow-up" aria-label="Archive follow-up">
                                                <i class="bi bi-archive"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="crm-empty">
                <div class="crm-empty-icon"><i class="bi bi-telephone"></i></div>
                <h3>@(totalCount == 0 && string.IsNullOrWhiteSpace(search) && string.IsNullOrWhiteSpace(status) && string.IsNullOrWhiteSpace(followUpType) ? "No follow-ups yet" : "No follow-ups found")</h3>
                <p>@(totalCount == 0 && string.IsNullOrWhiteSpace(search) && string.IsNullOrWhiteSpace(status) && string.IsNullOrWhiteSpace(followUpType) ? "Create a follow-up to start maintaining customer relationships." : "Try changing your search or filter criteria.")</p>
                <a class="crm-primary-btn" href="@QueryUrl(1, "create")"><i class="bi bi-plus-lg"></i> New Follow-up</a>
            </div>
        }

        @if (pageCount > 1)
        {
            <div class="crm-pagination">
                <a class="crm-page-btn @(page <= 1 ? "disabled" : "")" href="@(page <= 1 ? "#" : QueryUrl(page - 1))" aria-label="Previous"><i class="bi bi-chevron-left"></i></a>
                @for (var p = 1; p <= pageCount; p++)
                {
                    <a class="crm-page-btn @(p == page ? "active" : "")" href="@QueryUrl(p)">@p</a>
                }
                <a class="crm-page-btn @(page >= pageCount ? "disabled" : "")" href="@(page >= pageCount ? "#" : QueryUrl(page + 1))" aria-label="Next"><i class="bi bi-chevron-right"></i></a>
            </div>
        }
    </div>
</div>

<div id="archivedFollowUpsBackdrop" class="crm-archive-backdrop" aria-hidden="true">
    <aside id="archivedFollowUpsDrawer" class="crm-archive-drawer" role="dialog" aria-modal="true" aria-labelledby="archivedFollowUpsTitle">
        <div class="crm-archive-drawer-shell">
            <header class="crm-archive-drawer-header">
                <div>
                    <div class="crm-archive-kicker">Customer Follow-ups CRM</div>
                    <h2 id="archivedFollowUpsTitle">Archived Follow-ups</h2>
                    <p>@archivedCount archived follow-up record@(archivedCount == 1 ? "" : "s").</p>
                </div>
                <button type="button" class="crm-archive-close" onclick="closeArchivedFollowUpsDrawer()" aria-label="Close archived follow-ups">
                    <i class="bi bi-x-lg"></i>
                </button>
            </header>

            <div class="crm-archive-drawer-body">
                @if (archivedFollowUps.Any())
                {
                    @foreach (var archived in archivedFollowUps)
                    {
                        var archivedCustomer = archived.Customer == null
                            ? "Unknown Customer"
                            : $"{archived.Customer.FirstName} {archived.Customer.LastName}".Trim();
                        var archivedVehicle = archived.Vehicle == null
                            ? "Unknown Vehicle"
                            : $"{archived.Vehicle.Make} {archived.Vehicle.Model}".Trim();

                        <div class="crm-archived-card">
                            <div class="crm-archived-card-info">
                                <div class="crm-archived-profile-pair">
                                    <div class="crm-archived-avatar">
                                        @if (!string.IsNullOrWhiteSpace(archived.Customer?.ImageUrl))
                                        {
                                            <img src="@archived.Customer.ImageUrl" alt="@archivedCustomer" loading="lazy" />
                                        }
                                        else
                                        {
                                            @string.Concat(archivedCustomer.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpperInvariant()
                                        }
                                    </div>
                                    <div class="crm-archived-vehicle">
                                        @if (!string.IsNullOrWhiteSpace(archived.Vehicle?.ImageUrl))
                                        {
                                            <img src="@archived.Vehicle.ImageUrl" alt="@archivedVehicle" loading="lazy" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-car-front-fill"></i>
                                        }
                                    </div>
                                </div>
                                <div>
                                    <strong>@archived.Subject</strong>
                                    <span>@archivedCustomer</span>
                                    <small>@archivedVehicle · @archived.FollowUpDate.ToString("MMM d, yyyy")</small>
                                    <em><i class="bi bi-archive"></i> Archived</em>
                                </div>
                            </div>
                            <div class="crm-archived-card-actions">
                                <a class="crm-action view" href="@QueryUrl(page, "details", archived.FollowUpId)" title="View details" aria-label="View details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <form asp-action="Restore" method="post" class="crm-inline-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@archived.FollowUpId" />
                                    <button type="submit" class="crm-action restore" title="Restore follow-up" aria-label="Restore follow-up">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="crm-archive-empty">
                        <div class="crm-archive-empty-icon"><i class="bi bi-archive"></i></div>
                        <h3>No Archived Follow-ups</h3>
                        <p>Archived customer follow-up records will appear here.</p>
                    </div>
                }
            </div>
        </div>
    </aside>
</div>

@if (drawer != null && !string.IsNullOrWhiteSpace(open))
{
    <div class="crm-drawer-backdrop" onclick="closeCrmDrawer(event)"></div>
    <aside class="crm-drawer" aria-modal="true" role="dialog">
        <div class="crm-drawer-head">
            <div>
                @if (open.Equals("create", StringComparison.OrdinalIgnoreCase))
                {
                    <h2>New Customer Follow-up</h2>
                    <p>Record a customer follow-up activity.</p>
                }
                else if (open.Equals("edit", StringComparison.OrdinalIgnoreCase))
                {
                    <h2>Edit Customer Follow-up</h2>
                    <p>Update the follow-up activity and schedule.</p>
                }
                else if (open.Equals("delete", StringComparison.OrdinalIgnoreCase))
                {
                    <h2>Archive Follow-up</h2>
                    <p>Review this record before archiving it.</p>
                }
                else
                {
                    <h2>Follow-up Details</h2>
                    <p>Record and customer communication history.</p>
                }
            </div>
            <a class="crm-drawer-close" href="@QueryUrl(page)" aria-label="Close"><i class="bi bi-x-lg"></i></a>
        </div>

        @if (open.Equals("create", StringComparison.OrdinalIgnoreCase) || open.Equals("edit", StringComparison.OrdinalIgnoreCase))
        {
            <form action="@Url.Action(open.Equals("edit", StringComparison.OrdinalIgnoreCase) ? "Edit" : "Create", "CustomerFollowUps")" method="post" class="crm-drawer-form">
                @if (open.Equals("edit", StringComparison.OrdinalIgnoreCase))
                {
                    <input type="hidden" name="FollowUpId" value="@drawer.FollowUpId" />
                }
                @Html.AntiForgeryToken()

                <div class="crm-drawer-section">
                    <div class="crm-section-label">CUSTOMER</div>
                    <label for="drawerCustomer">Customer <b>*</b></label>
                    <select id="drawerCustomer" name="CustomerId" class="crm-drawer-input" required>
                        <option value="">Search and select existing customer...</option>
                        @foreach (var option in customerOptions)
                        {
                            @if (option.Selected)
                            {
                                <option value="@option.Value" selected="selected">@option.Text</option>
                            }
                            else
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        }
                    </select>
                    <small>Select the customer who will receive the follow-up.</small>
                </div>

                <div class="crm-drawer-grid">
                    <div>
                        <label for="drawerDate">Follow-up Date <b>*</b></label>
                        <input id="drawerDate" name="FollowUpDate" type="datetime-local" class="crm-drawer-input" value="@drawer.FollowUpDate.ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>
                    <div>
                        <label for="drawerType">Follow-up Type <b>*</b></label>
                        <select id="drawerType" name="FollowUpType" class="crm-drawer-input" required>
                            @foreach (var option in followUpTypes)
                            {
                                @if (option.Selected)
                            {
                                <option value="@option.Value" selected="selected">@option.Text</option>
                            }
                            else
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                            }
                        </select>
                    </div>
                </div>

                <div class="crm-drawer-section">
                    <label for="drawerSubject">Subject <b>*</b></label>
                    <input id="drawerSubject" name="Subject" class="crm-drawer-input" value="@drawer.Subject" maxlength="150" placeholder="Short subject/purpose" required />
                </div>

                <div class="crm-drawer-section">
                    <label for="drawerVehicle">Vehicle <b>*</b></label>
                    <select id="drawerVehicle" name="VehicleId" class="crm-drawer-input" required data-selected="@drawer.VehicleId">
                        <option value="">Select vehicle...</option>
                        @foreach (var option in vehicleOptions)
                        {
                            @if (option.Selected)
                            {
                                <option value="@option.Value" selected="selected">@option.Text</option>
                            }
                            else
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        }
                    </select>
                    <small>The vehicle must belong to the selected customer.</small>
                    <div id="crmLinkedProfiles" class="crm-linked-profiles" hidden>
                        <div class="crm-linked-profile">
                            <div id="crmLinkedCustomerImage" class="crm-linked-avatar"></div>
                            <div><span>OWNER</span><strong id="crmLinkedCustomerName">—</strong></div>
                        </div>
                        <div class="crm-linked-profile">
                            <div id="crmLinkedVehicleImage" class="crm-linked-vehicle"></div>
                            <div><span>VEHICLE</span><strong id="crmLinkedVehicleName">—</strong><small id="crmLinkedVehiclePlate">—</small></div>
                        </div>
                    </div>
                </div>

                <div class="crm-drawer-section">
                    <label for="drawerNotes">Notes</label>
                    <textarea id="drawerNotes" name="Notes" class="crm-drawer-input crm-drawer-textarea" maxlength="1000" placeholder="Additional notes about the interaction...">@drawer.Notes</textarea>
                </div>

                <div class="crm-drawer-grid">
                    <div>
                        <label for="drawerStatus">Status <b>*</b></label>
                        <select id="drawerStatus" name="Status" class="crm-drawer-input" required>
                            @foreach (var option in statuses)
                            {
                                @if (option.Selected)
                            {
                                <option value="@option.Value" selected="selected">@option.Text</option>
                            }
                            else
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                            }
                        </select>
                    </div>
                    <div>
                        <label for="drawerNextDate">Next Follow-up (optional)</label>
                        <input id="drawerNextDate" name="NextFollowUpDate" type="datetime-local" class="crm-drawer-input" value="@(drawer.NextFollowUpDate?.ToString("yyyy-MM-ddTHH:mm") ?? "")" />
                    </div>
                </div>

                <div class="crm-drawer-footer">
                    <a class="crm-secondary-btn" href="@QueryUrl(page)">Cancel</a>
                    <button class="crm-primary-btn" type="submit"><i class="bi bi-check-lg"></i>@(open.Equals("edit", StringComparison.OrdinalIgnoreCase) ? "Save Changes" : "Create Follow-up")</button>
                </div>
            </form>
        }
        else if (open.Equals("delete", StringComparison.OrdinalIgnoreCase))
        {
            <div class="crm-delete-body">
                <div class="crm-delete-warning"><i class="bi bi-exclamation-triangle"></i><div><strong>Archive this follow-up?</strong><p>This archives the selected CRM follow-up while keeping the record available for review and restoration.</p></div></div>
                <div class="crm-detail-title">@drawer.Subject</div>
                <div class="crm-delete-grid">
                    <div><span>Customer</span><strong>@drawer.Customer?.FirstName @drawer.Customer?.LastName</strong></div>
                    <div><span>Vehicle</span><strong>@drawer.Vehicle?.Make @drawer.Vehicle?.Model</strong></div>
                    <div><span>Status</span><strong>@drawer.Status</strong></div>
                    <div><span>Follow-up</span><strong>@drawer.FollowUpDate.ToString("MMM d, yyyy")</strong></div>
                </div>
                <form asp-action="Delete" method="post" class="crm-delete-actions">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@drawer.FollowUpId" />
                    <a class="crm-secondary-btn" href="@QueryUrl(page)">Cancel</a>
                    <button class="crm-archive-confirm-btn" type="submit"><i class="bi bi-archive"></i> Archive Follow-up</button>
                </form>
            </div>
        }
        else
        {
            var customerName = $"{drawer.Customer?.FirstName} {drawer.Customer?.LastName}".Trim();
            var vehicleName = $"{drawer.Vehicle?.Make} {drawer.Vehicle?.Model}".Trim();
            var statusClass = drawer.Status switch { "Completed" => "completed", "Cancelled" => "cancelled", _ => "pending" };

            <div class="crm-detail-body">
                <div class="crm-context-card">
                    <div class="crm-avatar large">
                        @if (!string.IsNullOrWhiteSpace(drawer.Customer?.ImageUrl))
                        {
                            <img src="@drawer.Customer.ImageUrl" alt="@customerName" />
                        }
                        else
                        {
                            @string.Concat(customerName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpperInvariant()
                        }
                    </div>
                    <div><strong>@customerName</strong><span>@vehicleName</span><div><a asp-controller="Customers" asp-action="Details" asp-route-id="@drawer.CustomerId">View Customer</a></div></div>
                </div>

                <div class="crm-detail-grid">
                    <div><span>DATE</span><strong>@drawer.FollowUpDate.ToString("MMM d, yyyy h:mm tt")</strong></div>
                    <div><span>TYPE</span><strong>@drawer.FollowUpType</strong></div>
                    <div><span>SUBJECT</span><strong>@drawer.Subject</strong></div>
                    <div><span>STATUS</span><strong class="crm-status @statusClass"><i></i>@drawer.Status</strong></div>
                    <div><span>NEXT FOLLOW-UP</span><strong>@(drawer.NextFollowUpDate?.ToString("MMM d, yyyy") ?? "—")</strong></div>
                    <div><span>VEHICLE</span><strong>@drawer.Vehicle?.PlateNumber</strong></div>
                </div>

                <div class="crm-detail-notes">
                    <span>NOTES</span>
                    <p>@(string.IsNullOrWhiteSpace(drawer.Notes) ? "No notes were recorded for this follow-up." : drawer.Notes)</p>
                </div>

                <div class="crm-activity">
                    <div class="crm-activity-head"><span>ACTIVITY HISTORY</span></div>
                    <div class="crm-activity-item"><span class="dot"></span><div><strong>@drawer.FollowUpDate.ToString("MMM d, yyyy")</strong><small>@drawer.FollowUpType recorded</small></div></div>
</div>
            </div>

            <div class="crm-drawer-footer detail-footer">
                <a class="crm-secondary-btn" href="@QueryUrl(page, "edit", drawer.FollowUpId)"><i class="bi bi-pencil"></i> Edit</a>
                <a class="crm-primary-btn" href="@QueryUrl(page, "delete", drawer.FollowUpId)">Delete</a>
            </div>
        }
    </aside>
}

