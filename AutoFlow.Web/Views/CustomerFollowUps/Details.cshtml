@model AutoFlow.Web.Models.CustomerFollowUp

@{
    ViewData["Title"] = "Follow-up Details";

    var customerName = Model.Customer != null
        ? $"{Model.Customer.FirstName} {Model.Customer.LastName}".Trim()
        : "Unknown Customer";

    var vehicleName = Model.Vehicle != null
        ? $"{Model.Vehicle.Year} {Model.Vehicle.Make} {Model.Vehicle.Model}".Trim()
        : "Unknown Vehicle";

    var statusClass = Model.Status switch
    {
        "Completed" => "status-completed",
        "Cancelled" => "status-cancelled",
        "Overdue" => "status-overdue",
        _ => "status-pending"
    };
}

<div class="page-container">
    <div class="page-header">
        <div>
            <div class="breadcrumb">
                <a asp-action="Index">Customer Follow-ups</a>
                <i class="bi bi-chevron-right"></i>
                <span>Details</span>
            </div>

            <div class="page-title-row">
                <div class="title-icon">
                    <i class="bi bi-person-lines-fill"></i>
                </div>
                <div>
                    <h1>Follow-up Details</h1>
                    <p>View the complete information for this customer follow-up.</p>
                </div>
            </div>
        </div>

        <div class="header-actions">
            <a asp-action="Edit" asp-route-id="@Model.FollowUpId" class="btn btn-primary">
                <i class="bi bi-pencil-square"></i>
                Edit Follow-up
            </a>

            <a asp-action="Index" class="btn btn-light">
                <i class="bi bi-arrow-left"></i>
                Back
            </a>
        </div>
    </div>

    <div class="details-grid">

        <!-- Customer & Vehicle -->
        <div class="details-card">
            <div class="card-header">
                <div class="card-header-icon">
                    <i class="bi bi-person-vcard"></i>
                </div>
                <div>
                    <h2>Customer & Vehicle</h2>
                    <p>Customer and vehicle associated with this follow-up.</p>
                </div>
            </div>

            <div class="info-list">
                <div class="info-item">
                    <div class="info-icon">
                        <i class="bi bi-person"></i>
                    </div>
                    <div class="info-content">
                        <span class="info-label">Customer</span>
                        <span class="info-value">@customerName</span>

                        @if (Model.Customer != null)
                        {
                            @if (!string.IsNullOrWhiteSpace(Model.Customer.Email))
                            {
                                <span class="info-sub">@Model.Customer.Email</span>
                            }

                            @if (!string.IsNullOrWhiteSpace(Model.Customer.Phone))
                            {
                                <span class="info-sub">@Model.Customer.Phone</span>
                            }
                        }
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">
                        <i class="bi bi-car-front"></i>
                    </div>
                    <div class="info-content">
                        <span class="info-label">Vehicle</span>
                        <span class="info-value">@vehicleName</span>

                        @if (Model.Vehicle != null)
                        {
                            @if (!string.IsNullOrWhiteSpace(Model.Vehicle.PlateNumber))
                            {
                                <span class="info-sub">
                                    Plate: @Model.Vehicle.PlateNumber
                                </span>
                            }

                            @if (!string.IsNullOrWhiteSpace(Model.Vehicle.Color))
                            {
                                <span class="info-sub">
                                    Color: @Model.Vehicle.Color
                                </span>
                            }
                        }
                    </div>
                </div>

                @if (Model.ServiceRecord != null)
                {
                    <div class="info-item">
                        <div class="info-icon">
                            <i class="bi bi-wrench-adjustable"></i>
                        </div>
                        <div class="info-content">
                            <span class="info-label">Service Record</span>
                            <span class="info-value">
                                #@Model.ServiceRecord.ServiceRecordId
                            </span>

                            <span class="info-sub">
                                @Model.ServiceRecord.ServiceDate.ToString("MMM dd, yyyy")
                            </span>

                            @if (!string.IsNullOrWhiteSpace(Model.ServiceRecord.Status))
                            {
                                <span class="info-sub">
                                    Status: @Model.ServiceRecord.Status
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Follow-up Information -->
        <div class="details-card">
            <div class="card-header">
                <div class="card-header-icon">
                    <i class="bi bi-chat-left-text"></i>
                </div>
                <div>
                    <h2>Follow-up Information</h2>
                    <p>Details about the customer communication.</p>
                </div>
            </div>

            <div class="info-list">
                <div class="info-item">
                    <div class="info-icon">
                        <i class="bi bi-tag"></i>
                    </div>
                    <div class="info-content">
                        <span class="info-label">Follow-up Type</span>
                        <span class="info-value">@Model.FollowUpType</span>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">
                        <i class="bi bi-card-text"></i>
                    </div>
                    <div class="info-content">
                        <span class="info-label">Subject</span>
                        <span class="info-value">@Model.Subject</span>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">
                        <i class="bi bi-circle-half"></i>
                    </div>
                    <div class="info-content">
                        <span class="info-label">Status</span>
                        <span class="status-badge @statusClass">
                            <span class="status-dot"></span>
                            @Model.Status
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Schedule -->
        <div class="details-card">
            <div class="card-header">
                <div class="card-header-icon">
                    <i class="bi bi-calendar-event"></i>
                </div>
                <div>
                    <h2>Schedule</h2>
                    <p>Follow-up dates and scheduling information.</p>
                </div>
            </div>

            <div class="schedule-grid">
                <div class="schedule-box">
                    <span class="schedule-label">Follow-up Date</span>
                    <div class="schedule-value">
                        <i class="bi bi-calendar-check"></i>
                        @Model.FollowUpDate.ToString("MMM dd, yyyy")
                    </div>
                    <span class="schedule-time">
                        @Model.FollowUpDate.ToString("hh:mm tt")
                    </span>
                </div>

                <div class="schedule-box">
                    <span class="schedule-label">Next Follow-up</span>

                    @if (Model.NextFollowUpDate.HasValue)
                    {
                        <div class="schedule-value">
                            <i class="bi bi-calendar-plus"></i>
                            @Model.NextFollowUpDate.Value.ToString("MMM dd, yyyy")
                        </div>
                        <span class="schedule-time">
                            @Model.NextFollowUpDate.Value.ToString("hh:mm tt")
                        </span>
                    }
                    else
                    {
                        <div class="schedule-value empty-value">
                            <i class="bi bi-dash-circle"></i>
                            Not scheduled
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Notes -->
        <div class="details-card">
            <div class="card-header">
                <div class="card-header-icon">
                    <i class="bi bi-journal-text"></i>
                </div>
                <div>
                    <h2>Notes</h2>
                    <p>Additional information recorded for this follow-up.</p>
                </div>
            </div>

            <div class="notes-box">
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <p>@Model.Notes</p>
                }
                else
                {
                    <div class="empty-notes">
                        <i class="bi bi-file-earmark-text"></i>
                        <span>No notes were recorded for this follow-up.</span>
                    </div>
                }
            </div>
        </div>

        <!-- Record Information -->
        <div class="details-card record-card">
            <div class="card-header">
                <div class="card-header-icon">
                    <i class="bi bi-info-circle"></i>
                </div>
                <div>
                    <h2>Record Information</h2>
                    <p>System information for this follow-up record.</p>
                </div>
            </div>

            <div class="record-grid">
                <div>
                    <span class="record-label">Follow-up ID</span>
                    <span class="record-value">#@Model.FollowUpId</span>
                </div>

                <div>
                    <span class="record-label">Created</span>
                    <span class="record-value">
                        @Model.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")
                    </span>
                </div>

                <div>
                    <span class="record-label">Last Updated</span>
                    <span class="record-value">
                        @Model.UpdatedAt.ToString("MMM dd, yyyy hh:mm tt")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="bottom-actions">
        <a asp-action="Index" class="btn btn-light">
            <i class="bi bi-arrow-left"></i>
            Back to Follow-ups
        </a>

        <div class="bottom-action-right">
            <a asp-action="Edit"
               asp-route-id="@Model.FollowUpId"
               class="btn btn-primary">
                <i class="bi bi-pencil-square"></i>
                Edit Follow-up
            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.FollowUpId"
               class="btn btn-danger">
                <i class="bi bi-trash3"></i>
                Delete
            </a>
        </div>
    </div>
</div>

<style>
    .page-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 28px 32px 40px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 24px;
        margin-bottom: 28px;
    }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
        color: #8b93a7;
        font-size: 13px;
        font-weight: 500;
    }

    .breadcrumb a {
        color: #6d5dfc;
        text-decoration: none;
    }

    .breadcrumb i {
        font-size: 10px;
    }

    .page-title-row {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .title-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f0edff;
        color: #6d5dfc;
        font-size: 22px;
        flex-shrink: 0;
    }

    .page-title-row h1 {
        margin: 0;
        color: #172033;
        font-size: 28px;
        font-weight: 700;
        letter-spacing: -0.4px;
    }

    .page-title-row p {
        margin: 4px 0 0;
        color: #7b8498;
        font-size: 14px;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: 0 16px;
        border-radius: 9px;
        border: 1px solid transparent;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: all .2s ease;
        cursor: pointer;
    }

    .btn-primary {
        background: #6d5dfc;
        border-color: #6d5dfc;
        color: #fff;
    }

    .btn-primary:hover {
        background: #5d4ce8;
        border-color: #5d4ce8;
        color: #fff;
        transform: translateY(-1px);
    }

    .btn-light {
        background: #fff;
        border-color: #e5e8ef;
        color: #465064;
    }

    .btn-light:hover {
        background: #f8f9fc;
        color: #293246;
    }

    .btn-danger {
        background: #fff;
        border-color: #f0c7cd;
        color: #d94a5b;
    }

    .btn-danger:hover {
        background: #fff4f5;
        border-color: #e6aeb6;
        color: #c83d4e;
    }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .details-card {
        background: #fff;
        border: 1px solid #e8eaf0;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(25, 32, 56, .03);
    }

    .card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px 22px;
        border-bottom: 1px solid #eef0f4;
    }

    .card-header-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f3f1ff;
        color: #6d5dfc;
        font-size: 17px;
        flex-shrink: 0;
    }

    .card-header h2 {
        margin: 0;
        color: #20283a;
        font-size: 15px;
        font-weight: 700;
    }

    .card-header p {
        margin: 3px 0 0;
        color: #8a92a4;
        font-size: 12px;
    }

    .info-list {
        padding: 4px 22px 12px;
    }

    .info-item {
        display: flex;
        gap: 13px;
        padding: 17px 0;
        border-bottom: 1px solid #f0f1f5;
    }

    .info-item:last-child {
        border-bottom: 0;
    }

    .info-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f7f7fb;
        color: #6d5dfc;
        font-size: 15px;
        flex-shrink: 0;
    }

    .info-content {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .info-label {
        color: #9299aa;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .info-value {
        color: #252d3d;
        font-size: 14px;
        font-weight: 600;
        word-break: break-word;
    }

    .info-sub {
        color: #7d8597;
        font-size: 12px;
    }

    .status-badge {
        width: fit-content;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        margin-top: 2px;
    }

    .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: currentColor;
    }

    .status-pending {
        background: #fff6df;
        color: #b77900;
    }

    .status-completed {
        background: #eaf8f0;
        color: #238653;
    }

    .status-cancelled {
        background: #fff0f2;
        color: #cc4b5c;
    }

    .status-overdue {
        background: #fff0f0;
        color: #d63d3d;
    }

    .schedule-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
        padding: 22px;
    }

    .schedule-box {
        border: 1px solid #eceef3;
        border-radius: 11px;
        padding: 17px;
        background: #fbfbfd;
    }

    .schedule-label {
        display: block;
        color: #8c94a6;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .45px;
        margin-bottom: 9px;
    }

    .schedule-value {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #283143;
        font-size: 14px;
        font-weight: 700;
    }

    .schedule-value i {
        color: #6d5dfc;
        font-size: 16px;
    }

    .schedule-time {
        display: block;
        color: #7d8597;
        font-size: 12px;
        margin-top: 5px;
        padding-left: 24px;
    }

    .empty-value {
        color: #8c94a6;
        font-weight: 500;
    }

    .notes-box {
        min-height: 130px;
        padding: 22px;
    }

    .notes-box p {
        margin: 0;
        color: #505a6d;
        font-size: 13px;
        line-height: 1.7;
        white-space: pre-wrap;
    }

    .empty-notes {
        min-height: 86px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 7px;
        color: #a0a6b4;
        font-size: 13px;
    }

    .empty-notes i {
        font-size: 24px;
        color: #c2c6d1;
    }

    .record-card {
        grid-column: 1 / -1;
    }

    .record-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
        padding: 22px;
    }

    .record-grid > div {
        min-width: 0;
    }

    .record-label {
        display: block;
        color: #9299aa;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-bottom: 6px;
    }

    .record-value {
        display: block;
        color: #313a4c;
        font-size: 13px;
        font-weight: 600;
        word-break: break-word;
    }

    .bottom-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-top: 22px;
    }

    .bottom-action-right {
        display: flex;
        gap: 10px;
    }

    @@media (max-width: 900px) {
        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .header-actions {
            width: 100%;
        }

        .header-actions .btn {
            flex: 1;
        }

        .details-grid {
            grid-template-columns: 1fr;
        }

        .record-card {
            grid-column: auto;
        }
    }

    @@media (max-width: 640px) {
        .page-container {
            padding: 20px 16px 30px;
        }

        .page-title-row h1 {
            font-size: 23px;
        }

        .page-title-row p {
            font-size: 13px;
        }

        .header-actions {
            flex-direction: column;
        }

        .header-actions .btn {
            width: 100%;
        }

        .schedule-grid,
        .record-grid {
            grid-template-columns: 1fr;
        }

        .bottom-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .bottom-action-right {
            flex-direction: column;
        }

        .bottom-actions .btn {
            width: 100%;
        }
    }
</style>