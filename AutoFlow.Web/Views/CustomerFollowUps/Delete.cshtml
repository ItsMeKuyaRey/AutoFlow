@model AutoFlow.Web.Models.CustomerFollowUp

@{
    ViewData["Title"] = "Delete Customer Follow-up";

    var customerName = Model.Customer == null
        ? "Unknown Customer"
        : $"{Model.Customer.FirstName} {Model.Customer.LastName}";

    var vehicleName = Model.Vehicle == null
        ? "Unknown Vehicle"
        : $"{Model.Vehicle.Make} {Model.Vehicle.Model} · {Model.Vehicle.PlateNumber}";
}

<div class="crm-delete-page">

    <div class="form-header">
        <div>
            <div class="breadcrumb-text">
                CRM <span>/</span> Customer Follow-ups <span>/</span> Delete
            </div>

            <h1>Delete Customer Follow-up</h1>

            <p class="page-description">
                Review the follow-up information before permanently deleting this CRM activity.
            </p>
        </div>

        <a asp-action="Index" class="btn-back">
            <i class="bi bi-arrow-left"></i>
            Back to Follow-ups
        </a>
    </div>

    <div class="delete-card">

        <div class="delete-warning">
            <div class="warning-icon">
                <i class="bi bi-exclamation-triangle"></i>
            </div>

            <div>
                <h2>Are you sure you want to delete this follow-up?</h2>

                <p>
                    This action permanently removes the selected customer follow-up
                    from the CRM records and cannot be undone.
                </p>
            </div>
        </div>

        <div class="followup-summary">

            <div class="summary-header">
                <div>
                    <span class="summary-label">FOLLOW-UP RECORD</span>

                    <h3>
                        @Model.Subject
                    </h3>
                </div>

                <span class="status-badge">
                    @Model.Status
                </span>
            </div>

            <div class="summary-grid">

                <div class="summary-item">
                    <div class="summary-icon">
                        <i class="bi bi-person"></i>
                    </div>

                    <div>
                        <span class="item-label">Customer</span>
                        <strong>@customerName</strong>

                        @if (!string.IsNullOrWhiteSpace(Model.Customer?.Phone))
                        {
                            <small>@Model.Customer.Phone</small>
                        }
                        else if (!string.IsNullOrWhiteSpace(Model.Customer?.Email))
                        {
                            <small>@Model.Customer.Email</small>
                        }
                    </div>
                </div>

                <div class="summary-item">
                    <div class="summary-icon">
                        <i class="bi bi-car-front"></i>
                    </div>

                    <div>
                        <span class="item-label">Vehicle</span>
                        <strong>@vehicleName</strong>

                        @if (Model.Vehicle != null && Model.Vehicle.Year.HasValue)
                        {
                            <small>@Model.Vehicle.Year</small>
                        }
                    </div>
                </div>

                <div class="summary-item">
                    <div class="summary-icon">
                        <i class="bi bi-chat-left-text"></i>
                    </div>

                    <div>
                        <span class="item-label">Follow-up Type</span>
                        <strong>@Model.FollowUpType</strong>
                    </div>
                </div>

                <div class="summary-item">
                    <div class="summary-icon">
                        <i class="bi bi-calendar-event"></i>
                    </div>

                    <div>
                        <span class="item-label">Follow-up Date</span>
                        <strong>
                            @Model.FollowUpDate.ToString("MMM dd, yyyy")
                        </strong>

                        <small>
                            @Model.FollowUpDate.ToString("hh:mm tt")
                        </small>
                    </div>
                </div>

                @if (Model.NextFollowUpDate.HasValue)
                {
                    <div class="summary-item">
                        <div class="summary-icon">
                            <i class="bi bi-calendar-plus"></i>
                        </div>

                        <div>
                            <span class="item-label">Next Follow-up</span>
                            <strong>
                                @Model.NextFollowUpDate.Value.ToString("MMM dd, yyyy")
                            </strong>

                            <small>
                                @Model.NextFollowUpDate.Value.ToString("hh:mm tt")
                            </small>
                        </div>
                    </div>
                }

                @if (Model.ServiceRecord != null)
                {
                    <div class="summary-item">
                        <div class="summary-icon">
                            <i class="bi bi-wrench-adjustable"></i>
                        </div>

                        <div>
                            <span class="item-label">Service Record</span>

                            <strong>
                                @Model.ServiceRecord.ServiceDate.ToString("MMM dd, yyyy")
                            </strong>

                            <small>
                                @(string.IsNullOrWhiteSpace(Model.ServiceRecord.Complaint)
                                    ? "Linked service record"
                                    : Model.ServiceRecord.Complaint)
                            </small>
                        </div>
                    </div>
                }

            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <div class="notes-section">

                    <span class="item-label">Notes</span>

                    <p>
                        @Model.Notes
                    </p>

                </div>
            }

        </div>

        <div class="delete-actions">

            <a asp-action="Details"
               asp-route-id="@Model.FollowUpId"
               class="btn-secondary">
                <i class="bi bi-eye"></i>
                View Details
            </a>

            <a asp-action="Index"
               class="btn-cancel">
                Cancel
            </a>

            <form asp-action="Delete"
                  asp-route-id="@Model.FollowUpId"
                  method="post"
                  class="delete-form">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn-delete"
                        onclick="return confirm('Are you sure you want to permanently delete this customer follow-up?');">
                    <i class="bi bi-trash3"></i>
                    Delete Follow-up
                </button>

            </form>

        </div>

    </div>

</div>

<style>
    .crm-delete-page {
        padding: 8px 4px 32px;
        color: #1f2937;
    }

    .form-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 28px;
    }

    .breadcrumb-text {
        color: #8b5cf6;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .breadcrumb-text span {
        color: #9ca3af;
        margin: 0 5px;
    }

    .form-header h1 {
        margin: 0;
        color: #111827;
        font-size: 30px;
        font-weight: 700;
        letter-spacing: -.6px;
    }

    .page-description {
        margin: 8px 0 0;
        color: #6b7280;
        font-size: 14px;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 41px;
        padding: 0 15px;
        border: 1px solid #e5e7eb;
        border-radius: 9px;
        background: #fff;
        color: #6b7280;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
        transition: all .2s ease;
    }

    .btn-back:hover {
        border-color: #c4b5fd;
        background: #f5f3ff;
        color: #7c3aed;
    }

    .delete-card {
        overflow: hidden;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 3px 12px rgba(15, 23, 42, .04);
    }

    .delete-warning {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 20px;
        border-bottom: 1px solid #fee2e2;
        background: #fffafa;
    }

    .warning-icon {
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #fef2f2;
        color: #dc2626;
        font-size: 18px;
    }

    .delete-warning h2 {
        margin: 1px 0 4px;
        color: #991b1b;
        font-size: 15px;
        font-weight: 700;
    }

    .delete-warning p {
        max-width: 720px;
        margin: 0;
        color: #7f1d1d;
        font-size: 11px;
        line-height: 1.55;
    }

    .followup-summary {
        padding: 22px;
    }

    .summary-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 20px;
    }

    .summary-label {
        display: block;
        margin-bottom: 5px;
        color: #9ca3af;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .8px;
    }

    .summary-header h3 {
        margin: 0;
        color: #111827;
        font-size: 19px;
        font-weight: 700;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 27px;
        padding: 0 10px;
        border-radius: 999px;
        background: #f5f3ff;
        color: #7c3aed;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

    .summary-item {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        min-width: 0;
        padding: 14px;
        border: 1px solid #f1f5f9;
        border-radius: 10px;
        background: #fafafa;
    }

    .summary-icon {
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #f5f3ff;
        color: #7c3aed;
        font-size: 14px;
    }

    .item-label {
        display: block;
        margin-bottom: 4px;
        color: #9ca3af;
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .4px;
    }

    .summary-item strong {
        display: block;
        overflow: hidden;
        color: #374151;
        font-size: 11px;
        font-weight: 700;
        line-height: 1.45;
        text-overflow: ellipsis;
    }

    .summary-item small {
        display: block;
        margin-top: 2px;
        overflow: hidden;
        color: #9ca3af;
        font-size: 9px;
        line-height: 1.4;
        text-overflow: ellipsis;
    }

    .notes-section {
        margin-top: 14px;
        padding: 15px;
        border: 1px solid #f1f5f9;
        border-radius: 10px;
        background: #fafafa;
    }

    .notes-section p {
        margin: 5px 0 0;
        color: #6b7280;
        font-size: 11px;
        line-height: 1.6;
        white-space: pre-wrap;
    }

    .delete-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 9px;
        padding: 17px 22px;
        border-top: 1px solid #f1f5f9;
        background: #fcfcfd;
    }

    .delete-form {
        margin: 0;
    }

    .btn-secondary,
    .btn-cancel,
    .btn-delete {
        min-height: 40px;
        padding: 0 15px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: all .2s ease;
    }

    .btn-secondary {
        border: 1px solid #e5e7eb;
        background: #fff;
        color: #6b7280;
    }

    .btn-secondary:hover {
        border-color: #c4b5fd;
        background: #f5f3ff;
        color: #7c3aed;
    }

    .btn-cancel {
        border: 1px solid #e5e7eb;
        background: #fff;
        color: #6b7280;
    }

    .btn-cancel:hover {
        background: #f9fafb;
        color: #374151;
    }

    .btn-delete {
        border: 1px solid #dc2626;
        background: #dc2626;
        color: #fff;
    }

    .btn-delete:hover {
        border-color: #b91c1c;
        background: #b91c1c;
        box-shadow: 0 5px 14px rgba(220, 38, 38, .15);
        transform: translateY(-1px);
    }

    @@media (max-width: 900px) {
        .form-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 650px) {
        .crm-delete-page {
            padding: 4px 0 24px;
        }

        .form-header h1 {
            font-size: 24px;
        }

        .delete-warning {
            padding: 16px;
        }

        .followup-summary {
            padding: 16px;
        }

        .summary-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .summary-grid {
            grid-template-columns: 1fr;
        }

        .delete-actions {
            align-items: stretch;
            flex-direction: column;
            padding: 16px;
        }

        .btn-secondary,
        .btn-cancel,
        .btn-delete,
        .delete-form {
            width: 100%;
        }

        .delete-form {
            display: block;
        }
    }
</style>