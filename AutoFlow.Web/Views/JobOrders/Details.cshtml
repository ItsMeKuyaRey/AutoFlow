@model AutoFlow.Web.Models.JobOrder

@{
    ViewData["Title"] = "Job Order Details";

    var badgeClass = Model.Status switch
    {
        "Open" => "badge-blue",
        "In Progress" => "badge-orange",
        "Completed" => "badge-green",
        "Cancelled" => "badge-red",
        _ => "badge-blue"
    };

    var partsTotal = Model.JobOrderParts?
        .Sum(jp => jp.Quantity * jp.UnitPriceAtTimeOfUse) ?? 0;

    var partsCount = Model.JobOrderParts?.Sum(jp => jp.Quantity) ?? 0;
}

<style>
    .job-detail-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 330px;
        gap: 22px;
        align-items: start;
    }

    .job-detail-card {
        background: var(--af-surface);
        border: 1px solid var(--af-border);
        border-radius: 12px;
        padding: 26px;
        margin-bottom: 22px;
        box-shadow: var(--af-shadow);
    }

    .job-detail-card:last-child {
        margin-bottom: 0;
    }

    .job-card-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        margin-bottom: 20px;
    }

    .job-card-heading-left {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .job-card-icon {
        width: 38px;
        height: 38px;
        border-radius: 9px;
        background: var(--af-bg);
        border: 1px solid var(--af-border);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .job-card-heading h2 {
        font-size: 0.98rem;
        font-weight: 650;
        margin: 0;
    }

    .job-info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .job-info-label {
        display: block;
        color: var(--af-text-muted);
        font-size: 0.74rem;
        margin-bottom: 5px;
    }

    .job-info-value {
        font-weight: 600;
    }

    .job-info-sub {
        display: block;
        color: var(--af-text-muted);
        font-size: 0.78rem;
        margin-top: 3px;
    }

    .repair-field {
        margin-bottom: 20px;
    }

    .repair-field:last-child {
        margin-bottom: 0;
    }

    .repair-field-label {
        color: var(--af-text-muted);
        font-size: 0.75rem;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .repair-field-value {
        line-height: 1.6;
        white-space: pre-wrap;
    }

    .empty-text {
        color: var(--af-text-muted);
        margin: 0;
        font-size: 0.86rem;
    }

    .parts-summary {
        display: flex;
        gap: 8px;
        align-items: center;
        color: var(--af-text-secondary);
        font-size: 0.78rem;
    }

    .parts-table td,
    .parts-table th {
        vertical-align: middle;
    }

    .remove-part-button {
        background: transparent;
        border: 0;
        color: var(--af-danger);
        cursor: pointer;
        font-size: 12px;
        padding: 5px 7px;
    }

    .remove-part-button:hover {
        text-decoration: underline;
    }

    .cost-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
    }

    .cost-box {
        padding: 17px;
        border: 1px solid var(--af-border);
        border-radius: 10px;
        background: var(--af-bg);
    }

    .cost-label {
        color: var(--af-text-muted);
        font-size: 0.75rem;
        margin-bottom: 6px;
    }

    .cost-value {
        font-weight: 700;
        font-size: 1.1rem;
    }

    .cost-total {
        font-size: 1.35rem;
        color: var(--af-primary);
    }

    .side-detail {
        margin-bottom: 18px;
    }

    .side-detail:last-child {
        margin-bottom: 0;
    }

    .side-label {
        display: block;
        color: var(--af-text-muted);
        font-size: 0.73rem;
        margin-bottom: 4px;
    }

    .side-value {
        font-weight: 600;
        line-height: 1.5;
    }

    .side-divider {
        border-top: 1px solid var(--af-border);
        margin: 20px 0;
    }

    .job-footer-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 22px;
    }

    @@media (max-width: 1050px) {
        .job-detail-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .job-info-grid,
        .cost-grid {
            grid-template-columns: 1fr;
        }

        .job-card-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .job-card-heading .af-button {
            width: 100%;
        }

        .job-footer-actions {
            flex-direction: column;
        }

        .job-footer-actions .af-button {
            width: 100%;
        }
    }
</style>

<div class="dashboard-page">

    <div class="page-header">

        <div>
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:5px;">
                <h1 style="margin:0;">
                    Job Order #@Model.JobOrderId
                </h1>

                <span class="af-badge @badgeClass">
                    @Model.Status
                </span>
            </div>

            <p>
                Repair workspace containing service information, vehicle details,
                parts usage, and cost summary.
            </p>
        </div>

        <div class="page-header-actions">

            <a asp-action="Edit"
               asp-route-id="@Model.JobOrderId"
               class="af-button af-button-primary">
                Edit Job
            </a>

            <a asp-action="Index"
               class="af-button af-button-secondary">
                Back
            </a>

        </div>

    </div>

    <div class="job-detail-grid">

        <!-- LEFT COLUMN -->
        <div>

            <!-- JOB INFORMATION -->
            <div class="job-detail-card">

                <div class="job-card-heading">
                    <div class="job-card-heading-left">
                        <div class="job-card-icon">🔧</div>

                        <h2>Job Order Information</h2>
                    </div>
                </div>

                <div class="job-info-grid">

                    <div>
                        <span class="job-info-label">
                            Job Order ID
                        </span>

                        <span class="job-info-value">
                            #@Model.JobOrderId
                        </span>
                    </div>

                    <div>
                        <span class="job-info-label">
                            Status
                        </span>

                        <span class="af-badge @badgeClass">
                            @Model.Status
                        </span>
                    </div>

                    <div>
                        <span class="job-info-label">
                            Job Order Date
                        </span>

                        <span class="job-info-value">
                            @Model.JobOrderDate.ToString("MMM dd, yyyy")
                        </span>

                        <span class="job-info-sub">
                            @Model.JobOrderDate.ToString("hh:mm tt")
                        </span>
                    </div>

                    <div>
                        <span class="job-info-label">
                            Created
                        </span>

                        <span class="job-info-value">
                            @Model.CreatedAt.ToString("MMM dd, yyyy")
                        </span>
                    </div>

                </div>

            </div>

            <!-- REPAIR INFORMATION -->
            <div class="job-detail-card">

                <div class="job-card-heading">
                    <div class="job-card-heading-left">
                        <div class="job-card-icon">📝</div>

                        <h2>Repair Information</h2>
                    </div>
                </div>

                <div class="repair-field">

                    <div class="repair-field-label">
                        Repair Description
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <div class="repair-field-value">
                            @Model.Description
                        </div>
                    }
                    else
                    {
                        <p class="empty-text">
                            No repair description provided.
                        </p>
                    }

                </div>

                <div class="repair-field">

                    <div class="repair-field-label">
                        Diagnosis
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Diagnosis))
                    {
                        <div class="repair-field-value">
                            @Model.Diagnosis
                        </div>
                    }
                    else
                    {
                        <p class="empty-text">
                            No diagnosis recorded.
                        </p>
                    }

                </div>

                <div class="repair-field">

                    <div class="repair-field-label">
                        Additional Notes
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <div class="repair-field-value">
                            @Model.Notes
                        </div>
                    }
                    else
                    {
                        <p class="empty-text">
                            No additional notes.
                        </p>
                    }

                </div>

            </div>

            <!-- PARTS -->
            <div class="job-detail-card">

                <div class="job-card-heading">

                    <div class="job-card-heading-left">
                        <div class="job-card-icon">📦</div>

                        <div>
                            <h2>Parts Used</h2>

                            <div class="parts-summary">
                                @partsCount item(s) used
                            </div>
                        </div>
                    </div>

                    <a asp-action="AddPart"
                       asp-route-id="@Model.JobOrderId"
                       class="af-button af-button-primary"
                       style="padding:7px 13px; font-size:12px;">
                        + Add Part
                    </a>

                </div>

                @if (Model.JobOrderParts == null || !Model.JobOrderParts.Any())
                {
                    <div style="padding:24px;
                                border:1px dashed var(--af-border);
                                border-radius:9px;
                                text-align:center;">

                        <div style="font-size:1.6rem; margin-bottom:8px;">
                            📦
                        </div>

                        <strong style="display:block; margin-bottom:4px;">
                            No Parts Added
                        </strong>

                        <span style="color:var(--af-text-muted);
                                     font-size:0.82rem;">
                            Parts consumed during this repair will appear here.
                        </span>

                    </div>
                }
                else
                {
                    <div class="af-table-wrapper">

                        <table class="af-table parts-table">

                            <thead>
                                <tr>
                                    <th>Part</th>
                                    <th>Qty</th>
                                    <th>Unit Price</th>
                                    <th>Subtotal</th>
                                    <th></th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var jp in Model.JobOrderParts)
                                {
                                    <tr>

                                        <td>
                                            <strong>
                                                @jp.Part?.Name
                                            </strong>
                                        </td>

                                        <td>
                                            @jp.Quantity
                                        </td>

                                        <td>
                                            @jp.UnitPriceAtTimeOfUse.ToString("C")
                                        </td>

                                        <td>
                                            <strong>
                                                @((jp.Quantity * jp.UnitPriceAtTimeOfUse).ToString("C"))
                                            </strong>
                                        </td>

                                        <td>
                                            <form asp-action="RemovePart"
                                                  method="post"
                                                  style="display:inline;">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="jobOrderPartId"
                                                       value="@jp.JobOrderPartId" />

                                                <input type="hidden"
                                                       name="jobOrderId"
                                                       value="@Model.JobOrderId" />

                                                <button type="submit"
                                                        class="remove-part-button"
                                                        onclick="return confirm('Remove this part and restore stock?');">
                                                    Remove
                                                </button>

                                            </form>
                                        </td>

                                    </tr>
                                }

                            </tbody>

                            <tfoot>

                                <tr>
                                    <td colspan="3"
                                        style="text-align:right; font-weight:600;">
                                        Parts Total
                                    </td>

                                    <td colspan="2">
                                        <strong>
                                            @partsTotal.ToString("C")
                                        </strong>
                                    </td>
                                </tr>

                            </tfoot>

                        </table>

                    </div>
                }

            </div>

            <!-- COST SUMMARY -->
            <div class="job-detail-card">

                <div class="job-card-heading">
                    <div class="job-card-heading-left">
                        <div class="job-card-icon">₱</div>

                        <h2>Cost Summary</h2>
                    </div>
                </div>

                <div class="cost-grid">

                    <div class="cost-box">
                        <div class="cost-label">
                            Labor Cost
                        </div>

                        <div class="cost-value">
                            @Model.LaborCost.ToString("C")
                        </div>
                    </div>

                    <div class="cost-box">
                        <div class="cost-label">
                            Parts Cost
                        </div>

                        <div class="cost-value">
                            @Model.PartsCost.ToString("C")
                        </div>
                    </div>

                    <div class="cost-box">
                        <div class="cost-label">
                            Total Job Cost
                        </div>

                        <div class="cost-value cost-total">
                            @Model.TotalCost.ToString("C")
                        </div>
                    </div>

                </div>

            </div>

        </div>

        <!-- RIGHT COLUMN -->
        <div>

            <!-- VEHICLE -->
            <div class="job-detail-card">

                <div class="job-card-heading">
                    <div class="job-card-heading-left">
                        <div class="job-card-icon">🚗</div>

                        <h2>Vehicle</h2>
                    </div>
                </div>

                @if (Model.Vehicle != null)
                {
                    <div class="side-detail">
                        <span class="side-label">
                            Plate Number
                        </span>

                        <span class="side-value">
                            @Model.Vehicle.PlateNumber
                        </span>
                    </div>

                    <div class="side-detail">
                        <span class="side-label">
                            Vehicle
                        </span>

                        <span class="side-value">
                            @Model.Vehicle.Make @Model.Vehicle.Model
                        </span>
                    </div>

                    @if (Model.Vehicle.Year.HasValue)
                    {
                        <div class="side-detail">
                            <span class="side-label">
                                Year
                            </span>

                            <span class="side-value">
                                @Model.Vehicle.Year
                            </span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Vehicle.Color))
                    {
                        <div class="side-detail">
                            <span class="side-label">
                                Color
                            </span>

                            <span class="side-value">
                                @Model.Vehicle.Color
                            </span>
                        </div>
                    }
                }
                else
                {
                    <p class="empty-text">
                        Vehicle information unavailable.
                    </p>
                }

            </div>

            <!-- CUSTOMER -->
            <div class="job-detail-card">

                <div class="job-card-heading">
                    <div class="job-card-heading-left">
                        <div class="job-card-icon">👤</div>

                        <h2>Customer</h2>
                    </div>
                </div>

                @if (Model.Vehicle?.Customer != null)
                {
                    <div class="side-detail">

                        <span class="side-label">
                            Customer Name
                        </span>

                        <span class="side-value">
                            @Model.Vehicle.Customer.FirstName
                            @Model.Vehicle.Customer.LastName
                        </span>

                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Vehicle.Customer.Phone))
                    {
                        <div class="side-detail">

                            <span class="side-label">
                                Phone
                            </span>

                            <span class="side-value">
                                @Model.Vehicle.Customer.Phone
                            </span>

                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Vehicle.Customer.Email))
                    {
                        <div class="side-detail">

                            <span class="side-label">
                                Email
                            </span>

                            <span class="side-value">
                                @Model.Vehicle.Customer.Email
                            </span>

                        </div>
                    }
                }
                else
                {
                    <p class="empty-text">
                        Customer information unavailable.
                    </p>
                }

            </div>

            <!-- APPOINTMENT -->
            <div class="job-detail-card">

                <div class="job-card-heading">
                    <div class="job-card-heading-left">
                        <div class="job-card-icon">📅</div>

                        <h2>Appointment</h2>
                    </div>
                </div>

                @if (Model.Appointment != null)
                {
                    <div class="side-detail">

                        <span class="side-label">
                            Appointment Date
                        </span>

                        <span class="side-value">
                            @Model.Appointment.AppointmentDate.ToString("MMM dd, yyyy")
                        </span>

                        <span class="job-info-sub">
                            @Model.Appointment.AppointmentDate.ToString("hh:mm tt")
                        </span>

                    </div>

                    <div class="side-detail">

                        <span class="side-label">
                            Status
                        </span>

                        <span class="af-badge badge-blue">
                            @Model.Appointment.Status
                        </span>

                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Appointment.CustomerConcern))
                    {
                        <div class="side-detail">

                            <span class="side-label">
                                Customer Concern
                            </span>

                            <span class="side-value">
                                @Model.Appointment.CustomerConcern
                            </span>

                        </div>
                    }
                }
                else
                {
                    <p class="empty-text">
                        No appointment linked to this job.
                    </p>
                }

            </div>

        </div>

    </div>

    <div class="job-footer-actions">

        <a asp-action="Edit"
           asp-route-id="@Model.JobOrderId"
           class="af-button af-button-primary">
            Edit Job Order
        </a>

        <a asp-action="AddPart"
           asp-route-id="@Model.JobOrderId"
           class="af-button af-button-secondary">
            + Add Part
        </a>

        <a asp-action="Delete"
           asp-route-id="@Model.JobOrderId"
           class="af-button af-button-secondary">
            Delete
        </a>

    </div>

</div>