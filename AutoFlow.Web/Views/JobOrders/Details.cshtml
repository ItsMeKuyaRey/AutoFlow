@model AutoFlow.Web.Models.JobOrder

@{
    ViewData["Title"] = "Job Order Details";
}

<div class="dashboard-page">

    <div class="page-header">
        <div>
            <h1>Job Order #@Model.JobOrderId</h1>
            <p>View repair job information and service details.</p>
        </div>
        <div class="page-header-actions">
            <a asp-action="Edit" asp-route-id="@Model.JobOrderId"
               class="af-button af-button-primary">
                Edit
            </a>
            <a asp-action="Index" class="af-button af-button-secondary">
                Back
            </a>
        </div>
    </div>

    <div style="display:grid; grid-template-columns:1fr 340px; gap:24px; align-items:start;">

        <!-- LEFT COLUMN -->
        <div>

            <!-- Job Order Info -->
            <div class="af-card" style="padding:28px; margin-bottom:24px;">
                <h2 style="font-size:1rem; font-weight:600; margin-bottom:20px;">Job Order Information</h2>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                    <div>
                        <small style="color:var(--af-text-muted); display:block;">Job Order ID</small>
                        <strong>#@Model.JobOrderId</strong>
                    </div>
                    <div>
                        <small style="color:var(--af-text-muted); display:block;">Status</small>
                        @{
                            var badgeClass = Model.Status switch
                            {
                                "Open" => "badge-blue",
                                "In Progress" => "badge-orange",
                                "Completed" => "badge-green",
                                "Cancelled" => "badge-red",
                                _ => "badge-blue"
                            };
                        }
                        <span class="af-badge @badgeClass">@Model.Status</span>
                    </div>
                    <div>
                        <small style="color:var(--af-text-muted); display:block;">Job Order Date</small>
                        <strong>@Model.JobOrderDate.ToString("MMM dd, yyyy")</strong>
                        <small style="display:block; color:var(--af-text-muted);">@Model.JobOrderDate.ToString("hh:mm tt")</small>
                    </div>
                    <div>
                        <small style="color:var(--af-text-muted); display:block;">Created</small>
                        <span>@Model.CreatedAt.ToString("MMM dd, yyyy")</span>
                    </div>
                </div>
            </div>

            <!-- Repair Info -->
            <div class="af-card" style="padding:28px; margin-bottom:24px;">
                <h2 style="font-size:1rem; font-weight:600; margin-bottom:20px;">Repair Information</h2>

                <div style="margin-bottom:16px;">
                    <small style="color:var(--af-text-muted); display:block; margin-bottom:4px;">Description</small>
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p style="margin:0;">@Model.Description</p>
                    }
                    else
                    {
                        <span style="color:var(--af-text-muted);">No description provided.</span>
                    }
                </div>

                <div style="margin-bottom:16px;">
                    <small style="color:var(--af-text-muted); display:block; margin-bottom:4px;">Diagnosis</small>
                    @if (!string.IsNullOrWhiteSpace(Model.Diagnosis))
                    {
                        <p style="margin:0;">@Model.Diagnosis</p>
                    }
                    else
                    {
                        <span style="color:var(--af-text-muted);">No diagnosis recorded.</span>
                    }
                </div>

                <div>
                    <small style="color:var(--af-text-muted); display:block; margin-bottom:4px;">Notes</small>
                    @if (!string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <p style="margin:0;">@Model.Notes</p>
                    }
                    else
                    {
                        <span style="color:var(--af-text-muted);">No additional notes.</span>
                    }
                </div>
            </div>

            <!-- Parts Used -->
            <div class="af-card" style="padding:28px; margin-bottom:24px;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
                    <h2 style="font-size:1rem; font-weight:600; margin:0;">Parts Used</h2>
                    <a asp-action="AddPart" asp-route-id="@Model.JobOrderId"
                       class="af-button af-button-primary" style="padding:6px 14px; font-size:12px;">
                        + Add Part
                    </a>
                </div>

                @if (!Model.JobOrderParts.Any())
                {
                    <p style="color:var(--af-text-muted); margin:0;">No parts have been added to this job order yet.</p>
                }
                else
                {
                    <div class="af-table-wrapper">
                        <table class="af-table">
                            <thead>
                                <tr>
                                    <th>Part</th>
                                    <th>Qty</th>
                                    <th>Unit Price</th>
                                    <th>Subtotal</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var jp in Model.JobOrderParts)
                                {
                                    <tr>
                                        <td><strong>@jp.Part?.Name</strong></td>
                                        <td>@jp.Quantity</td>
                                        <td>@jp.UnitPriceAtTimeOfUse.ToString("C")</td>
                                        <td><strong>@((jp.Quantity * jp.UnitPriceAtTimeOfUse).ToString("C"))</strong></td>
                                        <td>
                                            <form asp-action="RemovePart" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="jobOrderPartId" value="@jp.JobOrderPartId" />
                                                <input type="hidden" name="jobOrderId" value="@Model.JobOrderId" />
                                                <button type="submit"
                                                        onclick="return confirm('Remove this part and restore stock?');"
                                                        style="background:none; border:none; color:var(--af-danger); cursor:pointer; font-size:12px; padding:4px 8px;">
                                                    Remove
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" style="text-align:right; font-weight:600;">Parts Total</td>
                                    <td colspan="2"><strong>@Model.JobOrderParts.Sum(jp => jp.Quantity * jp.UnitPriceAtTimeOfUse).ToString("C")</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>

            <!-- Cost Summary -->
            <div class="af-card" style="padding:28px; margin-bottom:24px;">
                <h2 style="font-size:1rem; font-weight:600; margin-bottom:20px;">Cost Summary</h2>
                <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:20px;">
                    <div>
                        <small style="color:var(--af-text-muted); display:block;">Labor Cost</small>
                        <strong style="font-size:1.1rem;">@Model.LaborCost.ToString("C")</strong>
                    </div>
                    <div>
                        <small style="color:var(--af-text-muted); display:block;">Parts Cost</small>
                        <strong style="font-size:1.1rem;">@Model.PartsCost.ToString("C")</strong>
                    </div>
                    <div>
                        <small style="color:var(--af-text-muted); display:block;">Total Cost</small>
                        <strong style="font-size:1.25rem; color:var(--af-primary);">@Model.TotalCost.ToString("C")</strong>
                    </div>
                </div>
            </div>

        </div>

        <!-- RIGHT COLUMN -->
        <div>

            <!-- Vehicle -->
            <div class="af-card" style="padding:28px; margin-bottom:24px;">
                <h2 style="font-size:1rem; font-weight:600; margin-bottom:20px;">Vehicle</h2>
                @if (Model.Vehicle != null)
                {
                    <div style="margin-bottom:12px;">
                        <small style="color:var(--af-text-muted); display:block;">Plate Number</small>
                        <strong style="font-size:1.1rem;">@Model.Vehicle.PlateNumber</strong>
                    </div>
                    <div style="margin-bottom:12px;">
                        <small style="color:var(--af-text-muted); display:block;">Vehicle</small>
                        <span>@Model.Vehicle.Make @Model.Vehicle.Model</span>
                    </div>
                    @if (Model.Vehicle.Year.HasValue)
                    {
                        <div style="margin-bottom:12px;">
                            <small style="color:var(--af-text-muted); display:block;">Year</small>
                            <span>@Model.Vehicle.Year</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Vehicle.Color))
                    {
                        <div>
                            <small style="color:var(--af-text-muted); display:block;">Color</small>
                            <span>@Model.Vehicle.Color</span>
                        </div>
                    }
                }
                else
                {
                    <p style="color:var(--af-text-muted); margin:0;">Vehicle information unavailable.</p>
                }
            </div>

            <!-- Customer -->
            <div class="af-card" style="padding:28px; margin-bottom:24px;">
                <h2 style="font-size:1rem; font-weight:600; margin-bottom:20px;">Customer</h2>
                @if (Model.Vehicle?.Customer != null)
                {
                    <div style="margin-bottom:12px;">
                        <small style="color:var(--af-text-muted); display:block;">Name</small>
                        <strong>@Model.Vehicle.Customer.FirstName @Model.Vehicle.Customer.LastName</strong>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Vehicle.Customer.Phone))
                    {
                        <div style="margin-bottom:12px;">
                            <small style="color:var(--af-text-muted); display:block;">Phone</small>
                            <span>@Model.Vehicle.Customer.Phone</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Vehicle.Customer.Email))
                    {
                        <div>
                            <small style="color:var(--af-text-muted); display:block;">Email</small>
                            <span>@Model.Vehicle.Customer.Email</span>
                        </div>
                    }
                }
                else
                {
                    <p style="color:var(--af-text-muted); margin:0;">Customer information unavailable.</p>
                }
            </div>

            <!-- Appointment -->
            <div class="af-card" style="padding:28px;">
                <h2 style="font-size:1rem; font-weight:600; margin-bottom:20px;">Appointment</h2>
                @if (Model.Appointment != null)
                {
                    <div style="margin-bottom:12px;">
                        <small style="color:var(--af-text-muted); display:block;">Appointment Date</small>
                        <strong>@Model.Appointment.AppointmentDate.ToString("MMM dd, yyyy")</strong>
                        <small style="display:block; color:var(--af-text-muted);">@Model.Appointment.AppointmentDate.ToString("hh:mm tt")</small>
                    </div>
                    <div style="margin-bottom:12px;">
                        <small style="color:var(--af-text-muted); display:block;">Status</small>
                        <span class="af-badge badge-blue">@Model.Appointment.Status</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Appointment.CustomerConcern))
                    {
                        <div>
                            <small style="color:var(--af-text-muted); display:block;">Customer Concern</small>
                            <p style="margin:4px 0 0 0;">@Model.Appointment.CustomerConcern</p>
                        </div>
                    }
                }
                else
                {
                    <p style="color:var(--af-text-muted); margin:0;">No appointment linked to this job.</p>
                }
            </div>

        </div>

    </div>

    <!-- Footer Actions -->
    <div style="margin-top:24px; display:flex; gap:12px;">
        <a asp-action="Edit" asp-route-id="@Model.JobOrderId"
           class="af-button af-button-primary">
            Edit Job Order
        </a>
        <a asp-action="Delete" asp-route-id="@Model.JobOrderId"
           class="af-button af-button-secondary">
            Delete
        </a>
    </div>

</div>
