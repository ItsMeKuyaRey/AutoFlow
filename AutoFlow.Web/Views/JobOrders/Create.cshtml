@model AutoFlow.Web.Models.JobOrder

@{
    ViewData["Title"] = "Create Job Order";
}

<style>
    .job-form-card {
        max-width: 980px;
    }

    .job-form-section {
        margin-bottom: 30px;
    }

    .job-form-section:last-of-type {
        margin-bottom: 0;
    }

    .job-section-heading {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 20px;
    }

    .job-section-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: var(--af-bg);
        border: 1px solid var(--af-border);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .job-section-heading h2 {
        font-size: 1rem;
        font-weight: 650;
        margin: 0 0 4px;
    }

    .job-section-heading p {
        margin: 0;
        color: var(--af-text-secondary);
        font-size: 0.84rem;
    }

    .job-form-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 22px;
        margin-top: 30px;
        border-top: 1px solid var(--af-border);
    }

    @@media (max-width: 768px) {
        .job-form-footer {
            flex-direction: column-reverse;
        }

        .job-form-footer .af-button {
            width: 100%;
        }
    }
</style>

<div class="dashboard-page">

    <div class="page-header">
        <div>
            <h1>Create Job Order</h1>
            <p>Create a repair job and connect it to the customer's vehicle and appointment.</p>
        </div>

        <div class="page-header-actions">
            <a asp-action="Index" class="af-button af-button-secondary">
                Back to Repair Jobs
            </a>
        </div>
    </div>

    <div class="af-card job-form-card" style="padding:30px;">

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

            <div class="job-form-section">

                <div class="job-section-heading">
                    <div class="job-section-icon">🔧</div>
                    <div>
                        <h2>Job Information</h2>
                        <p>Define the vehicle, appointment, date, and current repair status.</p>
                    </div>
                </div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="VehicleId" class="form-label fw-semibold">
                            Vehicle
                        </label>

                        <select asp-for="VehicleId"
                                class="form-select"
                                asp-items="ViewBag.VehicleId">
                            <option value="">-- Select Vehicle --</option>
                        </select>

                        <span asp-validation-for="VehicleId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AppointmentId" class="form-label fw-semibold">
                            Appointment
                        </label>

                        <select asp-for="AppointmentId"
                                class="form-select"
                                asp-items="ViewBag.AppointmentId">
                            <option value="">-- No Appointment --</option>
                        </select>

                        <span asp-validation-for="AppointmentId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="JobOrderDate" class="form-label fw-semibold">
                            Job Order Date
                        </label>

                        <input asp-for="JobOrderDate"
                               type="datetime-local"
                               class="form-control" />

                        <span asp-validation-for="JobOrderDate" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label fw-semibold">
                            Status
                        </label>

                        <select asp-for="Status" class="form-select">
                            <option value="Open">Open</option>
                            <option value="In Progress">In Progress</option>
                            <option value="Completed">Completed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>

                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LaborCost" class="form-label fw-semibold">
                            Labor Cost
                        </label>

                        <div class="input-group">
                            <span class="input-group-text">₱</span>
                            <input asp-for="LaborCost"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control" />
                        </div>

                        <span asp-validation-for="LaborCost" class="text-danger"></span>
                    </div>

                </div>

            </div>

            <div class="job-form-section">

                <div class="job-section-heading">
                    <div class="job-section-icon">📝</div>
                    <div>
                        <h2>Repair Details</h2>
                        <p>Record the repair request, diagnosis, and relevant service notes.</p>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold">
                        Repair Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Describe the customer's repair request or reported problem..."></textarea>

                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Diagnosis" class="form-label fw-semibold">
                        Diagnosis
                    </label>

                    <textarea asp-for="Diagnosis"
                              class="form-control"
                              rows="4"
                              placeholder="Enter the technician's diagnosis or findings..."></textarea>

                    <span asp-validation-for="Diagnosis" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="Notes" class="form-label fw-semibold">
                        Additional Notes
                    </label>

                    <textarea asp-for="Notes"
                              class="form-control"
                              rows="3"
                              placeholder="Add instructions, observations, or other important notes..."></textarea>

                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>

            </div>

            <div class="job-form-footer">
                <a asp-action="Index" class="af-button af-button-secondary">
                    Cancel
                </a>

                <button type="submit" class="af-button af-button-primary">
                    Create Job Order
                </button>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}