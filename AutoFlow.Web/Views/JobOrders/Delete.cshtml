@model AutoFlow.Web.Models.JobOrder

@{
    ViewData["Title"] = "Delete Job Order";
}

<div class="dashboard-page">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div>
            <h1>Delete Job Order</h1>
            <p>Confirm that you want to remove this repair job from the system.</p>
        </div>

        <div class="page-header-actions">
            <a asp-action="Index"
               class="af-button af-button-secondary">
                Back to Repair Jobs
            </a>
        </div>
    </div>


    <!-- DELETE CONFIRMATION -->
    <div class="af-card"
         style="max-width:720px; padding:28px;">

        <div style="text-align:center; padding:20px 10px 28px;">

            <div style="font-size:3rem; margin-bottom:16px;">
                ⚠️
            </div>

            <h2 style="font-size:1.3rem; font-weight:600; margin-bottom:8px;">
                Delete Job Order #@Model.JobOrderId?
            </h2>

            <p style="color:var(--af-text-secondary); margin:0;">
                This action cannot be undone. Are you sure you want to delete
                this repair job?
            </p>

        </div>


        <!-- JOB SUMMARY -->
        <div style="border:1px solid var(--af-border); border-radius:8px; padding:20px; margin-bottom:24px;">

            <div style="display:flex; justify-content:space-between; padding:10px 0; border-bottom:1px solid var(--af-border);">

                <span style="color:var(--af-text-secondary);">
                    Job Order
                </span>

                <strong>
                    #@Model.JobOrderId
                </strong>

            </div>


            <div style="display:flex; justify-content:space-between; padding:10px 0; border-bottom:1px solid var(--af-border);">

                <span style="color:var(--af-text-secondary);">
                    Date
                </span>

                <strong>
                    @Model.JobOrderDate.ToString("MMM dd, yyyy")
                </strong>

            </div>


            <div style="display:flex; justify-content:space-between; padding:10px 0; border-bottom:1px solid var(--af-border);">

                <span style="color:var(--af-text-secondary);">
                    Status
                </span>

                <strong>
                    @(string.IsNullOrWhiteSpace(Model.Status)
                        ? "Pending"
                        : Model.Status)
                </strong>

            </div>


            <div style="display:flex; justify-content:space-between; padding:10px 0;">

                <span style="color:var(--af-text-secondary);">
                    Total Cost
                </span>

                <strong>
                    ₱@Model.TotalCost.ToString("N2")
                </strong>

            </div>

        </div>


        <!-- CONFIRMATION FORM -->
        <form asp-action="Delete"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="JobOrderId" />


            <div style="display:flex; justify-content:flex-end; gap:12px;">

                <a asp-action="Details"
                   asp-route-id="@Model.JobOrderId"
                   class="af-button af-button-secondary">
                    Cancel
                </a>

                <button type="submit"
                        class="af-button"
                        style="background:#dc3545; color:#fff; border:none;">
                    Delete Job Order
                </button>

            </div>

        </form>

    </div>

</div>