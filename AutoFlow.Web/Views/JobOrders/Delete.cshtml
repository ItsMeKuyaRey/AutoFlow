@model AutoFlow.Web.Models.JobOrder

@{
    ViewData["Title"] = "Delete Job Order";
}

<style>
    .delete-card {
        max-width: 760px;
    }

    .delete-warning {
        text-align: center;
        padding: 18px 10px 28px;
    }

    .delete-icon {
        width: 64px;
        height: 64px;
        border-radius: 16px;
        margin: 0 auto 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(220, 53, 69, 0.08);
        font-size: 28px;
    }

    .delete-warning h2 {
        font-size: 1.25rem;
        font-weight: 650;
        margin-bottom: 8px;
    }

    .delete-warning p {
        color: var(--af-text-secondary);
        max-width: 520px;
        margin: 0 auto;
    }

    .delete-summary {
        border: 1px solid var(--af-border);
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 26px;
    }

    .delete-summary-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 13px 18px;
        border-bottom: 1px solid var(--af-border);
    }

    .delete-summary-row:last-child {
        border-bottom: none;
    }

    .delete-summary-label {
        color: var(--af-text-secondary);
    }

    .delete-summary-value {
        font-weight: 650;
        text-align: right;
    }

    .delete-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 22px;
        border-top: 1px solid var(--af-border);
    }

    .delete-button {
        background: #dc3545;
        color: #fff;
        border: none;
    }

    .delete-button:hover {
        background: #bb2d3b;
        color: #fff;
    }

    @@media (max-width: 600px) {
        .delete-footer {
            flex-direction: column-reverse;
        }

        .delete-footer .af-button {
            width: 100%;
        }

        .delete-summary-row {
            flex-direction: column;
            gap: 4px;
        }

        .delete-summary-value {
            text-align: left;
        }
    }
</style>

<div class="dashboard-page">

    <div class="page-header">
        <div>
            <h1>Delete Job Order</h1>
            <p>Review the repair job before permanently removing it.</p>
        </div>

        <div class="page-header-actions">
            <a asp-action="Index"
               class="af-button af-button-secondary">
                Back to Repair Jobs
            </a>
        </div>
    </div>

    <div class="af-card delete-card" style="padding:30px;">

        <div class="delete-warning">

            <div class="delete-icon">
                ⚠️
            </div>

            <h2>
                Delete Job Order #@Model.JobOrderId?
            </h2>

            <p>
                This action permanently removes this repair job from the system.
                Review the information below before continuing.
            </p>

        </div>

        <div class="delete-summary">

            <div class="delete-summary-row">
                <span class="delete-summary-label">
                    Job Order
                </span>

                <span class="delete-summary-value">
                    #@Model.JobOrderId
                </span>
            </div>

            <div class="delete-summary-row">
                <span class="delete-summary-label">
                    Job Order Date
                </span>

                <span class="delete-summary-value">
                    @Model.JobOrderDate.ToString("MMM dd, yyyy hh:mm tt")
                </span>
            </div>

            <div class="delete-summary-row">
                <span class="delete-summary-label">
                    Status
                </span>

                <span class="delete-summary-value">
                    @(string.IsNullOrWhiteSpace(Model.Status)
                        ? "Pending"
                        : Model.Status)
                </span>
            </div>

            <div class="delete-summary-row">
                <span class="delete-summary-label">
                    Labor Cost
                </span>

                <span class="delete-summary-value">
                    @Model.LaborCost.ToString("C")
                </span>
            </div>

            <div class="delete-summary-row">
                <span class="delete-summary-label">
                    Parts Cost
                </span>

                <span class="delete-summary-value">
                    @Model.PartsCost.ToString("C")
                </span>
            </div>

            <div class="delete-summary-row">
                <span class="delete-summary-label">
                    Total Cost
                </span>

                <span class="delete-summary-value">
                    @Model.TotalCost.ToString("C")
                </span>
            </div>

        </div>

        <form asp-action="Delete"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="JobOrderId" />

            <div class="delete-footer">

                <a asp-action="Details"
                   asp-route-id="@Model.JobOrderId"
                   class="af-button af-button-secondary">
                    Cancel
                </a>

                <button type="submit"
                        class="af-button delete-button">
                    Delete Job Order
                </button>

            </div>

        </form>

    </div>

</div>