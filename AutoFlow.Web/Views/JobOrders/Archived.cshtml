@model IEnumerable<AutoFlow.Web.Models.JobOrder>

@{
    ViewData["Title"] = "Archived Repair Job Orders";
    var jobs = Model.ToList();
    var jobOrderNotification = TempData["JobOrderNotification"]?.ToString();
}

<style>
    .job-archive-workspace { max-width: 1500px; margin: 0 auto; padding: 8px 0 40px; }
    .job-archive-header { display:flex; align-items:flex-start; justify-content:space-between; gap:20px; margin-bottom:20px; }
    .job-archive-eyebrow { display:inline-flex; align-items:center; gap:7px; margin-bottom:7px; color:#7c3aed; font-size:.64rem; font-weight:850; letter-spacing:.09em; text-transform:uppercase; }
    .job-archive-eyebrow::before { content:""; width:7px; height:7px; border-radius:50%; background:#7c3aed; }
    .job-archive-header h1 { margin:0 0 6px; font-size:1.55rem; }
    .job-archive-header p { margin:0; color:#7b8494; font-size:.82rem; }
    .job-archive-back { display:inline-flex; align-items:center; justify-content:center; height:38px; padding:0 14px; border:1px solid #e1e5eb; border-radius:8px; background:#fff; color:#6d3df5; text-decoration:none; font-size:.73rem; font-weight:800; white-space:nowrap; }
    .job-archive-back:hover { border-color:#c4b5fd; background:#faf8ff; }
    .job-archive-card { background:#fff; border:1px solid #e5e7eb; border-radius:14px; overflow:hidden; box-shadow:0 8px 28px rgba(15,23,42,.05); }
    .job-archive-card-head { display:flex; align-items:center; justify-content:space-between; gap:15px; padding:18px 20px; border-bottom:1px solid #edf0f4; }
    .job-archive-card-head h2 { margin:0 0 4px; font-size:.98rem; }
    .job-archive-card-head p { margin:0; color:#8b94a3; font-size:.72rem; }
    .job-archive-list { display:grid; }
    .job-archive-row { display:grid; grid-template-columns:minmax(0,1.3fr) minmax(0,1fr) minmax(0,1fr) auto auto; align-items:center; gap:16px; padding:15px 18px; border-bottom:1px solid #f0f2f5; }
    .job-archive-row:last-child { border-bottom:0; }
    .job-archive-job, .job-archive-vehicle, .job-archive-owner { min-width:0; display:flex; align-items:center; gap:10px; }
    .job-archive-avatar { width:38px; height:38px; flex:0 0 38px; border-radius:9px; display:flex; align-items:center; justify-content:center; overflow:hidden; background:#f1ecff; color:#6d3df5; font-size:.73rem; font-weight:850; }
    .job-archive-owner-avatar { border-radius:50%; background:#ece8ff; }
    .job-archive-avatar img { display:block; width:100%; height:100%; object-fit:contain; background:#fff; }
    .job-archive-copy { min-width:0; display:flex; flex-direction:column; gap:3px; }
    .job-archive-copy strong { color:#303847; font-size:.77rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .job-archive-copy span { color:#929aa8; font-size:.67rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .job-archive-status { display:inline-flex; align-items:center; gap:5px; padding:5px 8px; border-radius:999px; background:#fff1f0; color:#d95548; font-size:.63rem; font-weight:850; white-space:nowrap; }
    .job-archive-value { display:flex; flex-direction:column; gap:3px; white-space:nowrap; }
    .job-archive-value strong { color:#303847; font-size:.77rem; }
    .job-archive-value span { color:#929aa8; font-size:.66rem; }
    .job-archive-actions { display:flex; align-items:center; justify-content:flex-end; gap:7px; }
    .job-archive-action { width:32px; height:32px; display:inline-flex; align-items:center; justify-content:center; border:1px solid #e1e5eb; border-radius:8px; background:#fff; color:#657083; cursor:pointer; }
    .job-archive-action:hover { border-color:#c4b5fd; color:#7c3aed; background:#faf8ff; }
    .job-archive-action.restore { color:#047857; border-color:#ccefe1; background:#f0fdf4; }
    .job-archive-action svg { width:15px; height:15px; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
    .job-archive-empty { padding:64px 20px; text-align:center; color:#8b94a3; }
    .job-archive-empty-icon { width:52px; height:52px; margin:0 auto 12px; display:flex; align-items:center; justify-content:center; border-radius:14px; background:#f3f1ff; color:#7c3aed; }
    .job-archive-empty-icon svg { width:24px; height:24px; fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }
    .job-archive-empty strong { display:block; margin-bottom:5px; color:#303847; font-size:.9rem; }
    .job-archive-empty span { font-size:.73rem; }
    .job-archive-drawer-backdrop { position:fixed; inset:0; z-index:5000; display:none; background:rgba(15,23,42,.22); backdrop-filter:blur(3px); }
    .job-archive-drawer-backdrop.open { display:block; }
    .job-archive-drawer { position:absolute; top:0; right:0; width:min(570px,100%); height:100%; display:flex; flex-direction:column; background:#fff; box-shadow:-18px 0 45px rgba(15,23,42,.14); }
    .job-archive-drawer-head { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; padding:22px 25px 18px; border-bottom:1px solid #edf0f4; }
    .job-archive-drawer-kicker { color:#7c3aed; font-size:.62rem; font-weight:850; letter-spacing:.08em; text-transform:uppercase; }
    .job-archive-drawer-head h2 { margin:5px 0 4px; font-size:1.08rem; }
    .job-archive-drawer-head p { margin:0; color:#8b94a3; font-size:.72rem; }
    .job-archive-drawer-close { width:30px; height:30px; border:0; border-radius:7px; background:transparent; color:#9aa3b2; font-size:22px; cursor:pointer; }
    .job-archive-drawer-close:hover { background:#f7f8fb; color:#303847; }
    .job-archive-drawer-body { flex:1; overflow-y:auto; padding:22px 25px 28px; }
    .job-archive-section { margin-bottom:22px; padding-bottom:20px; border-bottom:1px solid #edf0f4; }
    .job-archive-section:last-child { border-bottom:0; }
    .job-archive-section-title { margin-bottom:11px; color:#8a93a2; font-size:.63rem; font-weight:850; letter-spacing:.08em; text-transform:uppercase; }
    .job-archive-info-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
    .job-archive-info-card { padding:11px 12px; border:1px solid #e7e9ef; border-radius:9px; background:#fafbfc; }
    .job-archive-info-card span { display:block; margin-bottom:4px; color:#929aa8; font-size:.64rem; }
    .job-archive-info-card strong { display:block; color:#303847; font-size:.74rem; line-height:1.35; }
    .job-archive-linked-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
    .job-archive-linked-card { display:flex; align-items:center; gap:10px; min-width:0; padding:11px; border:1px solid #e7e9ef; border-radius:10px; background:#fff; }
    .job-archive-linked-media { width:72px; height:60px; flex:0 0 72px; overflow:hidden; display:flex; align-items:center; justify-content:center; border:1px solid #e8eaf0; border-radius:8px; background:#f7f8fb; }
    .job-archive-linked-media.owner { width:58px; height:58px; flex-basis:58px; border-radius:50%; background:#ece8ff; color:#6445e8; font-size:.82rem; font-weight:850; }
    .job-archive-linked-media img { display:block; width:100%; height:100%; object-fit:contain; background:#fff; }
    .job-archive-linked-copy { min-width:0; display:flex; flex-direction:column; gap:3px; }
    .job-archive-linked-copy span:first-child { color:#929aa8; font-size:.61rem; font-weight:800; letter-spacing:.05em; text-transform:uppercase; }
    .job-archive-linked-copy strong, .job-archive-linked-copy span:not(:first-child), .job-archive-linked-copy small { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .job-archive-linked-copy strong { color:#303847; font-size:.73rem; }
    .job-archive-linked-copy span:not(:first-child) { color:#667184; font-size:.65rem; }
    .job-archive-linked-copy small { color:#087f5b; font-size:.6rem; font-weight:750; }
    .job-archive-text { color:#4e5869; font-size:.75rem; line-height:1.6; white-space:pre-wrap; }
    .job-archive-part { display:flex; justify-content:space-between; gap:12px; padding:10px 0; border-bottom:1px solid #f0f2f5; }
    .job-archive-part:last-child { border-bottom:0; }
    .job-archive-part strong { color:#303847; font-size:.73rem; }
    .job-archive-part span { display:block; margin-top:3px; color:#929aa8; font-size:.65rem; }
    .job-archive-cost { display:flex; justify-content:space-between; gap:15px; padding:7px 0; color:#667184; font-size:.72rem; }
    .job-archive-cost strong { color:#303847; }
    .job-archive-total { margin-top:6px; padding-top:11px; border-top:1px solid #e5e7eb; font-weight:750; }
    .job-archive-total strong { color:#7c3aed; font-size:.92rem; }
    .job-archive-drawer-footer { display:flex; justify-content:flex-end; gap:8px; padding:14px 25px; border-top:1px solid #edf0f4; }
    .job-archive-footer-btn { height:36px; padding:0 14px; border:1px solid #e1e5eb; border-radius:8px; background:#fff; color:#586477; font-size:.72rem; font-weight:750; cursor:pointer; }
    .job-archive-footer-btn.restore { border-color:#ccefe1; background:#f0fdf4; color:#047857; font-weight:800; }
    body.job-archive-open { overflow:hidden; }

    /* Archived eye -> one clean detail view.
       Keep the injected archive root alive so its drawer remains mounted,
       but hide the archive-list drawer underneath it. The detail drawer then
       owns the full viewport, so there is no doubled Archived page behind it. */
    body.job-archive-detail-open { overflow:hidden; }
    body.job-archive-detail-open .job-archive-overlay-drawer { display:none; }
    body.job-archive-detail-open #jobArchiveDrawer {
        display:block;
        position:fixed;
        inset:0;
        z-index:8000;
        background:rgba(15,23,42,.22);
        backdrop-filter:blur(2px);
    }
    body.job-archive-detail-open #jobArchiveDrawer .job-archive-drawer {
        position:absolute;
        top:0;
        right:0;
        bottom:0;
        width:min(570px,100%);
        height:100vh;
        max-width:none;
        box-shadow:-18px 0 45px rgba(15,23,42,.14);
        border:0;
    }
    @@media (max-width:900px) { .job-archive-row { grid-template-columns:minmax(0,1fr) minmax(0,1fr) auto; } .job-archive-status, .job-archive-value { display:none; } }
    @@media (max-width:680px) { .job-archive-header { flex-direction:column; } .job-archive-row { grid-template-columns:1fr auto; } .job-archive-vehicle, .job-archive-owner { display:none; } .job-archive-linked-grid, .job-archive-info-grid { grid-template-columns:1fr; } .job-archive-drawer { width:100%; } }


    /* Archive page opens as a right-side workspace, matching Vehicle Records. */
    .job-archive-overlay-page {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        z-index: 5000;
        background: transparent;
        overflow: hidden;
    }

    .job-archive-overlay-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(15, 23, 42, .22);
        backdrop-filter: blur(2px);
    }

    .job-archive-overlay-drawer {
        position: absolute;
        top: 0;
        right: 0;
        width: min(820px, 100%);
        height: 100vh;
        max-height: 100vh;
        overflow-y: auto;
        box-sizing: border-box;
        background: #fff;
        border-left: 1px solid #e5e7eb;
        box-shadow: -18px 0 45px rgba(15, 23, 42, .12);
        animation: afJobArchiveDrawerIn .20s ease-out;
    }

    .job-archive-workspace {
        max-width: none;
        min-height: 100%;
        margin: 0;
        padding: 26px 28px 30px;
        box-sizing: border-box;
    }

    .job-archive-drawer-backdrop {
        z-index: 6000;
    }

    .job-archive-drawer {
        z-index: 6001;
    }

    .job-archive-overlay-loading {
        position: fixed;
        inset: 0;
        z-index: 7000;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        background: rgba(15, 23, 42, .16);
        backdrop-filter: blur(2px);
    }

    .job-archive-overlay-loading-card {
        width: min(820px, 100%);
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        box-sizing: border-box;
        background: #fff;
        color: #657083;
        font-size: .78rem;
        font-weight: 750;
        box-shadow: -18px 0 45px rgba(15, 23, 42, .12);
    }

    .job-archive-overlay-spinner {
        width: 16px;
        height: 16px;
        border: 2px solid #e8e3ff;
        border-top-color: #7c3aed;
        border-radius: 50%;
        animation: afJobArchiveSpin .7s linear infinite;
    }

    body.job-archive-overlay-open {
        overflow: hidden;
    }

    @@keyframes afJobArchiveDrawerIn {
        from { transform: translateX(28px); opacity: .94; }
        to { transform: translateX(0); opacity: 1; }
    }

    @@keyframes afJobArchiveSpin {
        to { transform: rotate(360deg); }
    }

    @@media (max-width: 680px) {
        .job-archive-overlay-drawer,
        .job-archive-overlay-loading-card {
            width: 100%;
            border-left: 0;
        }

        .job-archive-workspace {
            padding-left: 20px;
            padding-right: 20px;
        }
    }

</style>

@if (!string.IsNullOrWhiteSpace(jobOrderNotification))
{
    <div id="jobArchiveNotification" style="position:fixed;right:24px;bottom:24px;z-index:7000;min-width:280px;max-width:380px;padding:13px 16px;border:1px solid #ccefe1;border-radius:10px;background:#f0fdf4;color:#047857;box-shadow:0 14px 35px rgba(15,23,42,.14);font-size:.76rem;font-weight:750;">
        <span style="margin-right:7px;">✓</span>@jobOrderNotification
    </div>
}

<div class="job-archive-overlay-page">
    <div class="job-archive-overlay-backdrop"></div>
    <aside class="job-archive-overlay-drawer" role="dialog" aria-modal="true" aria-label="Archived Repair Job Orders">
        <div class="job-archive-workspace">
    <div class="job-archive-header">
        <div>
            <div class="job-archive-eyebrow">Repair Job Orders</div>
            <h1>Archived Repair Job Orders</h1>
            <p>Preserved repair records remain available for review and restoration.</p>
        </div>
        <a asp-action="Index" class="job-archive-back">Back to Repair Job Orders</a>
    </div>

    <div class="job-archive-card">
        <div class="job-archive-card-head">
            <div>
                <h2>Archived Jobs</h2>
                <p>@jobs.Count archived job order@(jobs.Count == 1 ? "" : "s")</p>
            </div>
        </div>

        @if (jobs.Any())
        {
            <div class="job-archive-list">
                @foreach (var item in jobs)
                {
                    var owner = item.Vehicle?.Customer == null ? "No customer" : $"{item.Vehicle.Customer.FirstName} {item.Vehicle.Customer.LastName}".Trim();
                    var vehicle = item.Vehicle == null ? "No vehicle" : $"{item.Vehicle.Make} {item.Vehicle.Model}".Trim();
                    var plate = item.Vehicle?.PlateNumber ?? "—";
                    var vehicleImage = item.Vehicle?.ImageUrl ?? string.Empty;
                    var ownerImage = item.Vehicle?.Customer?.ImageUrl ?? string.Empty;
                    var ownerInitial = item.Vehicle?.Customer?.FirstName?.FirstOrDefault().ToString().ToUpperInvariant() ?? "?";

                    <div class="job-archive-row">
                        <div class="job-archive-job">
                            <div class="job-archive-avatar">
                                <span>#@item.JobOrderId</span>
                            </div>
                            <div class="job-archive-copy">
                                <strong>Job Order #@item.JobOrderId</strong>
                                <span>@item.JobOrderDate.ToString("MMM dd, yyyy hh:mm tt")</span>
                            </div>
                        </div>

                        <div class="job-archive-vehicle">
                            <div class="job-archive-avatar">
                                @if (!string.IsNullOrWhiteSpace(vehicleImage))
                                {
                                    <img src="@vehicleImage" alt="@vehicle" loading="lazy" />
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 17h14"></path><path d="M6 17l1-5h10l1 5"></path><path d="M8 12l1.5-4h5L16 12"></path><circle cx="8" cy="17" r="1.5"></circle><circle cx="16" cy="17" r="1.5"></circle></svg>
                                }
                            </div>
                            <div class="job-archive-copy"><strong>@vehicle</strong><span>@plate</span></div>
                        </div>

                        <div class="job-archive-owner">
                            <div class="job-archive-avatar job-archive-owner-avatar">
                                @if (!string.IsNullOrWhiteSpace(ownerImage))
                                {
                                    <img src="@ownerImage" alt="@owner" loading="lazy" />
                                }
                                else
                                {
                                    @ownerInitial
                                }
                            </div>
                            <div class="job-archive-copy"><strong>@owner</strong><span>Customer record</span></div>
                        </div>

                        <span class="job-archive-status"><span>●</span> Archived</span>

                        <div class="job-archive-actions">
                            <button type="button" class="job-archive-action" data-view-archived="@item.JobOrderId" title="View archived job order" aria-label="View archived job order">
                                <svg viewBox="0 0 24 24"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6z"></path><circle cx="12" cy="12" r="2.5"></circle></svg>
                            </button>
                            <form asp-action="Restore" method="post" style="margin:0;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.JobOrderId" />
                                <button type="submit" class="job-archive-action restore" title="Restore job order" aria-label="Restore job order #@item.JobOrderId">
                                    <svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 3-6.7"></path><path d="M3 4v6h6"></path></svg>
                                </button>
                            </form>
                        </div>
                    </div>

                    <template id="job-archive-details-@item.JobOrderId">
                        <div class="job-archive-section">
                            <div class="job-archive-section-title">Job Information</div>
                            <div class="job-archive-info-grid">
                                <div class="job-archive-info-card"><span>Job Order</span><strong>#@item.JobOrderId</strong></div>
                                <div class="job-archive-info-card"><span>Status</span><strong>Archived · @item.Status</strong></div>
                                <div class="job-archive-info-card"><span>Job Date</span><strong>@item.JobOrderDate.ToString("MMM dd, yyyy hh:mm tt")</strong></div>
                                <div class="job-archive-info-card"><span>Appointment</span><strong>@(item.Appointment == null ? "No appointment" : item.Appointment.AppointmentDate.ToString("MMM dd, yyyy hh:mm tt"))</strong></div>
                            </div>
                        </div>

                        <div class="job-archive-section">
                            <div class="job-archive-section-title">Vehicle & Owner</div>
                            <div class="job-archive-linked-grid">
                                <div class="job-archive-linked-card">
                                    <div class="job-archive-linked-media">
                                        @if (!string.IsNullOrWhiteSpace(vehicleImage))
                                        {
                                            <img src="@vehicleImage" alt="@vehicle" loading="lazy" />
                                        }
                                        else
                                        {
                                            <svg viewBox="0 0 24 24" style="width:22px;height:22px;fill:none;stroke:#6d4aff;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;"><path d="M5 17h14"></path><path d="M6 17l1-5h10l1 5"></path><path d="M8 12l1.5-4h5L16 12"></path><circle cx="8" cy="17" r="1.5"></circle><circle cx="16" cy="17" r="1.5"></circle></svg>
                                        }
                                    </div>
                                    <div class="job-archive-linked-copy">
                                        <span>Vehicle</span><strong>@vehicle</strong><span>@plate</span>
                                        <small><i class="bi bi-check-circle-fill"></i> @(string.IsNullOrWhiteSpace(vehicleImage) ? "No image saved" : "Vehicle image linked")</small>
                                    </div>
                                </div>

                                <div class="job-archive-linked-card">
                                    <div class="job-archive-linked-media owner">
                                        @if (!string.IsNullOrWhiteSpace(ownerImage))
                                        {
                                            <img src="@ownerImage" alt="@owner" loading="lazy" />
                                        }
                                        else
                                        {
                                            @ownerInitial
                                        }
                                    </div>
                                    <div class="job-archive-linked-copy">
                                        <span>Owner</span><strong>@owner</strong><span>Customer record</span>
                                        <small><i class="bi bi-check-circle-fill"></i> @(string.IsNullOrWhiteSpace(ownerImage) ? "No image saved" : "Owner image linked")</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="job-archive-section">
                            <div class="job-archive-section-title">Repair Details</div>
                            <div class="job-archive-info-card"><span>Description</span><div class="job-archive-text">@(string.IsNullOrWhiteSpace(item.Description) ? "No repair description recorded." : item.Description)</div></div>
                            <div class="job-archive-info-card" style="margin-top:9px;"><span>Diagnosis</span><div class="job-archive-text">@(string.IsNullOrWhiteSpace(item.Diagnosis) ? "No diagnosis recorded." : item.Diagnosis)</div></div>
                            <div class="job-archive-info-card" style="margin-top:9px;"><span>Notes</span><div class="job-archive-text">@(string.IsNullOrWhiteSpace(item.Notes) ? "No additional notes." : item.Notes)</div></div>
                        </div>

                        <div class="job-archive-section">
                            <div class="job-archive-section-title">Parts Used</div>
                            @if (item.JobOrderParts.Any())
                            {
                                foreach (var part in item.JobOrderParts)
                                {
                                    <div class="job-archive-part"><div><strong>@(part.Part?.Name ?? "Unknown Part")</strong><span>Qty @part.Quantity × ₱@part.UnitPriceAtTimeOfUse.ToString("N2")</span></div><strong>₱@((part.Quantity * part.UnitPriceAtTimeOfUse).ToString("N2"))</strong></div>
                                }
                            }
                            else
                            {
                                <div class="job-archive-text">No parts were recorded for this job order.</div>
                            }
                        </div>

                        <div class="job-archive-section">
                            <div class="job-archive-cost"><span>Labor Cost</span><strong>₱@item.LaborCost.ToString("N2")</strong></div>
                            <div class="job-archive-cost"><span>Parts Cost</span><strong>₱@item.PartsCost.ToString("N2")</strong></div>
                            <div class="job-archive-cost job-archive-total"><span>Total Job Value</span><strong>₱@item.TotalCost.ToString("N2")</strong></div>
                        </div>
                    </template>
                }
            </div>
        }
        else
        {
            <div class="job-archive-empty">
                <div class="job-archive-empty-icon"><svg viewBox="0 0 24 24"><path d="M3 7h18"></path><path d="M5 7l1 13h12l1-13"></path><path d="M9 7V4h6v3"></path></svg></div>
                <strong>No Archived Repair Job Orders</strong>
                <span>Archived job orders will appear here and can be restored.</span>
            </div>
        }
    </div>
</div>
    </aside>

    <div class="job-archive-drawer-backdrop" id="jobArchiveDrawer" aria-hidden="true">
    <aside class="job-archive-drawer" role="dialog" aria-modal="true" aria-labelledby="jobArchiveDrawerTitle">
        <header class="job-archive-drawer-head">
            <div>
                <div class="job-archive-drawer-kicker">Archived Repair Job</div>
                <h2 id="jobArchiveDrawerTitle">Job Order</h2>
                <p id="jobArchiveDrawerSubtitle">Preserved repair record</p>
            </div>
            <button type="button" class="job-archive-drawer-close" data-close-archive-drawer aria-label="Close archived job order">×</button>
        </header>
        <div class="job-archive-drawer-body" id="jobArchiveDrawerContent"></div>
        <footer class="job-archive-drawer-footer">
            <button type="button" class="job-archive-footer-btn" data-close-archive-drawer>Close</button>
            <form asp-action="Restore" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="jobArchiveRestoreId" />
                <button type="submit" class="job-archive-footer-btn restore">Restore Job Order</button>
            </form>
        </footer>
    </aside>
</div>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {
    const drawer = document.getElementById("jobArchiveDrawer");
    const content = document.getElementById("jobArchiveDrawerContent");
    const title = document.getElementById("jobArchiveDrawerTitle");
    const subtitle = document.getElementById("jobArchiveDrawerSubtitle");
    const restoreId = document.getElementById("jobArchiveRestoreId");
    const notification = document.getElementById("jobArchiveNotification");

    if (notification) {
        window.setTimeout(function () {
            notification.style.transition = "opacity .2s ease, transform .2s ease";
            notification.style.opacity = "0";
            notification.style.transform = "translateY(8px)";
            window.setTimeout(function () { notification.remove(); }, 220);
        }, 3200);
    }

    function closeDrawer() {
        drawer.classList.remove("open");
        drawer.setAttribute("aria-hidden", "true");
        document.body.classList.remove("job-archive-open", "job-archive-detail-open");
    }

    document.querySelectorAll("[data-close-archive-drawer]").forEach(function (button) {
        button.addEventListener("click", closeDrawer);
    });

    drawer.addEventListener("click", function (event) {
        if (event.target === drawer) closeDrawer();
    });

    function openArchivedDetails(id) {
        if (!drawer || !content || !id) return;

        const template = document.getElementById(`job-archive-details-${id}`);
        if (!template) {
            window.alert(`Archived details for Job Order #${id} could not be loaded.`);
            return;
        }

        title.textContent = `Job Order #${id}`;
        subtitle.textContent = "Preserved repair record · Archived";
        content.replaceChildren(template.content.cloneNode(true));
        if (restoreId) restoreId.value = id;

        drawer.classList.add("open");
        drawer.setAttribute("aria-hidden", "false");
        document.body.classList.add("job-archive-open", "job-archive-detail-open");
    }

    // Delegated handler keeps the eye button working even when the archive
    // workspace is injected/re-rendered by the layout.
    document.addEventListener("click", function (event) {
        const button = event.target.closest("[data-view-archived]");
        if (!button) return;
        event.preventDefault();
        event.stopPropagation();
        openArchivedDetails(button.getAttribute("data-view-archived"));
    });

    document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") closeDrawer();
    });
});
</script>
}
