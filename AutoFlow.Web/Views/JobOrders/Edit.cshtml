@model AutoFlow.Web.Models.JobOrder

@{
    ViewData["Title"] = "Edit Job Order";
}

<style>
    .job-form-card {
        max-width: 980px;
    }

    .job-form-section {
        margin-bottom: 30px;
    }

    .job-section-heading {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 20px;
    }

    .job-section-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: var(--af-bg);
        border: 1px solid var(--af-border);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .job-section-heading h2 {
        font-size: 1rem;
        font-weight: 650;
        margin: 0 0 4px;
    }

    .job-section-heading p {
        margin: 0;
        color: var(--af-text-secondary);
        font-size: 0.84rem;
    }

    .job-edit-id {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 7px;
        background: var(--af-bg);
        border: 1px solid var(--af-border);
        font-size: 0.8rem;
        font-weight: 600;
        margin-bottom: 22px;
    }

    .job-form-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 22px;
        margin-top: 30px;
        border-top: 1px solid var(--af-border);
    }

    @@media (max-width: 768px) {
        .job-form-footer {
            flex-direction: column-reverse;
        }

        .job-form-footer .af-button {
            width: 100%;
        }
    }
</style>

<div class="dashboard-page">

    <div class="page-header">
        <div>
            <h1>Edit Job Order #@Model.JobOrderId</h1>
            <p>Update repair information, service status, labor cost, and notes.</p>
        </div>

        <div class="page-header-actions">
            <a asp-action="Details"
               asp-route-id="@Model.JobOrderId"
               class="af-button af-button-secondary">
                View Details
            </a>

            <a asp-action="Index"
               class="af-button af-button-secondary">
                Back
            </a>
        </div>
    </div>

    <div class="af-card job-form-card" style="padding:30px;">

        <div class="job-edit-id">
            🔧 Job Order #@Model.JobOrderId
        </div>

        <form asp-action="Edit" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="JobOrderId" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-4"></div>

            <div class="job-form-section">

                <div class="job-section-heading">
                    <div class="job-section-icon">⚙️</div>
                    <div>
                        <h2>Job Information</h2>
                        <p>Update the vehicle, appointment, date, and current repair status.</p>
                    </div>
                </div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="VehicleId"
                               class="form-label fw-semibold">
                            Vehicle
                        </label>

                        <select asp-for="VehicleId"
                                class="form-select"
                                asp-items="ViewBag.VehicleId">
                            <option value="">-- Select Vehicle --</option>
                        </select>

                        <span asp-validation-for="VehicleId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AppointmentId"
                               class="form-label fw-semibold">
                            Appointment
                        </label>

                        <select asp-for="AppointmentId"
                                class="form-select"
                                asp-items="ViewBag.AppointmentId">
                            <option value="">-- No Appointment --</option>
                        </select>

                        <span asp-validation-for="AppointmentId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="JobOrderDate"
                               class="form-label fw-semibold">
                            Job Order Date
                        </label>

                        <input asp-for="JobOrderDate"
                               type="datetime-local"
                               class="form-control" />

                        <span asp-validation-for="JobOrderDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Status"
                               class="form-label fw-semibold">
                            Status
                        </label>

                        <select asp-for="Status"
                                class="form-select">
                            <option value="Open">Open</option>
                            <option value="In Progress">In Progress</option>
                            <option value="Completed">Completed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>

                        <span asp-validation-for="Status"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LaborCost"
                               class="form-label fw-semibold">
                            Labor Cost
                        </label>

                        <div class="input-group">
                            <span class="input-group-text">₱</span>

                            <input asp-for="LaborCost"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control" />
                        </div>

                        <span asp-validation-for="LaborCost"
                              class="text-danger"></span>
                    </div>

                </div>

            </div>

            <div class="job-form-section">

                <div class="job-section-heading">
                    <div class="job-section-icon">📝</div>
                    <div>
                        <h2>Repair Details</h2>
                        <p>Keep the repair description, diagnosis, and service notes updated.</p>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description"
                           class="form-label fw-semibold">
                        Repair Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Describe the repair or requested service..."></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Diagnosis"
                           class="form-label fw-semibold">
                        Diagnosis
                    </label>

                    <textarea asp-for="Diagnosis"
                              class="form-control"
                              rows="4"
                              placeholder="Enter the mechanic's diagnosis or findings..."></textarea>

                    <span asp-validation-for="Diagnosis"
                          class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="Notes"
                           class="form-label fw-semibold">
                        Additional Notes
                    </label>

                    <textarea asp-for="Notes"
                              class="form-control"
                              rows="3"
                              placeholder="Add additional notes or instructions..."></textarea>

                    <span asp-validation-for="Notes"
                          class="text-danger"></span>
                </div>

            </div>

            <div class="job-form-footer">

                <a asp-action="Details"
                   asp-route-id="@Model.JobOrderId"
                   class="af-button af-button-secondary">
                    Cancel
                </a>

                <button type="submit"
                        class="af-button af-button-primary">
                    Save Changes
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}