@using Microsoft.AspNetCore.Mvc.Rendering
@model AutoFlow.Web.Models.JobOrder

@{
    ViewData["Title"] = "Edit Job Order";

    var parts = Model.JobOrderParts?.ToList() ?? new List<AutoFlow.Web.Models.JobOrderPart>();
    var partsTotal = parts.Sum(p => p.Quantity * p.UnitPriceAtTimeOfUse);
    var vehicleName = Model.Vehicle == null ? "Vehicle unavailable" : $"{Model.Vehicle.Make} {Model.Vehicle.Model}".Trim();
    var vehicleImage = Model.Vehicle?.ImageUrl ?? string.Empty;
    var ownerName = Model.Vehicle?.Customer == null ? "Customer unavailable" : $"{Model.Vehicle.Customer.FirstName} {Model.Vehicle.Customer.LastName}".Trim();
    var ownerImage = Model.Vehicle?.Customer?.ImageUrl ?? string.Empty;
    var ownerInitial = Model.Vehicle?.Customer?.FirstName?.FirstOrDefault().ToString().ToUpperInvariant() ?? "?";
}

<style>
    .job-form-card {
        max-width: 980px;
    }

    .job-form-section {
        margin-bottom: 30px;
    }

    .job-section-heading {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 20px;
    }

    .job-section-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: var(--af-bg);
        border: 1px solid var(--af-border);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .job-section-heading h2 {
        font-size: 1rem;
        font-weight: 650;
        margin: 0 0 4px;
    }

    .job-section-heading p {
        margin: 0;
        color: var(--af-text-secondary);
        font-size: 0.84rem;
    }

    .job-edit-id {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 7px;
        background: var(--af-bg);
        border: 1px solid var(--af-border);
        font-size: 0.8rem;
        font-weight: 600;
        margin-bottom: 22px;
    }

    .job-form-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 22px;
        margin-top: 30px;
        border-top: 1px solid var(--af-border);
    }

    .job-edit-linked-grid {
        display:grid;
        grid-template-columns:repeat(2,minmax(0,1fr));
        gap:10px;
        margin-top:14px;
    }

    .job-edit-linked-card {
        display:flex;
        align-items:center;
        gap:10px;
        min-width:0;
        padding:10px;
        border:1px solid var(--af-border);
        border-radius:10px;
        background:var(--af-bg);
    }

    .job-edit-linked-media {
        width:72px;
        height:60px;
        flex:0 0 72px;
        display:flex;
        align-items:center;
        justify-content:center;
        overflow:hidden;
        border:1px solid #e8eaf0;
        border-radius:8px;
        background:#fff;
    }

    .job-edit-linked-media.owner {
        width:58px;
        height:58px;
        flex-basis:58px;
        border-radius:50%;
        background:#ece8ff;
        color:#6445e8;
        font-weight:800;
    }

    .job-edit-linked-media img { width:100%; height:100%; object-fit:contain; display:block; }
    .job-edit-linked-copy { min-width:0; display:flex; flex-direction:column; gap:3px; }
    .job-edit-linked-copy span { color:var(--af-text-secondary); font-size:.66rem; }
    .job-edit-linked-copy strong { color:var(--af-text); font-size:.75rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .job-edit-parts { margin-top:26px; padding-top:22px; border-top:1px solid var(--af-border); }
    .job-edit-parts-row { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:10px; }
    .job-edit-parts-row strong { color:var(--af-text); font-size:.88rem; }
    .job-edit-parts-row span { color:var(--af-text-secondary); font-size:.72rem; }
    .job-edit-part-list { border:1px solid var(--af-border); border-radius:10px; overflow:hidden; }
    .job-edit-part-item { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:10px 12px; border-bottom:1px solid var(--af-border); }
    .job-edit-part-item:last-child { border-bottom:0; }
    .job-edit-part-item strong { color:var(--af-text); font-size:.74rem; }
    .job-edit-part-item span { color:var(--af-text-secondary); font-size:.67rem; }


    @@media (max-width: 768px) {
        .job-form-footer {
            flex-direction: column-reverse;
        }

        .job-form-footer .af-button {
            width: 100%;
        }
    }
</style>

<div class="dashboard-page">

    <div class="page-header">
        <div>
            <h1>Edit Job Order #@Model.JobOrderId</h1>
            <p>Update repair information, service status, labor cost, and notes.</p>
        </div>

        <div class="page-header-actions">
            <a asp-action="Details"
               asp-route-id="@Model.JobOrderId"
               class="af-button af-button-secondary">
                View Details
            </a>

            <a asp-action="Index"
               class="af-button af-button-secondary">
                Back
            </a>
        </div>
    </div>

    <div class="af-card job-form-card" style="padding:30px;">

        <div class="job-edit-id">
            🔧 Job Order #@Model.JobOrderId
        </div>

        <form asp-action="Edit" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="JobOrderId" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-4"></div>

            <div class="job-form-section">

                <div class="job-section-heading">
                    <div class="job-section-icon">⚙️</div>
                    <div>
                        <h2>Job Information</h2>
                        <p>Update the vehicle, appointment, date, and current repair status.</p>
                    </div>
                </div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="VehicleId"
                               class="form-label fw-semibold">
                            Vehicle
                        </label>

                        <select asp-for="VehicleId"
                                class="form-select"
                                asp-items="ViewBag.VehicleId">
                            <option value="">-- Select Vehicle --</option>
                        </select>

                        <span asp-validation-for="VehicleId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AppointmentId"
                               class="form-label fw-semibold">
                            Appointment
                        </label>

                        <select asp-for="AppointmentId"
                                class="form-select"
                                asp-items="ViewBag.AppointmentId">
                            <option value="">-- No Appointment --</option>
                        </select>

                        <span asp-validation-for="AppointmentId"
                              class="text-danger"></span>
                        <small class="text-muted d-block mt-1">A scheduled appointment automatically controls the repair date/time. Leave it empty for a manual repair date.</small>
                    </div>

                    <div class="col-12">
                        <div class="job-edit-linked-grid">
                            <div class="job-edit-linked-card">
                                <div class="job-edit-linked-media">
                                    @if (!string.IsNullOrWhiteSpace(vehicleImage))
                                    {
                                        <img src="@vehicleImage" alt="@vehicleName" />
                                    }
                                    else
                                    {
                                        <span>🚗</span>
                                    }
                                </div>
                                <div class="job-edit-linked-copy">
                                    <span>Vehicle</span>
                                    <strong>@vehicleName</strong>
                                    <span>@Model.Vehicle?.PlateNumber</span>
                                </div>
                            </div>
                            <div class="job-edit-linked-card">
                                <div class="job-edit-linked-media owner">
                                    @if (!string.IsNullOrWhiteSpace(ownerImage))
                                    {
                                        <img src="@ownerImage" alt="@ownerName" />
                                    }
                                    else
                                    {
                                        @ownerInitial
                                    }
                                </div>
                                <div class="job-edit-linked-copy">
                                    <span>Owner</span>
                                    <strong>@ownerName</strong>
                                    <span>Customer record</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="JobOrderDate"
                               class="form-label fw-semibold">
                            Job Order Date
                        </label>

                        <input asp-for="JobOrderDate"
                               type="datetime-local"
                               class="form-control" />

                        <span asp-validation-for="JobOrderDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Status"
                               class="form-label fw-semibold">
                            Status
                        </label>

                        <select asp-for="Status"
                                class="form-select">
                            <option value="Open">Open</option>
                            <option value="In Progress">In Progress</option>
                            <option value="Completed">Completed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>

                        <span asp-validation-for="Status"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LaborCost"
                               class="form-label fw-semibold">
                            Labor Cost
                        </label>

                        <div class="input-group">
                            <span class="input-group-text">₱</span>

                            <input asp-for="LaborCost"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control" />
                        </div>

                        <span asp-validation-for="LaborCost"
                              class="text-danger"></span>
                    </div>

                </div>

            </div>

            <div class="job-form-section">

                <div class="job-section-heading">
                    <div class="job-section-icon">📝</div>
                    <div>
                        <h2>Repair Details</h2>
                        <p>Keep the repair description, diagnosis, and service notes updated.</p>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description"
                           class="form-label fw-semibold">
                        Repair Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Describe the repair or requested service..."></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Diagnosis"
                           class="form-label fw-semibold">
                        Diagnosis
                    </label>

                    <textarea asp-for="Diagnosis"
                              class="form-control"
                              rows="4"
                              placeholder="Enter the mechanic's diagnosis or findings..."></textarea>

                    <span asp-validation-for="Diagnosis"
                          class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="Notes"
                           class="form-label fw-semibold">
                        Additional Notes
                    </label>

                    <textarea asp-for="Notes"
                              class="form-control"
                              rows="3"
                              placeholder="Add additional notes or instructions..."></textarea>

                    <span asp-validation-for="Notes"
                          class="text-danger"></span>
                </div>

            </div>

            <div class="job-edit-parts">
                <div class="job-edit-parts-row">
                    <strong>Parts Used</strong>
                    <span>Choose the parts used for this repair. Inventory and Billing update automatically.</span>
                </div>

                <div class="job-create-part-entry" style="margin-top:10px;">
                    <select id="standaloneEditPartSelect" aria-label="Select part to use">
                        <option value="">Select part</option>
                        @if (ViewBag.PartId is SelectList editPartOptions)
                        {
                            foreach (var option in editPartOptions)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        }
                    </select>
                    <input type="number" id="standaloneEditPartQuantity" value="1" min="1" step="1" aria-label="Part quantity" />
                    <button type="button" class="af-button af-button-secondary" id="standaloneEditAddPart">+ Add Part</button>
                </div>

                <div class="job-edit-part-list" id="standaloneEditPartsList">
                    @foreach (var part in parts)
                    {
                        <div class="job-edit-part-item" data-part-id="@part.PartId" data-quantity="@part.Quantity" data-unit-price="@part.UnitPriceAtTimeOfUse">
                            <div>
                                <strong>@(part.Part?.Name ?? "Unknown Part")</strong>
                                <span>Qty @part.Quantity × ₱@part.UnitPriceAtTimeOfUse.ToString("N2")</span>
                            </div>
                            <button type="button" class="job-edit-part-remove" aria-label="Remove part">×</button>
                        </div>
                    }
                    @if (!parts.Any())
                    {
                        <div class="text-muted" id="standaloneEditPartsEmpty" style="padding:12px;font-size:.74rem;">No parts have been added to this job order yet.</div>
                    }
                </div>
                <div class="job-create-parts-total" style="margin-top:10px;">
                    <span>Estimated Parts Cost</span>
                    <strong id="standaloneEditPartsTotal">₱@partsTotal.ToString("N2")</strong>
                </div>
                <div id="standaloneEditPartHiddenInputs"></div>
            </div>

            <div class="job-form-footer">

                <a asp-action="Details"
                   asp-route-id="@Model.JobOrderId"
                   class="af-button af-button-secondary">
                    Cancel
                </a>

                <button type="submit"
                        class="af-button af-button-primary">
                    Save Changes
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}