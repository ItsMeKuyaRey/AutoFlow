@model IEnumerable<AutoFlow.Web.Models.JobOrder>
@using System.Text.Json

@{
    ViewData["Title"] = "Repair Job Orders";

    var jobs = Model.ToList();

    var initialOpen = ViewData["Open"]?.ToString() ?? "";
    var initialOpenId = ViewData["OpenId"]?.ToString() ?? "";
    var archivedJobOrderCount = ViewData["ArchivedJobOrderCount"] is int count ? count : 0;
    var billingIdsByJobOrder = ViewData["BillingIdsByJobOrder"] as Dictionary<int, int> ?? new Dictionary<int, int>();
    var billingStatusesByJobOrder = ViewData["BillingStatusesByJobOrder"] as Dictionary<int, string> ?? new Dictionary<int, string>();
    var jobOrderNotification = TempData["JobOrderNotification"]?.ToString();

    var vehicleOptions = ViewBag.VehicleId as SelectList;
    var vehicleImageMap = ViewData["VehicleImageMap"] as Dictionary<int, string> ?? new Dictionary<int, string>();
    var appointmentOptions = ViewBag.AppointmentId as SelectList;
    var appointmentMetaJson = ViewData["AppointmentMetaJson"]?.ToString() ?? "[]";
    var partOptions = ViewBag.PartId as SelectList;
    var partMetaJson = ViewData["PartMetaJson"]?.ToString() ?? "[]";
}

<div class="job-workspace">

    <div class="job-workspace-header">
        <div>
            <h1>Repair Job Orders</h1>
            <p>Manage repair work, track service progress, parts usage, and job costs.</p>
        </div>

        <div style="display:flex; gap:8px; align-items:center;">

        <a asp-action="Archived"
           class="job-secondary-button"
           style="text-decoration:none; display:inline-flex; align-items:center; justify-content:center; gap:7px;">
            Archived
            <span style="display:inline-flex; align-items:center; justify-content:center; min-width:20px; height:20px; padding:0 6px; border-radius:999px; background:#f1ecff; color:#6d3df5; font-size:.66rem; font-weight:800;">@archivedJobOrderCount</span>
        </a>

        <button type="button"
                class="job-primary-button"
                id="openCreateJob">
            <span class="job-button-plus">+</span>
            New Job Order
        </button>

        </div>
    </div>

    <div class="job-filter-card">

        <div class="job-search-box">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m20 20-4-4"></path>
            </svg>

            <input type="text"
                   id="jobSearch"
                   placeholder="Search by job order, vehicle, plate, or customer..." />
        </div>

        <select id="jobStatusFilter" class="job-filter-control">
            <option value="">All Statuses</option>
            <option value="Open">Open</option>
            <option value="In Progress">In Progress</option>
            <option value="Completed">Completed</option>
            <option value="Cancelled">Cancelled</option>
            <option value="Archived">Archived</option>
        </select>

        <select id="jobDateFilter" class="job-filter-control">
            <option value="">All Dates</option>
            <option value="today">Today</option>
            <option value="week">This Week</option>
            <option value="month">This Month</option>
        </select>

        <button type="button"
                class="job-filter-button"
                id="applyJobFilters">
            Filter
        </button>

        <button type="button"
                class="job-clear-button"
                id="clearJobFilters">
            Clear
        </button>

    </div>

    <div class="job-table-card">

        <div class="job-table-top">
            <div>
                <h2>Repair Jobs</h2>
                <span id="jobResultSummary"></span>
            </div>

            <div class="job-table-meta">
                <span class="job-status-summary">
                    <span class="job-summary-dot job-summary-open"></span>
                    <span id="openCount">0</span> open
                </span>

                <span class="job-status-summary">
                    <span class="job-summary-dot job-summary-progress"></span>
                    <span id="progressCount">0</span> in progress
                </span>

                <span class="job-status-summary">
                    <span class="job-summary-dot job-summary-completed"></span>
                    <span id="completedCount">0</span> completed
                </span>
            </div>
        </div>

        <div class="job-table-wrapper">

            <table class="job-modern-table">

                <thead>
                    <tr>
                        <th>JOB ORDER</th>
                        <th>VEHICLE</th>
                        <th>OWNER</th>
                        <th>DATE</th>
                        <th>STATUS</th>
                        <th>JOB VALUE</th>
                        <th class="job-action-column">ACTIONS</th>
                    </tr>
                </thead>

                <tbody id="jobTableBody">

                    @foreach (var item in jobs)
                    {
                        var ownerName =
                            item.Vehicle?.Customer == null
                                ? "No customer"
                                : $"{item.Vehicle.Customer.FirstName} {item.Vehicle.Customer.LastName}";

                        var vehicleName =
                            item.Vehicle == null
                                ? "No vehicle"
                                : $"{item.Vehicle.Make} {item.Vehicle.Model}";

                        var vehicleImageUrl = item.Vehicle?.ImageUrl ?? string.Empty;
                        var ownerImageUrl = item.Vehicle?.Customer?.ImageUrl ?? string.Empty;

                        var plate =
                            item.Vehicle?.PlateNumber ?? "—";

                        var appointmentText =
                            item.Appointment == null
                                ? "No appointment"
                                : item.Appointment.AppointmentDate
                                    .ToString("MMM dd, yyyy hh:mm tt");

                        var displayStatus =
                            item.IsArchived
                                ? "Archived"
                                : item.Status;

                        var badgeClass =
                            item.IsArchived
                                ? "job-badge-archived"
                                : item.Status switch
                                {
                                    "Open" => "job-badge-blue",
                                    "In Progress" => "job-badge-orange",
                                    "Completed" => "job-badge-green",
                                    "Cancelled" => "job-badge-red",
                                    _ => "job-badge-blue"
                                };

                        var billingId = billingIdsByJobOrder.TryGetValue(item.JobOrderId, out var foundBillingId)
                            ? foundBillingId
                            : 0;

                        var billingStatus = billingStatusesByJobOrder.TryGetValue(item.JobOrderId, out var foundBillingStatus)
                            ? foundBillingStatus
                            : string.Empty;

                        <tr class="job-data-row"
                            data-id="@item.JobOrderId"
                            data-status="@displayStatus"
                            data-job-status="@item.Status"
                            data-archived="@item.IsArchived.ToString().ToLowerInvariant()"
                            data-date="@item.JobOrderDate.ToString("yyyy-MM-dd")"
                            data-search="@($"#{item.JobOrderId} {vehicleName} {plate} {ownerName}")"
                            data-vehicle-id="@item.VehicleId"
                            data-vehicle="@vehicleName"
                            data-vehicle-image="@vehicleImageUrl"
                            data-plate="@plate"
                            data-owner="@ownerName"
                            data-owner-image="@ownerImageUrl"
                            data-appointment-id="@(item.AppointmentId?.ToString() ?? "")"
                            data-appointment="@appointmentText"
                            data-job-date="@item.JobOrderDate.ToString("yyyy-MM-ddTHH:mm")"
                            data-labor="@item.LaborCost.ToString("0.00")"
                            data-description="@(item.Description ?? "")"
                            data-diagnosis="@(item.Diagnosis ?? "")"
                            data-notes="@(item.Notes ?? "")"
                            data-parts="@JsonSerializer.Serialize(item.JobOrderParts.Select(jp => new { id = jp.PartId, quantity = jp.Quantity, name = jp.Part?.Name ?? "Unknown Part", unitPrice = jp.UnitPriceAtTimeOfUse, archived = jp.Part?.IsArchived ?? false }))"
                            data-total="@item.TotalCost.ToString("0.00")"
                            data-billing-id="@billingId"
                            data-billing-status="@billingStatus">

                            <td>
                                <div class="job-primary-cell">
                                    <strong>#@item.JobOrderId</strong>
                                    <span>
                                        @item.JobOrderDate.ToString("MMM dd, yyyy")
                                    </span>
                                </div>
                            </td>

                            <td>
                                <div class="job-vehicle-cell">
                                    <div class="job-vehicle-icon job-vehicle-photo">
                                        @if (!string.IsNullOrWhiteSpace(vehicleImageUrl))
                                        {
                                            <img src="@vehicleImageUrl"
                                                 alt="@vehicleName"
                                                 loading="lazy" />
                                        }
                                        else
                                        {
                                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="M5 17h14"></path>
                                                <path d="M6 17l1-5h10l1 5"></path>
                                                <path d="M8 12l1.5-4h5L16 12"></path>
                                                <circle cx="8" cy="17" r="1.5"></circle>
                                                <circle cx="16" cy="17" r="1.5"></circle>
                                            </svg>
                                        }
                                    </div>

                                    <div>
                                        <strong>@vehicleName</strong>
                                        <span>@plate</span>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <div class="job-owner-cell">
                                    <div class="job-owner-avatar job-owner-photo">
                                        @if (!string.IsNullOrWhiteSpace(ownerImageUrl))
                                        {
                                            <img src="@ownerImageUrl"
                                                 alt="@ownerName"
                                                 loading="lazy" />
                                        }
                                        else
                                        {
                                            @(item.Vehicle?.Customer?.FirstName?.FirstOrDefault().ToString().ToUpperInvariant() ?? "?")
                                        }
                                    </div>

                                    <div>
                                        <strong>@ownerName</strong>

                                        @if (!string.IsNullOrWhiteSpace(item.Vehicle?.Customer?.Phone))
                                        {
                                            <span>@item.Vehicle.Customer.Phone</span>
                                        }
                                        else
                                        {
                                            <span>Customer record</span>
                                        }
                                    </div>
                                </div>
                            </td>

                            <td>
                                <div class="job-date-cell">
                                    <strong>
                                        @item.JobOrderDate.ToString("MMM dd, yyyy")
                                    </strong>

                                    <span>
                                        @item.JobOrderDate.ToString("hh:mm tt")
                                    </span>
                                </div>
                            </td>

                            <td>
                                <div style="display:flex;align-items:center;gap:7px;flex-wrap:wrap;">
                                    <span class="job-status-badge @badgeClass">
                                        <span></span>
                                        @displayStatus
                                    </span>
                                    @if (billingId > 0)
                                    {
                                        <span style="display:inline-flex;align-items:center;height:24px;padding:0 8px;border-radius:999px;background:#f5f3ff;color:#6d28d9;font-size:9px;font-weight:800;">Invoiced</span>
                                    }
                                </div>
                            </td>

                            <td>
                                <strong class="job-value">
                                    ₱@item.TotalCost.ToString("N2")
                                </strong>

                                <span class="job-value-sub">
                                    Labor ₱@item.LaborCost.ToString("N2")
                                </span>
                            </td>

                            <td>
                                <div class="job-row-actions">

                                    <button type="button"
                                            class="job-icon-button"
                                            data-job-action="view"
                                            title="View Job Order">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6z"></path>
                                            <circle cx="12" cy="12" r="2.5"></circle>
                                        </svg>
                                    </button>

                                    <button type="button"
                                            class="job-icon-button"
                                            data-job-action="edit"
                                            title="Edit Job Order">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M12 20h9"></path>
                                            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4z"></path>
                                        </svg>
                                    </button>

                                    @if (!item.IsArchived)
                                    {
                                        <button type="button"
                                                class="job-icon-button job-icon-danger"
                                                data-job-action="archive"
                                                title="Archive Job Order">
                                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="M4 7h16"></path>
                                                <path d="M5 7l1 13h12l1-13"></path>
                                                <path d="M9 11h6"></path>
                                                <path d="M9 4h6l1 3H8l1-3z"></path>
                                            </svg>
                                        </button>
                                    }
                                    else
                                    {
                                        <form asp-action="Restore" method="post" class="job-inline-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.JobOrderId" />
                                            <button type="submit"
                                                    class="job-icon-button job-icon-restore"
                                                    title="Restore Job Order"
                                                    aria-label="Restore Job Order #@item.JobOrderId">
                                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                                    <path d="M3 12a9 9 0 1 0 3-6.7"></path>
                                                    <path d="M3 4v6h6"></path>
                                                </svg>
                                            </button>
                                        </form>
                                    }

                                </div>
                            </td>
                        </tr>

                        <template id="job-details-@item.JobOrderId">

                            <div class="job-detail-section">

                                <div class="job-detail-section-title">
                                    Job Information
                                </div>

                                <div class="job-detail-grid">

                                    <div>
                                        <span>Job Order</span>
                                        <strong>#@item.JobOrderId</strong>
                                    </div>

                                    <div>
                                        <span>Status</span>
                                        <strong>@item.Status</strong>
                                    </div>

                                    <div>
                                        <span>Job Date</span>
                                        <strong>
                                            @item.JobOrderDate.ToString("MMM dd, yyyy hh:mm tt")
                                        </strong>
                                    </div>

                                    <div>
                                        <span>Appointment</span>
                                        <strong>@appointmentText</strong>
                                    </div>

                                </div>

                            </div>

                            <div class="job-detail-section">

                                <div class="job-detail-section-title">
                                    Vehicle & Customer
                                </div>

                                <div class="job-detail-people-grid">

                                    <div class="job-detail-profile-card">
                                        <div class="job-detail-profile-media job-detail-vehicle-media">
                                            @if (!string.IsNullOrWhiteSpace(vehicleImageUrl))
                                            {
                                                <img src="@vehicleImageUrl" alt="@vehicleName" loading="lazy" />
                                            }
                                            else
                                            {
                                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                                    <path d="M5 17h14"></path>
                                                    <path d="M6 17l1-5h10l1 5"></path>
                                                    <path d="M8 12l1.5-4h5L16 12"></path>
                                                    <circle cx="8" cy="17" r="1.5"></circle>
                                                    <circle cx="16" cy="17" r="1.5"></circle>
                                                </svg>
                                            }
                                        </div>
                                        <div class="job-detail-profile-copy">
                                            <span class="job-detail-profile-label">Vehicle</span>
                                            <strong>@vehicleName</strong>
                                            <span>@plate</span>
                                            @if (!string.IsNullOrWhiteSpace(vehicleImageUrl))
                                            {
                                                <small><i class="bi bi-check-circle-fill"></i> Vehicle image linked</small>
                                            }
                                            else
                                            {
                                                <small><i class="bi bi-info-circle-fill"></i> No vehicle image saved</small>
                                            }
                                        </div>
                                    </div>

                                    <div class="job-detail-profile-card">
                                        <div class="job-detail-profile-media job-detail-owner-media">
                                            @if (!string.IsNullOrWhiteSpace(ownerImageUrl))
                                            {
                                                <img src="@ownerImageUrl" alt="@ownerName" loading="lazy" />
                                            }
                                            else
                                            {
                                                <span>@(item.Vehicle?.Customer?.FirstName?.FirstOrDefault().ToString().ToUpperInvariant() ?? "?")</span>
                                            }
                                        </div>
                                        <div class="job-detail-profile-copy">
                                            <span class="job-detail-profile-label">Owner</span>
                                            <strong>@ownerName</strong>
                                            @if (!string.IsNullOrWhiteSpace(item.Vehicle?.Customer?.Phone))
                                            {
                                                <span>@item.Vehicle.Customer.Phone</span>
                                            }
                                            else
                                            {
                                                <span>Customer record</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(ownerImageUrl))
                                            {
                                                <small><i class="bi bi-check-circle-fill"></i> Owner image linked</small>
                                            }
                                            else
                                            {
                                                <small><i class="bi bi-info-circle-fill"></i> No owner image saved</small>
                                            }
                                        </div>
                                    </div>

                                </div>

                            </div>

                            <div class="job-detail-section">

                                <div class="job-detail-section-title">
                                    Repair Details
                                </div>

                                <div class="job-detail-text-card">

                                    <div>
                                        <span>Description</span>
                                        <p>
                                            @(string.IsNullOrWhiteSpace(item.Description)
                                                ? "No repair description recorded."
                                                : item.Description)
                                        </p>
                                    </div>

                                    <div>
                                        <span>Diagnosis</span>
                                        <p>
                                            @(string.IsNullOrWhiteSpace(item.Diagnosis)
                                                ? "No diagnosis recorded."
                                                : item.Diagnosis)
                                        </p>
                                    </div>

                                    <div>
                                        <span>Notes</span>
                                        <p>
                                            @(string.IsNullOrWhiteSpace(item.Notes)
                                                ? "No additional notes."
                                                : item.Notes)
                                        </p>
                                    </div>

                                </div>

                            </div>

                            <div class="job-detail-section">

                                <div class="job-detail-section-title">
                                    Parts Used
                                </div>

                                @if (item.JobOrderParts.Any())
                                {
                                    <div class="job-parts-list">

                                        @foreach (var jobPart in item.JobOrderParts)
                                        {
                                            <div class="job-part-row">

                                                <div>
                                                    <strong>
                                                        @(jobPart.Part?.Name ?? "Unknown Part")
                                                    </strong>

                                                    <span>
                                                        Qty @jobPart.Quantity ×
                                                        ₱@jobPart.UnitPriceAtTimeOfUse.ToString("N2")
                                                    </span>
                                                </div>

                                                <div class="job-part-actions">

                                                    <strong>
                                                        ₱@((jobPart.Quantity * jobPart.UnitPriceAtTimeOfUse).ToString("N2"))
                                                    </strong>

                                                    <form asp-action="RemovePart"
                                                          method="post">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="jobOrderPartId"
                                                               value="@jobPart.JobOrderPartId" />

                                                        <input type="hidden"
                                                               name="jobOrderId"
                                                               value="@item.JobOrderId" />

                                                        <button type="submit"
                                                                class="job-part-remove"
                                                                title="Remove Part">
                                                            ×
                                                        </button>

                                                    </form>

                                                </div>

                                            </div>
                                        }

                                    </div>
                                }
                                else
                                {
                                    <div class="job-no-parts">
                                        No parts have been added to this job order yet.
                                    </div>
                                }

                            </div>

                            <div class="job-cost-summary">

                                <div>
                                    <span>Labor Cost</span>
                                    <strong>₱@item.LaborCost.ToString("N2")</strong>
                                </div>

                                <div>
                                    <span>Parts Cost</span>
                                    <strong>₱@item.PartsCost.ToString("N2")</strong>
                                </div>

                                <div class="job-total-cost">
                                    <span>Total Job Value</span>
                                    <strong>₱@item.TotalCost.ToString("N2")</strong>
                                </div>

                            </div>

                        </template>
                    }

                </tbody>

            </table>

        </div>

        <div id="jobEmptyState"
             class="job-empty-state"
             style="display:none;">

            <div class="job-empty-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 17h14"></path>
                    <path d="M6 17l1-5h10l1 5"></path>
                    <path d="M8 12l1.5-4h5L16 12"></path>
                    <circle cx="8" cy="17" r="1.5"></circle>
                    <circle cx="16" cy="17" r="1.5"></circle>
                </svg>
            </div>

            <h3>No Job Orders Found</h3>
            <p>
                No repair jobs match your current search or filters.
            </p>

        </div>

        <div class="job-table-footer">

            <span id="jobPaginationText">
                Showing 0–0 of 0 job orders
            </span>

            <div class="job-pagination"
                 id="jobPagination">
            </div>

        </div>

    </div>

</div>


<div class="job-drawer"
     id="jobCreateDrawer">

    <div class="job-drawer-header">

        <div>
            <span class="job-drawer-kicker">REPAIR MANAGEMENT</span>
            <h2>New Job Order</h2>
            <p>Create a repair job and connect it to a customer's vehicle.</p>
        </div>

        <button type="button"
                class="job-drawer-close"
                data-close-drawer>
            ×
        </button>

    </div>

    <form asp-action="Create"
          method="post"
          id="jobCreateForm"
          class="job-drawer-form">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="job-form-section-title">
            Job Information
        </div>

        <div class="job-form-grid">

            <div class="job-field job-field-full">
                <label>Vehicle</label>

                <select name="VehicleId"
                        id="jobCreateVehicleId"
                        required>
                    <option value="">Select vehicle</option>

                    @if (vehicleOptions != null)
                    {
                        foreach (var option in vehicleOptions)
                        {
                            var vehicleId = int.TryParse(option.Value, out var parsedVehicleId) ? parsedVehicleId : 0;
                            var vehicleImage = vehicleImageMap.TryGetValue(vehicleId, out var image) ? image : string.Empty;

                            <option value="@option.Value" data-image="@vehicleImage">
                                @option.Text
                            </option>
                        }
                    }
                </select>

                <div class="job-selected-vehicle" id="jobCreateSelectedVehicle" hidden>
                    <div class="job-selected-vehicle-image">
                        <img id="jobCreateVehicleImage" src="" alt="Selected vehicle" />
                    </div>
                    <div class="job-selected-vehicle-copy">
                        <strong id="jobCreateVehicleName">Vehicle selected</strong>
                        <span id="jobCreateVehicleStatus"><i class="bi bi-check-circle-fill"></i> Vehicle image linked</span>
                    </div>
                </div>
            </div>

            <div class="job-field job-field-full">
                <label>Appointment</label>

                <select name="AppointmentId"
                        id="jobCreateAppointmentId">
                    <option value="">No appointment</option>

                    @if (appointmentOptions != null)
                    {
                        foreach (var option in appointmentOptions)
                        {
                            var appointmentId = int.TryParse(option.Value, out var parsedAppointmentId) ? parsedAppointmentId : 0;
                            <option value="@option.Value"
                                    data-appointment-id="@appointmentId">
                                @option.Text
                            </option>
                        }
                    }
                </select>

                <small class="job-appointment-link-note"
                       id="jobCreateAppointmentNote">
                    Select a vehicle to automatically link its scheduled repair appointment when one exists.
                </small>
            </div>

            <div class="job-field">
                <label>Job Order Date</label>
                <input type="datetime-local"
                       name="JobOrderDate"
                       id="jobCreateJobOrderDate"
                       value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                       required />
                <small class="job-appointment-link-note"
                       id="jobCreateJobDateNote">
                    Manual date — no appointment is linked.
                </small>
            </div>

            <div class="job-field">
                <label>Status</label>

                <select name="Status">
                    <option value="Open">Open</option>
                    <option value="In Progress">In Progress</option>
                    <option value="Completed">Completed</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
            </div>

            <div class="job-field job-field-full">
                <label>Labor Cost</label>

                <div class="job-money-input">
                    <span>₱</span>
                    <input type="number"
                           name="LaborCost"
                           value="0"
                           min="0"
                           step="0.01" />
                </div>
            </div>

        </div>

        <div class="job-form-section-title">
            Parts Used
        </div>

        <div class="job-create-parts-panel" id="jobCreatePartsPanel">
            <div class="job-create-parts-help">
                Add the parts that will be used for this repair. Selected parts are linked to the job order, deducted from Parts Inventory, and included automatically in Billing.
            </div>

            <div class="job-create-part-entry">
                <select id="jobCreatePartSelect" aria-label="Select part to use">
                    <option value="">Select part</option>
                    @if (partOptions != null)
                    {
                        foreach (var option in partOptions)
                        {
                            <option value="@option.Value">@option.Text</option>
                        }
                    }
                </select>

                <input type="number"
                       id="jobCreatePartQuantity"
                       value="1"
                       min="1"
                       step="1"
                       aria-label="Part quantity" />

                <button type="button"
                        class="job-secondary-button job-add-part-button"
                        id="jobCreateAddPart">
                    + Add Part
                </button>
            </div>

            <div class="job-create-parts-list" id="jobCreatePartsList">
                <div class="job-create-parts-empty" id="jobCreatePartsEmpty">No parts added yet.</div>
            </div>

            <div class="job-create-parts-total" id="jobCreatePartsTotal">
                <span>Estimated Parts Cost</span>
                <strong>₱0.00</strong>
            </div>

            <div id="jobCreatePartHiddenInputs"></div>
        </div>

        <div class="job-form-section-title">
            Repair Details
        </div>

        <div class="job-field">
            <label>Repair Description</label>

            <textarea name="Description"
                      rows="4"
                      placeholder="Describe the customer's repair request or reported problem..."></textarea>
        </div>

        <div class="job-field">
            <label>Diagnosis</label>

            <textarea name="Diagnosis"
                      rows="4"
                      placeholder="Enter the technician's diagnosis or findings..."></textarea>
        </div>

        <div class="job-field">
            <label>Additional Notes</label>

            <textarea name="Notes"
                      rows="3"
                      placeholder="Add instructions, observations, or other important notes..."></textarea>
        </div>

        <div class="job-drawer-footer">

            <button type="button"
                    class="job-secondary-button"
                    data-close-drawer>
                Cancel
            </button>

            <button type="submit"
                    class="job-primary-button">
                Create Job Order
            </button>

        </div>

    </form>

</div>


<div class="job-drawer"
     id="jobEditDrawer">

    <div class="job-drawer-header">

        <div>
            <span class="job-drawer-kicker">REPAIR MANAGEMENT</span>
            <h2>Edit Job Order</h2>
            <p>Update repair progress, costs, and service information.</p>
        </div>

        <button type="button"
                class="job-drawer-close"
                data-close-drawer>
            ×
        </button>

    </div>

    <form method="post"
          id="jobEditForm"
          class="job-drawer-form">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="JobOrderId"
               id="editJobOrderId" />

        <div class="job-form-section-title">
            Job Information
        </div>

        <div class="job-form-grid">

            <div class="job-field job-field-full">
                <label>Vehicle</label>

                <select name="VehicleId"
                        id="editVehicleId"
                        required>
                    <option value="">Select vehicle</option>

                    @if (vehicleOptions != null)
                    {
                        foreach (var option in vehicleOptions)
                        {
                            var vehicleId = int.TryParse(option.Value, out var parsedVehicleId) ? parsedVehicleId : 0;
                            var vehicleImage = vehicleImageMap.TryGetValue(vehicleId, out var image) ? image : string.Empty;

                            <option value="@option.Value" data-image="@vehicleImage">
                                @option.Text
                            </option>
                        }
                    }
                </select>

                <div class="job-selected-vehicle" id="jobEditSelectedVehicle" hidden>
                    <div class="job-selected-vehicle-image">
                        <img id="jobEditVehicleImage" src="" alt="Selected vehicle" />
                    </div>
                    <div class="job-selected-vehicle-copy">
                        <strong id="jobEditVehicleName">Vehicle selected</strong>
                        <span id="jobEditVehicleStatus"><i class="bi bi-check-circle-fill"></i> Vehicle image linked</span>
                    </div>
                </div>
            </div>

            <div class="job-field job-field-full">
                <label>Appointment</label>

                <select name="AppointmentId"
                        id="editAppointmentId">

                    <option value="">No appointment</option>

                    @if (appointmentOptions != null)
                    {
                        foreach (var option in appointmentOptions)
                        {
                            <option value="@option.Value">
                                @option.Text
                            </option>
                        }
                    }

                </select>
            </div>

            <div class="job-field">
                <label>Job Order Date</label>

                <input type="datetime-local"
                       name="JobOrderDate"
                       id="editJobOrderDate"
                       required />
            </div>

            <div class="job-field">
                <label>Status</label>

                <select name="Status"
                        id="editStatus">

                    <option value="Open">Open</option>
                    <option value="In Progress">In Progress</option>
                    <option value="Completed">Completed</option>
                    <option value="Cancelled">Cancelled</option>

                </select>
            </div>

            <div class="job-field job-field-full">
                <label>Labor Cost</label>

                <div class="job-money-input">
                    <span>₱</span>

                    <input type="number"
                           name="LaborCost"
                           id="editLaborCost"
                           min="0"
                           step="0.01" />
                </div>
            </div>

        </div>

        <div class="job-form-section-title">
            Parts Used
        </div>

        <div class="job-create-parts-panel job-edit-parts-panel" id="jobEditPartsPanel">
            <div class="job-create-parts-help">
                Add the parts that will be used for this repair. Selected parts are linked to the job order, deducted from Parts Inventory, and included automatically in Billing.
            </div>

            <div class="job-create-part-entry">
                <select id="jobEditPartSelect" aria-label="Select part to use">
                    <option value="">Select part</option>
                    @if (partOptions != null)
                    {
                        foreach (var option in partOptions)
                        {
                            <option value="@option.Value">@option.Text</option>
                        }
                    }
                </select>

                <input type="number"
                       id="jobEditPartQuantity"
                       value="1"
                       min="1"
                       step="1"
                       aria-label="Part quantity" />

                <button type="button"
                        class="job-secondary-button job-add-part-button"
                        id="jobEditAddPart">
                    + Add Part
                </button>
            </div>

            <div class="job-create-parts-list" id="jobEditPartsList">
                <div class="job-create-parts-empty" id="jobEditPartsEmpty">No parts added yet.</div>
            </div>

            <div class="job-create-parts-total" id="jobEditPartsTotal">
                <span>Estimated Parts Cost</span>
                <strong>₱0.00</strong>
            </div>

            <div id="jobEditPartHiddenInputs"></div>
            <input type="hidden" name="partsUsedJson" id="jobEditPartsJson" value="[]" />
        </div>

        <div class="job-form-section-title">
            Repair Details
        </div>

        <div class="job-field">
            <label>Repair Description</label>

            <textarea name="Description"
                      id="editDescription"
                      rows="4"></textarea>
        </div>

        <div class="job-field">
            <label>Diagnosis</label>

            <textarea name="Diagnosis"
                      id="editDiagnosis"
                      rows="4"></textarea>
        </div>

        <div class="job-field">
            <label>Additional Notes</label>

            <textarea name="Notes"
                      id="editNotes"
                      rows="3"></textarea>
        </div>

        <div class="job-drawer-footer">

            <button type="button"
                    class="job-secondary-button"
                    data-close-drawer>
                Cancel
            </button>

            <button type="submit"
                    class="job-primary-button">
                Save Changes
            </button>

        </div>

    </form>

</div>


<div class="job-drawer"
     id="jobDetailsDrawer">

    <div class="job-drawer-header">

        <div>
            <span class="job-drawer-kicker">JOB ORDER SUMMARY</span>
            <h2 id="detailsJobTitle">Job Order</h2>
            <p id="detailsJobSubtitle">Repair information</p>
        </div>

        <button type="button"
                class="job-drawer-close"
                data-close-drawer>
            ×
        </button>

    </div>

    <div class="job-details-body">

        <div class="job-detail-status-line">
            <span id="detailsStatusBadge"
                  class="job-status-badge job-badge-blue">
                <span></span>
                Open
            </span>
        </div>

        <div id="detailsContent"></div>

        <div class="job-detail-actions">

            <button type="button"
                    class="job-secondary-button"
                    id="detailsAddPart">
                Add Part
            </button>

            <a class="job-secondary-button"
               id="detailsCreateInvoice"
               href="#"
               style="display:none; text-decoration:none; align-items:center; justify-content:center;">
                Create Invoice
            </a>

            <span id="detailsInvoiceCreated"
                  style="display:none; align-items:center; justify-content:center; height:36px; padding:0 10px; border:1px solid #ddd6fe; border-radius:9px; background:#f5f3ff; color:#6d28d9; font-size:9px; font-weight:800;">
                Invoice Created
            </span>

            <a class="job-secondary-button"
               id="detailsBilling"
               href="#"
               style="display:none; text-decoration:none; align-items:center; justify-content:center;">
