@{
    Layout = null;

    // AutoFlow always goes to the dashboard after successful login.
    var returnUrl = "/Home/Index";

    var firebaseApiKey =
        ViewData["FirebaseApiKey"]?.ToString() ?? "";

    var firebaseAuthDomain =
        ViewData["FirebaseAuthDomain"]?.ToString() ?? "";

    var firebaseProjectId =
        ViewData["FirebaseProjectId"]?.ToString() ?? "";

    var firebaseStorageBucket =
        ViewData["FirebaseStorageBucket"]?.ToString() ?? "";

    var firebaseMessagingSenderId =
        ViewData["FirebaseMessagingSenderId"]?.ToString() ?? "";

    var firebaseAppId =
        ViewData["FirebaseAppId"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Login | AutoFlow</title>

    <style>

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            min-height: 100%;
            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                Helvetica,
                Arial,
                sans-serif;
            background: #f7f7fb;
            color: #172033;
        }

        body {
            min-height: 100vh;

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 24px;
        }

        .login-wrapper {
            width: 100%;
            max-width: 440px;
        }

        .login-card {
            background: #ffffff;

            border: 1px solid #e8e8ef;

            border-radius: 20px;

            padding: 42px 38px 34px;

            box-shadow:
                0 18px 50px rgba(28, 25, 48, 0.08);

            text-align: center;
        }

        .brand-icon {
            width: 64px;
            height: 64px;

            margin: 0 auto 22px;

            border-radius: 18px;

            background: #6d4aff;
            color: white;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 25px;
            font-weight: 800;

            letter-spacing: -1px;

            box-shadow:
                0 10px 25px rgba(109, 74, 255, 0.22);
        }

        h1 {
            margin: 0;

            font-size: 28px;
            font-weight: 750;

            letter-spacing: -0.6px;
        }

        .subtitle {
            margin: 10px auto 30px;

            max-width: 330px;

            color: #73788a;

            font-size: 14px;
            line-height: 1.6;
        }

        .google-button {
            width: 100%;
            height: 52px;

            border: 1px solid #dedee7;

            border-radius: 11px;

            background: #ffffff;

            color: #252838;

            font-size: 14px;
            font-weight: 650;

            cursor: pointer;

            display: flex;
            align-items: center;
            justify-content: center;

            gap: 12px;

            transition:
                background 0.2s ease,
                border-color 0.2s ease,
                box-shadow 0.2s ease,
                transform 0.2s ease;
        }

        .google-button:hover {
            background: #fafafe;

            border-color: #cfcfe0;

            box-shadow:
                0 6px 18px rgba(30, 28, 50, 0.08);

            transform: translateY(-1px);
        }

        .google-button:disabled {
            opacity: 0.65;

            cursor: not-allowed;

            transform: none;

            box-shadow: none;
        }

        .google-icon {
            width: 19px;
            height: 19px;

            display: block;
        }

        .status-message {
            display: none;

            margin-top: 18px;

            padding: 12px 14px;

            border-radius: 10px;

            background: #fff2f2;

            border: 1px solid #ffd8d8;

            color: #b42318;

            font-size: 13px;

            line-height: 1.45;

            text-align: left;
        }

        .status-message.show {
            display: block;
        }

        .authorized {
            margin-top: 28px;

            padding-top: 24px;

            border-top: 1px solid #eeeeF3;
        }

        .authorized-title {
            margin: 0 0 7px;

            font-size: 11px;

            font-weight: 800;

            letter-spacing: 1.2px;

            color: #6d4aff;
        }

        .authorized-text {
            margin: 0;

            color: #8a8e9d;

            font-size: 12px;

            line-height: 1.55;
        }

        .footer {
            margin-top: 28px;

            color: #a0a3af;

            font-size: 11px;

            letter-spacing: 0.3px;
        }

        .spinner {
            width: 17px;
            height: 17px;

            border: 2px solid #ddddE8;

            border-top-color: #6d4aff;

            border-radius: 50%;

            animation: spin 0.7s linear infinite;
        }

        @@keyframes spin {

            to {
                transform: rotate(360deg);
            }
        }

        @@media (max-width: 480px) {

            body {
                padding: 16px;
            }

            .login-card {
                padding: 34px 24px 28px;

                border-radius: 16px;
            }

            h1 {
                font-size: 25px;
            }

        }

    </style>

</head>

<body>

    <main class="login-wrapper">

        <section class="login-card">

            <!-- ASP.NET Core Antiforgery Token -->

            <div style="display:none;">

                @Html.AntiForgeryToken()

            </div>


            <!-- AutoFlow Brand -->

            <div class="brand-icon">

                AF

            </div>


            <!-- Heading -->

            <h1>

                Welcome to AutoFlow

            </h1>


            <p class="subtitle">

                Sign in to access the AutoFlow automotive repair
                management system.

            </p>


            <!-- Google Sign-In -->

            <button
                id="googleSignInButton"
                class="google-button"
                type="button">

                <svg
                    class="google-icon"
                    viewBox="0 0 24 24"
                    aria-hidden="true">

                    <path
                        fill="#4285F4"
                        d="M21.35 12.23c0-.71-.06-1.39-.18-2.05H12v3.88h5.24a4.48 4.48 0 0 1-1.94 2.94v2.45h3.14c1.84-1.69 2.91-4.18 2.91-7.22z" />

                    <path
                        fill="#34A853"
                        d="M12 21.76c2.63 0 4.84-.87 6.45-2.35l-3.14-2.45c-.87.58-1.98.92-3.31.92-2.54 0-4.69-1.72-5.46-4.03H3.3v2.52A9.75 9.75 0 0 0 12 21.76z" />

                    <path
                        fill="#FBBC05"
                        d="M6.54 13.85a5.86 5.86 0 0 1 0-3.7V7.63H3.3a9.77 9.77 0 0 0 0 8.74l3.24-2.52z" />

                    <path
                        fill="#EA4335"
                        d="M12 6.12c1.43 0 2.72.49 3.73 1.45l2.8-2.8C16.83 3.18 14.63 2.24 12 2.24A9.75 9.75 0 0 0 3.3 7.63l3.24 2.52C7.31 7.84 9.46 6.12 12 6.12z" />

                </svg>

                <span id="googleButtonText">

                    Continue with Google

                </span>

            </button>


            <!-- Error Message -->

            <div
                id="statusMessage"
                class="status-message"
                role="alert">
            </div>


            <!-- Authorization Notice -->

            <div class="authorized">

                <p class="authorized-title">

                    AUTHORIZED ACCESS ONLY

                </p>

                <p class="authorized-text">

                    Sign in using your authorized Google account.
                    Access is restricted to AutoFlow personnel.

                </p>

            </div>


            <!-- Footer -->

            <div class="footer">

                AutoFlow Enterprise ERP

            </div>

        </section>

    </main>


    <!-- Firebase Authentication -->

    <script type="module">

        import { initializeApp }
            from "https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";

        import {
            getAuth,
            GoogleAuthProvider,
            signInWithPopup,
            signOut
        }
            from "https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";


        // Firebase Configuration

        const firebaseConfig = {

            apiKey:
                @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                        firebaseApiKey
                    )
                ),

            authDomain:
                @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                        firebaseAuthDomain
                    )
                ),

            projectId:
                @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                        firebaseProjectId
                    )
                ),

            storageBucket:
                @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                        firebaseStorageBucket
                    )
                ),

            messagingSenderId:
                @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                        firebaseMessagingSenderId
                    )
                ),

            appId:
                @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                        firebaseAppId
                    )
                )

        };


        // Firebase Initialization

        const firebaseApp =
            initializeApp(firebaseConfig);

        const auth =
            getAuth(firebaseApp);

        const provider =
            new GoogleAuthProvider();

        provider.setCustomParameters({
            prompt: "select_account"
        });


        // DOM Elements

        const button =
            document.getElementById(
                "googleSignInButton"
            );

        const buttonText =
            document.getElementById(
                "googleButtonText"
            );

        const statusMessage =
            document.getElementById(
                "statusMessage"
            );


        // Display Error

        function showError(message) {

            statusMessage.textContent =
                message;

            statusMessage.classList.add(
                "show"
            );

        }


        // Reset Button

        function resetButton() {

            button.disabled = false;

            buttonText.textContent =
                "Continue with Google";

        }


        // Google Authentication

        button.addEventListener(
            "click",
            async () => {

                statusMessage.classList.remove(
                    "show"
                );

                button.disabled = true;

                buttonText.innerHTML =
                    '<span class="spinner"></span> Signing in...';


                try {

                    // Sign out any existing Firebase account first.

                    await signOut(auth);


                    // Sign in with Google through Firebase.

                    const result =
                        await signInWithPopup(
                            auth,
                            provider
                        );


                    // Get Firebase ID token.

                    const idToken =
                        await result.user.getIdToken(
                            true
                        );


                    if (!idToken) {

                        throw new Error(
                            "Firebase did not return an ID token."
                        );

                    }


                    // Get ASP.NET Core antiforgery token.

                    const antiforgeryToken =
                        document.querySelector(
                            'input[name="__RequestVerificationToken"]'
                        )?.value;


                    if (!antiforgeryToken) {

                        throw new Error(
                            "Security token is missing. Please refresh the login page and try again."
                        );

                    }


                    // Create request body.

                    const formData =
                        new FormData();

                    formData.append(
                        "idToken",
                        idToken
                    );


                    // Always use the AutoFlow dashboard.

                    formData.append(
                        "returnUrl",
                        "/Home/Index"
                    );


                    // Send Firebase token to ASP.NET Core.

                    const response =
                        await fetch(
                            "/Auth/FirebaseLogin",
                            {
                                method: "POST",

                                body: formData,

                                credentials:
                                    "same-origin",

                                headers: {
                                    "RequestVerificationToken":
                                        antiforgeryToken
                                }
                            }
                        );


                    // Read server response.

                    const responseText =
                        await response.text();


                    let data = {};


                    if (responseText) {

                        try {

                            data =
                                JSON.parse(
                                    responseText
                                );

                        }
                        catch {

                            console.error(
                                "AutoFlow server returned non-JSON:",
                                responseText
                            );

                            throw new Error(
                                `Server returned an unexpected response (${response.status}).`
                            );

                        }

                    }


                    // Handle failed authentication.

                    if (
                        !response.ok ||
                        !data.success
                    ) {

                        throw new Error(
                            data.message ||
                            `Unable to sign in to AutoFlow. Server status: ${response.status}.`
                        );

                    }


                    // Successfully authenticate and go to dashboard.

                    window.location.replace(
                        "/Home/Index"
                    );


                }
                catch (error) {

                    console.error(
                        "AutoFlow Firebase login error:",
                        error
                    );


                    let message =
                        "Google sign-in failed. Please try again.";


                    if (
                        error &&
                        typeof error.message === "string" &&
                        error.message.length > 0
                    ) {

                        message =
                            error.message;

                    }


                    showError(
                        message
                    );


                    resetButton();

                }

            }
        );

    </script>

</body>

</html>