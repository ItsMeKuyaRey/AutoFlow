@{
    Layout = null;

    // AutoFlow always goes to the dashboard after successful login.
    var returnUrl = "/Home/Index";

    var firebaseApiKey =
        ViewData["FirebaseApiKey"]?.ToString() ?? "";

    var firebaseAuthDomain =
        ViewData["FirebaseAuthDomain"]?.ToString() ?? "";

    var firebaseProjectId =
        ViewData["FirebaseProjectId"]?.ToString() ?? "";

    var firebaseStorageBucket =
        ViewData["FirebaseStorageBucket"]?.ToString() ?? "";

    var firebaseMessagingSenderId =
        ViewData["FirebaseMessagingSenderId"]?.ToString() ?? "";

    var firebaseAppId =
        ViewData["FirebaseAppId"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Login | AutoFlow</title>

    <style>

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            min-height: 100%;
            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                Helvetica,
                Arial,
                sans-serif;
            color: #172033;
        }

        html {
            background: #cfeeff;
        }

        body {
            min-height: 100vh;

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 24px;

            position: relative;
            overflow: hidden;

            background:
                radial-gradient(
                    circle at 12% 15%,
                    rgba(255, 255, 255, 0.82) 0,
                    rgba(255, 255, 255, 0.42) 18%,
                    transparent 40%
                ),
                radial-gradient(
                    circle at 88% 82%,
                    rgba(255, 255, 255, 0.58) 0,
                    rgba(255, 255, 255, 0.22) 20%,
                    transparent 42%
                ),
                radial-gradient(
                    circle at 50% 110%,
                    rgba(109, 74, 255, 0.12),
                    transparent 42%
                ),
                linear-gradient(
                    135deg,
                    #dff5ff 0%,
                    #bfeaff 42%,
                    #c9e9ff 70%,
                    #e6f5ff 100%
                );
        }

        body::before {
            content: "";
            position: fixed;
            inset: -30%;
            pointer-events: none;
            z-index: 0;

            background:
                radial-gradient(
                    circle,
                    rgba(255, 255, 255, 0.34) 0,
                    transparent 28%
                );

            animation: backgroundPulse 10s ease-in-out infinite;
        }

        body::after {
            content: "";
            position: fixed;
            width: 560px;
            height: 560px;
            border-radius: 50%;

            left: -280px;
            bottom: -320px;

            background:
                radial-gradient(
                    circle,
                    rgba(109, 74, 255, 0.10),
                    transparent 68%
                );

            pointer-events: none;
            z-index: 0;

            animation: ambientFloat 12s ease-in-out infinite;
        }

        .login-wrapper {
            width: 100%;
            max-width: 440px;

            position: relative;
            z-index: 10;
        }

        .login-card {
            position: relative;
            z-index: 10;

            background: rgba(255, 255, 255, 0.94);

            border: 1px solid rgba(255, 255, 255, 0.85);

            border-radius: 24px;

            padding: 42px 38px 34px;

            box-shadow:
                0 30px 80px rgba(34, 102, 145, 0.18),
                0 12px 35px rgba(109, 74, 255, 0.09);

            text-align: center;

            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);

            overflow: hidden;

            animation: cardEnter 0.7s ease-out both;
        }

        .login-card::before {
            content: "";
            position: absolute;

            top: 0;
            left: 0;
            right: 0;

            height: 4px;

            background:
                linear-gradient(
                    90deg,
                    #55bff2,
                    #6d4aff,
                    #55bff2
                );

            background-size: 200% 100%;

            animation: gradientMove 5s linear infinite;
        }

        .login-card::after {
            content: "";

            position: absolute;

            width: 220px;
            height: 220px;

            top: -150px;
            right: -120px;

            border-radius: 50%;

            background:
                radial-gradient(
                    circle,
                    rgba(109, 74, 255, 0.10),
                    transparent 70%
                );

            pointer-events: none;
        }

        .brand-icon {
            width: min(100%, 320px);

            min-height: 92px;

            margin: 0 auto 22px;

            display: flex;
            align-items: center;
            justify-content: center;

            background: transparent;

            position: relative;
            z-index: 2;

            animation: logoEnter 0.9s ease-out 0.1s both;
        }

        .brand-icon img {
            display: block;

            width: 100%;
            height: auto;

            max-height: 125px;

            object-fit: contain;

            filter:
                drop-shadow(
                    0 8px 18px rgba(109, 74, 255, 0.10)
                );

            transition:
                transform 0.35s ease,
                filter 0.35s ease;
        }

        .brand-icon img:hover {
            transform: scale(1.025);

            filter:
                drop-shadow(
                    0 10px 24px rgba(109, 74, 255, 0.16)
                );
        }

        h1 {
            margin: 0;

            font-size: 28px;
            font-weight: 750;

            letter-spacing: -0.6px;

            color: #172033;

            position: relative;
            z-index: 2;

            animation: contentEnter 0.7s ease-out 0.2s both;
        }

        .subtitle {
            margin: 10px auto 30px;

            max-width: 330px;

            color: #667085;

            font-size: 14px;
            line-height: 1.6;

            position: relative;
            z-index: 2;

            animation: contentEnter 0.7s ease-out 0.28s both;
        }

        .google-button {
            width: 100%;
            height: 52px;

            border: 1px solid #d9e1e8;

            border-radius: 12px;

            background: rgba(255, 255, 255, 0.98);

            color: #252838;

            font-size: 14px;
            font-weight: 650;

            cursor: pointer;

            display: flex;
            align-items: center;
            justify-content: center;

            gap: 12px;

            position: relative;
            z-index: 2;

            transition:
                background 0.2s ease,
                border-color 0.2s ease,
                box-shadow 0.2s ease,
                transform 0.2s ease;

            box-shadow:
                0 4px 12px rgba(30, 60, 80, 0.04);

            animation: contentEnter 0.7s ease-out 0.36s both;
        }

        .google-button:hover {
            background: #ffffff;

            border-color: #c8d3dc;

            box-shadow:
                0 8px 24px rgba(30, 60, 80, 0.10);

            transform: translateY(-2px);
        }

        .google-button:active {
            transform: translateY(0);
        }

        .google-button:focus-visible {
            outline: 3px solid rgba(109, 74, 255, 0.20);
            outline-offset: 3px;
        }

        .google-button:disabled {
            opacity: 0.65;

            cursor: not-allowed;

            transform: none;

            box-shadow: none;
        }

        .google-icon {
            width: 19px;
            height: 19px;

            display: block;

            flex-shrink: 0;
        }

        .status-message {
            display: none;

            margin-top: 18px;

            padding: 12px 14px;

            border-radius: 10px;

            background: #fff2f2;

            border: 1px solid #ffd8d8;

            color: #b42318;

            font-size: 13px;

            line-height: 1.45;

            text-align: left;

            position: relative;
            z-index: 2;
        }

        .status-message.show {
            display: block;

            animation:
                statusEnter 0.25s ease-out both;
        }

        .authorized {
            margin-top: 28px;

            padding-top: 24px;

            border-top: 1px solid rgba(30, 50, 70, 0.08);

            position: relative;
            z-index: 2;

            animation: contentEnter 0.7s ease-out 0.44s both;
        }

        .authorized-title {
            margin: 0 0 7px;

            font-size: 11px;

            font-weight: 800;

            letter-spacing: 1.2px;

            color: #6d4aff;
        }

        .authorized-text {
            margin: 0;

            color: #7c8492;

            font-size: 12px;

            line-height: 1.55;
        }

        .footer {
            margin-top: 28px;

            color: #99a2ae;

            font-size: 11px;

            letter-spacing: 0.3px;

            position: relative;
            z-index: 2;

            animation: contentEnter 0.7s ease-out 0.50s both;
        }

        .spinner {
            width: 17px;
            height: 17px;

            border: 2px solid #ddddE8;

            border-top-color: #6d4aff;

            border-radius: 50%;

            animation: spin 0.7s linear infinite;

            flex-shrink: 0;
        }

        .falling-tools {
            position: fixed;
            inset: 0;

            overflow: hidden;

            pointer-events: none;

            z-index: 2;
        }

        .falling-tool {
            position: absolute;

            top: -90px;

            left: var(--left);

            width: var(--size);
            height: var(--size);

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: var(--font-size);

            opacity: 0;

            filter: drop-shadow(0 8px 14px rgba(0,0,0,.18));

            transform: translate3d(0, 0, 0) rotate(0deg);

            animation:
                toolFall
                var(--duration)
                linear
                var(--delay)
                infinite;

            user-select: none;

            will-change:
                transform,
                opacity;
        }

        .falling-tool.tool-blue {
            color: rgba(54, 155, 215, 0.30);
        }

        .falling-tool.tool-violet {
            color: rgba(109, 74, 255, 0.24);
        }

        .falling-tool.tool-dark {
            color: rgba(43, 82, 105, 0.20);
        }

        .floating-glow {
            position: fixed;

            border-radius: 50%;

            pointer-events: none;

            z-index: 1;

            opacity: 0.55;

            filter: blur(2px);
        }

        .floating-glow.one {
            width: 190px;
            height: 190px;

            left: 5%;
            bottom: 8%;

            background:
                radial-gradient(
                    circle,
                    rgba(255, 255, 255, 0.48),
                    transparent 70%
                );

            animation:
                glowFloatOne
                9s
                ease-in-out
                infinite;
        }

        .floating-glow.two {
            width: 250px;
            height: 250px;

            right: 2%;
            top: 4%;

            background:
                radial-gradient(
                    circle,
                    rgba(109, 74, 255, 0.08),
                    transparent 70%
                );

            animation:
                glowFloatTwo
                12s
                ease-in-out
                infinite;
        }

        .floating-glow.three {
            width: 140px;
            height: 140px;

            right: 14%;
            bottom: 12%;

            background:
                radial-gradient(
                    circle,
                    rgba(80, 190, 240, 0.15),
                    transparent 70%
                );

            animation:
                glowFloatThree
                10s
                ease-in-out
                infinite;
        }

        @@keyframes toolFall {

            0% {
                transform:
                    translate3d(0, -100px, 0)
                    rotate(0deg);

                opacity: 0;
            }

            8% {
                opacity: var(--opacity);
            }

            25% {
                transform:
                    translate3d(
                        var(--drift-one),
                        25vh,
                        0
                    )
                    rotate(95deg);
            }

            50% {
                transform:
                    translate3d(
                        var(--drift-two),
                        52vh,
                        0
                    )
                    rotate(190deg);
            }

            75% {
                transform:
                    translate3d(
                        var(--drift-three),
                        80vh,
                        0
                    )
                    rotate(285deg);
            }

            91% {
                opacity: var(--opacity);
            }

            100% {
                transform:
                    translate3d(
                        var(--drift-four),
                        116vh,
                        0
                    )
                    rotate(390deg);

                opacity: 0;
            }
        }

        @@keyframes spin {

            to {
                transform: rotate(360deg);
            }
        }

        @@keyframes cardEnter {

            from {
                opacity: 0;

                transform:
                    translateY(18px)
                    scale(0.985);
            }

            to {
                opacity: 1;

                transform:
                    translateY(0)
                    scale(1);
            }
        }

        @@keyframes logoEnter {

            from {
                opacity: 0;

                transform:
                    translateY(-12px)
                    scale(0.96);
            }

            to {
                opacity: 1;

                transform:
                    translateY(0)
                    scale(1);
            }
        }

        @@keyframes contentEnter {

            from {
                opacity: 0;

                transform:
                    translateY(8px);
            }

            to {
                opacity: 1;

                transform:
                    translateY(0);
            }
        }

        @@keyframes statusEnter {

            from {
                opacity: 0;

                transform:
                    translateY(-4px);
            }

            to {
                opacity: 1;

                transform:
                    translateY(0);
            }
        }

        @@keyframes backgroundPulse {

            0%,
            100% {
                transform:
                    scale(1)
                    translate3d(0, 0, 0);

                opacity: 0.65;
            }

            50% {
                transform:
                    scale(1.08)
                    translate3d(2%, -1%, 0);

                opacity: 0.90;
            }
        }

        @@keyframes ambientFloat {

            0%,
            100% {
                transform:
                    translate3d(0, 0, 0)
                    scale(1);
            }

            50% {
                transform:
                    translate3d(70px, -40px, 0)
                    scale(1.08);
            }
        }

        @@keyframes gradientMove {

            0% {
                background-position: 0% 50%;
            }

            100% {
                background-position: 200% 50%;
            }
        }

        @@keyframes glowFloatOne {

            0%,
            100% {
                transform:
                    translate3d(0, 0, 0)
                    scale(1);
            }

            50% {
                transform:
                    translate3d(35px, -25px, 0)
                    scale(1.12);
            }
        }

        @@keyframes glowFloatTwo {

            0%,
            100% {
                transform:
                    translate3d(0, 0, 0)
                    scale(1);
            }

            50% {
                transform:
                    translate3d(-35px, 30px, 0)
                    scale(1.08);
            }
        }

        @@keyframes glowFloatThree {

            0%,
            100% {
                transform:
                    translate3d(0, 0, 0)
                    scale(1);
            }

            50% {
                transform:
                    translate3d(-25px, -30px, 0)
                    scale(1.10);
            }
        }

        @@media (max-width: 700px) {

            body {
                padding: 18px;
            }

            .falling-tool {
                font-size: calc(var(--font-size) * 0.82);
            }

            .login-card {
                padding:
                    38px
                    28px
                    30px;
            }
        }

        @@media (max-width: 480px) {

            body {
                padding: 14px;
            }

            .login-card {
                padding:
                    34px
                    22px
                    28px;

                border-radius: 18px;
            }

            .brand-icon {
                width: 100%;

                min-height: 76px;

                margin-bottom: 18px;
            }

            .brand-icon img {
                max-height: 100px;
            }

            h1 {
                font-size: 25px;
            }

            .subtitle {
                margin-bottom: 25px;
            }

            .falling-tool {
                font-size: calc(var(--font-size) * 0.72);
            }

            .floating-glow.one {
                width: 120px;
                height: 120px;
            }

            .floating-glow.two {
                width: 160px;
                height: 160px;
            }

            .floating-glow.three {
                width: 100px;
                height: 100px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {

            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                scroll-behavior: auto !important;
            }

            .falling-tools,
            .floating-glow {
                display: none;
            }
        }

    </style>

</head>

<body>

    <div class="falling-tools"
         aria-hidden="true">
    </div>

    <div class="floating-glow one"
         aria-hidden="true">
    </div>

    <div class="floating-glow two"
         aria-hidden="true">
    </div>

    <div class="floating-glow three"
         aria-hidden="true">
    </div>

    <main class="login-wrapper">

        <section class="login-card">

            <!-- ASP.NET Core Antiforgery Token -->

            <div style="display:none;">

                @Html.AntiForgeryToken()

            </div>


            <!-- AutoFlow Brand -->

            <div class="brand-icon">

                <img src="~/images/autoFlow-logo.png"
                     alt="AutoFlow - Automotive ERP & CRM System" />

            </div>


            <!-- Heading -->

            <h1>

                Welcome to AutoFlow

            </h1>


            <p class="subtitle">

                Sign in to access the AutoFlow automotive repair
                management system.

            </p>


            <!-- Google Sign-In -->

            <button
                id="googleSignInButton"
                class="google-button"
                type="button">

                <svg
                    class="google-icon"
                    viewBox="0 0 24 24"
                    aria-hidden="true">

                    <path
                        fill="#4285F4"
                        d="M21.35 12.23c0-.71-.06-1.39-.18-2.05H12v3.88h5.24a4.48 4.48 0 0 1-1.94 2.94v2.45h3.14c1.84-1.69 2.91-4.18 2.91-7.22z" />

                    <path
                        fill="#34A853"
                        d="M12 21.76c2.63 0 4.84-.87 6.45-2.35l-3.14-2.45c-.87.58-1.98.92-3.31.92-2.54 0-4.69-1.72-5.46-4.03H3.3v2.52A9.75 9.75 0 0 0 12 21.76z" />

                    <path
                        fill="#FBBC05"
                        d="M6.54 13.85a5.86 5.86 0 0 1 0-3.7V7.63H3.3a9.77 9.77 0 0 0 0 8.74l3.24-2.52z" />

                    <path
                        fill="#EA4335"
                        d="M12 6.12c1.43 0 2.72.49 3.73 1.45l2.8-2.8C16.83 3.18 14.63 2.24 12 2.24A9.75 9.75 0 0 0 3.3 7.63l3.24 2.52C7.31 7.84 9.46 6.12 12 6.12z" />

                </svg>

                <span id="googleButtonText">

                    Continue with Google

                </span>

            </button>


            <!-- Error Message -->

            <div
                id="statusMessage"
                class="status-message"
                role="alert">
            </div>


            <!-- Authorization Notice -->

            <div class="authorized">

                <p class="authorized-title">

                    AUTHORIZED ACCESS ONLY

                </p>

                <p class="authorized-text">

                    Sign in using your authorized Google account.
                    Access is restricted to AutoFlow personnel.

                </p>

            </div>


            <!-- Footer -->

            <div class="footer">

                AutoFlow Enterprise ERP

            </div>

        </section>

    </main>


    <!-- Firebase Authentication -->

    <script type="module">

        import { initializeApp }
            from "https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";

        import {
            getAuth,
            GoogleAuthProvider,
            signInWithPopup,
            signOut
        }
            from "https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";


        // Firebase Configuration

        const firebaseConfig = {

            apiKey:
                @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                        firebaseApiKey
                    )
                ),

            authDomain:
                @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                        firebaseAuthDomain
                    )
                ),

            projectId:
                @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                        firebaseProjectId
                    )
                ),

            storageBucket:
                @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                        firebaseStorageBucket
                    )
                ),

            messagingSenderId:
                @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                        firebaseMessagingSenderId
                    )
                ),

            appId:
                @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                        firebaseAppId
                    )
                )

        };


        // Firebase Initialization

        const firebaseApp =
            initializeApp(firebaseConfig);

        const auth =
            getAuth(firebaseApp);

        const provider =
            new GoogleAuthProvider();

        provider.setCustomParameters({
            prompt: "select_account"
        });


        // DOM Elements

        const button =
            document.getElementById(
                "googleSignInButton"
            );

        const buttonText =
            document.getElementById(
                "googleButtonText"
            );

        const statusMessage =
            document.getElementById(
                "statusMessage"
            );


        // Display Error

        function showError(message) {

            statusMessage.textContent =
                message;

            statusMessage.classList.add(
                "show"
            );

        }


        // Reset Button

        function resetButton() {

            button.disabled = false;

            buttonText.textContent =
                "Continue with Google";

        }


        // Google Authentication

        button.addEventListener(
            "click",
            async () => {

                statusMessage.classList.remove(
                    "show"
                );

                button.disabled = true;

                buttonText.innerHTML =
                    '<span class="spinner"></span> Signing in...';


                try {

                    // Sign out any existing Firebase account first.

                    await signOut(auth);


                    // Sign in with Google through Firebase.

                    const result =
                        await signInWithPopup(
                            auth,
                            provider
                        );


                    // Get Firebase ID token.

                    const idToken =
                        await result.user.getIdToken(
                            true
                        );


                    if (!idToken) {

                        throw new Error(
                            "Firebase did not return an ID token."
                        );

                    }


                    // Get ASP.NET Core antiforgery token.

                    const antiforgeryToken =
                        document.querySelector(
                            'input[name="__RequestVerificationToken"]'
                        )?.value;


                    if (!antiforgeryToken) {

                        throw new Error(
                            "Security token is missing. Please refresh the login page and try again."
                        );

                    }


                    // Create request body.

                    const formData =
                        new FormData();

                    formData.append(
                        "idToken",
                        idToken
                    );


                    // Always use the AutoFlow dashboard.

                    formData.append(
                        "returnUrl",
                        "/Home/Index"
                    );


                    // Send Firebase token to ASP.NET Core.

                    const response =
                        await fetch(
                            "/Auth/FirebaseLogin",
                            {
                                method: "POST",

                                body: formData,

                                credentials:
                                    "same-origin",

                                headers: {
                                    "RequestVerificationToken":
                                        antiforgeryToken
                                }
                            }
                        );


                    // Read server response.

                    const responseText =
                        await response.text();


                    let data = {};


                    if (responseText) {

                        try {

                            data =
                                JSON.parse(
                                    responseText
                                );

                        }

                        catch {

                            console.error(
                                "AutoFlow server returned non-JSON:",
                                responseText
                            );

                            throw new Error(
                                `Server returned an unexpected response (${response.status}).`
                            );

                        }

                    }


                    // Handle failed authentication.

                    if (
                        !response.ok ||
                        !data.success
                    ) {

                        throw new Error(
                            data.message ||
                            `Unable to sign in to AutoFlow. Server status: ${response.status}.`
                        );

                    }


                    // Successfully authenticate and go to dashboard.

                    window.location.replace(
                        "/Home/Index"
                    );


                }

                catch (error) {

                    console.error(
                        "AutoFlow Firebase login error:",
                        error
                    );


                    let message =
                        "Google sign-in failed. Please try again.";


                    if (
                        error &&
                        typeof error.message === "string" &&
                        error.message.length > 0
                    ) {

                        message =
                            error.message;

                    }


                    showError(
                        message
                    );


                    resetButton();

                }

            }
        );

    </script>


    <!-- Falling Automotive Tools -->

    <script>

        (() => {

            const container =
                document.querySelector(
                    ".falling-tools"
                );

            if (!container) return;


            const tools = [
                "🔧",
                "⚙️",
                "🔩",
                "🛠️",
                "⚙",
                "🔧",
                "🔩",
                "🛠",
                "⚙️",
                "🔧",
                "🔩",
                "⚙️",
                "🛠️",
                "🔧",
                "⚙",
                "🔩",
                "🛠️",
                "⚙️",
                "🔧",
                "🔩",
                "⚙️",
                "🛠️",
                "🔧",
                "⚙",
                "🔩",
                "🛠️",
                "⚙️",
                "🔧",
                "🔩",
                "⚙️",
                "🛠️",
                "🔧"
            ];


            const types = [
                "tool-blue",
                "tool-violet",
                "tool-dark"
            ];


            const count =
                window.innerWidth < 600
                    ? 16
                    : 32;


            for (
                let i = 0;
                i < count;
                i++
            ) {

                const tool =
                    document.createElement(
                        "span"
                    );


                tool.className =
                    "falling-tool " +
                    types[
                        Math.floor(
                            Math.random() *
                            types.length
                        )
                    ];


                tool.textContent =
                    tools[
                        Math.floor(
                            Math.random() *
                            tools.length
                        )
                    ];


                const size =
                    22 +
                    Math.random() * 28;


                const duration =
                    9 +
                    Math.random() * 13;


                const delay =
                    Math.random() * -18;


                const left =
                    Math.random() * 100;


                const opacity = 1;


                const driftOne =
                    -100 +
                    Math.random() * 200;


                const driftTwo =
                    -130 +
                    Math.random() * 260;


                const driftThree =
                    -110 +
                    Math.random() * 220;


                const driftFour =
                    -160 +
                    Math.random() * 320;


                const blur =
                    Math.random() > 0.72
                        ? "1px"
                        : "0";


                tool.style.setProperty(
                    "--size",
                    `${size}px`
                );


                tool.style.setProperty(
                    "--font-size",
                    `${size}px`
                );


                tool.style.setProperty(
                    "--duration",
                    `${duration}s`
                );


                tool.style.setProperty(
                    "--delay",
                    `${delay}s`
                );


                tool.style.setProperty(
                    "--left",
                    `${left}%`
                );


                tool.style.setProperty(
                    "--opacity",
                    opacity
                );


                tool.style.setProperty(
                    "--drift-one",
                    `${driftOne}px`
                );


                tool.style.setProperty(
                    "--drift-two",
                    `${driftTwo}px`
                );


                tool.style.setProperty(
                    "--drift-three",
                    `${driftThree}px`
                );


                tool.style.setProperty(
                    "--drift-four",
                    `${driftFour}px`
                );


                tool.style.setProperty(
                    "--blur",
                    blur
                );


                container.appendChild(
                    tool
                );

            }

        })();

    </script>

</body>

</html>