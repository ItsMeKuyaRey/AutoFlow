@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("vehicleSearch");
        const statusFilter = document.getElementById("vehicleStatusFilter");
        const makeFilter = document.getElementById("vehicleMakeFilter");
        const sortFilter = document.getElementById("vehicleSortFilter");
        const imageFilter = document.getElementById("vehicleImageFilter");
        const clearButton = document.getElementById("clearVehicleFilters");
        const emptyClearButton = document.getElementById("vehicleEmptyClear");
        const advancedToggle = document.getElementById("vehicleAdvancedToggle");
        const advancedFilters = document.getElementById("vehicleAdvancedFilters");
        const advancedClose = document.getElementById("vehicleAdvancedClose");
        const advancedApply = document.getElementById("vehicleApplyAdvanced");
        const filterCount = document.getElementById("vehicleFilterCount");
        const advancedSummary = document.getElementById("vehicleAdvancedSummary");
        const resultCount = document.getElementById("vehicleResultCount");
        const resultState = document.getElementById("vehicleResultState");
        const showingRange = document.getElementById("vehicleShowingRange");
        const totalFiltered = document.getElementById("vehicleTotalFiltered");
        const pagination = document.getElementById("vehiclePagination");
        const filteredEmpty = document.getElementById("vehicleFilteredEmpty");
        const tableBody = document.getElementById("vehicleTableBody");
        const rows = Array.from(document.querySelectorAll(".vehicle-row"));
        const pageSize = 14;
        let currentPage = 1;

        function closeAdvanced() {
            advancedFilters.hidden = true;
            advancedToggle.setAttribute("aria-expanded", "false");
            advancedToggle.classList.remove("is-open");
        }

        function openAdvanced() {
            advancedFilters.hidden = false;
            advancedToggle.setAttribute("aria-expanded", "true");
            advancedToggle.classList.add("is-open");
        }

        function sortRows(list) {
            return list.sort((a, b) => {
                const sort = sortFilter.value;
                const makeA = a.dataset.vehicleMake || "";
                const makeB = b.dataset.vehicleMake || "";
                const dateA = new Date(a.dataset.vehicleCreated || 0).getTime();
                const dateB = new Date(b.dataset.vehicleCreated || 0).getTime();
                const mileageA = Number(a.dataset.vehicleMileage || 0);
                const mileageB = Number(b.dataset.vehicleMileage || 0);

                if (sort === "oldest") return dateA - dateB;
                if (sort === "makeAsc") return makeA.localeCompare(makeB);
                if (sort === "makeDesc") return makeB.localeCompare(makeA);
                if (sort === "mileageHigh") return mileageB - mileageA;
                if (sort === "mileageLow") return mileageA - mileageB;
                return dateB - dateA;
            });
        }

        function updateFilterCount() {
            let count = 0;
            if (statusFilter.value !== "all") count++;
            if (makeFilter.value !== "all") count++;
            if (sortFilter.value !== "newest") count++;
            if (imageFilter.value !== "all") count++;
            if (searchInput.value.trim()) count++;

            filterCount.textContent = count;
            filterCount.classList.toggle("has-filters", count > 0);

            const labels = [];
            if (sortFilter.value !== "newest") labels.push("custom sort");
            if (imageFilter.value !== "all") labels.push(imageFilter.options[imageFilter.selectedIndex].text.toLowerCase());
            advancedSummary.textContent = labels.length ? labels.join(" • ") : "No additional filters";
        }

        function updatePagination(totalPages) {
            pagination.innerHTML = "";
            if (totalPages <= 1) return;

            const previous = document.createElement("button");
            previous.type = "button";
            previous.className = "vehicle-page-nav";
            previous.textContent = "Previous";
            previous.disabled = currentPage === 1;
            previous.addEventListener("click", () => {
                if (currentPage > 1) {
                    currentPage--;
                    filterVehicles(false);
                }
            });
            pagination.appendChild(previous);

            const start = Math.max(1, currentPage - 2);
            const end = Math.min(totalPages, start + 4);

            for (let page = start; page <= end; page++) {
                const button = document.createElement("button");
                button.type = "button";
                button.className = page === currentPage ? "active" : "";
                button.textContent = page;
                button.setAttribute("aria-label", `Go to page ${page}`);
                button.addEventListener("click", () => {
                    currentPage = page;
                    filterVehicles(false);
                });
                pagination.appendChild(button);
            }

            const next = document.createElement("button");
            next.type = "button";
            next.className = "vehicle-page-nav";
            next.textContent = "Next";
            next.disabled = currentPage === totalPages;
            next.addEventListener("click", () => {
                if (currentPage < totalPages) {
                    currentPage++;
                    filterVehicles(false);
                }
            });
            pagination.appendChild(next);
        }

        function filterVehicles(resetPage = true) {
            if (resetPage) currentPage = 1;

            const searchValue = searchInput.value.toLowerCase().trim();
            const statusValue = statusFilter.value;
            const makeValue = makeFilter.value.toLowerCase();
            const imageValue = imageFilter.value;

            let matchingRows = rows.filter(row => {
                const searchableText = row.dataset.vehicleSearch || "";
                const rowMake = row.dataset.vehicleMake || "";
                const rowStatus = row.dataset.vehicleStatus || "";
                const hasImage = row.dataset.hasImage === "true";

                const matchesSearch = searchableText.includes(searchValue);
                const matchesStatus = statusValue === "all" || rowStatus === statusValue;
                const matchesMake = makeValue === "all" || rowMake === makeValue;
                const matchesImage = imageValue === "all"
                    || (imageValue === "hasImage" && hasImage)
                    || (imageValue === "noImage" && !hasImage);

                return matchesSearch && matchesStatus && matchesMake && matchesImage;
            });

            matchingRows = sortRows(matchingRows);

            rows.forEach(row => {
                row.style.display = "none";
                row.classList.remove("vehicle-row-visible");
            });

            const total = matchingRows.length;
            const totalPages = Math.max(1, Math.ceil(total / pageSize));
            if (currentPage > totalPages) currentPage = totalPages;

            const startIndex = (currentPage - 1) * pageSize;
            const visibleRows = matchingRows.slice(startIndex, startIndex + pageSize);

            visibleRows.forEach(row => {
                row.style.display = "table-row";
                row.classList.add("vehicle-row-visible");
                tableBody.appendChild(row);
            });

            resultCount.textContent = total;
            totalFiltered.textContent = total;

            if (total === 0) {
                showingRange.textContent = "0–0";
                filteredEmpty.hidden = rows.length === 0;
                resultState.textContent = rows.length === 0
                    ? "No vehicle records in the database"
                    : "No records match the current filters";
            } else {
                filteredEmpty.hidden = true;
                const first = startIndex + 1;
                const last = Math.min(startIndex + pageSize, total);
                showingRange.textContent = `${first}–${last}`;
                resultState.textContent = total === rows.length
                    ? "Showing all vehicle records"
                    : `${total} record${total === 1 ? "" : "s"} match your filters`;
            }

            updatePagination(totalPages);
            updateFilterCount();
        }

        function clearFilters() {
            searchInput.value = "";
            statusFilter.value = "all";
            makeFilter.value = "all";
            sortFilter.value = "newest";
            imageFilter.value = "all";
            closeAdvanced();
            filterVehicles(true);
        }

        searchInput.addEventListener("input", () => filterVehicles(true));
        statusFilter.addEventListener("change", () => filterVehicles(true));
        makeFilter.addEventListener("change", () => filterVehicles(true));
        sortFilter.addEventListener("change", () => filterVehicles(true));
        imageFilter.addEventListener("change", () => filterVehicles(true));
        clearButton.addEventListener("click", clearFilters);
        emptyClearButton.addEventListener("click", clearFilters);

        advancedToggle.addEventListener("click", function () {
            if (advancedFilters.hidden) openAdvanced();
            else closeAdvanced();
        });

        advancedClose.addEventListener("click", closeAdvanced);
        advancedApply.addEventListener("click", function () {
            closeAdvanced();
            filterVehicles(true);
        });

        document.addEventListener("click", function (event) {
            const wrapper = document.querySelector(".vehicle-filter-popover-wrap");
            if (wrapper && !wrapper.contains(event.target)) closeAdvanced();
        });

        filterVehicles(true);

        const vehicleOverlayHost = document.getElementById("vehicleOverlayHost");
        const vehicleOverlaySelectors = {
            create: ".vehicle-create-drawer-page",
            edit: ".vehicle-edit-page",
            details: ".vehicle-details-page",
            delete: ".vehicle-archive-modal-page",
            archived: ".vehicle-archive-history-page",
            archivedDetails: ".vehicle-archived-details-page"
        };
        const vehicleOverlayStyleIds = new Set();

        function vehicleRouteKey(url) {
            const path = new URL(url, window.location.origin).pathname.replace(/\/+$/, "").toLowerCase();
            if (path === "/vehicles/create") return "create";
            if (/^\/vehicles\/edit\/\d+$/.test(path)) return "edit";
            if (/^\/vehicles\/details\/\d+$/.test(path)) return "details";
            if (/^\/vehicles\/delete\/\d+$/.test(path)) return "delete";
            if (path === "/vehicles/archived") return "archived";
            if (/^\/vehicles\/archiveddetails\/\d+$/.test(path)) return "archivedDetails";
            return null;
        }

        function isVehicleIndexUrl(url) {
            const path = new URL(url, window.location.origin).pathname.replace(/\/+$/, "").toLowerCase();
            return path === "/vehicles" || path === "/vehicles/index";
        }

        function closeVehicleOverlay() {
            vehicleOverlayHost.innerHTML = "";
            document.body.classList.remove("vehicle-overlay-open");
        }

        function appendVehicleOverlayStyles(doc, routeKey) {
            if (vehicleOverlayStyleIds.has(routeKey)) return;
            const selector = vehicleOverlaySelectors[routeKey];
            const styleSignature = selector ? selector.replace(/^\./, "") : "";
            const style = Array.from(doc.querySelectorAll("style")).find(item => (item.textContent || "").includes(styleSignature));
            if (!style) return;
            const clone = document.createElement("style");
            clone.setAttribute("data-vehicle-overlay-style", routeKey);
            clone.textContent = style.textContent || "";
            document.head.appendChild(clone);
            vehicleOverlayStyleIds.add(routeKey);
        }

        function getVehicleOverlayRoot(doc, routeKey) {
            const selector = vehicleOverlaySelectors[routeKey];
            return selector ? doc.querySelector(selector) : null;
        }

        function showVehicleOverlayLoading() {
            vehicleOverlayHost.innerHTML = `
                <div class="vehicle-overlay-loading">
                    <div class="vehicle-overlay-loading-card">
                        <span class="vehicle-overlay-spinner"></span>
                        Loading vehicle workspace...
                    </div>
                </div>`;
            document.body.classList.add("vehicle-overlay-open");
        }

        async function openVehicleOverlay(url) {
            const routeKey = vehicleRouteKey(url);
            if (!routeKey) {
                window.location.href = url;
                return;
            }

            showVehicleOverlayLoading();

            try {
                const response = await fetch(url, {
                    method: "GET",
                    credentials: "same-origin",
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });

                if (!response.ok) throw new Error(`Request failed: ${response.status}`);

                const html = await response.text();
                const doc = new DOMParser().parseFromString(html, "text/html");
                const root = getVehicleOverlayRoot(doc, routeKey);

                if (!root) {
                    window.location.href = url;
                    return;
                }

                appendVehicleOverlayStyles(doc, routeKey);
                vehicleOverlayHost.innerHTML = "";
                root.setAttribute("data-vehicle-overlay-root", "true");
                vehicleOverlayHost.appendChild(root);
                document.body.classList.add("vehicle-overlay-open");

                const firstField = root.querySelector("input:not([type='hidden']), textarea, select");
                if (firstField) window.setTimeout(() => firstField.focus(), 120);
            } catch (error) {
                console.error("AutoFlow vehicle overlay error:", error);
                window.location.href = url;
            }
        }

        document.addEventListener("click", function (event) {
            const link = event.target.closest("a[href]");
            if (!link) return;

            const overlayRoot = link.closest("[data-vehicle-overlay-root]");
            const href = link.href;
            const routeKey = vehicleRouteKey(href);

            if (overlayRoot) {
                if (isVehicleIndexUrl(href)) {
                    event.preventDefault();
                    closeVehicleOverlay();
                    return;
                }
                if (routeKey) {
                    event.preventDefault();
                    openVehicleOverlay(href);
                }
                return;
            }

            if (!routeKey) return;
            event.preventDefault();
            openVehicleOverlay(href);
        }, true);

        document.addEventListener("click", function (event) {
            const backdrop = event.target.closest(
                ".vehicle-create-drawer-backdrop, " +
                ".vehicle-drawer-backdrop, " +
                ".vehicle-edit-backdrop, " +
                ".vehicle-details-backdrop, " +
                ".vehicle-archive-history-backdrop, " +
                ".vehicle-archived-details-backdrop"
            );
            if (!backdrop) return;
            const root = backdrop.closest("[data-vehicle-overlay-root]");
            if (!root) return;
            event.preventDefault();
            closeVehicleOverlay();
        }, true);

        // Live vehicle image preview for dynamically loaded drawers.
        document.addEventListener("change", function (event) {
            const input = event.target.closest("#vehicleCreateProfileImage, #vehicleEditProfileImage");
            if (!input) return;

            const root = input.closest("[data-vehicle-overlay-root]") || document;
            const preview = root.querySelector(
                input.id === "vehicleEditProfileImage"
                    ? "#vehicleEditImagePreview"
                    : "#vehicleCreateImagePreview"
            );
            const status = root.querySelector(
                input.id === "vehicleEditProfileImage"
                    ? "#vehicleEditImageStatus"
                    : "#vehicleCreateImageStatus"
            );
            const file = input.files && input.files[0];

            if (!preview || !status) return;

            if (!file) {
                status.classList.remove("is-selected", "is-changed");
                status.innerHTML = input.id === "vehicleEditProfileImage"
                    ? "Current image saved"
                    : "No image selected";
                return;
            }

            if (!file.type.startsWith("image/")) {
                input.value = "";
                status.classList.remove("is-selected", "is-changed");
                status.textContent = "Please choose an image file";
                return;
            }

            if (file.size > 5 * 1024 * 1024) {
                input.value = "";
                status.classList.remove("is-selected", "is-changed");
                status.textContent = "Image must be 5 MB or smaller";
                return;
            }

            const message = input.id === "vehicleEditProfileImage"
                ? "Image changed"
                : "Image selected";

            status.classList.add(input.id === "vehicleEditProfileImage" ? "is-changed" : "is-selected");
            status.innerHTML =
                '<span class="af-image-check"><i class="bi bi-check-lg"></i></span>' +
                '<span>' + message + '</span>' +
                '<span class="af-image-file-name">' + escapeVehicleImageText(file.name) + '</span>';

            const reader = new FileReader();
            reader.onload = function (loadEvent) {
                preview.innerHTML =
                    '<img src="' + loadEvent.target.result + '" alt="Selected vehicle image" />';
            };
            reader.readAsDataURL(file);
        }, true);

        function escapeVehicleImageText(value) {
            return String(value || "").replace(/[&<>"']/g, function (character) {
                return {
                    "&": "&amp;",
                    "<": "&lt;",
                    ">": "&gt;",
                    '"': "&quot;",
                    "'": "&#039;"
                }[character];
            });
        }

        document.addEventListener("submit", async function (event) {
            const form = event.target.closest("[data-vehicle-overlay-root] form");
            if (!form) return;

            event.preventDefault();
            const submitButton = form.querySelector("button[type='submit']");
            const originalText = submitButton ? submitButton.innerHTML : "";
            if (submitButton) {
                submitButton.disabled = true;
                submitButton.innerHTML = "Saving...";
            }

            try {
                const response = await fetch(form.action, {
                    method: (form.method || "POST").toUpperCase(),
                    credentials: "same-origin",
                    body: new FormData(form),
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });

                if (response.redirected && isVehicleIndexUrl(response.url)) {
                    closeVehicleOverlay();
                    window.location.reload();
                    return;
                }

                if (!response.ok) throw new Error(`Request failed: ${response.status}`);

                const html = await response.text();
                const finalUrl = response.url;
                const routeKey = vehicleRouteKey(finalUrl);

                if (isVehicleIndexUrl(finalUrl)) {
                    closeVehicleOverlay();
                    window.location.reload();
                    return;
                }

                if (!routeKey) {
                    window.location.href = finalUrl;
                    return;
                }

                const doc = new DOMParser().parseFromString(html, "text/html");
                const root = getVehicleOverlayRoot(doc, routeKey);
                if (!root) {
                    window.location.href = finalUrl;
                    return;
                }

                appendVehicleOverlayStyles(doc, routeKey);
                vehicleOverlayHost.innerHTML = "";
                root.setAttribute("data-vehicle-overlay-root", "true");
                vehicleOverlayHost.appendChild(root);
                document.body.classList.add("vehicle-overlay-open");
            } catch (error) {
                console.error("AutoFlow vehicle form error:", error);
                if (submitButton) {
                    submitButton.disabled = false;
                    submitButton.innerHTML = originalText;
                }
            }
        }, true);

        document.addEventListener("keydown", function (event) {
            if (event.key !== "Escape") return;
            if (!vehicleOverlayHost.querySelector("[data-vehicle-overlay-root]")) return;
            closeVehicleOverlay();
        });
    });
</script>
}


