@model IEnumerable<AutoFlow.Web.Models.Vehicle>

@{
    ViewData["Title"] = "Vehicle Records";
    var vehicles = Model.ToList();
    var activeCount = vehicles.Count(v => !v.IsArchived);
    var archivedCount = vehicles.Count(v => v.IsArchived);
}

<div class="vehicle-page vehicle-page-premium">

    <div class="vehicle-page-header">
        <div>
            <div class="vehicle-eyebrow">
                <span class="vehicle-eyebrow-dot"></span>
                VEHICLE RECORDS
            </div>
            <h1>Vehicle Records</h1>
            <p>Manage customer vehicles, ownership information, and service-ready records.</p>
        </div>

        <div class="vehicle-header-actions">
            <a asp-action="Archived" class="vehicle-secondary-button vehicle-archive-link">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 7h16v13H4z" />
                    <path d="M3 4h18v3H3z" />
                    <path d="M9 11h6" />
                </svg>
                Archived
                <span class="vehicle-header-count">@archivedCount</span>
            </a>

            <a asp-action="Create" class="vehicle-primary-button">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" />
                </svg>
                Add Vehicle
            </a>
        </div>
    </div>

    <div class="vehicle-summary-strip">
        <div class="vehicle-summary-item">
            <span class="vehicle-summary-icon vehicle-summary-icon-purple">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 16.5h14l-1.2-5.2a2 2 0 0 0-1.9-1.5H8.1a2 2 0 0 0-1.9 1.5L5 16.5Z" />
                    <path d="M4 16.5v2.2M20 16.5v2.2M7 16.5h10" />
                    <circle cx="8" cy="16.5" r="1" />
                    <circle cx="16" cy="16.5" r="1" />
                </svg>
            </span>
            <span><strong>@activeCount</strong> Active Vehicles</span>
        </div>

        <div class="vehicle-summary-divider"></div>

        <div class="vehicle-summary-item">
            <span class="vehicle-summary-icon vehicle-summary-icon-green">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 7h16v13H4z" />
                    <path d="M3 4h18v3H3z" />
                    <path d="M9 11h6" />
                </svg>
            </span>
            <span><strong>@archivedCount</strong> Archived Records</span>
        </div>

        <div class="vehicle-summary-divider"></div>

        <div class="vehicle-summary-item vehicle-summary-item-muted">
            <span class="vehicle-summary-icon vehicle-summary-icon-blue">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="8" />
                    <path d="M12 8v4l2.5 2.5" />
                </svg>
            </span>
            <span>Database-synced vehicle records</span>
        </div>
    </div>

    <div class="vehicle-toolbar vehicle-toolbar-premium">

        <div class="vehicle-search">
            <span class="vehicle-search-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="6.5" />
                    <path d="m16 16 4 4" />
                </svg>
            </span>
            <input type="search"
                   id="vehicleSearch"
                   autocomplete="off"
                   placeholder="Search by plate, VIN, customer, make, or model..."
                   aria-label="Search vehicles" />
        </div>

        <div class="vehicle-filter vehicle-filter-select">
            <span class="vehicle-control-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M6 8h12M8 12h8M10 16h4" />
                </svg>
            </span>
            <label for="vehicleStatusFilter">Status</label>
            <select id="vehicleStatusFilter" aria-label="Filter vehicles by status">
                <option value="all">All Statuses</option>
                <option value="active">Active</option>
                <option value="archived">Archived</option>
            </select>
            <svg class="vehicle-select-chevron" viewBox="0 0 24 24" aria-hidden="true">
                <path d="m7 9 5 5 5-5" />
            </svg>
        </div>

        <div class="vehicle-filter vehicle-filter-select">
            <span class="vehicle-control-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M5 6h14M8 12h8M10 18h4" />
                </svg>
            </span>
            <label for="vehicleMakeFilter">Make</label>
            <select id="vehicleMakeFilter" aria-label="Filter vehicles by make">
                <option value="all">All Makes</option>
                @foreach (var make in vehicles.Select(v => v.Make).Where(m => !string.IsNullOrWhiteSpace(m)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(m => m))
                {
                    <option value="@make">@make</option>
                }
            </select>
            <svg class="vehicle-select-chevron" viewBox="0 0 24 24" aria-hidden="true">
                <path d="m7 9 5 5 5-5" />
            </svg>
        </div>

        <div class="vehicle-filter-popover-wrap">
            <button type="button"
                    class="vehicle-filter-button vehicle-filter-toggle"
                    id="vehicleAdvancedToggle"
                    aria-expanded="false"
                    aria-controls="vehicleAdvancedFilters"
                    title="More vehicle filters">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 6h16M7 12h10M10 18h4" />
                </svg>
                <span class="vehicle-filter-triangle" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path d="m7 9 5 5 5-5" />
                    </svg>
                </span>
                <span class="vehicle-filter-count" id="vehicleFilterCount">0</span>
            </button>

            <div class="vehicle-advanced-filters" id="vehicleAdvancedFilters" hidden>
                <div class="vehicle-advanced-head">
                    <div>
                        <strong>More Filters</strong>
                        <span>Refine the vehicle list</span>
                    </div>
                    <button type="button" id="vehicleAdvancedClose" class="vehicle-popover-close" aria-label="Close filters">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m7 7 10 10M17 7 7 17" />
                        </svg>
                    </button>
                </div>

                <div class="vehicle-advanced-field">
                    <label for="vehicleSortFilter">Sort By</label>
                    <select id="vehicleSortFilter">
                        <option value="newest">Newest first</option>
                        <option value="oldest">Oldest first</option>
                        <option value="makeAsc">Make A–Z</option>
                        <option value="makeDesc">Make Z–A</option>
                        <option value="mileageHigh">Mileage high to low</option>
                        <option value="mileageLow">Mileage low to high</option>
                    </select>
                </div>

                <div class="vehicle-advanced-field">
                    <label for="vehicleImageFilter">Vehicle Image</label>
                    <select id="vehicleImageFilter">
                        <option value="all">Any image status</option>
                        <option value="hasImage">Has vehicle image</option>
                        <option value="noImage">No vehicle image</option>
                    </select>
                </div>

                <div class="vehicle-advanced-footer">
                    <span id="vehicleAdvancedSummary">No additional filters</span>
                    <button type="button" id="vehicleApplyAdvanced" class="vehicle-small-primary">Apply</button>
                </div>
            </div>
        </div>

        <button type="button" class="vehicle-clear-button" id="clearVehicleFilters">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 7h16M9 11v6M15 11v6M6 7l1 13h10l1-13M9 7l1-3h4l1 3" />
            </svg>
            Clear
        </button>
    </div>

    <div class="vehicle-result-bar">
        <div>
            <strong id="vehicleResultCount">@vehicles.Count</strong>
            <span>records shown</span>
        </div>
        <div class="vehicle-result-state" id="vehicleResultState">
            Showing all vehicle records
        </div>
    </div>

    <div class="vehicle-table-card vehicle-table-card-premium">

        <div class="vehicle-table-wrapper">
            <table class="vehicle-table">
                <thead>
                    <tr>
                        <th>Vehicle</th>
                        <th>Owner</th>
                        <th>Registration</th>
                        <th>Details</th>
                        <th>Mileage</th>
                        <th>Status</th>
                        <th class="vehicle-actions-heading">Actions</th>
                    </tr>
                </thead>

                <tbody id="vehicleTableBody">
                    @foreach (var item in vehicles)
                    {
                        var ownerName = item.Customer == null
                            ? "No owner assigned"
                            : $"{item.Customer.FirstName} {item.Customer.LastName}".Trim();
                        var firstInitial = item.Customer == null || string.IsNullOrWhiteSpace(item.Customer.FirstName)
                            ? "?"
                            : item.Customer.FirstName.Substring(0, 1);
                        var ownerImageUrl = item.Customer?.ImageUrl;
                        var hasOwnerImage = !string.IsNullOrWhiteSpace(ownerImageUrl);
                        var vehicleName = $"{item.Make} {item.Model}".Trim();
                        var searchText = $"{vehicleName} {item.PlateNumber} {item.VIN} {ownerName} {item.Make} {item.Model} {item.Year} {item.Color}".ToLowerInvariant();
                        var status = item.IsArchived ? "archived" : "active";
                        var hasImage = !string.IsNullOrWhiteSpace(item.ImageUrl);

                        <tr class="vehicle-row"
                            data-vehicle-search="@searchText"
                            data-vehicle-name="@vehicleName.ToLowerInvariant()"
                            data-vehicle-make="@(item.Make ?? string.Empty).ToLowerInvariant()"
                            data-vehicle-status="@status"
                            data-vehicle-created="@item.CreatedAt.ToString("O")"
                            data-vehicle-mileage="@(item.Mileage?.ToString() ?? "0")"
                            data-has-image="@hasImage.ToString().ToLowerInvariant()">

                            <td>
                                <div class="vehicle-identity">
                                    <div class="vehicle-avatar @(item.IsArchived ? "vehicle-avatar-archived" : "")">
                                        @if (hasImage)
                                        {
                                            <img src="@item.ImageUrl" alt="@vehicleName" />
                                        }
                                        else
                                        {
                                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="M5 16.5h14l-1.2-5.2a2 2 0 0 0-1.9-1.5H8.1a2 2 0 0 0-1.9 1.5L5 16.5Z" />
                                                <path d="M4 16.5v2.2M20 16.5v2.2M7 16.5h10" />
                                                <circle cx="8" cy="16.5" r="1" />
                                                <circle cx="16" cy="16.5" r="1" />
                                            </svg>
                                        }
                                    </div>
                                    <div class="vehicle-identity-text">
                                        <strong>@vehicleName</strong>
                                        <small>
                                            @(item.Year?.ToString() ?? "Year unknown")
                                            ·
                                            @(string.IsNullOrWhiteSpace(item.Color) ? "Color not recorded" : item.Color)
                                        </small>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <div class="vehicle-contact">
                                    <span class="vehicle-owner-avatar">
                                        @if (hasOwnerImage)
                                        {
                                            <img src="@ownerImageUrl" alt="@ownerName" />
                                        }
                                        else
                                        {
                                            @firstInitial
                                        }
                                    </span>
                                    <div>
                                        <strong>@ownerName</strong>
                                        <small>Customer</small>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <div class="vehicle-registration">
                                    <strong>@item.PlateNumber</strong>
                                    <small>
                                        VIN:
                                        @(string.IsNullOrWhiteSpace(item.VIN) ? "Not recorded" : item.VIN)
                                    </small>
                                </div>
                            </td>

                            <td>
                                <div class="vehicle-detail-cell">
                                    <strong>@item.Make @item.Model</strong>
                                    <small>
                                        @(item.Year?.ToString() ?? "Year unknown")
                                        ·
                                        @(string.IsNullOrWhiteSpace(item.Color) ? "Color not recorded" : item.Color)
                                    </small>
                                </div>
                            </td>

                            <td>
                                <span class="vehicle-mileage">
                                    @(item.Mileage.HasValue ? $"{item.Mileage:N0} km" : "—")
                                </span>
                            </td>

                            <td>
                                @if (item.IsArchived)
                                {
                                    <span class="vehicle-status-badge archived">
                                        <span></span>
                                        ARCHIVED
                                    </span>
                                }
                                else
                                {
                                    <span class="vehicle-status-badge active">
                                        <span></span>
                                        ACTIVE
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="vehicle-row-actions">
                                    <a asp-action="Details"
                                       asp-route-id="@item.VehicleId"
                                       class="vehicle-icon-button"
                                       title="View vehicle"
                                       aria-label="View vehicle">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" />
                                            <circle cx="12" cy="12" r="2.5" />
                                        </svg>
                                    </a>

                                    @if (!item.IsArchived)
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@item.VehicleId"
                                           class="vehicle-icon-button"
                                           title="Edit vehicle"
                                           aria-label="Edit vehicle">
                                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="m4 16-.8 4.8L8 20l10.8-10.8a2.2 2.2 0 0 0-3.1-3.1L4 16Z" />
                                                <path d="m14.8 7.2 2 2" />
                                            </svg>
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.VehicleId"
                                           class="vehicle-icon-button vehicle-delete-action"
                                           title="Archive vehicle"
                                           aria-label="Archive vehicle">
                                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="M4 7h16v13H4z" />
                                                <path d="M3 4h18v3H3z" />
                                                <path d="M9 11h6" />
                                            </svg>
                                        </a>
                                    }
                                    else
                                    {
                                        <form asp-action="Restore" method="post" class="vehicle-inline-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.VehicleId" />
                                            <button type="submit"
                                                    class="vehicle-icon-button vehicle-restore-action"
                                                    title="Restore vehicle"
                                                    aria-label="Restore vehicle">
                                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                                    <path d="M4 12a8 8 0 1 0 3-6" />
                                                    <path d="M4 5v5h5" />
                                                </svg>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="vehicle-filtered-empty" id="vehicleFilteredEmpty" hidden>
            <div class="vehicle-empty-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="11" cy="11" r="6.5" />
                    <path d="m16 16 4 4" />
                </svg>
            </div>
            <strong>No matching vehicles</strong>
            <span>Try changing your search or filters.</span>
            <button type="button" class="vehicle-secondary-button" id="vehicleEmptyClear">Clear Filters</button>
        </div>

        @if (!vehicles.Any())
        {
            <div class="vehicle-empty-state">
                <div class="vehicle-empty-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5 16.5h14l-1.2-5.2a2 2 0 0 0-1.9-1.5H8.1a2 2 0 0 0-1.9 1.5L5 16.5Z" />
                        <path d="M4 16.5v2.2M20 16.5v2.2M7 16.5h10" />
                        <circle cx="8" cy="16.5" r="1" />
                        <circle cx="16" cy="16.5" r="1" />
                    </svg>
                </div>
                <strong>No vehicle records found</strong>
                <span>Register your first customer vehicle to get started.</span>
                <a asp-action="Create" class="vehicle-primary-button">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 5v14M5 12h14" />
                    </svg>
                    Add Vehicle
                </a>
            </div>
        }

        <div class="vehicle-table-footer">
            <span>
                Showing <strong id="vehicleShowingRange">0–0</strong>
                of <strong id="vehicleTotalFiltered">0</strong> vehicles
            </span>
            <div class="vehicle-pagination" id="vehiclePagination" aria-label="Vehicle pagination"></div>
        </div>
    </div>
</div>

<div id="vehicleOverlayHost" class="vehicle-overlay-host" aria-live="polite"></div>

<style>
@@keyframes vehicleOverlaySpin {
    to { transform: rotate(360deg); }
}

.vehicle-overlay-host {
    position: relative;
    z-index: 5000;
}

body.vehicle-overlay-open {
    overflow: hidden;
}

.vehicle-overlay-loading {
    position: fixed;
    inset: 0;
    z-index: 5200;
    display: grid;
    place-items: center;
    background: rgba(15, 23, 42, .18);
    backdrop-filter: blur(2px);
}

.vehicle-overlay-loading-card {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 15px;
    border: 1px solid #e7eaf0;
    border-radius: 10px;
    background: #fff;
    color: #5f6b7c;
    font-size: 10px;
    font-weight: 800;
    box-shadow: 0 16px 40px rgba(15, 23, 42, .12);
}

.vehicle-overlay-spinner {
    width: 14px;
    height: 14px;
    border: 2px solid #e5e7eb;
    border-top-color: #7c3aed;
    border-radius: 50%;
    animation: vehicleOverlaySpin .65s linear infinite;
}

/* AutoFlow Customer Management - Premium Functional UI */
.vehicle-page-premium {
    max-width: 1500px;
    margin: 0 auto;
}

.vehicle-page-premium .vehicle-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 7px;
    color: #7c3aed;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .12em;
}

.vehicle-eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #7c3aed;
    box-shadow: 0 0 0 4px rgba(124,58,237,.08);
}

.vehicle-page-premium .vehicle-page-header {
    align-items: flex-end;
    margin-bottom: 18px;
}

.vehicle-page-premium .vehicle-page-header h1 {
    margin: 0;
    font-size: 27px;
    font-weight: 760;
    letter-spacing: -.7px;
    color: #111827;
}

.vehicle-page-premium .vehicle-page-header p {
    margin-top: 5px;
    color: #7b8494;
}

.vehicle-header-actions {
    display: flex;
    align-items: center;
    gap: 9px;
}

.vehicle-header-actions .vehicle-secondary-button,
.vehicle-header-actions .vehicle-primary-button {
    min-height: 38px;
}

.vehicle-secondary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 38px;
    padding: 0 14px;
    border: 1px solid #e2e5eb;
    border-radius: 8px;
    background: #fff;
    color: #475569;
    font-size: 11px;
    font-weight: 650;
    text-decoration: none;
    cursor: pointer;
    transition: .18s ease;
}

.vehicle-secondary-button:hover {
    color: #6d28d9;
    border-color: #d9ccfa;
    background: #faf8ff;
}

.vehicle-secondary-button svg,
.vehicle-primary-button svg,
.vehicle-clear-button svg,
.vehicle-filter-button svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.vehicle-header-count {
    min-width: 20px;
    padding: 2px 6px;
    border-radius: 999px;
    background: #f3f4f6;
    color: #64748b;
    font-size: 9px;
    text-align: center;
}

.vehicle-summary-strip {
    display: flex;
    align-items: center;
    min-height: 58px;
    margin-bottom: 14px;
    padding: 0 15px;
    border: 1px solid #e7e9ef;
    border-radius: 11px;
    background: linear-gradient(180deg,#fff 0%,#fbfbfd 100%);
    box-shadow: 0 4px 16px rgba(15,23,42,.025);
}

.vehicle-summary-item {
    display: flex;
    align-items: center;
    gap: 9px;
    color: #64748b;
    font-size: 10px;
}

.vehicle-summary-item strong {
    margin-right: 3px;
    color: #111827;
    font-size: 13px;
}

.vehicle-summary-item-muted {
    color: #94a3b8;
}

.vehicle-summary-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
}

.vehicle-summary-icon svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.vehicle-summary-icon-purple { background:#f3efff; color:#7c3aed; }
.vehicle-summary-icon-green { background:#ecfdf5; color:#059669; }
.vehicle-summary-icon-blue { background:#eff6ff; color:#2563eb; }

.vehicle-summary-divider {
    width: 1px;
    height: 24px;
    margin: 0 20px;
    background: #edf0f4;
}

.vehicle-toolbar-premium {
    position: relative;
    gap: 8px;
    padding: 10px;
    margin-bottom: 7px;
    border-radius: 11px;
    box-shadow: 0 3px 12px rgba(15,23,42,.025);
}

.vehicle-toolbar-premium .vehicle-search {
    min-width: 280px;
}

.vehicle-toolbar-premium .vehicle-search-icon {
    display: inline-flex;
    width: 15px;
    height: 15px;
}

.vehicle-toolbar-premium .vehicle-search-icon svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
}

.vehicle-toolbar-premium .vehicle-filter-select {
    position: relative;
    min-width: 150px;
    gap: 6px;
    padding-right: 27px;
}

.vehicle-toolbar-premium .vehicle-filter-select label {
    color: #9ca3af;
    font-size: 9px;
    font-weight: 650;
}

.vehicle-toolbar-premium .vehicle-filter-select select {
    min-width: 75px;
    max-width: 130px;
    color: #374151;
    font-size: 10px;
    font-weight: 600;
    appearance: none;
    cursor: pointer;
}

.vehicle-control-icon {
    display: inline-flex;
    color: #8b5cf6;
}

.vehicle-control-icon svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.vehicle-select-chevron {
    position: absolute;
    right: 9px;
    width: 13px;
    height: 13px;
    fill: none;
    stroke: #94a3b8;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
}

.vehicle-filter-popover-wrap {
    position: relative;
}

.vehicle-filter-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    width: auto;
    min-width: 55px;
    padding: 0 9px;
    transition: .18s ease;
}

.vehicle-filter-toggle.is-open,
.vehicle-filter-toggle:hover {
    border-color: #cfc2f7;
    color: #6d28d9;
    background: #faf8ff;
}

.vehicle-filter-triangle {
    display: inline-flex;
    transition: transform .18s ease;
}

.vehicle-filter-triangle svg {
    width: 12px;
    height: 12px;
    stroke-width: 2;
}

.vehicle-filter-toggle.is-open .vehicle-filter-triangle {
    transform: rotate(180deg);
}

.vehicle-filter-count {
    display: none;
