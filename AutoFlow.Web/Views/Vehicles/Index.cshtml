@model IEnumerable<AutoFlow.Web.Models.Vehicle>

@{
    ViewData["Title"] = "Vehicles";
}

<div class="page-header">
    <div>
        <h1>Vehicles</h1>
        <p>Manage service history, specs, and status for all shop-registered vehicles.</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Create" class="af-button af-button-primary">
            + Add Vehicle
        </a>
    </div>
</div>

<div class="af-card" style="padding: 20px;">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div class="d-flex gap-2 flex-wrap">
            <input type="text" class="af-input" placeholder="Search by plate, VIN, make or model..." style="width: 280px;" />
            <button class="af-button af-button-secondary">Filters</button>
        </div>
        <button class="af-button af-button-secondary">Report</button>
    </div>

    <div class="af-table-wrapper">
        <table class="af-table">
            <thead>
                <tr>
                    <th>Vehicle</th>
                    <th>Identifiers</th>
                    <th>Owner</th>
                    <th>Mileage</th>
                    <th>Color / Year</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div>
                                <strong>@item.Make @item.Model</strong>
                                <small>@(item.Year.HasValue ? item.Year.ToString() : "—")</small>
                            </div>
                        </td>
                        <td>
                            <div>
                                <strong>@item.PlateNumber</strong>
                                <small>@(string.IsNullOrEmpty(item.VIN) ? "No VIN" : item.VIN)</small>
                            </div>
                        </td>
                        <td>
                            @if (item.Customer != null)
                            {
                                <strong>@item.Customer.FirstName @item.Customer.LastName</strong>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @(item.Mileage.HasValue ? $"{item.Mileage:N0} km" : "—")
                        </td>
                        <td>
                            <div>
                                <strong>@(string.IsNullOrEmpty(item.Color) ? "—" : item.Color)</strong>
                                <small>@(item.Year.HasValue ? item.Year.ToString() : "")</small>
                            </div>
                        </td>
                        <td style="text-align: right;">
                            <div class="d-flex gap-1 justify-content-end">
                                <a asp-action="Details" asp-route-id="@item.VehicleId"
                                   class="af-button af-button-secondary" style="padding: 6px 10px;" title="View">👁</a>
                                <a asp-action="Edit" asp-route-id="@item.VehicleId"
                                   class="af-button af-button-secondary" style="padding: 6px 10px;" title="Edit">✎</a>
                                <a asp-action="Delete" asp-route-id="@item.VehicleId"
                                   class="af-button af-button-secondary" style="padding: 6px 10px; color:#dc2626;" title="Delete">🗑</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <p class="mb-2">No vehicles yet.</p>
            <a asp-action="Create" class="af-button af-button-primary">Add your first vehicle</a>
        </div>
    }
</div>