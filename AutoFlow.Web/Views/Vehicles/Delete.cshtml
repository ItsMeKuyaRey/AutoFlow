@model AutoFlow.Web.Models.Vehicle

@{
    ViewData["Title"] = "Delete Vehicle";
}

<div class="page-header">
    <div>
        <h1>Delete Vehicle</h1>
        <p>Are you sure you want to delete this vehicle?</p>
    </div>
</div>

<div class="af-card" style="max-width: 620px; padding: 28px;">
    <div class="alert alert-warning mb-4">
        This action cannot be undone. Related service records and appointments may also be affected.
    </div>

    <dl class="row mb-4">
        <dt class="col-sm-4 text-muted">Vehicle</dt>
        <dd class="col-sm-8 fw-semibold">@Model.Make @Model.Model (@Model.Year)</dd>

        <dt class="col-sm-4 text-muted">Plate</dt>
        <dd class="col-sm-8">@Model.PlateNumber</dd>

        <dt class="col-sm-4 text-muted">Owner</dt>
        <dd class="col-sm-8">
            @if (Model.Customer != null)
            {
                @($"{Model.Customer.FirstName} {Model.Customer.LastName}")
            }
            else
            {
                <span>—</span>
            }
        </dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="VehicleId" />
        <div class="d-flex gap-2">
            <button type="submit" class="af-button" style="background:#dc2626; color:white;">Delete Vehicle</button>
            <a asp-action="Index" class="af-button af-button-secondary">Cancel</a>
        </div>
    </form>
</div>