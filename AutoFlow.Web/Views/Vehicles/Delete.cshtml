@model AutoFlow.Web.Models.Vehicle

@{
    ViewData["Title"] = "Archive Vehicle";
}

<div class="customer-archive-page">

    <div class="customer-form-header">
        <div>
            <a asp-action="Index" class="customer-back-link">
                ← Back to Vehicles
            </a>

            <h1>Archive Vehicle</h1>
            <p>Remove this vehicle from the active vehicle records.</p>
        </div>
    </div>

    <div class="customer-archive-card">

        <div class="customer-archive-summary">

            <div class="customer-large-avatar">
                🚗
            </div>

            <div>
                <span class="customer-status-badge">
                    Active
                </span>

                <h2>@Model.Make @Model.Model</h2>

                <p>
                    @Model.PlateNumber
                    ·
                    @(Model.Year?.ToString() ?? "Year unknown")
                </p>
            </div>

        </div>

        <div class="alert alert-warning mt-4">
            <strong>Archive this vehicle?</strong>
            <br />
            This vehicle will no longer appear in the active vehicle list.
            Its record will remain stored and can be restored later.
        </div>

        <div class="customer-information-grid mt-4">

            <div class="customer-info-card">
                <span class="customer-info-label">Owner</span>

                <strong>
                    @if (Model.Customer != null)
                    {
                        @($"{Model.Customer.FirstName} {Model.Customer.LastName}")
                    }
                    else
                    {
                        <span>Not assigned</span>
                    }
                </strong>
            </div>

            <div class="customer-info-card">
                <span class="customer-info-label">Plate Number</span>
                <strong>@Model.PlateNumber</strong>
            </div>

            <div class="customer-info-card">
                <span class="customer-info-label">VIN</span>
                <strong>
                    @(string.IsNullOrWhiteSpace(Model.VIN) ? "Not recorded" : Model.VIN)
                </strong>
            </div>

            <div class="customer-info-card">
                <span class="customer-info-label">Mileage</span>
                <strong>
                    @(Model.Mileage.HasValue ? $"{Model.Mileage:N0} km" : "—")
                </strong>
            </div>

        </div>

        <form asp-action="Delete" method="post" class="customer-form-footer">

            <input type="hidden" asp-for="VehicleId" />

            <a asp-action="Index"
               class="af-button af-button-secondary">
                Cancel
            </a>

            <button type="submit"
                    class="af-button customer-danger-button">
                Archive Vehicle
            </button>

        </form>

    </div>
</div>