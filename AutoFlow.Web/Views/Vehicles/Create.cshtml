@model AutoFlow.Web.Models.Vehicle

@{
    ViewData["Title"] = "Add Vehicle";
}

<style>
    .vehicle-create-drawer-page {
        position: relative;
        min-height: calc(100vh - 120px);
        margin: -20px -24px;
        background: #f5f7fb;
        overflow: hidden;
    }

    .vehicle-create-drawer-backdrop {
        position: absolute;
        inset: 0;
        background:
            linear-gradient(90deg, rgba(245,247,251,.82), rgba(245,247,251,.58)),
            #f5f7fb;
    }

    .vehicle-create-drawer-shell {
        position: relative;
        min-height: calc(100vh - 120px);
    }

    .vehicle-create-drawer {
        position: absolute;
        top: 0;
        right: 0;
        width: min(560px, 100%);
        min-height: calc(100vh - 120px);
        background: #fff;
        border-left: 1px solid #e5e7eb;
        box-shadow: -18px 0 45px rgba(15, 23, 42, .10);
        display: flex;
        flex-direction: column;
        z-index: 2;
    }

    .vehicle-create-drawer-header {
        padding: 25px 28px 22px;
        border-bottom: 1px solid #edf0f4;
    }

    .vehicle-create-drawer-title-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
    }

    .vehicle-create-drawer-title {
        margin: 0;
        color: #111827;
        font-size: 20px;
        font-weight: 850;
        letter-spacing: -.02em;
    }

    .vehicle-create-drawer-subtitle {
        margin: 7px 0 0;
        color: #8b95a7;
        font-size: 11px;
        line-height: 1.6;
    }

    .vehicle-create-drawer-close {
        color: #8b95a7;
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
        padding-top: 3px;
    }

    .vehicle-create-drawer-close:hover {
        color: #7c3aed;
    }

    .vehicle-create-drawer-body {
        flex: 1;
        overflow-y: auto;
        padding: 26px 28px 30px;
    }

    .vehicle-create-drawer-section {
        margin-bottom: 26px;
    }

    .vehicle-create-drawer-section:last-child {
        margin-bottom: 0;
    }

    .vehicle-create-drawer-section-heading {
        margin-bottom: 14px;
    }

    .vehicle-create-drawer-section-heading h2 {
        margin: 0;
        color: #172033;
        font-size: 12px;
        font-weight: 850;
    }

    .vehicle-create-drawer-section-heading p {
        margin: 4px 0 0;
        color: #9aa3b2;
        font-size: 10px;
    }

    .vehicle-create-drawer-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .vehicle-create-drawer-field {
        margin-bottom: 14px;
    }

    .vehicle-create-drawer-field.full {
        grid-column: 1 / -1;
    }

    .vehicle-create-drawer-field label {
        display: block;
        margin-bottom: 7px;
        color: #697386;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    .vehicle-create-drawer-field input,
    .vehicle-create-drawer-field textarea {
        width: 100%;
        border: 1px solid #e2e6ed;
        border-radius: 8px;
        background: #fff;
        color: #172033;
        font-size: 11px;
        padding: 11px 12px;
        outline: none;
        transition: .18s ease;
        box-sizing: border-box;
    }

    .vehicle-create-drawer-field input {
        height: 40px;
    }

    .vehicle-create-drawer-field textarea {
        min-height: 92px;
        resize: vertical;
    }

    .vehicle-create-drawer-field input:focus,
    .vehicle-create-drawer-field textarea:focus {
        border-color: #8b5cf6;
        box-shadow: 0 0 0 3px rgba(124, 58, 237, .08);
    }

    .vehicle-create-drawer-field-error {
        display: block;
        margin-top: 5px;
        color: #dc2626;
        font-size: 9px;
    }

    .vehicle-create-drawer-validation {
        margin-bottom: 20px;
        padding: 11px 13px;
        border: 1px solid #fecaca;
        border-radius: 8px;
        background: #fff7f7;
        color: #b91c1c;
        font-size: 10px;
    }

    .vehicle-create-drawer-footer {
        display: flex;
        justify-content: flex-end;
        gap: 9px;
        padding: 17px 28px;
        border-top: 1px solid #edf0f4;
        background: #fff;
    }

    .vehicle-create-drawer-btn {
        min-width: 112px;
        height: 38px;
        padding: 0 15px;
        border-radius: 8px;
        font-size: 10px;
        font-weight: 800;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid transparent;
        box-sizing: border-box;
    }

    .vehicle-create-drawer-btn-secondary {
        border-color: #e1e5eb;
        background: #fff;
        color: #5f6b7c;
    }

    .vehicle-create-drawer-btn-secondary:hover {
        background: #f8fafc;
        color: #172033;
    }

    .vehicle-create-drawer-btn-primary {
        border-color: #7c3aed;
        background: #7c3aed;
        color: #fff;
        box-shadow: 0 7px 18px rgba(124, 58, 237, .18);
    }

    .vehicle-create-drawer-btn-primary:hover {
        background: #6d28d9;
    }

    .vehicle-create-drawer-icon {
        width: 40px;
        height: 40px;
        margin-bottom: 18px;
        border-radius: 11px;
        background: #f1eaff;
        color: #7c3aed;
        display: grid;
        place-items: center;
        font-size: 18px;
    }

    @@media (max-width: 700px) {
        .vehicle-create-drawer {
            width: 100%;
            border-left: 0;
        }

        .vehicle-create-drawer-grid {
            grid-template-columns: 1fr;
        }

        .vehicle-create-drawer-field.full {
            grid-column: auto;
        }

        .vehicle-create-drawer-header,
        .vehicle-create-drawer-body,
        .vehicle-create-drawer-footer {
            padding-left: 20px;
            padding-right: 20px;
        }
    }

    /* AutoFlow vehicle overlay */
    .vehicle-create-drawer-page {
        position: fixed !important;
        inset: 0 !important;
        width: 100vw !important;
        height: 100vh !important;
        min-height: 100vh !important;
        margin: 0 !important;
        background: transparent !important;
        overflow: hidden !important;
        z-index: 5000 !important;
    }

    .vehicle-create-drawer-backdrop {
        position: absolute !important;
        inset: 0 !important;
        background: rgba(15, 23, 42, .22) !important;
        backdrop-filter: blur(2px);
    }

    .vehicle-create-drawer-shell {
        position: relative !important;
        width: 100% !important;
        height: 100% !important;
        min-height: 100vh !important;
    }

    .vehicle-create-drawer {
        position: absolute !important;
        top: 0 !important;
        right: 0 !important;
        height: 100vh !important;
        min-height: 100vh !important;
        max-height: 100vh !important;
        animation: afVehicleCreateDrawerIn .20s ease-out;
    }

    @@keyframes afVehicleCreateDrawerIn {
        from { transform: translateX(28px); opacity: .94; }
        to { transform: translateX(0); opacity: 1; }
    }



    .vehicle-create-drawer-icon.vehicle-create-drawer-icon-vehicle {
        background: #f0eafa;
        color: #7c3aed;
    }

    .vehicle-create-drawer-preview {
        margin-top: 8px;
        padding: 10px 12px;
        border: 1px solid #edf0f4;
        border-radius: 9px;
        background: #fafbfc;
        color: #7b8494;
        font-size: 9px;
        line-height: 1.6;
    }
    .af-image-picker { display:flex; align-items:center; gap:14px; padding:12px; border:1px solid #e8eaf0; border-radius:14px; background:#fafbfc; }
    .af-image-preview { width:76px; height:76px; flex:0 0 76px; border-radius:16px; overflow:hidden; background:#f1eaff; display:grid; place-items:center; border:1px solid #e6defe; }
    .af-image-preview img { width:100%; height:100%; object-fit:contain; display:block; background:#fff; }
    .af-image-preview-empty { width:100%; height:100%; display:grid; place-items:center; color:#7c3aed; font-size:24px; }
    .af-image-picker-controls { min-width:0; display:flex; flex-direction:column; gap:5px; }
    .af-image-picker-button { display:inline-flex; align-items:center; justify-content:center; gap:7px; width:max-content; padding:8px 11px; border-radius:8px; background:#7c3aed; color:#fff; font-size:11px; font-weight:800; cursor:pointer; }
    .af-image-picker-button:hover { background:#6d28d9; }
    .af-image-selected { color:#344054; font-size:11px; font-weight:750; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:280px; }
    .af-image-picker-controls small { color:#98a1b2; font-size:10px; }

    .vehicle-customer-profile { display:none; align-items:center; gap:12px; margin-top:10px; padding:12px; border:1px solid #e8eaf0; border-radius:14px; background:#fafbfc; }
    .vehicle-customer-profile.is-visible { display:flex; }
    .vehicle-customer-profile-avatar { width:48px; height:48px; flex:0 0 48px; border-radius:12px; overflow:hidden; display:grid; place-items:center; background:#f1eaff; color:#6d28d9; font-size:16px; font-weight:900; border:1px solid #e6defe; }
    .vehicle-customer-profile-avatar img { width:100%; height:100%; object-fit:contain; display:block; background:#fff; }
    .vehicle-customer-profile-copy { min-width:0; display:flex; flex-direction:column; gap:2px; }
    .vehicle-customer-profile-copy strong { color:#1f2937; font-size:12px; font-weight:850; }
    .vehicle-customer-profile-copy span { color:#667085; font-size:10px; line-height:1.35; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .vehicle-customer-profile-status { margin-left:auto; padding:4px 8px; border-radius:999px; background:#dcfce7; color:#16803a; font-size:9px; font-weight:850; text-transform:uppercase; }
    .vehicle-customer-profile-status.archived { background:#f1f5f9; color:#64748b; }

</style>

<div class="vehicle-create-drawer-page">
    <div class="vehicle-create-drawer-backdrop"></div>
    <div class="vehicle-create-drawer-shell">
        <aside class="vehicle-create-drawer">
            <div class="vehicle-create-drawer-header">
                <div class="vehicle-create-drawer-title-row">
                    <div>
                        <h1 class="vehicle-create-drawer-title">Add Vehicle</h1>
                        <p class="vehicle-create-drawer-subtitle">Register a new vehicle and connect it to an AutoFlow customer.</p>
                    </div>
                    <a asp-action="Index" class="vehicle-create-drawer-close">Cancel</a>
                </div>
            </div>

            <form asp-action="Create" method="post" enctype="multipart/form-data" class="d-flex flex-column flex-grow-1">
                @Html.AntiForgeryToken()
                <div class="vehicle-create-drawer-body">
                    <div class="vehicle-create-drawer-icon vehicle-create-drawer-icon-vehicle">
                        <i class="bi bi-car-front"></i>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="vehicle-create-drawer-validation"></div>

                    <section class="vehicle-create-drawer-section">
                        <div class="vehicle-create-drawer-section-heading">
                            <h2>Vehicle Information</h2>
                            <p>Enter the vehicle's registered information.</p>
                        </div>

                        <div class="vehicle-create-drawer-grid">
                            <div class="vehicle-create-drawer-field full">
                                <label asp-for="CustomerId">Customer</label>
                                <select asp-for="CustomerId" asp-items="ViewBag.CustomerId" id="vehicleCreateCustomer">
                                    <option value="">Select customer...</option>
                                </select>
                                <span asp-validation-for="CustomerId" class="vehicle-create-drawer-field-error"></span>
                                <div class="vehicle-customer-profile" id="vehicleCreateCustomerProfile" aria-live="polite">
                                    <div class="vehicle-customer-profile-avatar" id="vehicleCreateCustomerAvatar"></div>
                                    <div class="vehicle-customer-profile-copy">
                                        <strong id="vehicleCreateCustomerName"></strong>
                                        <span id="vehicleCreateCustomerContact"></span>
                                    </div>
                                    <span class="vehicle-customer-profile-status" id="vehicleCreateCustomerStatus">Active</span>
                                </div>
                            </div>

                            <div class="vehicle-create-drawer-field">
                                <label asp-for="Make">Make</label>
                                <input asp-for="Make" placeholder="e.g. Toyota" autocomplete="organization" />
                                <span asp-validation-for="Make" class="vehicle-create-drawer-field-error"></span>
                            </div>

                            <div class="vehicle-create-drawer-field">
                                <label asp-for="Model">Model</label>
                                <input asp-for="Model" placeholder="e.g. Vios" />
                                <span asp-validation-for="Model" class="vehicle-create-drawer-field-error"></span>
                            </div>

                            <div class="vehicle-create-drawer-field">
                                <label asp-for="Year">Year</label>
                                <input asp-for="Year" type="number" placeholder="e.g. 2024" min="1900" max="2100" />
                                <span asp-validation-for="Year" class="vehicle-create-drawer-field-error"></span>
                            </div>

                            <div class="vehicle-create-drawer-field">
                                <label asp-for="Color">Color</label>
                                <input asp-for="Color" placeholder="e.g. Silver" />
                                <span asp-validation-for="Color" class="vehicle-create-drawer-field-error"></span>
                            </div>

                            <div class="vehicle-create-drawer-field full">
                                <label asp-for="PlateNumber">Plate Number</label>
                                <input asp-for="PlateNumber" placeholder="Enter plate number" autocomplete="off" />
                                <span asp-validation-for="PlateNumber" class="vehicle-create-drawer-field-error"></span>
                            </div>

                            <div class="vehicle-create-drawer-field full">
                                <label asp-for="VIN">VIN</label>
                                <input asp-for="VIN" placeholder="Enter VIN if available" autocomplete="off" />
                                <span asp-validation-for="VIN" class="vehicle-create-drawer-field-error"></span>
                            </div>

                            <div class="vehicle-create-drawer-field">
                                <label asp-for="Mileage">Mileage</label>
                                <input asp-for="Mileage" type="number" min="0" placeholder="Current mileage" />
                                <span asp-validation-for="Mileage" class="vehicle-create-drawer-field-error"></span>
                            </div>

                            <div class="vehicle-create-drawer-field">
                                <label>Vehicle Image</label>
                                <div class="af-image-picker">
                                    <div class="af-image-preview" id="vehicleCreateImagePreview"><div class="af-image-preview-empty"><i class="bi bi-car-front"></i></div></div>
                                    <div class="af-image-picker-controls">
                                        <label for="vehicleCreateProfileImage" class="af-image-picker-button"><i class="bi bi-image"></i> Choose Image</label>
                                        <input id="vehicleCreateProfileImage" name="profileImage" type="file" accept="image/png,image/jpeg,image/webp,image/gif" hidden />
                                        <div class="af-image-selected" id="vehicleCreateImageStatus">No image selected</div>
                                        <small>PNG, JPG, WEBP or GIF · Max 5 MB</small>
                                    </div>
                                </div>
                                <span asp-validation-for="ImageUrl" class="vehicle-create-drawer-field-error"></span>
                            </div>
                        </div>

                        <div class="vehicle-create-drawer-preview">
                            Vehicle images are optional. The vehicle record remains fully usable without an image.
                        </div>
                    </section>
                </div>

                <div class="vehicle-create-drawer-footer">
                    <a asp-action="Index" class="vehicle-create-drawer-btn vehicle-create-drawer-btn-secondary">Cancel</a>
                    <button type="submit" class="vehicle-create-drawer-btn vehicle-create-drawer-btn-primary">Create Vehicle</button>
                </div>
            </form>
        </aside>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

<script>
(function(){
    const input=document.getElementById('vehicleCreateProfileImage'),preview=document.getElementById('vehicleCreateImagePreview'),status=document.getElementById('vehicleCreateImageStatus');
    if(input&&preview&&status){input.addEventListener('change',function(){const file=this.files&&this.files[0];if(!file){status.textContent='No image selected';return;}status.textContent=file.name;const r=new FileReader();r.onload=e=>preview.innerHTML='<img src="'+e.target.result+'" alt="Selected vehicle image" />';r.readAsDataURL(file);});}
    const customer=document.getElementById('vehicleCreateCustomer'),card=document.getElementById('vehicleCreateCustomerProfile'),avatar=document.getElementById('vehicleCreateCustomerAvatar'),name=document.getElementById('vehicleCreateCustomerName'),contact=document.getElementById('vehicleCreateCustomerContact'),state=document.getElementById('vehicleCreateCustomerStatus');
    const profiles=@Html.Raw(ViewBag.CustomerProfilesJson ?? "[]");
    function renderCustomer(){const item=profiles.find(x=>String(x.id)===String(customer?.value));if(!item){card?.classList.remove('is-visible');return;}if(name)name.textContent=item.name||'Customer';if(contact)contact.textContent=item.phone||item.email||item.address||'No contact information';if(state){state.textContent=item.isArchived?'Archived':'Active';state.classList.toggle('archived',!!item.isArchived);}if(avatar)avatar.innerHTML=item.imageUrl?'<img src="'+item.imageUrl+'" alt="'+(item.name||'Customer')+'" />':((item.name||'?').trim().charAt(0).toUpperCase());card?.classList.add('is-visible');}
    customer?.addEventListener('change',renderCustomer); renderCustomer();
})();
</script>
