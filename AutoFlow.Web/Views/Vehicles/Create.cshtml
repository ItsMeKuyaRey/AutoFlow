@model AutoFlow.Web.Models.Vehicle

@{
    ViewData["Title"] = "Add Vehicle";
}

<div class="page-header">
    <div>
        <h1>Add Vehicle</h1>
        <p>Register a new vehicle and link it to a customer.</p>
    </div>
</div>

<div class="af-card" style="max-width: 780px; padding: 28px;">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="CustomerId" class="form-label fw-semibold">Customer</label>
                <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.CustomerId">
                    <option value="">-- Select Customer --</option>
                </select>
                <span asp-validation-for="CustomerId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="PlateNumber" class="form-label fw-semibold">Plate Number</label>
                <input asp-for="PlateNumber" class="form-control" />
                <span asp-validation-for="PlateNumber" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Make" class="form-label fw-semibold">Make</label>
                <input asp-for="Make" class="form-control" />
                <span asp-validation-for="Make" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Model" class="form-label fw-semibold">Model</label>
                <input asp-for="Model" class="form-control" />
                <span asp-validation-for="Model" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Year" class="form-label fw-semibold">Year</label>
                <input asp-for="Year" class="form-control" />
                <span asp-validation-for="Year" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Color" class="form-label fw-semibold">Color</label>
                <input asp-for="Color" class="form-control" />
                <span asp-validation-for="Color" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Mileage" class="form-label fw-semibold">Mileage</label>
                <input asp-for="Mileage" class="form-control" />
                <span asp-validation-for="Mileage" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="VIN" class="form-label fw-semibold">VIN</label>
                <input asp-for="VIN" class="form-control" />
                <span asp-validation-for="VIN" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ImageUrl" class="form-label fw-semibold">Image URL (optional)</label>
                <input asp-for="ImageUrl" class="form-control" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="af-button af-button-primary">Create Vehicle</button>
            <a asp-action="Index" class="af-button af-button-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}