@model IEnumerable<AutoFlow.Web.Models.Vehicle>

@{
    ViewData["Title"] = "Archived Vehicles";
    var vehicles = Model.ToList();
}

<style>
    .vehicle-archive-history {
        max-width: 1180px;
        margin: 0 auto;
    }

    .vehicle-archive-history-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 22px;
    }

    .vehicle-archive-history-back {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 8px;
        color: #7c3aed;
        text-decoration: none;
        font-size: 10px;
        font-weight: 800;
    }

    .vehicle-archive-history-back:hover {
        color: #5b21b6;
    }

    .vehicle-archive-eyebrow {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 7px;
        color: #7c3aed;
        font-size: 8px;
        font-weight: 850;
        letter-spacing: .12em;
    }

    .vehicle-archive-eyebrow-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #7c3aed;
    }

    .vehicle-archive-history-title {
        margin: 0;
        color: #111827;
        font-size: 25px;
        font-weight: 900;
        letter-spacing: -.035em;
    }

    .vehicle-archive-history-subtitle {
        margin: 6px 0 0;
        color: #8b95a7;
        font-size: 10px;
    }

    .vehicle-archive-history-count {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 12px;
        border: 1px solid #e6e9ee;
        border-radius: 9px;
        background: #fff;
        color: #657084;
        font-size: 9px;
        font-weight: 800;
    }

    .vehicle-archive-history-count strong {
        color: #7c3aed;
        font-size: 12px;
    }

    .vehicle-archive-history-card {
        overflow: hidden;
        border: 1px solid #e5e8ed;
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 8px 28px rgba(15,23,42,.035);
    }

    .vehicle-archive-history-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 13px 17px;
        border-bottom: 1px solid #edf0f4;
        background: #fbfcfe;
    }

    .vehicle-archive-history-toolbar span {
        color: #8d97a8;
        font-size: 9px;
    }

    .vehicle-archive-history-table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .vehicle-archive-history-table {
        width: 100%;
        min-width: 820px;
        border-collapse: collapse;
    }

    .vehicle-archive-history-table th {
        height: 42px;
        padding: 0 16px;
        background: #fafbfc;
        border-bottom: 1px solid #e5e8ed;
        color: #98a1b0;
        font-size: 8px;
        font-weight: 850;
        letter-spacing: .08em;
        text-align: left;
        text-transform: uppercase;
    }

    .vehicle-archive-history-table td {
        padding: 13px 16px;
        border-bottom: 1px solid #f0f2f5;
        color: #526073;
        font-size: 10px;
        vertical-align: middle;
    }

    .vehicle-archive-history-table tr:last-child td {
        border-bottom: 0;
    }

    .vehicle-archive-history-table tbody tr:hover {
        background: #faf9ff;
    }

    .vehicle-archive-person {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .vehicle-archive-person-avatar {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        background: #f0ebff;
        color: #7c3aed;
        display: grid;
        place-items: center;
        font-size: 9px;
        font-weight: 850;
    }

    .vehicle-archive-person strong {
        display: block;
        color: #1f2937;
        font-size: 10px;
        font-weight: 850;
    }

    .vehicle-archive-person span {
        display: block;
        margin-top: 3px;
        color: #9aa3b2;
        font-size: 8px;
    }

    .vehicle-archive-contact span {
        display: block;
        margin-bottom: 3px;
        color: #657084;
        font-size: 9px;
    }

    .vehicle-archive-contact span:last-child {
        margin-bottom: 0;
        color: #9aa3b2;
    }

    .vehicle-archive-status {
        display: inline-flex;
        padding: 5px 8px;
        border-radius: 999px;
        background: #fff1f0;
        color: #d95548;
        font-size: 8px;
        font-weight: 850;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .vehicle-archive-date {
        margin-top: 5px;
        color: #9aa3b2;
        font-size: 8px;
    }

    .vehicle-archive-row-actions {
        display: flex;
        justify-content: flex-end;
        gap: 6px;
    }

    .vehicle-archive-row-button {
        height: 29px;
        padding: 0 9px;
        border: 1px solid #e1e5eb;
        border-radius: 7px;
        background: #fff;
        color: #657084;
        font-size: 8px;
        font-weight: 800;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .vehicle-archive-row-button:hover {
        border-color: #c4b5fd;
        color: #7c3aed;
    }

    .vehicle-archive-row-button.restore {
        border-color: #ccefe1;
        background: #f4fffa;
        color: #059669;
    }

    .vehicle-archive-row-button.restore:hover {
        background: #ecfdf5;
    }

    .vehicle-archive-empty {
        padding: 70px 20px;
        text-align: center;
    }

    .vehicle-archive-empty-icon {
        width: 50px;
        height: 50px;
        margin: 0 auto 14px;
        border-radius: 13px;
        background: #ecfdf5;
        color: #059669;
        display: grid;
        place-items: center;
        font-size: 19px;
    }

    .vehicle-archive-empty h2 {
        margin: 0;
        color: #263143;
        font-size: 14px;
        font-weight: 850;
    }

    .vehicle-archive-empty p {
        margin: 6px 0 18px;
        color: #9aa3b2;
        font-size: 9px;
    }

    .vehicle-archive-empty-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 34px;
        padding: 0 13px;
        border-radius: 8px;
        background: #7c3aed;
        color: #fff;
        text-decoration: none;
        font-size: 9px;
        font-weight: 800;
    }

    @@media (max-width: 700px) {
        .vehicle-archive-history-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .vehicle-archive-history-count {
            align-self: flex-start;
        }
    }

    /* AutoFlow vehicle archive-history overlay */
    .vehicle-archive-history-page {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        min-height: 100vh;
        margin: 0;
        background: transparent;
        overflow: hidden;
        z-index: 5000;
    }

    .vehicle-archive-history-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(15, 23, 42, .22);
        backdrop-filter: blur(2px);
    }

    .vehicle-archive-history-drawer {
        position: absolute;
        top: 0;
        right: 0;
        width: min(780px, 100%);
        height: 100vh;
        max-height: 100vh;
        overflow-y: auto;
        box-sizing: border-box;
        background: #fff;
        border-left: 1px solid #e5e7eb;
        box-shadow: -18px 0 45px rgba(15, 23, 42, .12);
        animation: afVehicleDrawerIn .20s ease-out;
    }

    .vehicle-archive-history {
        max-width: none;
        min-height: 100%;
        margin: 0;
        padding: 26px 28px 30px;
        box-sizing: border-box;
    }

    .vehicle-archive-history-header {
        align-items: flex-start;
    }

    @@keyframes afVehicleDrawerIn {
        from { transform: translateX(28px); opacity: .94; }
        to { transform: translateX(0); opacity: 1; }
    }

    @@media (max-width: 700px) {
        .vehicle-archive-history-drawer {
            width: 100%;
            border-left: 0;
        }

        .vehicle-archive-history {
            padding-left: 20px;
            padding-right: 20px;
        }
    }


    .vehicle-archive-person-avatar img,
    .vehicle-archived-avatar img,
    .vehicle-details-avatar img,
    .vehicle-edit-avatar img,
    .vehicle-archive-avatar img,
    .vehicle-drawer-preview img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
    }

    .vehicle-archive-person-avatar { overflow:hidden; }
    .vehicle-archive-person-avatar img { width:100%; height:100%; object-fit:contain; display:block; background:#fff; }
</style>

<div class="vehicle-archive-history-page">
    <div class="vehicle-archive-history-backdrop"></div>

    <aside class="vehicle-archive-history-drawer">
        <div class="vehicle-archive-history">
            <div class="vehicle-archive-history-header">
                <div>
                    <a asp-action="Index" class="vehicle-archive-history-back">← Back to Vehicles</a>
                    <div class="vehicle-archive-eyebrow">
                        <span class="vehicle-archive-eyebrow-dot"></span>
                        VEHICLE HISTORY
                    </div>
                    <h1 class="vehicle-archive-history-title">Archived Vehicles</h1>
                    <p class="vehicle-archive-history-subtitle">Preserved vehicle records that are no longer active.</p>
                </div>
                <div class="vehicle-archive-history-count">Archived <strong>@vehicles.Count</strong></div>
            </div>

            <div class="vehicle-archive-history-card">
                @if (vehicles.Any())
                {
                    <div class="vehicle-archive-history-toolbar">
                        <span>Historical vehicle records</span>
                        <span>Restoration remains available</span>
                    </div>

                    <div class="vehicle-archive-history-table-wrap">
                        <table class="vehicle-archive-history-table">
                            <thead>
                                <tr>
                                    <th>Vehicle</th>
                                    <th>Registration</th>
                                    <th>Owner</th>
                                    <th>Archive Status</th>
                                    <th style="text-align:right;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var vehicle in vehicles)
                                {
                                    var vehicleName = $"{vehicle.Make} {vehicle.Model}".Trim();
                                    var ownerName = vehicle.Customer == null ? "No owner assigned" : $"{vehicle.Customer.FirstName} {vehicle.Customer.LastName}".Trim();
                                    <tr>
                                        <td>
                                            <div class="vehicle-archive-person">
                                                <div class="vehicle-archive-person-avatar">
                                                    @if (!string.IsNullOrWhiteSpace(vehicle.ImageUrl))
                                                    {
                                                        <img src="@vehicle.ImageUrl" alt="@vehicleName" />
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-car-front"></i>
                                                    }
                                                </div>
                                                <div>
                                                    <strong>@vehicleName</strong>
                                                    <span>ID #@vehicle.VehicleId</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="vehicle-archive-contact">
                                                <span>@vehicle.PlateNumber</span>
                                                <span>VIN: @(string.IsNullOrWhiteSpace(vehicle.VIN) ? "Not recorded" : vehicle.VIN)</span>
                                            </div>
                                        </td>
                                        <td>
                                            <strong>@ownerName</strong>
                                        </td>
                                        <td>
                                            <span class="vehicle-archive-status">Archived</span>
                                            <div class="vehicle-archive-date">@vehicle.UpdatedAt.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                        </td>
                                        <td>
                                            <div class="vehicle-archive-row-actions">
                                                <a asp-action="ArchivedDetails" asp-route-id="@vehicle.VehicleId" class="vehicle-archive-row-button">View</a>
                                                <form asp-action="Restore" method="post" style="margin:0;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@vehicle.VehicleId" />
                                                    <button type="submit" class="vehicle-archive-row-button restore">Restore</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="vehicle-archive-empty">
                        <div class="vehicle-archive-empty-icon"><i class="bi bi-car-front"></i></div>
                        <h2>No Archived Vehicles</h2>
                        <p>All vehicle records are currently active.</p>
                        <a asp-action="Index" class="vehicle-archive-empty-button">Back to Vehicles</a>
                    </div>
                }
            </div>
        </div>
    </aside>
</div>
