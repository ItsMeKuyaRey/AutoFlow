@model AutoFlow.Web.Models.Vehicle

@{
    ViewData["Title"] = "Vehicle Details";
}

<div class="customer-detail-page">

    <div class="customer-detail-header">
        <div>
            <a asp-action="Index" class="customer-back-link">
                ← Back to Vehicles
            </a>

            <h1>Vehicle Details</h1>
            <p>View vehicle specifications, ownership, and record information.</p>
        </div>

        <div class="page-header-actions">
            <a asp-action="Edit"
               asp-route-id="@Model.VehicleId"
               class="af-button af-button-primary">
                Edit Vehicle
            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.VehicleId"
               class="af-button af-button-secondary">
                Archive
            </a>
        </div>
    </div>

    <div class="customer-profile-card">

        <div class="customer-profile-main">
            <div class="customer-large-avatar">
                🚗
            </div>

            <div>
                <span class="customer-status-badge">
                    Active
                </span>

                <h2>@Model.Make @Model.Model</h2>

                <p>
                    @(Model.Year.HasValue ? Model.Year.ToString() : "Year unknown")
                    · @Model.PlateNumber
                </p>
            </div>
        </div>

        <div class="customer-information-grid">

            <div class="customer-info-card">
                <span class="customer-info-label">Owner</span>

                <strong>
                    @if (Model.Customer != null)
                    {
                        @($"{Model.Customer.FirstName} {Model.Customer.LastName}")
                    }
                    else
                    {
                        <span>Not assigned</span>
                    }
                </strong>
            </div>

            <div class="customer-info-card">
                <span class="customer-info-label">Plate Number</span>
                <strong>@Model.PlateNumber</strong>
            </div>

            <div class="customer-info-card">
                <span class="customer-info-label">VIN</span>

                <strong>
                    @(string.IsNullOrWhiteSpace(Model.VIN) ? "Not recorded" : Model.VIN)
                </strong>
            </div>

            <div class="customer-info-card">
                <span class="customer-info-label">Make</span>
                <strong>@Model.Make</strong>
            </div>

            <div class="customer-info-card">
                <span class="customer-info-label">Model</span>
                <strong>@Model.Model</strong>
            </div>

            <div class="customer-info-card">
                <span class="customer-info-label">Year</span>
                <strong>@(Model.Year?.ToString() ?? "—")</strong>
            </div>

            <div class="customer-info-card">
                <span class="customer-info-label">Color</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.Color) ? "—" : Model.Color)</strong>
            </div>

            <div class="customer-info-card">
                <span class="customer-info-label">Mileage</span>
                <strong>@(Model.Mileage.HasValue ? $"{Model.Mileage:N0} km" : "—")</strong>
            </div>

        </div>

        <div class="customer-form-section">
            <div class="customer-form-section-header">
                <div>
                    <h3>Record Information</h3>
                    <p>System timestamps for this vehicle record.</p>
                </div>
            </div>

            <div class="customer-information-grid">

                <div class="customer-info-card">
                    <span class="customer-info-label">Created</span>
                    <strong>
                        @Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                    </strong>
                </div>

                <div class="customer-info-card">
                    <span class="customer-info-label">Last Updated</span>
                    <strong>
                        @Model.UpdatedAt.ToString("MMM dd, yyyy HH:mm")
                    </strong>
                </div>

            </div>
        </div>

    </div>
</div>