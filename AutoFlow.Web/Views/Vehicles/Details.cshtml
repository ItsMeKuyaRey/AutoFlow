@model AutoFlow.Web.Models.Vehicle

@{
    ViewData["Title"] = "Vehicle Details";
    var vehicleInitial = string.IsNullOrWhiteSpace(Model.Make) ? "V" : Model.Make.Substring(0, 1).ToUpperInvariant();
    var vehicleName = $"{Model.Make} {Model.Model}".Trim();
    var ownerName = Model.Customer == null ? "No owner assigned" : $"{Model.Customer.FirstName} {Model.Customer.LastName}".Trim();
}

<style>
    .vehicle-details-page {
        position: relative;
        min-height: calc(100vh - 120px);
        margin: -20px -24px;
        background: #f5f7fb;
        overflow: hidden;
    }

    .vehicle-details-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(245,247,251,.78);
    }

    .vehicle-details-drawer {
        position: absolute;
        top: 0;
        right: 0;
        width: min(570px, 100%);
        min-height: calc(100vh - 120px);
        background: #fff;
        border-left: 1px solid #e5e7eb;
        box-shadow: -18px 0 45px rgba(15,23,42,.10);
        z-index: 2;
        display: flex;
        flex-direction: column;
    }

    .vehicle-details-header {
        padding: 22px 28px 20px;
        border-bottom: 1px solid #edf0f4;
    }

    .vehicle-details-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .vehicle-details-close {
        color: #9aa3b2;
        text-decoration: none;
        font-size: 18px;
        line-height: 1;
    }

    .vehicle-details-close:hover {
        color: #7c3aed;
    }

    .vehicle-details-actions {
        display: flex;
        gap: 7px;
    }

    .vehicle-details-action {
        height: 30px;
        padding: 0 11px;
        border: 1px solid #e1e5eb;
        border-radius: 7px;
        background: #fff;
        color: #586477;
        font-size: 9px;
        font-weight: 800;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .vehicle-details-action:hover {
        border-color: #c4b5fd;
        color: #7c3aed;
    }

    .vehicle-details-action-danger {
        color: #dc2626;
    }

    .vehicle-details-action-danger:hover {
        color: #b91c1c;
        border-color: #fecaca;
    }

    .vehicle-details-restore {
        color: #059669;
        border-color: #ccefe1;
        cursor: pointer;
    }

    .vehicle-details-restore:hover {
        color: #047857;
        border-color: #a7f3d0;
        background: #f0fdf4;
    }

    .vehicle-details-body {
        flex: 1;
        overflow-y: auto;
        padding: 26px 28px 35px;
    }

    .vehicle-details-profile {
        display: flex;
        align-items: center;
        gap: 15px;
        padding-bottom: 25px;
        border-bottom: 1px solid #edf0f4;
    }

    .vehicle-details-avatar {
        width: 60px;
        height: 60px;
        border-radius: 15px;
        background: #eee7ff;
        color: #7c3aed;
        display: grid;
        place-items: center;
        font-size: 18px;
        font-weight: 850;
    }

    .vehicle-details-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 8px;
        border-radius: 999px;
        background: #ecfdf5;
        color: #059669;
        font-size: 8px;
        font-weight: 850;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .vehicle-details-status-archived {
        background: #fff1f0;
        color: #d95548;
    }

    .vehicle-details-name {
        margin: 7px 0 0;
        color: #111827;
        font-size: 18px;
        font-weight: 850;
    }

    .vehicle-details-id {
        margin: 4px 0 0;
        color: #9aa3b2;
        font-size: 9px;
    }

    .vehicle-details-section {
        margin-top: 25px;
    }

    .vehicle-details-section-heading {
        margin-bottom: 13px;
    }

    .vehicle-details-section-heading h2 {
        margin: 0;
        color: #172033;
        font-size: 12px;
        font-weight: 850;
    }

    .vehicle-details-section-heading p {
        margin: 4px 0 0;
        color: #9aa3b2;
        font-size: 9px;
    }

    .vehicle-details-card {
        border: 1px solid #e8ebf0;
        border-radius: 11px;
        background: #fff;
        overflow: hidden;
    }

    .vehicle-details-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 14px 15px;
        border-bottom: 1px solid #f0f2f5;
    }

    .vehicle-details-row:last-child {
        border-bottom: 0;
    }

    .vehicle-details-row span {
        color: #9aa3b2;
        font-size: 9px;
        font-weight: 700;
    }

    .vehicle-details-row strong {
        max-width: 65%;
        color: #263143;
        font-size: 10px;
        font-weight: 800;
        text-align: right;
        word-break: break-word;
    }

    .vehicle-details-record {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .vehicle-details-record-box {
        padding: 15px;
        border: 1px solid #e8ebf0;
        border-radius: 10px;
        background: #fbfcfe;
    }

    .vehicle-details-record-box span {
        display: block;
        color: #9aa3b2;
        font-size: 8px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .vehicle-details-record-box strong {
        display: block;
        margin-top: 6px;
        color: #172033;
        font-size: 11px;
        font-weight: 850;
    }

    @@media (max-width: 700px) {
        .vehicle-details-drawer {
            width: 100%;
            border-left: 0;
        }

        .vehicle-details-header,
        .vehicle-details-body {
            padding-left: 20px;
            padding-right: 20px;
        }
    }

    /* AutoFlow vehicle overlay */
    .vehicle-details-page {
        position: fixed !important;
        inset: 0 !important;
        width: 100vw !important;
        height: 100vh !important;
        min-height: 100vh !important;
        margin: 0 !important;
        background: transparent !important;
        overflow: hidden !important;
        z-index: 5000 !important;
    }

    .vehicle-details-backdrop {
        position: absolute !important;
        inset: 0 !important;
        background: rgba(15, 23, 42, .22) !important;
        backdrop-filter: blur(2px);
    }

    .vehicle-details-drawer {
        position: absolute !important;
        top: 0 !important;
        right: 0 !important;
        height: 100vh !important;
        min-height: 100vh !important;
        max-height: 100vh !important;
        animation: afVehicleDrawerIn .20s ease-out;
    }

    .vehicle-details-avatar { overflow:hidden; }
    .vehicle-details-avatar img { width:100%; height:100%; object-fit:contain; display:block; background:#fff; }
</style>

<div class="vehicle-details-page">
    <div class="vehicle-details-backdrop"></div>

    <aside class="vehicle-details-drawer">

        <div class="vehicle-details-header">
            <div class="vehicle-details-top">

                <div class="vehicle-details-actions">

                    @if (!Model.IsArchived)
                    {
                        <a asp-action="Edit"
                           asp-route-id="@Model.VehicleId"
                           class="vehicle-details-action">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@Model.VehicleId"
                           class="vehicle-details-action vehicle-details-action-danger">
                            Archive
                        </a>
                    }
                    else
                    {
                        <form asp-action="Restore"
                              method="post"
                              style="margin:0;">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.VehicleId" />

                            <button type="submit"
                                    class="vehicle-details-action vehicle-details-restore">
                                Restore
                            </button>

                        </form>
                    }

                </div>

                <a asp-action="Index"
                   class="vehicle-details-close"
                   title="Close">
                    ×
                </a>

            </div>
        </div>

        <div class="vehicle-details-body">

            <div class="vehicle-details-profile">

                <div class="vehicle-details-avatar">

                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl"
                             alt="@vehicleName" />
                    }
                    else
                    {
                        @vehicleInitial
                    }

                </div>

                <div>

                    @if (Model.IsArchived)
                    {
                        <span class="vehicle-details-status vehicle-details-status-archived">
                            Archived
                        </span>
                    }
                    else
                    {
                        <span class="vehicle-details-status">
                            <span>●</span>
                            Active
                        </span>
                    }

                    <h1 class="vehicle-details-name">
                        @vehicleName
                    </h1>

                    <p class="vehicle-details-id">
                        Vehicle ID #@Model.VehicleId
                    </p>

                </div>

            </div>

            <section class="vehicle-details-section">

                <div class="vehicle-details-section-heading">
                    <h2>Vehicle Information</h2>
                    <p>Current registered vehicle details.</p>
                </div>

                <div class="vehicle-details-card">

                    <div class="vehicle-details-row">
                        <span>Make</span>
                        <strong>@Model.Make</strong>
                    </div>

                    <div class="vehicle-details-row">
                        <span>Model</span>
                        <strong>@Model.Model</strong>
                    </div>

                    <div class="vehicle-details-row">
                        <span>Year</span>
                        <strong>
                            @(Model.Year?.ToString() ?? "Not provided")
                        </strong>
                    </div>

                    <div class="vehicle-details-row">
                        <span>Color</span>
                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.Color)
                                ? "Not provided"
                                : Model.Color)
                        </strong>
                    </div>

                    <div class="vehicle-details-row">
                        <span>Plate Number</span>
                        <strong>@Model.PlateNumber</strong>
                    </div>

                    <div class="vehicle-details-row">
                        <span>VIN</span>
                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.VIN)
                                ? "Not recorded"
                                : Model.VIN)
                        </strong>
                    </div>

                    <div class="vehicle-details-row">
                        <span>Mileage</span>
                        <strong>
                            @(Model.Mileage.HasValue
                                ? $"{Model.Mileage:N0} km"
                                : "Not recorded")
                        </strong>
                    </div>

                </div>

            </section>

            <section class="vehicle-details-section">

                <div class="vehicle-details-section-heading">
                    <h2>Owner Information</h2>
                    <p>Customer connected to this vehicle record.</p>
                </div>

                <div class="vehicle-details-card">

                    <div class="vehicle-details-row">
                        <span>Customer</span>
                        <strong>@ownerName</strong>
                    </div>

                    <div class="vehicle-details-row">
                        <span>Customer ID</span>
                        <strong>
                            @(Model.Customer == null
                                ? "Not available"
                                : $"#{Model.Customer.CustomerId}")
                        </strong>
                    </div>

                </div>

            </section>

            <section class="vehicle-details-section">

                <div class="vehicle-details-section-heading">
                    <h2>Record Information</h2>
                    <p>AutoFlow system timestamps for this vehicle.</p>
                </div>

                <div class="vehicle-details-record">

                    <div class="vehicle-details-record-box">
                        <span>Status</span>
                        <strong>
                            @(Model.IsArchived ? "Archived" : "Active")
                        </strong>
                    </div>

                    <div class="vehicle-details-record-box">
                        <span>Created</span>
                        <strong>
                            @Model.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                        </strong>
                    </div>

                    <div class="vehicle-details-record-box">
                        <span>Last Updated</span>
                        <strong>
                            @Model.UpdatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                        </strong>
                    </div>

                </div>

            </section>

        </div>

    </aside>

</div>