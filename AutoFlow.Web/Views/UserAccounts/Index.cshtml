@model IEnumerable<AutoFlow.Web.Controllers.UserAccountViewModel>

@{
    ViewData["Title"] = "Manage User Accounts";
}

<div class="page-header">
    <div>
        <div class="page-eyebrow">SYSTEM SETTINGS</div>
        <h1>Manage User Accounts</h1>
        <p class="page-description">
            View authorized AutoFlow users and their assigned system roles.
        </p>
    </div>
</div>

<div class="content-card">
    <div class="card-header">
        <div>
            <h2>Authorized Users</h2>
            <p>Accounts currently configured to access AutoFlow.</p>
        </div>

        <div class="user-count">
            <span>@Model.Count()</span>
            <small>Users</small>
        </div>
    </div>

    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Email Address</th>
                    <th>Role</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            <div class="user-email">
                                <div class="user-avatar">
                                    @user.Email.Substring(0, 1).ToUpper()
                                </div>

                                <span>@user.Email</span>
                            </div>
                        </td>

                        <td>
                            @if (user.Role == "Administrator")
                            {
                                <span class="role-badge administrator">
                                    Administrator
                                </span>
                            }
                            else if (user.Role == "ServiceAdvisor")
                            {
                                <span class="role-badge service-advisor">
                                    Service Advisor
                                </span>
                            }
                            else if (user.Role == "Technician")
                            {
                                <span class="role-badge technician">
                                    Technician
                                </span>
                            }
                            else if (user.Role == "Cashier")
                            {
                                <span class="role-badge cashier">
                                    Cashier
                                </span>
                            }
                            else
                            {
                                <span class="role-badge">
                                    @user.Role
                                </span>
                            }
                        </td>

                        <td>
                            @if (user.Status == "Active")
                            {
                                <span class="status-badge active">
                                    <span class="status-dot"></span>
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="status-badge inactive">
                                    <span class="status-dot"></span>
                                    @user.Status
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="info-card">
    <div class="info-icon">
        <i class="fa-solid fa-shield-halved"></i>
    </div>

    <div>
        <h3>Role-Based Access Control</h3>
        <p>
            AutoFlow access is restricted to authorized Google accounts.
            Each account is assigned a specific role that determines which
            modules and actions are available within the system.
        </p>
    </div>
</div>

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 28px;
    }

    .page-eyebrow {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.12em;
        color: #7c3aed;
        margin-bottom: 7px;
    }

    .page-header h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
        color: #172033;
    }

    .page-description {
        margin: 8px 0 0;
        color: #6b7280;
        font-size: 14px;
    }

    .content-card {
        background: #ffffff;
        border: 1px solid #e7e9ef;
        border-radius: 16px;
        box-shadow: 0 5px 20px rgba(15, 23, 42, 0.04);
        overflow: hidden;
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 22px 24px;
        border-bottom: 1px solid #edf0f4;
    }

    .card-header h2 {
        margin: 0;
        color: #172033;
        font-size: 18px;
        font-weight: 700;
    }

    .card-header p {
        margin: 5px 0 0;
        color: #7b8494;
        font-size: 13px;
    }

    .user-count {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-width: 70px;
        padding: 9px 14px;
        background: #f5f3ff;
        border-radius: 10px;
    }

    .user-count span {
        color: #6d28d9;
        font-size: 20px;
        font-weight: 700;
        line-height: 1;
    }

    .user-count small {
        margin-top: 4px;
        color: #7c3aed;
        font-size: 11px;
        font-weight: 600;
    }

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

    .data-table th {
        padding: 15px 24px;
        background: #fafbfc;
        border-bottom: 1px solid #e7e9ef;
        color: #687184;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-align: left;
        text-transform: uppercase;
    }

    .data-table td {
        padding: 17px 24px;
        border-bottom: 1px solid #f0f1f4;
        color: #374151;
        font-size: 14px;
    }

    .data-table tbody tr:last-child td {
        border-bottom: none;
    }

    .data-table tbody tr:hover {
        background: #faf9ff;
    }

    .user-email {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 500;
        color: #263044;
    }

    .user-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #ede9fe;
        color: #6d28d9;
        font-size: 13px;
        font-weight: 700;
    }

    .role-badge,
    .status-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 6px 10px;
        font-size: 11px;
        font-weight: 700;
    }

    .role-badge.administrator {
        background: #ede9fe;
        color: #6d28d9;
    }

    .role-badge.service-advisor {
        background: #e0f2fe;
        color: #0369a1;
    }

    .role-badge.technician {
        background: #ecfdf5;
        color: #047857;
    }

    .role-badge.cashier {
        background: #fff7ed;
        color: #c2410c;
    }

    .status-badge.active {
        background: #ecfdf5;
        color: #047857;
    }

    .status-badge.inactive {
        background: #fef2f2;
        color: #b91c1c;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        margin-right: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    .info-card {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        margin-top: 20px;
        padding: 18px 20px;
        background: #f8f7ff;
        border: 1px solid #e9e4ff;
        border-radius: 14px;
    }

    .info-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        border-radius: 10px;
        background: #ede9fe;
        color: #6d28d9;
    }

    .info-card h3 {
        margin: 0 0 5px;
        color: #312e81;
        font-size: 14px;
        font-weight: 700;
    }

    .info-card p {
        margin: 0;
        color: #636b7a;
        font-size: 13px;
        line-height: 1.6;
    }

    @@media (max-width: 700px) {
        .page-header h1 {
            font-size: 24px;
        }

        .card-header {
            align-items: flex-start;
            gap: 15px;
        }

        .data-table th,
        .data-table td {
            padding-left: 16px;
            padding-right: 16px;
        }

        .user-email {
            min-width: 250px;
        }
    }
</style>