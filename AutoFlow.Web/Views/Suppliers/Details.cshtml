@model AutoFlow.Web.Models.Supplier

@{
    ViewData["Title"] = "Supplier Details";
    var isActive = string.Equals(Model.Status, "Active", StringComparison.OrdinalIgnoreCase);
    var partCount = Model.Parts?.Count() ?? 0;
}

<style>
    .af-page {
        max-width: 1180px;
        margin: 0 auto;
    }

    .af-breadcrumb {
        font-size: 13px;
        color: #8a94a6;
        margin-bottom: 8px;
    }

    .af-breadcrumb a {
        color: #6f42c1;
        text-decoration: none;
        font-weight: 600;
    }

    .af-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 26px;
    }

    .af-title {
        font-size: 28px;
        font-weight: 800;
        color: #182235;
        margin: 0;
    }

    .af-subtitle {
        margin: 7px 0 0;
        color: #7c8798;
        font-size: 14px;
    }

    .af-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 13px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 800;
    }

    .af-status.active {
        background: #eaf8ef;
        color: #20804a;
    }

    .af-status.inactive {
        background: #f1f3f5;
        color: #737c89;
    }

    .af-card {
        background: #fff;
        border: 1px solid #e9edf3;
        border-radius: 16px;
        box-shadow: 0 8px 28px rgba(31, 41, 55, 0.06);
        overflow: hidden;
        margin-bottom: 20px;
    }

    .af-card-header {
        padding: 22px 26px;
        border-bottom: 1px solid #edf0f4;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .af-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: #f1eafe;
        color: #6f42c1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
    }

    .af-card-title {
        margin: 0;
        font-size: 17px;
        font-weight: 750;
        color: #202b3c;
    }

    .af-card-description {
        margin: 3px 0 0;
        color: #8a94a6;
        font-size: 13px;
    }

    .af-card-body {
        padding: 26px;
    }

    .af-info-label {
        font-size: 11px;
        font-weight: 800;
        color: #9aa3b2;
        text-transform: uppercase;
        letter-spacing: .06em;
        margin-bottom: 5px;
    }

    .af-info-value {
        color: #293447;
        font-size: 14px;
        font-weight: 650;
        word-break: break-word;
    }

    .af-info-item {
        min-height: 68px;
    }

    .af-stat {
        border: 1px solid #edf0f4;
        border-radius: 12px;
        padding: 18px;
        background: #fafbfc;
    }

    .af-stat-value {
        font-size: 24px;
        font-weight: 800;
        color: #202b3c;
    }

    .af-stat-label {
        font-size: 12px;
        color: #8993a3;
        margin-top: 3px;
    }

    .af-notes {
        background: #faf9ff;
        border: 1px solid #eee9fa;
        border-radius: 12px;
        padding: 18px;
        color: #596579;
        font-size: 14px;
        line-height: 1.65;
        white-space: pre-wrap;
    }

    .af-actions {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-top: 22px;
    }

    .af-btn {
        border-radius: 9px;
        padding: 10px 17px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        border: 1px solid transparent;
    }

    .af-btn-secondary {
        background: #fff;
        border-color: #dfe4eb;
        color: #596579;
    }

    .af-btn-primary {
        background: #6f42c1;
        color: #fff;
    }

    .af-btn-primary:hover {
        background: #5f35ad;
        color: #fff;
    }
</style>

<div class="container-fluid py-4">
    <div class="af-page">

        <div class="af-breadcrumb">
            <a asp-action="Index">Supplier Management</a>
            <span> / Supplier Details</span>
        </div>

        <div class="af-header">
            <div>
                <h1 class="af-title">@Model.Name</h1>
                <p class="af-subtitle">
                    Supplier ID #@Model.SupplierId
                </p>
            </div>

            <div class="af-status @(isActive ? "active" : "inactive")">
                <span>●</span>
                @(string.IsNullOrWhiteSpace(Model.Status) ? "Unknown" : Model.Status)
            </div>
        </div>

        <div class="row g-4">

            <div class="col-lg-8">

                <div class="af-card">
                    <div class="af-card-header">
                        <div class="af-icon">
                            <i class="bi bi-truck"></i>
                        </div>
                        <div>
                            <h2 class="af-card-title">Supplier Information</h2>
                            <p class="af-card-description">
                                Contact and business information.
                            </p>
                        </div>
                    </div>

                    <div class="af-card-body">

                        <div class="row g-4">

                            <div class="col-md-6 af-info-item">
                                <div class="af-info-label">Supplier Name</div>
                                <div class="af-info-value">
                                    @Model.Name
                                </div>
                            </div>

                            <div class="col-md-6 af-info-item">
                                <div class="af-info-label">Contact Person</div>
                                <div class="af-info-value">
                                    @(string.IsNullOrWhiteSpace(Model.ContactPerson)
                                        ? "—"
                                        : Model.ContactPerson)
                                </div>
                            </div>

                            <div class="col-md-6 af-info-item">
                                <div class="af-info-label">Phone</div>
                                <div class="af-info-value">
                                    @(string.IsNullOrWhiteSpace(Model.Phone)
                                        ? "—"
                                        : Model.Phone)
                                </div>
                            </div>

                            <div class="col-md-6 af-info-item">
                                <div class="af-info-label">Email</div>
                                <div class="af-info-value">
                                    @(string.IsNullOrWhiteSpace(Model.Email)
                                        ? "—"
                                        : Model.Email)
                                </div>
                            </div>

                            <div class="col-md-6 af-info-item">
                                <div class="af-info-label">City</div>
                                <div class="af-info-value">
                                    @(string.IsNullOrWhiteSpace(Model.City)
                                        ? "—"
                                        : Model.City)
                                </div>
                            </div>

                            <div class="col-md-6 af-info-item">
                                <div class="af-info-label">Address</div>
                                <div class="af-info-value">
                                    @(string.IsNullOrWhiteSpace(Model.Address)
                                        ? "—"
                                        : Model.Address)
                                </div>
                            </div>

                        </div>

                    </div>
                </div>

                <div class="af-card">
                    <div class="af-card-header">
                        <div class="af-icon">
                            <i class="bi bi-journal-text"></i>
                        </div>
                        <div>
                            <h2 class="af-card-title">Notes</h2>
                            <p class="af-card-description">
                                Additional supplier information.
                            </p>
                        </div>
                    </div>

                    <div class="af-card-body">
                        <div class="af-notes">
                            @(string.IsNullOrWhiteSpace(Model.Notes)
                                ? "No additional notes have been recorded for this supplier."
                                : Model.Notes)
                        </div>
                    </div>
                </div>

            </div>

            <div class="col-lg-4">

                <div class="af-card">
                    <div class="af-card-header">
                        <div class="af-icon">
                            <i class="bi bi-box-seam"></i>
                        </div>
                        <div>
                            <h2 class="af-card-title">Inventory Relationship</h2>
                            <p class="af-card-description">
                                Parts associated with this supplier.
                            </p>
                        </div>
                    </div>

                    <div class="af-card-body">
                        <div class="af-stat">
                            <div class="af-stat-value">@partCount</div>
                            <div class="af-stat-label">
                                Associated Parts
                            </div>
                        </div>
                    </div>
                </div>

                <div class="af-card">
                    <div class="af-card-body">
                        <div class="af-info-label">Record Status</div>
                        <div class="af-info-value mb-3">
                            @(string.IsNullOrWhiteSpace(Model.Status)
                                ? "Not specified"
                                : Model.Status)
                        </div>

                        <div class="af-info-label">Supplier ID</div>
                        <div class="af-info-value">
                            #@Model.SupplierId
                        </div>
                    </div>
                </div>

            </div>

        </div>

        <div class="af-actions">
            <a asp-action="Index"
               class="af-btn af-btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Suppliers
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.SupplierId"
               class="af-btn af-btn-primary">
                <i class="bi bi-pencil me-1"></i>
                Edit Supplier
            </a>
        </div>

    </div>
</div>