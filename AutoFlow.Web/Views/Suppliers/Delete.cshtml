@model AutoFlow.Web.Models.Supplier
@{
    ViewData["Title"] = "Delete Supplier";
}

<div class="page-header mb-4">
    <h1 class="h3 mb-1">Delete Supplier</h1>
    <p class="text-muted">Are you sure you want to delete this supplier?</p>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Contact</dt>
            <dd class="col-sm-9">@(Model.ContactPerson ?? "—")</dd>

            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@(Model.Phone ?? "—")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>
        </dl>

        <form asp-action="Delete" method="post" class="mt-4">
            <input type="hidden" asp-for="SupplierId" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
