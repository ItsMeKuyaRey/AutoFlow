@model IEnumerable<AutoFlow.Web.Models.Supplier>
@{
    ViewData["Title"] = "Suppliers";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Suppliers</h1>
        <p class="text-muted mb-0">Manage parts suppliers and vendor relationships.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        + Add Supplier
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Supplier</th>
                        <th>Contact</th>
                        <th>Location</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@item.Name</div>
                            <small class="text-muted">ID: @item.SupplierId</small>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ContactPerson))
                            {
                                <div>@item.ContactPerson</div>
                            }
                            <div class="text-muted small">
                                @item.Phone
                                @if (!string.IsNullOrEmpty(item.Email))
                                {
                                    <br />@item.Email
                                }
                            </div>
                        </td>
                        <td>
                            @item.City
                            @if (!string.IsNullOrEmpty(item.Address))
                            {
                                <div class="text-muted small">@item.Address</div>
                            }
                        </td>
                        <td>
                            @if (item.Status == "Active")
                            {
                                <span class="badge bg-success-subtle text-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">@item.Status</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.SupplierId" class="btn btn-sm btn-outline-secondary" title="View">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.SupplierId" class="btn btn-sm btn-outline-primary" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.SupplierId" class="btn btn-sm btn-outline-danger" title="Delete">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
