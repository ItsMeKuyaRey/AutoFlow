@model IEnumerable<AutoFlow.Web.Models.Supplier>

@{
    ViewData["Title"] = "Supplier Management";

    var suppliers = Model.ToList();
    var activeSuppliers = suppliers.Count(s => s.Status == "Active");
    var inactiveSuppliers = suppliers.Count(s => s.Status != "Active");
}

<style>
    .suppliers-page {
        max-width: 1500px;
        margin: 0 auto;
        padding: 32px 28px 50px;
    }

    .suppliers-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #7b8190;
        font-size: 13px;
        margin-bottom: 20px;
    }

    .suppliers-breadcrumb i {
        font-size: 11px;
    }

    .suppliers-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 25px;
    }

    .suppliers-header h1 {
        font-size: 30px;
        font-weight: 800;
        color: #202431;
        margin: 0 0 7px;
        letter-spacing: -0.5px;
    }

    .suppliers-header p {
        color: #7b8190;
        font-size: 14px;
        margin: 0;
    }

    .supplier-add-btn {
        background: #7043c1;
        border-color: #7043c1;
        color: #fff;
        border-radius: 10px;
        padding: 10px 17px;
        font-weight: 700;
        font-size: 13px;
        white-space: nowrap;
    }

    .supplier-add-btn:hover {
        background: #5d35a6;
        border-color: #5d35a6;
        color: #fff;
    }

    .supplier-summary {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-bottom: 22px;
    }

    .supplier-stat {
        background: #fff;
        border: 1px solid #ececf1;
        border-radius: 14px;
        padding: 18px;
        box-shadow: 0 4px 16px rgba(30, 25, 50, .04);
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .supplier-stat-icon {
        width: 43px;
        height: 43px;
        border-radius: 12px;
        background: #f1ebff;
        color: #7043c1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
        flex-shrink: 0;
    }

    .supplier-stat-icon.success {
        background: #eaf8ef;
        color: #27834a;
    }

    .supplier-stat-icon.muted {
        background: #f1f2f5;
        color: #737986;
    }

    .supplier-stat-label {
        color: #858b98;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
        margin-bottom: 3px;
    }

    .supplier-stat-value {
        color: #252936;
        font-size: 22px;
        font-weight: 800;
    }

    .suppliers-card {
        background: #fff;
        border: 1px solid #ececf1;
        border-radius: 16px;
        box-shadow: 0 5px 20px rgba(30, 25, 50, .05);
        overflow: hidden;
    }

    .suppliers-card-header {
        padding: 20px 22px;
        border-bottom: 1px solid #eeeeF2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

    .suppliers-card-title {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .suppliers-card-title i {
        color: #7043c1;
        font-size: 18px;
    }

    .suppliers-card-title h2 {
        font-size: 16px;
        font-weight: 750;
        color: #292e39;
        margin: 0;
    }

    .suppliers-count {
        background: #f3effc;
        color: #7043c1;
        border-radius: 999px;
        padding: 5px 9px;
        font-size: 10px;
        font-weight: 750;
    }

    .supplier-table {
        margin: 0;
    }

    .supplier-table thead th {
        background: #fafafd;
        color: #777e8b;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .06em;
        padding: 14px 18px;
        border-bottom: 1px solid #ececf1;
        white-space: nowrap;
    }

    .supplier-table tbody td {
        padding: 16px 18px;
        border-color: #f0f0f3;
        color: #464c58;
        font-size: 13px;
    }

    .supplier-table tbody tr:hover {
        background: #fcfbff;
    }

    .supplier-avatar {
        width: 40px;
        height: 40px;
        border-radius: 11px;
        background: #f1ebff;
        color: #7043c1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 15px;
        flex-shrink: 0;
    }

    .supplier-name {
        color: #292e39;
        font-weight: 750;
        font-size: 13px;
    }

    .supplier-id {
        color: #969ba6;
        font-size: 10px;
        margin-top: 2px;
    }

    .supplier-contact-name {
        color: #4a505c;
        font-weight: 650;
        margin-bottom: 3px;
    }

    .supplier-contact-detail {
        color: #8b919d;
        font-size: 11px;
        line-height: 1.55;
    }

    .supplier-location {
        color: #4b515d;
        font-weight: 600;
    }

    .supplier-address {
        color: #9297a2;
        font-size: 11px;
        margin-top: 3px;
        max-width: 220px;
    }

    .supplier-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 6px 10px;
        font-size: 10px;
        font-weight: 750;
    }

    .supplier-status.active {
        color: #27834a;
        background: #eaf8ef;
    }

    .supplier-status.inactive {
        color: #737986;
        background: #f1f2f5;
    }

    .supplier-status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    .supplier-actions {
        display: flex;
        justify-content: flex-end;
        gap: 6px;
    }

    .supplier-action {
        min-width: 35px;
        height: 35px;
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-size: 13px;
    }

    .supplier-action.view {
        color: #69717e;
        border: 1px solid #dfe2e8;
        background: #fff;
    }

    .supplier-action.edit {
        color: #7043c1;
        border: 1px solid #ded2f5;
        background: #faf8ff;
    }

    .supplier-action.delete {
        color: #c03952;
        border: 1px solid #f0cbd2;
        background: #fff8f9;
    }

    .supplier-action:hover {
        transform: translateY(-1px);
    }

    .supplier-empty {
        padding: 65px 20px;
        text-align: center;
    }

    .supplier-empty-icon {
        width: 62px;
        height: 62px;
        border-radius: 17px;
        background: #f1ebff;
        color: #7043c1;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        font-size: 25px;
    }

    .supplier-empty h3 {
        font-size: 18px;
        font-weight: 750;
        color: #292e39;
        margin-bottom: 6px;
    }

    .supplier-empty p {
        color: #858b98;
        font-size: 13px;
        margin-bottom: 18px;
    }

    @@media (max-width: 900px) {
        .supplier-summary {
            grid-template-columns: 1fr;
        }

        .suppliers-header {
            flex-direction: column;
        }

        .supplier-add-btn {
            width: 100%;
        }
    }

    @@media (max-width: 700px) {
        .suppliers-page {
            padding: 22px 16px 40px;
        }

        .supplier-table thead {
            display: none;
        }

        .supplier-table tbody tr {
            display: block;
            padding: 15px;
            border-bottom: 1px solid #ececf1;
        }

        .supplier-table tbody td {
            display: block;
            border: 0;
            padding: 6px 0;
        }

        .supplier-actions {
            justify-content: flex-start;
            margin-top: 8px;
        }
    }
</style>

<div class="suppliers-page">

    <div class="suppliers-breadcrumb">
        <i class="bi bi-grid"></i>
        <span>Management</span>
        <i class="bi bi-chevron-right"></i>
        <span>Supplier Management</span>
    </div>

    <div class="suppliers-header">

        <div>
            <h1>Supplier Management</h1>
            <p>Manage parts suppliers and maintain vendor relationships.</p>
        </div>

        <a asp-action="Create"
           class="btn supplier-add-btn">
            <i class="bi bi-plus-lg me-1"></i>
            Add Supplier
        </a>

    </div>

    <div class="supplier-summary">

        <div class="supplier-stat">
            <div class="supplier-stat-icon">
                <i class="bi bi-truck"></i>
            </div>

            <div>
                <div class="supplier-stat-label">Total Suppliers</div>
                <div class="supplier-stat-value">@suppliers.Count</div>
            </div>
        </div>

        <div class="supplier-stat">
            <div class="supplier-stat-icon success">
                <i class="bi bi-check-circle"></i>
            </div>

            <div>
                <div class="supplier-stat-label">Active Suppliers</div>
                <div class="supplier-stat-value">@activeSuppliers</div>
            </div>
        </div>

        <div class="supplier-stat">
            <div class="supplier-stat-icon muted">
                <i class="bi bi-dash-circle"></i>
            </div>

            <div>
                <div class="supplier-stat-label">Inactive</div>
                <div class="supplier-stat-value">@inactiveSuppliers</div>
            </div>
        </div>

    </div>

    <div class="suppliers-card">

        <div class="suppliers-card-header">

            <div class="suppliers-card-title">
                <i class="bi bi-building"></i>
                <h2>Supplier Directory</h2>
            </div>

            <span class="suppliers-count">
                @suppliers.Count supplier@(suppliers.Count == 1 ? "" : "s")
            </span>

        </div>

        @if (!suppliers.Any())
        {
            <div class="supplier-empty">

                <div class="supplier-empty-icon">
                    <i class="bi bi-truck"></i>
                </div>

                <h3>No Suppliers Found</h3>

                <p>
                    There are currently no suppliers registered in AutoFlow.
                </p>

                <a asp-action="Create"
                   class="btn supplier-add-btn">
                    <i class="bi bi-plus-lg me-1"></i>
                    Add Your First Supplier
                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table supplier-table align-middle">

                    <thead>
                        <tr>
                            <th>Supplier</th>
                            <th>Contact</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                    @foreach (var item in suppliers)
                    {
                        var initials = string.IsNullOrWhiteSpace(item.Name)
                            ? "S"
                            : item.Name.Trim().Substring(0, 1).ToUpper();

                        var isActive = item.Status == "Active";

                        <tr>

                            <td>
                                <div class="d-flex align-items-center gap-3">

                                    <div class="supplier-avatar">
                                        @initials
                                    </div>

                                    <div>
                                        <div class="supplier-name">
                                            @item.Name
                                        </div>

                                        <div class="supplier-id">
                                            Supplier ID: @item.SupplierId
                                        </div>
                                    </div>

                                </div>
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.ContactPerson))
                                {
                                    <div class="supplier-contact-name">
                                        @item.ContactPerson
                                    </div>
                                }

                                <div class="supplier-contact-detail">
                                    @if (!string.IsNullOrWhiteSpace(item.Phone))
                                    {
                                        <span>
                                            <i class="bi bi-telephone me-1"></i>
                                            @item.Phone
                                        </span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(item.Email))
                                    {
                                        <br />
                                        <span>
                                            <i class="bi bi-envelope me-1"></i>
                                            @item.Email
                                        </span>
                                    }
                                </div>
                            </td>

                            <td>

                                <div class="supplier-location">
                                    <i class="bi bi-geo-alt me-1"></i>
                                    @item.City
                                </div>

                                @if (!string.IsNullOrWhiteSpace(item.Address))
                                {
                                    <div class="supplier-address">
                                        @item.Address
                                    </div>
                                }

                            </td>

                            <td>

                                <span class="supplier-status @(isActive ? "active" : "inactive")">

                                    <span class="supplier-status-dot"></span>

                                    @(string.IsNullOrWhiteSpace(item.Status)
                                        ? "Unknown"
                                        : item.Status)

                                </span>

                            </td>

                            <td>

                                <div class="supplier-actions">

                                    <a asp-action="Details"
                                       asp-route-id="@item.SupplierId"
                                       class="supplier-action view"
                                       title="View supplier">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.SupplierId"
                                       class="supplier-action edit"
                                       title="Edit supplier">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.SupplierId"
                                       class="supplier-action delete"
                                       title="Delete supplier">
                                        <i class="bi bi-trash3"></i>
                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>