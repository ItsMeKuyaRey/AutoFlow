@{
    ViewData["Title"] = "Record Payment";

    var totalAmount = (decimal)ViewBag.TotalAmount;
    var amountPaid = (decimal)ViewBag.AmountPaid;
    var remaining = (decimal)ViewBag.Remaining;

    var paymentProgress = totalAmount > 0
        ? Math.Min(100, (amountPaid / totalAmount) * 100)
        : 0;
}

<style>
    .payment-page {
        max-width: 1200px;
        margin: 0 auto;
    }

    .payment-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 350px;
        gap: 24px;
        align-items: start;
    }

    .payment-card {
        padding: 28px;
    }

    .payment-card-title {
        margin: 0;
        font-size: 1rem;
        font-weight: 650;
    }

    .payment-card-subtitle {
        margin: 5px 0 0;
        color: var(--af-text-muted);
        font-size: 0.8rem;
    }

    .payment-form-section {
        margin-top: 26px;
    }

    .payment-field {
        margin-bottom: 22px;
    }

    .payment-field:last-child {
        margin-bottom: 0;
    }

    .payment-label {
        display: block;
        margin-bottom: 7px;
        font-weight: 600;
        font-size: 0.86rem;
    }

    .payment-hint {
        display: block;
        margin-top: 6px;
        color: var(--af-text-muted);
        font-size: 0.74rem;
    }

    .payment-summary {
        display: grid;
        gap: 16px;
        margin-top: 22px;
    }

    .payment-summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
    }

    .payment-summary-label {
        color: var(--af-text-muted);
        font-size: 0.8rem;
    }

    .payment-summary-value {
        font-weight: 650;
        white-space: nowrap;
    }

    .payment-summary-total {
        padding-top: 16px;
        border-top: 1px solid var(--af-border);
    }

    .payment-summary-total .payment-summary-label {
        color: var(--af-text-primary);
        font-weight: 600;
    }

    .payment-summary-total .payment-summary-value {
        font-size: 1.15rem;
    }

    .payment-summary-paid {
        color: var(--af-success);
    }

    .payment-summary-due {
        color: var(--af-danger);
        font-size: 1.2rem;
    }

    .payment-progress {
        margin-top: 22px;
        padding-top: 20px;
        border-top: 1px solid var(--af-border);
    }

    .payment-progress-head {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 9px;
        font-size: 0.78rem;
    }

    .payment-progress-track {
        height: 8px;
        border-radius: 999px;
        overflow: hidden;
        background: var(--af-border);
    }

    .payment-progress-bar {
        height: 100%;
        border-radius: 999px;
        background: var(--af-primary);
    }

    .payment-notice {
        margin-top: 18px;
        padding: 15px;
        border-radius: 9px;
        border: 1px solid var(--af-border);
        background: var(--af-bg);
        color: var(--af-text-secondary);
        font-size: 0.8rem;
        line-height: 1.5;
    }

    .payment-invoice-label {
        color: var(--af-text-muted);
        font-size: 0.76rem;
        display: block;
        margin-bottom: 4px;
    }

    .payment-invoice-number {
        font-size: 1.1rem;
        font-weight: 700;
    }

    .payment-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 12px;
        margin-top: 28px;
        padding-top: 20px;
        border-top: 1px solid var(--af-border);
    }

    @@media (max-width: 900px) {
        .payment-layout {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .payment-card {
            padding: 20px;
        }

        .payment-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .payment-actions .af-button {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="dashboard-page payment-page">

    <div class="page-header">
        <div>
            <h1>Record Payment</h1>
            <p>Record a customer payment against the selected invoice.</p>
        </div>

        <div class="page-header-actions">
            <a asp-action="Details"
               asp-route-id="@ViewBag.BillingId"
               class="af-button af-button-secondary">
                Back to Invoice
            </a>
        </div>
    </div>

    <div class="payment-layout">

        <!-- PAYMENT FORM -->
        <div class="af-card payment-card">

            <h2 class="payment-card-title">Payment Details</h2>

            <p class="payment-card-subtitle">
                Enter the amount received and select the payment method.
            </p>

            <form asp-action="RecordPayment"
                  method="post"
                  class="payment-form-section">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="billingId"
                       value="@ViewBag.BillingId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-4"></div>

                <div class="payment-field">

                    <label for="amountPaid"
                           class="payment-label">
                        Amount to Pay
                    </label>

                    <input type="number"
                           id="amountPaid"
                           name="amountPaid"
                           step="0.01"
                           min="0.01"
                           max="@ViewBag.Remaining"
                           class="form-control"
                           required
                           placeholder="0.00" />

                    <span class="payment-hint">
                        Maximum payment allowed: ₱@remaining.ToString("N2")
                    </span>

                </div>

                <div class="payment-field">

                    <label for="paymentMethod"
                           class="payment-label">
                        Payment Method
                    </label>

                    <select id="paymentMethod"
                            name="paymentMethod"
                            class="form-select"
                            required>

                        <option value="Cash">Cash</option>
                        <option value="Card">Card</option>
                        <option value="Bank Transfer">Bank Transfer</option>
                        <option value="GCash">GCash</option>
                        <option value="Other">Other</option>

                    </select>

                </div>

                <div class="payment-field">

                    <label for="notes"
                           class="payment-label">
                        Notes
                        <span style="font-weight:400; color:var(--af-text-muted);">
                            (optional)
                        </span>
                    </label>

                    <textarea id="notes"
                              name="notes"
                              class="form-control"
                              rows="4"
                              placeholder="Add any notes about this payment..."></textarea>

                </div>

                <div class="payment-actions">

                    <a asp-action="Details"
                       asp-route-id="@ViewBag.BillingId"
                       class="af-button af-button-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="af-button af-button-primary">
                        Save Payment
                    </button>

                </div>

            </form>

        </div>

        <!-- INVOICE SUMMARY -->
        <div>

            <div class="af-card payment-card">

                <span class="payment-invoice-label">
                    Invoice
                </span>

                <span class="payment-invoice-number">
                    @ViewBag.InvoiceNumber
                </span>

                <div class="payment-summary">

                    <div class="payment-summary-row">
                        <span class="payment-summary-label">
                            Total Amount
                        </span>

                        <span class="payment-summary-value">
                            ₱@totalAmount.ToString("N2")
                        </span>
                    </div>

                    <div class="payment-summary-row">
                        <span class="payment-summary-label">
                            Already Paid
                        </span>

                        <span class="payment-summary-value payment-summary-paid">
                            ₱@amountPaid.ToString("N2")
                        </span>
                    </div>

                    <div class="payment-summary-row payment-summary-total">
                        <span class="payment-summary-label">
                            Remaining Balance
                        </span>

                        <span class="payment-summary-value payment-summary-due">
                            ₱@remaining.ToString("N2")
                        </span>
                    </div>

                </div>

                <div class="payment-progress">

                    <div class="payment-progress-head">
                        <span style="color:var(--af-text-muted);">
                            Payment Progress
                        </span>

                        <strong>
                            @paymentProgress.ToString("0")%
                        </strong>
                    </div>

                    <div class="payment-progress-track">
                        <div class="payment-progress-bar"
                             style="width:@paymentProgress.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;">
                        </div>
                    </div>

                </div>

            </div>

            <div class="af-card payment-card" style="margin-top:24px;">

                <h2 class="payment-card-title">
                    Payment Policy
                </h2>

                <div class="payment-notice">
                    The payment amount cannot exceed the remaining invoice
                    balance. Once saved, the payment will be added to the
                    payment history and the invoice status will update
                    automatically.
                </div>

            </div>

        </div>

    </div>

</div>