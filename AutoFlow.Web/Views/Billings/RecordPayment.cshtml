@model AutoFlow.Web.Models.Billing
@{
    ViewData["Title"] = "Record Payment";
}
<div class="dashboard-page" style="max-width:900px;margin:0 auto;">
    <div class="af-card" style="padding:28px;">
        <h1 style="margin:0 0 8px;font-size:22px;">Record Payment</h1>
        <p style="margin:0;color:var(--af-text-secondary);">Payment entry is now handled inside the Billing & Payments workspace.</p>
        <a asp-action="Index" asp-route-open="payment" asp-route-id="@Model.BillingId" class="af-button af-button-primary" style="display:inline-flex;margin-top:20px;">Open Payment Form</a>
    </div>
</div>
