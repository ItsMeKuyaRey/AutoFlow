    .drawer-alert { border-radius:9px;padding:10px 11px;margin-bottom:12px;font-size:9px;line-height:1.45; }
    .drawer-alert.error { background:#fef2f2;color:#b91c1c;border:1px solid #fecaca; }
    .drawer-success { text-align:center;padding:55px 20px; }
    .drawer-success-icon { width:54px;height:54px;border-radius:50%;background:#dcfce7;color:#16a34a;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;font-size:26px;font-weight:800; }
    .drawer-success h3 { margin:0;font-size:15px; }
    .drawer-success p { margin:6px auto 20px;color:#64748b;font-size:9px;max-width:260px; }
    .drawer-success-summary { border:1px solid #e5e7eb;border-radius:9px;text-align:left;padding:11px;margin-bottom:18px; }
    .drawer-success-summary div { display:flex;justify-content:space-between;padding:5px 0;font-size:9px; }
    .drawer-success-summary div + div { border-top:1px solid #f0f2f5; }
    .drawer-success-summary strong { color:#059669; }

    .print-modal-backdrop { position:fixed;inset:0;background:rgba(15,23,42,.55);z-index:4000;display:flex;align-items:center;justify-content:center;padding:20px; }
    .print-modal-backdrop[hidden] { display:none !important; }
    .print-modal { width:min(760px,100%);max-height:94vh;background:#fff;border-radius:10px;box-shadow:0 20px 70px rgba(15,23,42,.28);overflow:hidden;display:flex;flex-direction:column; }
    .print-modal-head { padding:10px 14px;border-bottom:1px solid #e5e7eb;display:flex;justify-content:space-between;align-items:center;font-size:10px;font-weight:750; }
    .print-modal-head-actions { display:flex;gap:7px; }
    .print-paper-wrap { overflow:auto;background:#f1f5f9;padding:25px; }
    .print-paper { background:#fff;min-height:680px;padding:38px;box-shadow:0 2px 12px rgba(15,23,42,.08);font-family:Arial,sans-serif;color:#111827; }
    .print-paper-head { display:flex;justify-content:space-between;gap:20px;border-bottom:2px solid #1f2937;padding-bottom:14px; }
    .print-brand { font-size:20px;font-weight:900;letter-spacing:.03em; }
    .print-small { color:#64748b;font-size:8px;margin-top:3px; }
    .print-invoice-title { text-align:right;font-size:20px;font-weight:900; }
    .print-invoice-number { color:#7c3aed;font-size:10px;text-align:right;margin-top:3px; }
    .print-meta-grid { display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:22px 0; }
    .print-meta-label { text-transform:uppercase;color:#64748b;font-size:7px;font-weight:700; }
    .print-meta-value { font-size:10px;font-weight:700;margin-top:4px; }
    .print-table { width:100%;border-collapse:collapse;font-size:8px; }
    .print-table th { text-align:left;color:#64748b;text-transform:uppercase;font-size:7px;padding:8px 0;border-bottom:1px solid #e5e7eb; }
    .print-table td { padding:10px 0;border-bottom:1px solid #eef2f7; }
    .print-table th:not(:first-child),.print-table td:not(:first-child) { text-align:right; }
    .print-totals { width:260px;margin:20px 0 0 auto;font-size:8px; }
    .print-total-row { display:flex;justify-content:space-between;padding:5px 0; }
    .print-total-final { border-top:1px solid #1f2937;margin-top:5px;padding-top:8px;font-size:12px;font-weight:900; }
    .print-thanks { border-top:1px solid #e5e7eb;margin-top:35px;padding-top:18px;text-align:center;color:#64748b;font-size:7px; }

    @@media (max-width: 1050px) {
        .billing-summary-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
        .billing-toolbar { grid-template-columns:1fr 140px 140px; }
        .billing-filter-actions { grid-column:1 / -1; }
    }
    @@media (max-width: 650px) {
        .billing-summary-grid { grid-template-columns:1fr; }
        .billing-toolbar { grid-template-columns:1fr; }
        .billing-filter-actions { grid-column:auto; }
        .billing-header-actions { width:100%; }
        .billing-header-actions .af-button { width:100%;justify-content:center; }
        .drawer-grid-2 { grid-template-columns:1fr; }
        .print-paper { padding:20px; }
        .print-paper-wrap { padding:10px; }
    }
    @@media print {
        body * { visibility:hidden !important; }
        .print-modal-backdrop,.print-modal-backdrop * { visibility:visible !important; }
        .print-modal-backdrop { position:absolute;inset:0;background:#fff;padding:0; }
        .print-modal { width:100%;max-height:none;box-shadow:none;border-radius:0; }
        .print-modal-head { display:none; }
        .print-paper-wrap { padding:0;background:#fff;overflow:visible; }
        .print-paper { box-shadow:none;min-height:auto; }
    }


    /* AutoFlow Permanent White Record Payment Button */
    a.af-button.af-button-primary[href*="open=payment"] {
        background: #ffffff !important;
        background-color: #ffffff !important;
        background-image: none !important;
        color: #1f2937 !important;
        border: 1px solid #d9dee8 !important;
        box-shadow: none !important;
        opacity: 1 !important;

        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        text-align: center !important;
        vertical-align: middle !important;
    }

    a.af-button.af-button-primary[href*="open=payment"]:hover,
    a.af-button.af-button-primary[href*="open=payment"]:focus,
    a.af-button.af-button-primary[href*="open=payment"]:active {
        background: #ffffff !important;
        background-color: #ffffff !important;
        background-image: none !important;
        color: #1f2937 !important;
        border-color: #cbd5e1 !important;
        box-shadow: none !important;
    }

    a.af-button.af-button-primary[href*="open=payment"] *,
    a.af-button.af-button-primary[href*="open=payment"] i,
    a.af-button.af-button-primary[href*="open=payment"] svg {
        color: #1f2937 !important;
        fill: currentColor !important;
        stroke: currentColor !important;
        opacity: 1 !important;
