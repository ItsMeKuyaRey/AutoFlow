    .xendit-payment-card { border:1px solid #ddd6fe; background:#faf8ff; border-radius:12px; padding:14px; margin-bottom:15px; }
    .xendit-payment-card h3 { margin:0; font-size:12px; color:#4c1d95; }
    .xendit-payment-card p { margin:5px 0 0; color:#64748b; font-size:9px; line-height:1.55; }
    .xendit-qr-wrap { margin:13px auto 8px; width:230px; min-height:230px; display:grid; place-items:center; background:#fff; border:1px solid #e5e7eb; border-radius:12px; padding:12px; box-sizing:border-box; }
    .xendit-qr-wrap img { width:205px; height:205px; display:block; }
    .xendit-status { margin-top:8px; display:flex; align-items:center; justify-content:center; gap:7px; font-size:9px; color:#475467; }
    .xendit-status-dot { width:7px; height:7px; border-radius:50%; background:#f59e0b; }
    .xendit-status-dot.success { background:#10b981; }
    .xendit-status-dot.error { background:#ef4444; }
    .xendit-actions { display:flex; justify-content:center; gap:7px; flex-wrap:wrap; margin-top:11px; }
    .xendit-test-note { margin-top:9px; padding:8px 9px; border-radius:8px; background:#fff7ed; color:#9a3412; font-size:8px; line-height:1.5; }

</style>

<div class="dashboard-page billing-workspace">
    <div class="page-header">
        <div>
            <div style="color:#94a3b8;font-size:9px;margin-bottom:5px;">Finance &nbsp;›&nbsp; Billing & Payments</div>
            <h1>Billing & Payments</h1>
            <p>Manage invoices, payments, and outstanding balances from completed repair jobs.</p>
        </div>
        <div class="billing-header-actions">
            <a asp-action="Index" asp-route-open="archived" class="af-button af-button-secondary billing-archive-link">
                <i class="bi bi-archive"></i> Archived
                <span class="billing-archive-count">@archivedBillingCount</span>
            </a>
            <a asp-action="Index" asp-route-open="create" class="af-button af-button-primary billing-primary-button">
                <span>＋</span> Create Invoice
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(billingError))
    {
        <div class="drawer-alert error">@billingError</div>
    }
    @if (!string.IsNullOrWhiteSpace(billingInfo))
    {
        <div class="drawer-alert info">@billingInfo</div>
    }

    @if (!billingList.Any() && string.IsNullOrWhiteSpace(search) && selectedStatus == "All" && string.IsNullOrWhiteSpace(selectedDate))
    {
        <div class="af-card billing-empty">
            <div class="billing-empty-icon">₱</div>
            <h3>No Invoices Yet</h3>
            <p>Invoices can be created from completed repair jobs. The same invoice can then receive multiple partial payments until it is fully paid.</p>
            <a asp-controller="JobOrders" asp-action="Index" class="af-button af-button-primary">View Repair Jobs</a>
        </div>
    }
    else
    {
        <div class="billing-summary-grid">
            <div class="billing-stat-card is-outstanding">
                <div class="billing-stat-icon">₱</div>
                <div><div class="billing-stat-label">Outstanding</div><div class="billing-stat-value">₱@totalOutstanding.ToString("N2")</div><div class="billing-stat-meta">@outstandingInvoices invoice(s) with balance</div></div>
            </div>
            <div class="billing-stat-card is-paid">
                <div class="billing-stat-icon">✓</div>
                <div><div class="billing-stat-label">Paid</div><div class="billing-stat-value">₱@totalCollected.ToString("N2")</div><div class="billing-stat-meta">@paidInvoices fully paid</div></div>
            </div>
            <div class="billing-stat-card is-partial">
                <div class="billing-stat-icon">◐</div>
                <div><div class="billing-stat-label">Partially Paid</div><div class="billing-stat-value">@partialInvoices</div><div class="billing-stat-meta">invoice(s) still needing payment</div></div>
            </div>
            <div class="billing-stat-card">
                <div class="billing-stat-icon">#</div>
                <div><div class="billing-stat-label">Total Invoices</div><div class="billing-stat-value">@totalInvoices</div><div class="billing-stat-meta">₱@totalBilled.ToString("N2") total billed</div></div>
            </div>
        </div>

        <div class="af-card billing-register">
            <div class="billing-register-head">
                <form asp-action="Index" method="get" class="billing-toolbar">
                    <div class="billing-filter">
                        <i class="bi bi-search"></i>
                        <input name="q" value="@search" placeholder="Search by invoice number, customer, or job order..." autocomplete="off" />
                    </div>
                    <select name="status" aria-label="Invoice status">
                        <option value="All" selected="@(selectedStatus == "All")">All Status</option>
                        <option value="Unpaid" selected="@(selectedStatus == "Unpaid")">Unpaid</option>
                        <option value="Partial" selected="@(selectedStatus == "Partial")">Partially Paid</option>
                        <option value="Paid" selected="@(selectedStatus == "Paid")">Paid</option>
                    </select>
                    <input type="date" name="issuedDate" value="@selectedDate" aria-label="Invoice date" />
                    <div class="billing-filter-actions">
                        <button type="submit" class="af-button af-button-secondary">Filter</button>
                        <a class="af-button af-button-secondary" href="@Url.Action("ExportCsv", new { q = search, status = selectedStatus, issuedDate = selectedDate })">Export CSV</a>
                    </div>
                </form>
            </div>

            @if (!billingList.Any())
            {
                <div class="billing-empty" style="padding:45px 20px;">
                    <div class="billing-empty-icon">⌕</div>
                    <h3>No matching invoices</h3>
                    <p>Try another search term, status, or invoice date.</p>
                    <a asp-action="Index" class="af-button af-button-secondary">Clear Filters</a>
                </div>
            }
            else
            {
                <div class="billing-table-wrap">
                    <table class="af-table billing-table">
                        <thead>
                            <tr>
                                <th>Invoice #</th>
                                <th>Customer</th>
                                <th>Job Order #</th>
                                <th>Invoice Date</th>
                                <th>Total Amount</th>
                                <th>Balance</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in billingList)
                            {
                                var balance = Math.Max(0, item.TotalAmount - item.AmountPaid);
                                var badgeClass = item.Status switch { "Paid" => "badge-green", "Partial" => "badge-orange", _ => "badge-red" };
                                var customerName = item.JobOrder?.Vehicle?.Customer == null
                                    ? "—"
                                    : $"{item.JobOrder.Vehicle.Customer.FirstName} {item.JobOrder.Vehicle.Customer.LastName}";

                                <tr>
                                    <td>
                                        <div class="billing-invoice">
                                            <div class="billing-invoice-icon">INV</div>
                                            <div><div class="billing-invoice-number">@item.InvoiceNumber</div><small>@item.IssuedAt.ToString("MMM d, yyyy")</small></div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="billing-vehicle-cell">
                                            <div class="billing-vehicle-thumb">
                                                @if (!string.IsNullOrWhiteSpace(item.JobOrder?.Vehicle?.ImageUrl))
                                                {
                                                    <img src="@item.JobOrder.Vehicle.ImageUrl" alt="Vehicle image" />
                                                }
                                                else
                                                {
                                                    <i class="bi bi-car-front"></i>
                                                }
                                            </div>
                                            <div class="billing-vehicle-copy">
                                                <span class="billing-customer">@customerName</span>
                                                @if (item.JobOrder?.Vehicle != null)
                                                {
                                                    <small>@item.JobOrder.Vehicle.PlateNumber · @item.JobOrder.Vehicle.Make @item.JobOrder.Vehicle.Model</small>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (item.JobOrder != null)
                                        {
                                            <a class="billing-job-link" asp-controller="JobOrders" asp-action="Details" asp-route-id="@item.JobOrder.JobOrderId">JO-@item.JobOrder.JobOrderId.ToString("D4")</a>
                                        }
                                        else { <span>—</span> }
                                    </td>
                                    <td><span>@item.IssuedAt.ToString("MMM d, yyyy")</span><small>@item.IssuedAt.ToString("h:mm tt")</small></td>
                                    <td><span class="billing-money">₱@item.TotalAmount.ToString("N2")</span></td>
                                    <td>
                                        @if (balance > 0) { <span class="billing-due">₱@balance.ToString("N2")</span> }
                                        else { <span class="billing-paid">₱0.00</span> }
                                    </td>
                                    <td><span class="af-badge @badgeClass">@(item.Status == "Partial" ? "Partially Paid" : item.Status)</span></td>
                                    <td>
                                        <div class="billing-actions">
                                            <a asp-action="Index" asp-route-open="details" asp-route-id="@item.BillingId" class="billing-icon-button" title="View invoice" aria-label="View @item.InvoiceNumber">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Index" asp-route-open="payment" asp-route-id="@item.BillingId" class="billing-icon-button billing-icon-payment" title="@(item.Status == "Paid" ? "Manage / edit payment" : "Record payment")" aria-label="@(item.Status == "Paid" ? $"Manage payments for {item.InvoiceNumber}" : $"Record payment for {item.InvoiceNumber}")">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-action="Index" asp-route-open="archive" asp-route-id="@item.BillingId" class="billing-icon-button billing-icon-archive" title="Archive invoice" aria-label="Archive @item.InvoiceNumber">
                                                <i class="bi bi-archive"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="billing-footer">
                    <span>Showing @billingList.Count invoice(s)</span>
                    <span>All amounts shown in Philippine Peso (₱)</span>
                </div>
            }
        </div>
    }
</div>

@if (open == "create")
{
    <div class="billing-drawer-backdrop" data-drawer-backdrop>
        <aside class="billing-drawer">
            <div class="billing-drawer-head">
                <div><h2>Create New Invoice</h2><p>Create billing from a completed repair job.</p></div>
                <a class="billing-drawer-close" asp-action="Index" aria-label="Close">×</a>
            </div>
            <div class="billing-drawer-body">
                @if (!availableJobs.Any())
                {
                    <div class="drawer-empty" style="padding:42px 10px 18px;">
                        <div class="billing-empty-icon">✓</div>
                        <h3 style="font-size:14px;color:#111827;">No jobs ready for invoicing</h3>
                        <p>Only completed repair jobs without an existing invoice appear here.</p>
                        <div class="billing-create-empty-note">
                            <strong>Billing is linked to Repair Job Orders.</strong>
                            <span>Complete the repair first, then create the invoice once the labor and parts have been reviewed. A job already linked to an invoice cannot be invoiced twice.</span>
                        </div>
                        <a asp-controller="JobOrders" asp-action="Index" class="af-button af-button-secondary" style="margin-top:12px;">View Repair Job Orders</a>
                    </div>
                }
                else
                {
                    <p class="drawer-section-label">Select Repair Job Order</p>
                    <form asp-action="CreateInvoice" method="post" enctype="multipart/form-data" id="createInvoiceForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="jobOrderId" id="selectedJobOrderId" value="@(selectedAvailableJob?.JobOrderId ?? 0)" />

                        @foreach (var job in availableJobs)
                        {
                            var jobPartsCost = job.JobOrderParts.Sum(jp => jp.Quantity * jp.UnitPriceAtTimeOfUse);
                            var jobSubtotal = job.LaborCost + jobPartsCost;
                            var jobTax = Math.Round(jobSubtotal * taxRate, 2, MidpointRounding.AwayFromZero);
                            var jobTotal = jobSubtotal + jobTax;
                            var customer = job.Vehicle?.Customer;
                            var customerName = customer == null ? "Customer unavailable" : $"{customer.FirstName} {customer.LastName}";
                            var vehicleName = job.Vehicle == null ? "Vehicle unavailable" : $"{job.Vehicle.Year} {job.Vehicle.Make} {job.Vehicle.Model}";

                            <div class="invoice-job-option @(job == selectedAvailableJob ? "is-selected" : "")" data-job-option data-job-id="@job.JobOrderId" data-labor="@job.LaborCost.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-parts="@jobPartsCost.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-subtotal="@jobSubtotal.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-tax="@jobTax.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-total="@jobTotal.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-customer="@customerName" data-vehicle="@vehicleName" data-plate="@(job.Vehicle?.PlateNumber ?? "—")" data-job-number="JO-@job.JobOrderId.ToString("D4")" data-image="@(job.Vehicle?.ImageUrl ?? "")">
                                <div class="invoice-job-option-head">
                                    <div style="min-width:0;">
                                        <strong>JO-@job.JobOrderId.ToString("D4")</strong>
                                        <small>@customerName</small>
                                        <div class="invoice-job-vehicle">
                                            <div class="invoice-job-vehicle-thumb">
                                                @if (!string.IsNullOrWhiteSpace(job.Vehicle?.ImageUrl))
                                                {
                                                    <img src="@job.Vehicle.ImageUrl" alt="Vehicle image" />
                                                }
                                                else
                                                {
                                                    <i class="bi bi-car-front"></i>
                                                }
                                            </div>
                                            <div class="invoice-job-vehicle-copy"><small>@vehicleName · @job.Vehicle?.PlateNumber</small></div>
                                        </div>
                                    </div>
                                    <div style="display:flex;align-items:center;gap:8px;"><span class="invoice-job-badge">COMPLETED</span><span class="invoice-job-check">✓</span></div>
                                </div>
                            </div>
                        }

                        <div class="drawer-card" style="margin-top:14px;">
                            <h3 class="drawer-card-title">Vehicle Image</h3>
                            <p class="drawer-card-subtitle">Add or replace the image linked to the selected vehicle. This image will also appear on the invoice details and billing list.</p>
                            <div class="billing-image-picker" style="margin-top:10px;">
                                <div class="billing-image-preview" id="billingVehicleImagePreview"><i class="bi bi-car-front"></i></div>
                                <div class="billing-image-controls">
                                    <label for="billingVehicleImage" class="billing-image-button"><i class="bi bi-image"></i> Choose Vehicle Image</label>
                                    <input id="billingVehicleImage" name="vehicleImage" type="file" accept="image/png,image/jpeg,image/webp,image/gif" hidden />
                                    <div class="billing-image-status" id="billingVehicleImageStatus">No new image selected</div>
                                    <div class="billing-image-help">PNG, JPG, WEBP or GIF · Max 5 MB</div>
                                </div>
                            </div>
                        </div>

                        <div class="invoice-preview" id="invoicePreview">
                            <div class="invoice-preview-title">Invoice Preview</div>
                            <div class="invoice-preview-row"><span>Customer</span><strong data-preview="customer">—</strong></div>
                            <div class="invoice-preview-row"><span>Vehicle</span><strong data-preview="vehicle">—</strong></div>
                            <div class="invoice-preview-row"><span>Services / Labor</span><strong>₱<span data-preview="labor">0.00</span></strong></div>
                            <div class="invoice-preview-row"><span>Parts Used</span><strong>₱<span data-preview="parts">0.00</span></strong></div>
                            <div class="invoice-preview-row"><span>Subtotal</span><strong>₱<span data-preview="subtotal">0.00</span></strong></div>
                            <div class="invoice-preview-row"><span>Tax (12%)</span><strong>₱<span data-preview="tax">0.00</span></strong></div>
                            <div class="invoice-preview-row invoice-preview-total"><span>Total Amount</span><strong>₱<span data-preview="total">0.00</span></strong></div>
                        </div>
                    </form>
                }
            </div>
            <div class="billing-drawer-foot">
                <a asp-action="Index" class="af-button af-button-secondary">Cancel</a>
                @if (availableJobs.Any())
                {
                    <button type="submit"
                            form="createInvoiceForm"
                            class="af-button af-button-primary billing-create-submit">
                        Create Invoice
                    </button>
                }
                else
                {
                    <button type="button"
                            class="af-button af-button-primary billing-create-submit"
                            disabled
                            aria-disabled="true">
                        Create Invoice
                    </button>
                }
            </div>
        </aside>
    </div>
}

@if (open == "archived")
{
    <div class="billing-archived-backdrop" data-drawer-backdrop>
        <aside class="billing-archived-drawer" aria-label="Archived Billing">
            <div class="billing-archived-head">
                <div>
                    <h2>Archived Billing</h2>
                    <p>Preserved invoices that are no longer shown in the active billing list.</p>
                </div>
                <a asp-action="Index" class="billing-archived-close" title="Close archived billing" aria-label="Close archived billing"><i class="bi bi-x-lg"></i></a>
            </div>
            <div class="billing-archived-body">
                @if (!archivedBillings.Any())
                {
                    <div class="billing-archived-empty">
                        <i class="bi bi-archive"></i>
                        <h3>No Archived Invoices</h3>
                        <p>Archived invoices will appear here and can be restored at any time.</p>
                    </div>
                }
                else
                {
                    @foreach (var item in archivedBillings)
                    {
                        var customer = item.JobOrder?.Vehicle?.Customer;
                        var customerName = customer == null ? "—" : $"{customer.FirstName} {customer.LastName}";
                        var vehicle = item.JobOrder?.Vehicle;
                        var vehicleName = vehicle == null ? "—" : $"{vehicle.Make} {vehicle.Model}";
                        var balance = Math.Max(0, item.TotalAmount - item.AmountPaid);

                        <div class="billing-archived-card">
                            <div class="billing-archived-card-head">
                                <div class="billing-archived-invoice">
                                    <div class="billing-archived-icon"><i class="bi bi-receipt"></i></div>
                                    <div>
                                        <strong>@item.InvoiceNumber</strong>
                                        <span>Archived @item.UpdatedAt.ToString("MMM d, yyyy · h:mm tt")</span>
                                    </div>
                                </div>
                                <span class="af-badge" style="background:#f1f5f9;color:#475569;">Archived</span>
                            </div>

                            <div class="billing-archived-profiles">
                                @if (customer != null)
                                {
                                    <a asp-controller="Customers" asp-action="@(customer.IsArchived ? "ArchivedDetails" : "Details")" asp-route-id="@customer.CustomerId" class="billing-archived-profile" title="Open customer profile">
                                        <span class="billing-archived-profile-media owner">
                                            @if (!string.IsNullOrWhiteSpace(customer.ImageUrl))
                                            {
                                                <img src="@customer.ImageUrl" alt="@customerName" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-person"></i>
                                            }
                                        </span>
                                        <span class="billing-archived-profile-copy">
                                            <span class="billing-archived-profile-label">Owner</span>
                                            <strong class="billing-archived-profile-name">@customerName</strong>
                                            <span class="billing-archived-profile-meta">@(customer.Phone ?? customer.Email ?? "Open profile")</span>
                                        </span>
                                    </a>
                                }
                                @if (vehicle != null)
                                {
                                    <a asp-controller="Vehicles" asp-action="@(vehicle.IsArchived ? "ArchivedDetails" : "Details")" asp-route-id="@vehicle.VehicleId" class="billing-archived-profile" title="Open vehicle profile">
                                        <span class="billing-archived-profile-media">
                                            @if (!string.IsNullOrWhiteSpace(vehicle.ImageUrl))
                                            {
                                                <img src="@vehicle.ImageUrl" alt="@vehicleName" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-car-front"></i>
                                            }
                                        </span>
                                        <span class="billing-archived-profile-copy">
                                            <span class="billing-archived-profile-label">Vehicle</span>
                                            <strong class="billing-archived-profile-name">@vehicleName</strong>
                                            <span class="billing-archived-profile-meta">@vehicle.PlateNumber · Open profile</span>
                                        </span>
                                    </a>
                                }
                            </div>

                            <div class="billing-archived-balance"><span>Remaining Balance</span><strong>₱@balance.ToString("N2")</strong></div>

                            <div class="billing-archived-actions">
                                <a asp-action="Index" asp-route-open="details" asp-route-id="@item.BillingId" class="billing-icon-button" title="View invoice" aria-label="View @item.InvoiceNumber"><i class="bi bi-eye"></i></a>
                                <form asp-action="Restore" method="post" style="margin:0;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.BillingId" />
                                    <button type="submit" class="billing-restore-button" title="Restore invoice" aria-label="Restore @item.InvoiceNumber"><i class="bi bi-arrow-counterclockwise"></i></button>
                                </form>
                            </div>
                        </div>
                    }
                }
            </div>
        </aside>
    </div>
}

@if (open == "archive" && selectedBilling != null)
{
    <div class="billing-archive-modal" data-billing-archive-modal>
        <div class="billing-archive-confirm">
            <div class="billing-archive-confirm-icon"><i class="bi bi-archive"></i></div>
            <h2>Archive Invoice?</h2>
            <p>This will move <strong>@selectedBilling.InvoiceNumber</strong> to Archived Billing. The invoice and its payment history will remain available for viewing and restoration.</p>
            <form asp-action="Archive" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@selectedBilling.BillingId" />
                <div class="billing-archive-confirm-actions">
                    <a asp-action="Index" class="af-button af-button-secondary">No, Keep Invoice</a>
                    <button type="submit" class="af-button billing-danger-button">Yes, Archive Invoice</button>
                </div>
            </form>
        </div>
    </div>
}

@if ((open == "details" || open == "payment") && selectedBilling != null)
{
    var customer = selectedBilling.JobOrder?.Vehicle?.Customer;
    var vehicle = selectedBilling.JobOrder?.Vehicle;
    var customerName = customer == null ? "—" : $"{customer.FirstName} {customer.LastName}";
    var vehicleName = vehicle == null ? "—" : $"{vehicle.Year} {vehicle.Make} {vehicle.Model}";
    var partRows = selectedBilling.JobOrder?.JobOrderParts ?? new List<JobOrderPart>();

    <div class="billing-drawer-backdrop" data-drawer-backdrop>
        <aside class="billing-drawer wide">
            <div class="billing-drawer-head">
                <div><h2>@(open == "payment" ? (paymentToEdit != null ? "Edit Payment" : "Record Payment") : "Invoice Details")</h2><p>@selectedBilling.InvoiceNumber · Job Order #@selectedBilling.JobOrderId</p></div>
                <a class="billing-drawer-close" asp-action="Index" aria-label="Close">×</a>
            </div>

            @if (open == "payment" && !string.IsNullOrWhiteSpace(paymentSuccess))
            {
                <div class="billing-drawer-body">
                    <div class="drawer-success">
                        <div class="drawer-success-icon">✓</div>
                        <h3>Payment Recorded</h3>
                        <p>The invoice has been updated successfully.</p>
                        <div class="drawer-success-summary">
                            <div><span>Payment Recorded</span><strong>@paymentSuccess.Replace("Payment of ", "").Replace(" recorded successfully.", "")</strong></div>
                            <div><span>New Balance</span><strong>₱@remaining.ToString("N2")</strong></div>
                            <div><span>New Status</span><strong>@selectedBilling.Status</strong></div>
                        </div>
                        <a asp-action="Index" asp-route-open="details" asp-route-id="@selectedBilling.BillingId" class="af-button af-button-primary" style="display:inline-flex;justify-content:center;min-width:190px;">View Invoice</a>
                    </div>
                </div>
            }
            else if (open == "payment")
            {
                <div class="billing-drawer-body">
                    @if (!string.IsNullOrWhiteSpace(paymentError))
                    {
                        <div class="drawer-alert error">@paymentError</div>
                    }
                    <div class="drawer-card" style="background:#f8fafc;">
                        <div class="drawer-section-label">Invoice</div>
                        <strong style="font-size:15px;">@selectedBilling.InvoiceNumber</strong>
                        <div class="drawer-lines">
                            <div class="drawer-line"><span>Total Amount</span><strong>₱@selectedBilling.TotalAmount.ToString("N2")</strong></div>
                            <div class="drawer-line paid"><span>Already Paid</span><strong>₱@selectedBilling.AmountPaid.ToString("N2")</strong></div>
                            <div class="drawer-line due total"><span>Remaining Balance</span><strong>₱@remaining.ToString("N2")</strong></div>
                        </div>
                        <div style="margin-top:13px;display:flex;justify-content:space-between;font-size:8px;color:#64748b;"><span>Payment Progress</span><strong>@paymentProgress.ToString("0")%</strong></div>
                        <div class="drawer-progress"><div style="width:@paymentProgress.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div></div>
                    </div>

                    @if (paymentToEdit == null && !string.IsNullOrWhiteSpace(xenditPaymentRequestId))
                    {
                        <div class="xendit-payment-card" id="xenditPaymentCard" data-payment-request-id="@xenditPaymentRequestId" data-billing-id="@selectedBilling.BillingId" data-status="@xenditStatus">
                            <h3>GCash / QRPh Online Payment</h3>
                            <p>Scan this QR code using GCash or another supported bank/e-wallet app. The payment is matched to this invoice automatically after Xendit confirms it.</p>
                            @if (!string.IsNullOrWhiteSpace(xenditQrString))
                            {
                                <div class="xendit-qr-wrap"><div id="xenditQrCode" data-qr-string="@xenditQrString"></div></div>
                            }
                            else if (!string.IsNullOrWhiteSpace(xenditCheckoutUrl))
                            {
                                <div class="xendit-qr-wrap" style="min-height:100px;"><a href="@xenditCheckoutUrl" target="_blank" rel="noopener" class="af-button af-button-primary">Open Xendit Checkout</a></div>
                            }
                            else
                            {
                                <div class="xendit-qr-wrap" style="min-height:100px;color:#94a3b8;font-size:9px;text-align:center;">Waiting for the QR code from Xendit…</div>
                            }
                            <div class="xendit-status" id="xenditStatusText">
                                <span class="xendit-status-dot @(xenditStatus.Equals("SUCCEEDED", StringComparison.OrdinalIgnoreCase) ? "success" : xenditStatus.Equals("FAILED", StringComparison.OrdinalIgnoreCase) ? "error" : "")"></span>
                                <strong>@(string.IsNullOrWhiteSpace(xenditStatus) ? "Waiting for payment" : xenditStatus)</strong>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(xenditError))
                            {
                                <div class="xendit-test-note" style="background:#fef2f2;color:#991b1b;">@xenditError</div>
                            }
                            <div class="xendit-actions">
                                <button type="button" class="af-button af-button-secondary" id="checkXenditPayment">Check Payment Status</button>
                                <button type="button" class="af-button af-button-secondary" id="simulateXenditPayment">Simulate Test Payment</button>
                            </div>
                            <div class="xendit-test-note">“Simulate Test Payment” is only for Xendit Test Mode. It does not move real money.</div>
                        </div>
                    }

                    @if (paymentToEdit != null || selectedBilling.Status != "Paid")
                    {
                        <form asp-action="@(paymentToEdit != null ? "EditPayment" : "RecordPayment")" method="post" id="paymentForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="billingId" value="@selectedBilling.BillingId" />
                            @if (paymentToEdit != null)
                            {
                                <input type="hidden" name="paymentId" value="@paymentToEdit.PaymentId" />
                            }
                            <div class="payment-form-field">
                                <label for="drawerAmountPaid">Amount @(paymentToEdit != null ? "Paid" : "to Pay")</label>
                                <input id="drawerAmountPaid" name="amountPaid" type="number" min="0.01" max="@editPaymentMaximum.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.01" value="@(paymentToEdit != null ? paymentToEdit.AmountPaid.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : paymentAmount)" placeholder="0.00" required />
                                <div class="payment-max">Maximum allowed for this payment: ₱@editPaymentMaximum.ToString("N2")</div>
                            </div>
                            <div class="payment-form-field">
                                <label for="drawerPaymentMethod">Payment Method</label>
                                @{ var activePaymentMethod = paymentToEdit?.PaymentMethod ?? paymentMethod; }
                                <select id="drawerPaymentMethod" name="paymentMethod">
                                    <option value="Cash" selected="@(activePaymentMethod == "Cash")">Cash</option>
                                    <option value="Card" selected="@(activePaymentMethod == "Card")">Card</option>
                                    <option value="Bank Transfer" selected="@(activePaymentMethod == "Bank Transfer")">Bank Transfer</option>
                                    <option value="GCash" selected="@(activePaymentMethod == "GCash")">GCash</option>
                                    <option value="GCash / QRPh" selected="@(activePaymentMethod == "GCash / QRPh")">GCash / QRPh</option>
                                    <option value="Other" selected="@(activePaymentMethod == "Other")">Other</option>
                                </select>
                            </div>
                            @if (paymentToEdit == null)
                            {
                                <div id="gcashOnlineHint" class="xendit-payment-card" style="display:@(paymentMethod == "GCash" && string.IsNullOrWhiteSpace(xenditPaymentRequestId) ? "block" : "none");">
                                    <h3>Connect GCash / QRPh</h3>
                                    <p>For an online payment, use the button below to create a real Xendit QR payment request for this invoice.</p>
                                    <div class="xendit-actions" style="margin-top:9px;">
                                        <button type="submit" form="xenditStartForm" class="af-button af-button-primary">Generate QR &amp; Pay Online</button>
                                    </div>
                                </div>
                            }
                            <div class="payment-form-field">
                                <label for="drawerPaymentNotes">Notes <span style="color:#94a3b8;font-weight:400;">(optional)</span></label>
                                <textarea id="drawerPaymentNotes" name="notes" rows="4" placeholder="Add any notes about this payment...">@(paymentToEdit?.Notes ?? paymentNotes)</textarea>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="drawer-card" style="background:#f8fafc;text-align:center;">
                            <div class="drawer-success-icon" style="margin:0 auto 10px;">✓</div>
                            <h3 class="drawer-card-title">Invoice Fully Paid</h3>
                            <p class="drawer-card-subtitle">Select <strong>Edit Payment</strong> from the Payment History below to update an existing payment.</p>
                        </div>
                    }
                    <form asp-action="StartXenditQr" method="post" id="xenditStartForm" style="display:none;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="billingId" value="@selectedBilling.BillingId" />
                        <input type="hidden" name="amountPaid" id="xenditAmountPaid" value="@paymentAmount" />
                        <input type="hidden" name="notes" id="xenditNotes" value="@paymentNotes" />
                    </form>
                </div>
                <div class="billing-drawer-foot">
                    <a asp-action="Index" asp-route-open="details" asp-route-id="@selectedBilling.BillingId" class="af-button af-button-secondary">Cancel</a>
                    @if (paymentToEdit != null)
                    {
                        <button type="submit" form="paymentForm" class="af-button af-button-primary">Save Changes</button>
                    }
                    else if (selectedBilling.Status != "Paid")
                    {
                        <button type="submit" form="paymentForm" class="af-button af-button-primary">Save Payment</button>
                    }
                </div>
            }
            else
            {
                <div class="billing-drawer-body">
                    <div class="drawer-card">
                        <div style="display:flex;justify-content:space-between;gap:12px;align-items:flex-start;">
                            <div><div class="drawer-section-label">Invoice / Job Context</div><strong style="font-size:15px;">@selectedBilling.InvoiceNumber</strong><div class="drawer-info-meta">Issued @selectedBilling.IssuedAt.ToString("MMM d, yyyy · h:mm tt")</div></div>
                            <span class="af-badge @(selectedBilling.Status == "Paid" ? "badge-green" : selectedBilling.Status == "Partial" ? "badge-orange" : "badge-red")">@(selectedBilling.Status == "Partial" ? "Partially Paid" : selectedBilling.Status)</span>
                        </div>
                        <div class="drawer-grid-2" style="margin-top:13px;">
                            <div class="drawer-info"><span class="drawer-info-label">Customer</span><span class="drawer-info-value">@customerName</span><span class="drawer-info-meta">@(customer?.Email ?? "No email")</span></div>
                            <div class="drawer-info"><span class="drawer-info-label">Vehicle</span><span class="drawer-info-value">@(vehicle?.PlateNumber ?? "—")</span><span class="drawer-info-meta">@vehicleName</span></div>
                        </div>
                    </div>

                    <div class="drawer-card">
                        <h3 class="drawer-card-title">Vehicle Image</h3>
                        <p class="drawer-card-subtitle">Image linked to this vehicle and invoice.</p>
                        <div class="billing-drawer-vehicle-image" style="margin-top:10px;">
                            @if (!string.IsNullOrWhiteSpace(vehicle?.ImageUrl))
                            {
                                <img src="@vehicle.ImageUrl" alt="Vehicle image for @vehicleName" />
                            }
                            else
                            {
                                <i class="bi bi-car-front"></i>
                            }
                        </div>
                    </div>

                    <div class="drawer-card">
                        <h3 class="drawer-card-title">Billing Breakdown</h3>
                        <p class="drawer-card-subtitle">Complete cost breakdown for this invoice.</p>
                        <div class="drawer-lines">
                            <div class="drawer-line"><span>Services / Labor</span><strong>₱@selectedBilling.LaborCost.ToString("N2")</strong></div>
                            <div class="drawer-line"><span>Parts Used</span><strong>₱@selectedBilling.PartsCost.ToString("N2")</strong></div>
                            @if (selectedBilling.DiscountAmount > 0) { <div class="drawer-line"><span>Discount</span><strong>-₱@selectedBilling.DiscountAmount.ToString("N2")</strong></div> }
                            <div class="drawer-line"><span>Tax (12%)</span><strong>₱@selectedBilling.TaxAmount.ToString("N2")</strong></div>
                            <div class="drawer-line total"><span>Total Amount</span><strong>₱@selectedBilling.TotalAmount.ToString("N2")</strong></div>
                            <div class="drawer-line paid"><span>Amount Paid</span><strong>₱@selectedBilling.AmountPaid.ToString("N2")</strong></div>
                            <div class="drawer-line due"><span>Remaining Balance</span><strong>₱@remaining.ToString("N2")</strong></div>
                        </div>
                        <div style="margin-top:12px;display:flex;justify-content:space-between;font-size:8px;color:#64748b;"><span>Payment Progress</span><strong>@paymentProgress.ToString("0")%</strong></div>
                        <div class="drawer-progress"><div style="width:@paymentProgress.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div></div>
                    </div>

                    <div class="drawer-card">
                        <h3 class="drawer-card-title">Parts Used</h3>
                        <p class="drawer-card-subtitle">Parts recorded against the associated repair job.</p>
                        @if (partRows.Any())
                        {
                            <div class="af-table-wrapper" style="margin-top:10px;"><table class="af-table"><thead><tr><th>Part</th><th>Qty</th><th>Unit</th><th>Total</th></tr></thead><tbody>
                            @foreach (var jp in partRows)
                            {
                                <tr><td><strong>@(jp.Part?.Name ?? "Unknown Part")</strong><small>@jp.Part?.PartNumber</small></td><td>@jp.Quantity</td><td>₱@jp.UnitPriceAtTimeOfUse.ToString("N2")</td><td><strong>₱@((jp.Quantity * jp.UnitPriceAtTimeOfUse).ToString("N2"))</strong></td></tr>
                            }
                            </tbody></table></div>
                        }
                        else { <div class="drawer-empty">No parts recorded on this job order.</div> }
                    </div>

                    <div class="drawer-card">
                        <div style="display:flex;justify-content:space-between;gap:10px;align-items:flex-start;"><div><h3 class="drawer-card-title">Payment History</h3><p class="drawer-card-subtitle">Transactions recorded against this invoice.</p></div>@if (selectedBilling.Status != "Paid") { <a asp-action="Index" asp-route-open="payment" asp-route-id="@selectedBilling.BillingId" class="af-button af-button-primary" style="padding:7px 10px;font-size:9px;">Record Payment</a> }</div>
                        @if (selectedBilling.Payments.Any())
                        {
                            @foreach (var p in selectedBilling.Payments.OrderByDescending(x => x.PaymentDate))
                            {
                                <div class="drawer-payment-item">
                                    <div class="drawer-payment-head"><strong>₱@p.AmountPaid.ToString("N2")</strong><span class="af-badge badge-blue">@p.PaymentMethod</span></div>
                                    <span class="drawer-payment-date">@p.PaymentDate.ToString("MMM d, yyyy · h:mm tt")</span>
                                    @if (!string.IsNullOrWhiteSpace(p.Notes)) { <span class="drawer-payment-notes">@p.Notes</span> }
                                    <div style="margin-top:8px;"><a asp-action="Index" asp-route-open="payment" asp-route-id="@selectedBilling.BillingId" asp-route-paymentId="@p.PaymentId" class="af-button af-button-secondary" style="padding:6px 9px;font-size:8px;"><i class="bi bi-pencil-square"></i> Edit Payment</a></div>
                                </div>
                            }
                        }
                        else { <div class="drawer-empty">No payments recorded yet.</div> }
                    </div>
                </div>
                <div class="billing-drawer-foot">
                    @if (selectedBilling.Status != "Paid") { <a asp-action="Index" asp-route-open="payment" asp-route-id="@selectedBilling.BillingId" class="af-button af-button-primary">Record Payment</a> }
                    <button type="button" class="af-button af-button-secondary" data-print-open>Print Invoice</button>
                    <a asp-action="Index" class="af-button af-button-secondary">Close</a>
                </div>

                <div class="print-modal-backdrop" data-print-modal hidden>
                    <div class="print-modal">
                        <div class="print-modal-head"><span>Print Preview</span><div class="print-modal-head-actions"><button type="button" class="af-button af-button-primary" data-print-now>🖨 Print</button><button type="button" class="af-button af-button-secondary" data-print-close>Close</button></div></div>
                        <div class="print-paper-wrap"><div class="print-paper">
                            <div class="print-paper-head"><div><div class="print-brand">AUTOFLOW</div><div class="print-small">PREMIUM AUTOMOTIVE SERVICES</div></div><div><div class="print-invoice-title">INVOICE</div><div class="print-invoice-number">@selectedBilling.InvoiceNumber</div></div></div>
                            <div class="print-meta-grid"><div><div class="print-meta-label">Billed To</div><div class="print-meta-value">@customerName</div><div class="print-small">@vehicleName · @(vehicle?.PlateNumber ?? "—")</div></div><div style="text-align:right;"><div class="print-meta-label">Invoice Details</div><div class="print-meta-value">Date: @selectedBilling.IssuedAt.ToString("MMM d, yyyy")</div><div class="print-small">Job Order: JO-@selectedBilling.JobOrderId.ToString("D4")</div><div class="print-small">Status: @selectedBilling.Status.ToUpperInvariant()</div></div></div>
                            <table class="print-table"><thead><tr><th>Description</th><th>Qty</th><th>Unit Price</th><th>Total</th></tr></thead><tbody><tr><td><strong>Labor / Services</strong><br><span class="print-small">@(selectedBilling.JobOrder?.Description ?? "Repair service")</span></td><td>1</td><td>₱@selectedBilling.LaborCost.ToString("N2")</td><td>₱@selectedBilling.LaborCost.ToString("N2")</td></tr>@foreach (var jp in partRows){<tr><td><strong>Part: @(jp.Part?.Name ?? "Unknown Part")</strong><br><span class="print-small">@jp.Part?.PartNumber</span></td><td>@jp.Quantity</td><td>₱@jp.UnitPriceAtTimeOfUse.ToString("N2")</td><td>₱@((jp.Quantity * jp.UnitPriceAtTimeOfUse).ToString("N2"))</td></tr>}</tbody></table>
                            <div class="print-totals"><div class="print-total-row"><span>Subtotal</span><strong>₱@((selectedBilling.LaborCost + selectedBilling.PartsCost - selectedBilling.DiscountAmount).ToString("N2"))</strong></div><div class="print-total-row"><span>Tax (12%)</span><strong>₱@selectedBilling.TaxAmount.ToString("N2")</strong></div><div class="print-total-row"><span>Discount</span><strong>₱@selectedBilling.DiscountAmount.ToString("N2")</strong></div><div class="print-total-row print-total-final"><span>TOTAL</span><strong>₱@selectedBilling.TotalAmount.ToString("N2")</strong></div><div class="print-total-row"><span>Amount Paid</span><strong>₱@selectedBilling.AmountPaid.ToString("N2")</strong></div><div class="print-total-row"><span>BALANCE</span><strong>₱@remaining.ToString("N2")</strong></div></div>
                            <div class="print-thanks">THANK YOU FOR YOUR BUSINESS!<br>This is a computer-generated invoice. No signature required.</div>
                        </div></div>
                    </div>
                </div>
            }
        </aside>
    </div>
}

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
<script>
(() => {
    const formatMoney = value => Number(value || 0).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    const updateInvoicePreview = option => {
        if (!option) return;
        document.getElementById('selectedJobOrderId')?.setAttribute('value', option.dataset.jobId);
        document.querySelectorAll('[data-preview]').forEach(el => {
            const key = el.dataset.preview;
            el.textContent = key === 'customer' || key === 'vehicle' ? option.dataset[key] : formatMoney(option.dataset[key]);
        });

        const fileInput = document.getElementById('billingVehicleImage');
        const preview = document.getElementById('billingVehicleImagePreview');
        const status = document.getElementById('billingVehicleImageStatus');
        if (fileInput) fileInput.value = '';
        if (status) status.textContent = option.dataset.image ? 'Current vehicle image will be kept unless replaced.' : 'No image linked to this vehicle.';
        if (preview) {
            preview.innerHTML = option.dataset.image
                ? `<img src="${option.dataset.image}" alt="Vehicle image" />`
                : '<i class="bi bi-car-front"></i>';
        }
    };

    const options = document.querySelectorAll('[data-job-option]');
    options.forEach(option => option.addEventListener('click', () => {
        options.forEach(x => x.classList.remove('is-selected'));
        option.classList.add('is-selected');
        updateInvoicePreview(option);
    }));
    if (options.length) updateInvoicePreview(document.querySelector('[data-job-option].is-selected') || options[0]);

    const vehicleImageInput = document.getElementById('billingVehicleImage');
    if (vehicleImageInput) {
        vehicleImageInput.addEventListener('change', () => {
            const file = vehicleImageInput.files?.[0];
            const preview = document.getElementById('billingVehicleImagePreview');
            const status = document.getElementById('billingVehicleImageStatus');
            if (!file) {
                const selected = document.querySelector('[data-job-option].is-selected') || options[0];
                updateInvoicePreview(selected);
                return;
            }
            if (file.size > 5 * 1024 * 1024) {
                vehicleImageInput.value = '';
                if (status) status.textContent = 'Image is too large. Maximum size is 5 MB.';
                return;
            }
            if (status) status.textContent = file.name;
            const reader = new FileReader();
            reader.onload = event => {
                if (preview) preview.innerHTML = `<img src="${event.target?.result}" alt="Selected vehicle image" />`;
            };
            reader.readAsDataURL(file);
        });
    }

    const printModal = document.querySelector('[data-print-modal]');
    if (printModal) {
        // Details view must never open the print preview by itself.
        printModal.hidden = true;
        printModal.setAttribute('hidden', 'hidden');
    }

    document.querySelectorAll('[data-print-open]').forEach(button => {
        button.addEventListener('click', () => {
            const modal = document.querySelector('[data-print-modal]');
            if (modal) {
                modal.hidden = false;
                modal.removeAttribute('hidden');
            }
        });
    });
    document.querySelectorAll('[data-print-close]').forEach(button => button.addEventListener('click', () => {
        const modal = document.querySelector('[data-print-modal]');
        if (modal) {
            modal.hidden = true;
            modal.setAttribute('hidden', 'hidden');
        }
    }));
    document.querySelectorAll('[data-print-now]').forEach(button => button.addEventListener('click', () => window.print()));

    document.querySelectorAll('[data-drawer-backdrop]').forEach(backdrop => {
        backdrop.addEventListener('click', event => {
            if (event.target === backdrop) window.location.href = '@Url.Action("Index", "Billings")';
        });
    });

    document.querySelectorAll('[data-billing-archive-modal]').forEach(modal => {
        modal.addEventListener('click', event => {
            if (event.target === modal) window.location.href = '@Url.Action("Index", "Billings")';
        });
    });

    const amount = document.getElementById('drawerAmountPaid');
    const paymentForm = document.getElementById('paymentForm');
    if (amount && paymentForm) {
        paymentForm.addEventListener('submit', event => {
            const max = Number(amount.max || 0);
            const value = Number(amount.value || 0);
            if (value <= 0 || value > max) {
                event.preventDefault();
                amount.focus();
                amount.setCustomValidity(value <= 0 ? 'Enter a payment amount greater than zero.' : 'Payment cannot exceed the remaining balance.');
                amount.reportValidity();
            } else {
                amount.setCustomValidity('');
            }
        });
        amount.addEventListener('input', () => amount.setCustomValidity(''));
    }

    const paymentMethod = document.getElementById('drawerPaymentMethod');
    const gcashHint = document.getElementById('gcashOnlineHint');
    const xenditAmount = document.getElementById('xenditAmountPaid');
    const xenditNotes = document.getElementById('xenditNotes');
    const syncOnlinePaymentFields = () => {
        if (!paymentMethod) return;
        const isGcash = paymentMethod.value === 'GCash';
        if (gcashHint) gcashHint.style.display = isGcash ? 'block' : 'none';
        if (xenditAmount && amount) xenditAmount.value = amount.value || '';
        if (xenditNotes) xenditNotes.value = document.getElementById('drawerPaymentNotes')?.value || '';
    };
    paymentMethod?.addEventListener('change', syncOnlinePaymentFields);
    amount?.addEventListener('input', syncOnlinePaymentFields);
    document.getElementById('drawerPaymentNotes')?.addEventListener('input', syncOnlinePaymentFields);
    syncOnlinePaymentFields();

    const xenditCard = document.getElementById('xenditPaymentCard');
    if (xenditCard) {
        const paymentRequestId = xenditCard.dataset.paymentRequestId;
        const billingId = xenditCard.dataset.billingId;
        const statusText = document.getElementById('xenditStatusText');
        const checkButton = document.getElementById('checkXenditPayment');
        const simulateButton = document.getElementById('simulateXenditPayment');
        const qrHost = document.getElementById('xenditQrCode');

        if (qrHost && qrHost.dataset.qrString && window.QRCode) {
            new QRCode(qrHost, { text: qrHost.dataset.qrString, width: 205, height: 205, correctLevel: QRCode.CorrectLevel.M });
        }

        const refreshStatus = async () => {
            if (!paymentRequestId || !billingId) return;
            try {
                const response = await fetch(`@Url.Action("CheckXenditStatus", "Billings")?billingId=${encodeURIComponent(billingId)}&paymentRequestId=${encodeURIComponent(paymentRequestId)}`, { headers: { 'Accept': 'application/json' } });
                const data = await response.json();
                if (!data.success) return;
                if (statusText) {
                    const dot = statusText.querySelector('.xendit-status-dot');
                    const label = statusText.querySelector('strong');
                    if (label) label.textContent = data.status;
                    if (dot) dot.className = `xendit-status-dot ${data.status === 'SUCCEEDED' ? 'success' : data.status === 'FAILED' ? 'error' : ''}`;
                }
                if (data.status === 'SUCCEEDED' || data.paymentRecorded) {
                    window.location.href = `@Url.Action("Index", "Billings")?open=payment&id=${encodeURIComponent(billingId)}&xendit=${encodeURIComponent(paymentRequestId)}`;
                }
            } catch (error) {
                console.warn('Xendit status check failed.', error);
            }
        };

        checkButton?.addEventListener('click', refreshStatus);
        simulateButton?.addEventListener('click', async () => {
            simulateButton.disabled = true;
            try {
                await fetch(`@Url.Action("SimulateXenditPayment", "Billings")?billingId=${encodeURIComponent(billingId)}&paymentRequestId=${encodeURIComponent(paymentRequestId)}`, { method: 'POST', headers: { 'RequestVerificationToken': document.querySelector('#paymentForm input[name="__RequestVerificationToken"]')?.value || '' } });
                let attempts = 0;
                const poll = async () => {
                    attempts += 1;
                    await refreshStatus();
                    if (attempts < 8 && document.getElementById('xenditPaymentCard')) setTimeout(poll, 2000);
                };
                setTimeout(poll, 1200);
            } finally {
                setTimeout(() => simulateButton.disabled = false, 1600);
            }
        });
    }
})();
</script>
}
