@model IEnumerable<AutoFlow.Web.Models.Billing>
@using AutoFlow.Web.Models

@{
    ViewData["Title"] = "Billing & Payments";

    var billingList = Model.ToList();
    var availableJobs = ViewBag.AvailableJobs as List<JobOrder> ?? new List<JobOrder>();
    var selectedBilling = ViewBag.SelectedBilling as Billing;
    var open = (ViewBag.Open as string ?? string.Empty).ToLowerInvariant();
    var search = ViewBag.Search as string ?? string.Empty;
    var selectedStatus = ViewBag.SelectedStatus as string ?? "All";
    var selectedDate = ViewBag.SelectedDate as string ?? string.Empty;
    var taxRate = (decimal)(ViewBag.TaxRate ?? 0.12m);
    var paymentSuccess = ViewBag.PaymentSuccess as string;
    var paymentError = ViewBag.PaymentError as string;
    var billingError = TempData["BillingError"] as string;
    var billingInfo = ViewBag.BillingInfo as string;
    var archivedBillingCount = ViewBag.ArchivedBillingCount is int archivedCount ? archivedCount : 0;
    var archivedBillings = ViewBag.ArchivedBillings as List<Billing> ?? new List<Billing>();
    var paymentAmount = ViewBag.PaymentAmount as string ?? string.Empty;
    var paymentMethod = ViewBag.PaymentMethod as string ?? "Cash";
    var paymentNotes = ViewBag.PaymentNotes as string ?? string.Empty;
    var xenditPaymentRequestId = ViewBag.XenditPaymentRequestId as string ?? string.Empty;
    var xenditStatus = ViewBag.XenditStatus as string ?? string.Empty;
    var xenditQrString = ViewBag.XenditQrString as string ?? string.Empty;
    var xenditCheckoutUrl = ViewBag.XenditCheckoutUrl as string ?? string.Empty;
    var xenditError = ViewBag.XenditError as string ?? string.Empty;
    var selectedJobOrderId = ViewBag.SelectedJobOrderId is int selectedJobId ? selectedJobId : 0;
    var selectedAvailableJob = availableJobs.FirstOrDefault(j => j.JobOrderId == selectedJobOrderId) ?? availableJobs.FirstOrDefault();
    var editPaymentId = ViewBag.PaymentId is int selectedPaymentId ? selectedPaymentId : 0;
    var paymentToEdit = selectedBilling?.Payments.FirstOrDefault(p => p.PaymentId == editPaymentId);
    var editPaymentMaximum = paymentToEdit == null || selectedBilling == null
        ? 0
        : Math.Max(0, selectedBilling.TotalAmount - selectedBilling.Payments
            .Where(p => p.PaymentId != paymentToEdit.PaymentId)
            .Sum(p => p.AmountPaid));

    var totalInvoices = billingList.Count;
    var paidInvoices = billingList.Count(x => x.Status == "Paid");
    var partialInvoices = billingList.Count(x => x.Status == "Partial");
    var outstandingInvoices = billingList.Count(x => x.Status != "Paid");
    var totalBilled = billingList.Sum(x => x.TotalAmount);
    var totalCollected = billingList.Sum(x => x.AmountPaid);
    var totalOutstanding = billingList.Sum(x => Math.Max(0, x.TotalAmount - x.AmountPaid));

    var remaining = selectedBilling == null
        ? 0
        : Math.Max(0, selectedBilling.TotalAmount - selectedBilling.AmountPaid);

    var paymentProgress = selectedBilling?.TotalAmount > 0
        ? Math.Min(100, (selectedBilling.AmountPaid / selectedBilling.TotalAmount) * 100)
        : 0;
}

