@model AutoFlow.Web.Models.Billing

@{
    ViewData["Title"] = "Invoice Details";
    var remaining = Model.TotalAmount - Model.AmountPaid;
}

<div class="dashboard-page">

    <div class="page-header">
        <div>
            <h1>Invoice @Model.InvoiceNumber</h1>
            <p>Invoice details, parts breakdown, and payment history.</p>
        </div>
        <div class="page-header-actions">
            @if (Model.Status != "Paid")
            {
                <a asp-action="RecordPayment" asp-route-id="@Model.BillingId"
                   class="af-button af-button-primary">
                    Record Payment
                </a>
            }
            <a asp-action="Index" class="af-button af-button-secondary">
                Back to Invoices
            </a>
        </div>
    </div>

    <div style="display:grid; grid-template-columns:1fr 340px; gap:24px; align-items:start;">

        <!-- LEFT COLUMN -->
        <div>

            <!-- Invoice Summary -->
            <div class="af-card" style="padding:28px; margin-bottom:24px;">
                <h2 style="font-size:1rem; font-weight:600; margin-bottom:20px;">Invoice Summary</h2>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                    <div>
                        <small style="color:var(--af-text-muted); display:block;">Invoice Number</small>
                        <strong>@Model.InvoiceNumber</strong>
                    </div>
                    <div>
                        <small style="color:var(--af-text-muted); display:block;">Status</small>
                        @{
                            var badgeClass = Model.Status switch
                            {
                                "Paid" => "badge-green",
                                "Partial" => "badge-orange",
                                _ => "badge-red"
                            };
                        }
                        <span class="af-badge @badgeClass">@Model.Status</span>
                    </div>
                    <div>
                        <small style="color:var(--af-text-muted); display:block;">Issued</small>
                        <strong>@Model.IssuedAt.ToString("MMM dd, yyyy")</strong>
                        <small style="display:block; color:var(--af-text-muted);">@Model.IssuedAt.ToString("hh:mm tt")</small>
                    </div>
                    @if (Model.JobOrder != null)
                    {
                        <div>
                            <small style="color:var(--af-text-muted); display:block;">Job Order</small>
                            <a asp-controller="JobOrders" asp-action="Details"
                               asp-route-id="@Model.JobOrder.JobOrderId"
                               style="color:var(--af-primary); text-decoration:none; font-weight:600;">
                                #@Model.JobOrder.JobOrderId
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- Cost Breakdown -->
            <div class="af-card" style="padding:28px; margin-bottom:24px;">
                <h2 style="font-size:1rem; font-weight:600; margin-bottom:20px;">Cost Breakdown</h2>
                <div style="display:grid; gap:12px;">
                    <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px solid var(--af-border);">
                        <span style="color:var(--af-text-secondary);">Labor</span>
                        <strong>@Model.LaborCost.ToString("C")</strong>
                    </div>
                    <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px solid var(--af-border);">
                        <span style="color:var(--af-text-secondary);">Parts</span>
                        <strong>@Model.PartsCost.ToString("C")</strong>
                    </div>
                    @if (Model.DiscountAmount > 0)
                    {
                        <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px solid var(--af-border);">
                            <span style="color:var(--af-text-secondary);">Discount</span>
                            <strong style="color:var(--af-success);">-@Model.DiscountAmount.ToString("C")</strong>
                        </div>
                    }
                    @if (Model.TaxAmount > 0)
                    {
                        <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px solid var(--af-border);">
                            <span style="color:var(--af-text-secondary);">Tax</span>
                            <strong>@Model.TaxAmount.ToString("C")</strong>
                        </div>
                    }
                    <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px solid var(--af-border);">
                        <span style="color:var(--af-text-secondary); font-weight:600;">Total Amount</span>
                        <strong style="font-size:1.1rem;">@Model.TotalAmount.ToString("C")</strong>
                    </div>
                    <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px solid var(--af-border);">
                        <span style="color:var(--af-text-secondary);">Amount Paid</span>
                        <strong style="color:var(--af-success);">@Model.AmountPaid.ToString("C")</strong>
                    </div>
                    <div style="display:flex; justify-content:space-between; padding:8px 0;">
                        <span style="color:var(--af-text-secondary); font-weight:600;">Remaining Balance</span>
                        @if (remaining > 0)
                        {
                            <strong style="color:var(--af-danger); font-size:1.1rem;">@remaining.ToString("C")</strong>
                        }
                        else
                        {
                            <strong style="color:var(--af-success); font-size:1.1rem;">$0.00</strong>
                        }
                    </div>
                </div>
            </div>

            <!-- Parts Used -->
            <div class="af-card" style="padding:28px; margin-bottom:24px;">
                <h2 style="font-size:1rem; font-weight:600; margin-bottom:20px;">Parts Used</h2>
                @if (Model.JobOrder?.JobOrderParts != null && Model.JobOrder.JobOrderParts.Any())
                {
                    <div class="af-table-wrapper">
                        <table class="af-table">
                            <thead>
                                <tr>
                                    <th>Part</th>
                                    <th>Qty</th>
                                    <th>Unit Price</th>
                                    <th>Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var jp in Model.JobOrder.JobOrderParts)
                                {
                                    <tr>
                                        <td><strong>@(jp.Part?.Name ?? "—")</strong></td>
                                        <td>@jp.Quantity</td>
                                        <td>@jp.UnitPriceAtTimeOfUse.ToString("C")</td>
                                        <td><strong>@((jp.Quantity * jp.UnitPriceAtTimeOfUse).ToString("C"))</strong></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p style="color:var(--af-text-muted); margin:0;">No parts recorded on this job order.</p>
                }
            </div>

        </div>

        <!-- RIGHT COLUMN -->
        <div>

            <!-- Vehicle / Customer -->
            <div class="af-card" style="padding:28px; margin-bottom:24px;">
                <h2 style="font-size:1rem; font-weight:600; margin-bottom:20px;">Vehicle & Customer</h2>
                @if (Model.JobOrder?.Vehicle != null)
                {
                    <div style="margin-bottom:16px;">
                        <small style="color:var(--af-text-muted); display:block;">Plate Number</small>
                        <strong style="font-size:1.1rem;">@Model.JobOrder.Vehicle.PlateNumber</strong>
                    </div>
                    <div style="margin-bottom:16px;">
                        <small style="color:var(--af-text-muted); display:block;">Vehicle</small>
                        <span>@Model.JobOrder.Vehicle.Make @Model.JobOrder.Vehicle.Model</span>
                        @if (Model.JobOrder.Vehicle.Year.HasValue)
                        {
                            <span> · @Model.JobOrder.Vehicle.Year</span>
                        }
                    </div>
                    @if (Model.JobOrder.Vehicle.Customer != null)
                    {
                        <div style="padding-top:12px; border-top:1px solid var(--af-border); margin-top:8px;">
                            <small style="color:var(--af-text-muted); display:block;">Customer</small>
                            <strong>@Model.JobOrder.Vehicle.Customer.FirstName @Model.JobOrder.Vehicle.Customer.LastName</strong>
                            @if (!string.IsNullOrWhiteSpace(Model.JobOrder.Vehicle.Customer.Phone))
                            {
                                <small style="display:block; color:var(--af-text-muted);">@Model.JobOrder.Vehicle.Customer.Phone</small>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.JobOrder.Vehicle.Customer.Email))
                            {
                                <small style="display:block; color:var(--af-text-muted);">@Model.JobOrder.Vehicle.Customer.Email</small>
                            }
                        </div>
                    }
                }
                else
                {
                    <p style="color:var(--af-text-muted); margin:0;">Vehicle information unavailable.</p>
                }
            </div>

            <!-- Payment History -->
            <div class="af-card" style="padding:28px;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
                    <h2 style="font-size:1rem; font-weight:600; margin:0;">Payment History</h2>
                    @if (Model.Status != "Paid")
                    {
                        <a asp-action="RecordPayment" asp-route-id="@Model.BillingId"
                           class="af-button af-button-primary" style="padding:6px 14px; font-size:12px;">
                            + Record Payment
                        </a>
                    }
                </div>
                @if (Model.Payments.Any())
                {
                    <div style="display:grid; gap:12px;">
                        @foreach (var p in Model.Payments.OrderByDescending(x => x.PaymentDate))
                        {
                            <div style="padding:12px; background:var(--af-bg); border:1px solid var(--af-border); border-radius:8px;">
                                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
                                    <strong>@p.AmountPaid.ToString("C")</strong>
                                    <span class="af-badge badge-blue" style="font-size:11px;">@p.PaymentMethod</span>
                                </div>
                                <small style="color:var(--af-text-muted); display:block;">
                                    @p.PaymentDate.ToString("MMM dd, yyyy")
                                </small>
                                @if (!string.IsNullOrWhiteSpace(p.Notes))
                                {
                                    <small style="color:var(--af-text-secondary); display:block; margin-top:4px;">
                                        @p.Notes
                                    </small>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p style="color:var(--af-text-muted); margin:0;">No payments recorded yet.</p>
                }
            </div>

        </div>

    </div>

    <!-- Footer Actions -->
    <div style="margin-top:24px; display:flex; gap:12px;">
        @if (Model.Status != "Paid")
        {
            <a asp-action="RecordPayment" asp-route-id="@Model.BillingId"
               class="af-button af-button-primary">
                Record Payment
            </a>
        }
        <a asp-action="Index" class="af-button af-button-secondary">
            Back to Invoices
        </a>
    </div>

</div>
