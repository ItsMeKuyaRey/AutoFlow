@model AutoFlow.Web.Models.Billing
@{
    ViewData["Title"] = "Invoice Details";
}
<div class="dashboard-page" style="max-width:900px;margin:0 auto;">
    <div class="af-card" style="padding:28px;">
        <h1 style="margin:0 0 8px;font-size:22px;">Invoice Details</h1>
        <p style="margin:0;color:var(--af-text-secondary);">The billing workspace now uses an in-page invoice drawer for a clearer workflow.</p>
        <a asp-action="Index" asp-route-open="details" asp-route-id="@Model.BillingId" class="af-button af-button-primary" style="display:inline-flex;margin-top:20px;">Open Invoice</a>
    </div>
</div>
