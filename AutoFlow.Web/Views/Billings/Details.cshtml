@model AutoFlow.Web.Models.Billing

@{
    ViewData["Title"] = "Invoice Details";

    var remaining = Model.TotalAmount - Model.AmountPaid;

    var badgeClass = Model.Status switch
    {
        "Paid" => "badge-green",
        "Partial" => "badge-orange",
        _ => "badge-red"
    };

    var paymentProgress = Model.TotalAmount > 0
        ? Math.Min(100, (Model.AmountPaid / Model.TotalAmount) * 100)
        : 0;
}

<style>
    .invoice-page {
        max-width: 1450px;
        margin: 0 auto;
    }

    .invoice-header-meta {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 7px;
        flex-wrap: wrap;
    }

    .invoice-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 350px;
        gap: 24px;
        align-items: start;
    }

    .invoice-card {
        padding: 26px;
        margin-bottom: 24px;
    }

    .invoice-card-title {
        margin: 0;
        font-size: 1rem;
        font-weight: 650;
    }

    .invoice-card-subtitle {
        margin: 5px 0 0;
        color: var(--af-text-muted);
        font-size: 0.8rem;
    }

    .invoice-info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        margin-top: 22px;
    }

    .invoice-info-label {
        display: block;
        margin-bottom: 5px;
        color: var(--af-text-muted);
        font-size: 0.76rem;
    }

    .invoice-info-value {
        font-weight: 650;
    }

    .invoice-link {
        color: var(--af-primary);
        text-decoration: none;
        font-weight: 650;
    }

    .invoice-money-list {
        display: grid;
        gap: 0;
        margin-top: 20px;
    }

    .invoice-money-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 12px 0;
        border-bottom: 1px solid var(--af-border);
    }

    .invoice-money-row:last-child {
        border-bottom: none;
    }

    .invoice-money-label {
        color: var(--af-text-secondary);
    }

    .invoice-money-value {
        font-weight: 650;
        white-space: nowrap;
    }

    .invoice-total-row {
        margin-top: 4px;
        padding-top: 16px;
        border-top: 1px solid var(--af-border);
    }

    .invoice-total-row .invoice-money-label {
        font-weight: 650;
        color: var(--af-text-primary);
    }

    .invoice-total-row .invoice-money-value {
        font-size: 1.15rem;
    }

    .invoice-due-row .invoice-money-label {
        font-weight: 650;
    }

    .invoice-due {
        color: var(--af-danger);
        font-size: 1.12rem;
    }

    .invoice-paid {
        color: var(--af-success);
    }

    .payment-progress {
        margin-top: 22px;
        padding-top: 20px;
        border-top: 1px solid var(--af-border);
    }

    .payment-progress-head {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 9px;
        font-size: 0.78rem;
    }

    .payment-progress-track {
        height: 8px;
        overflow: hidden;
        border-radius: 999px;
        background: var(--af-border);
    }

    .payment-progress-bar {
        height: 100%;
        border-radius: 999px;
        background: var(--af-primary);
    }

    .parts-empty {
        padding: 24px 0 4px;
        color: var(--af-text-muted);
    }

    .vehicle-panel {
        display: grid;
        gap: 16px;
        margin-top: 20px;
    }

    .vehicle-main {
        padding-bottom: 16px;
        border-bottom: 1px solid var(--af-border);
    }

    .vehicle-plate {
        font-size: 1.2rem;
        font-weight: 700;
        letter-spacing: 0.02em;
    }

    .vehicle-name {
        display: block;
        margin-top: 4px;
        color: var(--af-text-secondary);
    }

    .customer-panel {
        padding-top: 2px;
    }

    .customer-name {
        display: block;
        font-weight: 650;
        margin-bottom: 5px;
    }

    .customer-contact {
        display: block;
        color: var(--af-text-muted);
        font-size: 0.8rem;
        margin-top: 3px;
        overflow-wrap: anywhere;
    }

    .payment-history {
        display: grid;
        gap: 12px;
        margin-top: 18px;
    }

    .payment-item {
        border: 1px solid var(--af-border);
        border-radius: 10px;
        padding: 14px;
        background: var(--af-bg);
    }

    .payment-item-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    .payment-amount {
        font-weight: 700;
    }

    .payment-date {
        display: block;
        color: var(--af-text-muted);
        font-size: 0.76rem;
        margin-top: 5px;
    }

    .payment-notes {
        display: block;
        color: var(--af-text-secondary);
        font-size: 0.8rem;
        line-height: 1.45;
        margin-top: 8px;
    }

    .payment-method {
        font-size: 0.72rem;
    }

    .invoice-footer-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 4px;
    }

    @@media (max-width: 1050px) {
        .invoice-layout {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 650px) {
        .invoice-info-grid {
            grid-template-columns: 1fr;
        }

        .invoice-card {
            padding: 20px;
        }
    }
</style>

<div class="dashboard-page invoice-page">

    <div class="page-header">
        <div>
            <h1>Invoice @Model.InvoiceNumber</h1>

            <div class="invoice-header-meta">
                <span class="af-badge @badgeClass">@Model.Status</span>

                @if (Model.JobOrder != null)
                {
                    <span style="color:var(--af-text-muted); font-size:0.8rem;">
                        Job Order #@Model.JobOrder.JobOrderId
                    </span>
                }
            </div>
        </div>

        <div class="page-header-actions">

            @if (Model.Status != "Paid")
            {
                <a asp-action="RecordPayment"
                   asp-route-id="@Model.BillingId"
                   class="af-button af-button-primary">
                    Record Payment
                </a>
            }

            <a asp-action="Index"
               class="af-button af-button-secondary">
                Back to Invoices
            </a>

        </div>
    </div>

    <div class="invoice-layout">

        <!-- LEFT COLUMN -->
        <div>

            <!-- Invoice Summary -->
            <div class="af-card invoice-card">

                <h2 class="invoice-card-title">Invoice Summary</h2>
                <p class="invoice-card-subtitle">
                    Billing information generated from the repair job.
                </p>

                <div class="invoice-info-grid">

                    <div>
                        <span class="invoice-info-label">Invoice Number</span>
                        <span class="invoice-info-value">@Model.InvoiceNumber</span>
                    </div>

                    <div>
                        <span class="invoice-info-label">Status</span>
                        <span class="af-badge @badgeClass">@Model.Status</span>
                    </div>

                    <div>
                        <span class="invoice-info-label">Issued Date</span>
                        <span class="invoice-info-value">
                            @Model.IssuedAt.ToString("MMM dd, yyyy")
                        </span>
                        <small style="display:block; color:var(--af-text-muted); margin-top:3px;">
                            @Model.IssuedAt.ToString("hh:mm tt")
                        </small>
                    </div>

                    @if (Model.JobOrder != null)
                    {
                        <div>
                            <span class="invoice-info-label">Job Order</span>
                            <a asp-controller="JobOrders"
                               asp-action="Details"
                               asp-route-id="@Model.JobOrder.JobOrderId"
                               class="invoice-link">
                                #@Model.JobOrder.JobOrderId
                            </a>
                        </div>
                    }

                </div>

            </div>

            <!-- Cost Breakdown -->
            <div class="af-card invoice-card">

                <h2 class="invoice-card-title">Cost Breakdown</h2>
                <p class="invoice-card-subtitle">
                    Complete breakdown of the invoice amount.
                </p>

                <div class="invoice-money-list">

                    <div class="invoice-money-row">
                        <span class="invoice-money-label">Labor</span>
                        <span class="invoice-money-value">
                            ₱@Model.LaborCost.ToString("N2")
                        </span>
                    </div>

                    <div class="invoice-money-row">
                        <span class="invoice-money-label">Parts</span>
                        <span class="invoice-money-value">
                            ₱@Model.PartsCost.ToString("N2")
                        </span>
                    </div>

                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="invoice-money-row">
                            <span class="invoice-money-label">Discount</span>
                            <span class="invoice-money-value" style="color:var(--af-success);">
                                -₱@Model.DiscountAmount.ToString("N2")
                            </span>
                        </div>
                    }

                    @if (Model.TaxAmount > 0)
                    {
                        <div class="invoice-money-row">
                            <span class="invoice-money-label">Tax</span>
                            <span class="invoice-money-value">
                                ₱@Model.TaxAmount.ToString("N2")
                            </span>
                        </div>
                    }

                    <div class="invoice-money-row invoice-total-row">
                        <span class="invoice-money-label">Total Amount</span>
                        <span class="invoice-money-value">
                            ₱@Model.TotalAmount.ToString("N2")
                        </span>
                    </div>

                    <div class="invoice-money-row">
                        <span class="invoice-money-label">Amount Paid</span>
                        <span class="invoice-money-value invoice-paid">
                            ₱@Model.AmountPaid.ToString("N2")
                        </span>
                    </div>

                    <div class="invoice-money-row invoice-due-row">
                        <span class="invoice-money-label">Remaining Balance</span>

                        @if (remaining > 0)
                        {
                            <span class="invoice-money-value invoice-due">
                                ₱@remaining.ToString("N2")
                            </span>
                        }
                        else
                        {
                            <span class="invoice-money-value invoice-paid">
                                ₱0.00
                            </span>
                        }
                    </div>

                </div>

                <div class="payment-progress">

                    <div class="payment-progress-head">
                        <span style="color:var(--af-text-muted);">
                            Payment Progress
                        </span>

                        <strong>
                            @paymentProgress.ToString("0")%
                        </strong>
                    </div>

                    <div class="payment-progress-track">
                        <div class="payment-progress-bar"
                             style="width:@paymentProgress.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;">
                        </div>
                    </div>

                </div>

            </div>

            <!-- Parts Used -->
            <div class="af-card invoice-card">

                <h2 class="invoice-card-title">Parts Used</h2>
                <p class="invoice-card-subtitle">
                    Parts recorded against the associated repair job.
                </p>

                @if (Model.JobOrder?.JobOrderParts != null &&
                     Model.JobOrder.JobOrderParts.Any())
                {
                    <div class="af-table-wrapper" style="margin-top:18px;">

                        <table class="af-table">

                            <thead>
                                <tr>
                                    <th>Part</th>
                                    <th>Quantity</th>
                                    <th>Unit Price</th>
                                    <th>Subtotal</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var jp in Model.JobOrder.JobOrderParts)
                                {
                                    <tr>

                                        <td>
                                            <strong>
                                                @(jp.Part?.Name ?? "—")
                                            </strong>
                                        </td>

                                        <td>
                                            @jp.Quantity
                                        </td>

                                        <td>
                                            ₱@jp.UnitPriceAtTimeOfUse.ToString("N2")
                                        </td>

                                        <td>
                                            <strong>
                                                ₱@((jp.Quantity * jp.UnitPriceAtTimeOfUse).ToString("N2"))
                                            </strong>
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="parts-empty">
                        No parts recorded on this job order.
                    </div>
                }

            </div>

        </div>

        <!-- RIGHT COLUMN -->
        <div>

            <!-- Vehicle & Customer -->
            <div class="af-card invoice-card">

                <h2 class="invoice-card-title">Vehicle & Customer</h2>
                <p class="invoice-card-subtitle">
                    Customer and vehicle connected to this invoice.
                </p>

                @if (Model.JobOrder?.Vehicle != null)
                {
                    <div class="vehicle-panel">

                        <div class="vehicle-main">

                            <span class="invoice-info-label">
                                Plate Number
                            </span>

                            <span class="vehicle-plate">
                                @Model.JobOrder.Vehicle.PlateNumber
                            </span>

                            <span class="vehicle-name">
                                @Model.JobOrder.Vehicle.Make
                                @Model.JobOrder.Vehicle.Model

                                @if (Model.JobOrder.Vehicle.Year.HasValue)
                                {
                                    <span> · @Model.JobOrder.Vehicle.Year</span>
                                }
                            </span>

                        </div>

                        @if (Model.JobOrder.Vehicle.Customer != null)
                        {
                            <div class="customer-panel">

                                <span class="invoice-info-label">
                                    Customer
                                </span>

                                <span class="customer-name">
                                    @Model.JobOrder.Vehicle.Customer.FirstName
                                    @Model.JobOrder.Vehicle.Customer.LastName
                                </span>

                                @if (!string.IsNullOrWhiteSpace(Model.JobOrder.Vehicle.Customer.Phone))
                                {
                                    <span class="customer-contact">
                                        @Model.JobOrder.Vehicle.Customer.Phone
                                    </span>
                                }

                                @if (!string.IsNullOrWhiteSpace(Model.JobOrder.Vehicle.Customer.Email))
                                {
                                    <span class="customer-contact">
                                        @Model.JobOrder.Vehicle.Customer.Email
                                    </span>
                                }

                            </div>
                        }

                    </div>
                }
                else
                {
                    <p style="color:var(--af-text-muted); margin:20px 0 0;">
                        Vehicle information unavailable.
                    </p>
                }

            </div>

            <!-- Payment History -->
            <div class="af-card invoice-card">

                <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:12px;">

                    <div>
                        <h2 class="invoice-card-title">Payment History</h2>
                        <p class="invoice-card-subtitle">
                            Transactions recorded against this invoice.
                        </p>
                    </div>

                    @if (Model.Status != "Paid")
                    {
                        <a asp-action="RecordPayment"
                           asp-route-id="@Model.BillingId"
                           class="af-button af-button-primary"
                           style="padding:7px 12px; font-size:12px; white-space:nowrap;">
                            Record Payment
                        </a>
                    }

                </div>

                @if (Model.Payments.Any())
                {
                    <div class="payment-history">

                        @foreach (var p in Model.Payments.OrderByDescending(x => x.PaymentDate))
                        {
                            <div class="payment-item">

                                <div class="payment-item-head">

                                    <span class="payment-amount">
                                        ₱@p.AmountPaid.ToString("N2")
                                    </span>

                                    <span class="af-badge badge-blue payment-method">
                                        @p.PaymentMethod
                                    </span>

                                </div>

                                <span class="payment-date">
                                    @p.PaymentDate.ToString("MMM dd, yyyy")
                                    · @p.PaymentDate.ToString("hh:mm tt")
                                </span>

                                @if (!string.IsNullOrWhiteSpace(p.Notes))
                                {
                                    <span class="payment-notes">
                                        @p.Notes
                                    </span>
                                }

                            </div>
                        }

                    </div>
                }
                else
                {
                    <p style="color:var(--af-text-muted); margin:20px 0 0;">
                        No payments recorded yet.
                    </p>
                }

            </div>

        </div>

    </div>

    <!-- Footer Actions -->
    <div class="invoice-footer-actions">

        @if (Model.Status != "Paid")
        {
            <a asp-action="RecordPayment"
               asp-route-id="@Model.BillingId"
               class="af-button af-button-primary">
                Record Payment
            </a>
        }

        <a asp-action="Index"
           class="af-button af-button-secondary">
            Back to Invoices
        </a>

    </div>

</div>