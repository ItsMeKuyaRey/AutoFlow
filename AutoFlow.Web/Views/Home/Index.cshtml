    .ad-kpi:hover::after {
        opacity: 1;
        transform: scaleX(1);
    }

    .ad-kpi-icon {
        width: 38px;
        height: 38px;
        border: 1px solid #ece7ff;
        background: linear-gradient(145deg, #faf9ff, #f1edff);
        color: #7c3aed;
        box-shadow: 0 5px 14px rgba(124,58,237,.08);
    }

    .ad-kpi-badge {
        border: 1px solid #ece7ff;
        background: #faf8ff;
    }

    .ad-card {
        border-color: #e9edf3;
        border-radius: 17px;
        box-shadow: 0 8px 26px rgba(15, 23, 42, .035);
    }

    .ad-card-head {
        padding: 19px 21px;
    }

    .ad-card-title h2 {
