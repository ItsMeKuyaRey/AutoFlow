    }

    .ad-flow-icon {
        width: 46px;
        height: 46px;
        border-color: #e8ebf0;
        border-radius: 13px;
        box-shadow: 0 6px 17px rgba(15,23,42,.045);
    }

    .ad-flow-node:hover .ad-flow-action {
        color: #6d28d9;
    }

    .ad-arrow-icon {
        width: 14px;
        height: 14px;
        flex: 0 0 14px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.9;
        stroke-linecap: round;
        stroke-linejoin: round;
