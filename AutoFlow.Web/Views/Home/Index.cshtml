@model AutoFlow.Web.ViewModels.DashboardViewModel
@using AutoFlow.Web.ViewModels

@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-page">

    <!-- PAGE HEADER -->
    <div class="page-header">

        <div>
            <h1>Good morning, Administrator</h1>

            <p>
                Here's what's happening with your automotive service business today.
            </p>
        </div>

        <div class="page-header-actions">

            <a asp-controller="Appointments" asp-action="Create" class="af-button af-button-primary">
                + New Appointment
            </a>

        </div>

    </div>


    <!-- KPI CARDS -->
    <div class="dashboard-grid dashboard-grid-4">

        <a asp-controller="Billings" asp-action="Index" class="af-card metric-card" style="text-decoration:none;color:inherit;">

            <div class="metric-icon metric-blue">
                $
            </div>

            <div class="metric-label">
                Total Revenue
            </div>

            <div class="metric-value">
                @Model.TotalRevenue.ToString("C0")
            </div>

            <div class="metric-change positive">
                All time
            </div>

        </a>


        <a asp-controller="JobOrders" asp-action="Index" class="af-card metric-card" style="text-decoration:none;color:inherit;">

            <div class="metric-icon metric-purple">
                🔧
            </div>

            <div class="metric-label">
                Active Repair Jobs
            </div>

            <div class="metric-value">
                @Model.ActiveJobCount
            </div>

            <div class="metric-change positive">
                @Model.TodayJobCount <span>today</span>
            </div>

        </a>


        <a asp-controller="Appointments" asp-action="Index" class="af-card metric-card" style="text-decoration:none;color:inherit;">

            <div class="metric-icon metric-orange">
                📅
            </div>

            <div class="metric-label">
                Pending Appointments
            </div>

            <div class="metric-value">
                @Model.PendingAppointmentCount
            </div>

            <div class="metric-change negative">
                @Model.RescheduledAppointmentCount <span>rescheduled</span>
            </div>

        </a>


        <a asp-controller="Parts" asp-action="Index" class="af-card metric-card" style="text-decoration:none;color:inherit;">

            <div class="metric-icon metric-red">
                !
            </div>

            <div class="metric-label">
                Low Stock Alerts
            </div>

            <div class="metric-value">
                @Model.LowStockAlertCount
            </div>

            <div class="metric-change negative">
                Critical parts
            </div>

        </a>

    </div>


    <!-- MIDDLE SECTION -->
    <div class="dashboard-grid dashboard-grid-main">

        <!-- JOB STATUS -->
        <div class="af-card dashboard-card">

            <div class="card-header">

                <div>
                    <h2>Distribution of Job Statuses</h2>

                    <p>
                        Current repair workload
                    </p>
                </div>

            </div>


            <div class="job-status-chart">

                <div class="status-ring">

                    <div class="status-ring-inner">

                        <strong>@Model.TotalJobCount</strong>

                        <span>Total Jobs</span>

                    </div>

                </div>

            </div>

        </div>


        <!-- ACTIVE FOLLOW UPS -->
        <div class="af-card dashboard-card">

            <div class="card-header">

                <div>
                    <h2>Active Follow-ups</h2>

                    <p>
                        Customers requiring attention
                    </p>
                </div>

                <span class="af-badge badge-blue">
                    @Model.FollowUps.Count due
                </span>

            </div>


            <div class="follow-up-list">

                @if (Model.FollowUps.Any())
                {
                    @foreach (var followUp in Model.FollowUps)
                    {
                        <div class="follow-up-item">

                            <div class="avatar avatar-@followUp.AvatarColor">
                                @followUp.AvatarInitials
                            </div>

                            <div class="follow-up-info">

                                <strong>@followUp.CustomerName</strong>

                                <span>
                                    @followUp.VehicleInfo
                                </span>

                            </div>

                            <span class="af-badge badge-blue">
                                @followUp.Status
                            </span>

                        </div>
                    }
                }
                else
                {
                    <div class="follow-up-item">
                        <div class="follow-up-info">
                            <strong>No pending follow-ups</strong>
                        </div>
                    </div>
                }

            </div>


            <div class="capacity-section">

                @{
                    var bayPercent = Model.TotalBays > 0
                        ? (int)Math.Round((double)Model.ActiveBayCount / Model.TotalBays * 100)
                        : 0;
                }

                <div class="capacity-circle">
                    @bayPercent%
                </div>

                <div>
                    <strong>@bayPercent% Bay Capacity Utilized</strong>

                    <span>
                        @Model.ActiveBayCount of @Model.TotalBays bays occupied right now
                    </span>
                </div>

            </div>

        </div>

    </div>


    <!-- RECENT JOBS -->
    <div class="af-card dashboard-card recent-jobs">

        <div class="card-header">

            <div>
                <h2>Recent Repair Jobs</h2>

                <p>
                    Latest service activity across the shop
                </p>
            </div>

            <div class="table-actions">

                <a asp-controller="JobOrders" asp-action="Index" class="af-button af-button-secondary">
                    View All Jobs
                </a>

            </div>

        </div>


        <div class="af-table-wrapper">

            <table class="af-table">

                <thead>

                    <tr>

                        <th>Vehicle</th>
                        <th>Customer</th>
                        <th>Service</th>
                        <th>Value</th>
                        <th>Status</th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model.RecentJobs.Any())
                    {
                        @foreach (var job in Model.RecentJobs)
                        {
                            var badgeClass = job.Status switch
                            {
                                "In Progress" => "badge-blue",
                                "Completed" => "badge-green",
                                "Pending" => "badge-orange",
                                _ => "badge-blue"
                            };

                            <tr>

                                <td>
                                    <strong>@job.VehicleMake @job.VehicleModel</strong>
                                    <small>Plate · @job.PlateNumber</small>
                                </td>

                                <td>
                                    @job.CustomerName
                                </td>

                                <td>
                                    @(job.Description ?? "No description")
                                </td>

                                <td>
                                    <strong>@job.TotalCost.ToString("C0")</strong>
                                </td>

                                <td>
                                    <span class="af-badge @badgeClass">
                                        @job.Status
                                    </span>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" style="text-align:center;padding:2rem;">
                                No repair jobs yet. <a asp-controller="JobOrders" asp-action="Create">Create your first job order</a>.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>


    <!-- BOTTOM METRICS -->
    <div class="dashboard-grid dashboard-grid-3">

        <div class="af-card mini-chart-card">

            <div class="mini-card-header">

                <span>
                    Completed Jobs
                </span>

            </div>

            <div class="mini-value">
                @(Model.JobStatusCounts.FirstOrDefault(s => s.Status == "Completed")?.Count ?? 0)
            </div>

            <span class="mini-description">
                total completed
            </span>

        </div>


        <div class="af-card mini-chart-card">

            <div class="mini-card-header">

                <span>
                    Open Jobs
                </span>

            </div>

            <div class="mini-value">
                @(Model.JobStatusCounts.FirstOrDefault(s => s.Status == "Open")?.Count ?? 0)
            </div>

            <span class="mini-description">
                awaiting work
            </span>

        </div>


        <div class="af-card mini-chart-card">

            <div class="mini-card-header">

                <span>
                    In Progress
                </span>

            </div>

            <div class="mini-value">
                @(Model.JobStatusCounts.FirstOrDefault(s => s.Status == "In Progress")?.Count ?? 0)
            </div>

            <span class="mini-description">
                jobs in bay
            </span>

        </div>

    </div>

</div>
