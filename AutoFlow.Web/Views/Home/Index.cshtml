                   asp-action="Index"
                   class="ad-flow-node">

                    <div class="ad-flow-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4h6.5a4 4 0 1 1 0 8H7M7 8h9M7 12h5M7 4v16"/></svg></div>

                    <div class="ad-flow-count">
                        @Model.TotalBillingCount
                    </div>

                    <div class="ad-flow-label">
                        Billing
                    </div>

                    <div class="ad-flow-action">
                        Financial Workspace <svg class="ad-arrow-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    </div>

                </a>


                <a asp-controller="ServiceRecords"
                   asp-action="Index"
                   class="ad-flow-node">

                    <div class="ad-flow-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5M12 7v5l3 2"/></svg></div>

                    <div class="ad-flow-count">
                        @Model.TotalServiceRecordCount
                    </div>

                    <div class="ad-flow-label">
                        Service History
                    </div>

                    <div class="ad-flow-action">
                        Service Timeline <svg class="ad-arrow-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    </div>

                </a>


                <a asp-controller="CustomerFollowUps"
                   asp-action="Index"
                   class="ad-flow-node">

                    <div class="ad-flow-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7A2 2 0 0 1 22 16.9Z"/></svg></div>

                    <div class="ad-flow-count">
                        @Model.FollowUps.Count
                    </div>

                    <div class="ad-flow-label">
                        CRM Follow-up
                    </div>

                    <div class="ad-flow-action">
                        CRM Workspace <svg class="ad-arrow-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    </div>

                </a>

            </div>

        </div>

    </section>


    <!-- Appointments and repair jobs -->
    <section class="ad-two-column">

        <div class="ad-card">

            <div class="ad-card-head">

                <div class="ad-card-title">

                    <h2>
                        Today's Appointments
                    </h2>

                    <p>
                        Live service schedule for @today.ToString("dddd, MMMM dd").
                    </p>

                </div>

                <a asp-controller="Appointments"
                   asp-action="Index"
                   class="ad-link">
                    View All Appointments <svg class="ad-arrow-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>

            </div>

            @if (Model.TodayAppointments.Any())
            {
                <div class="ad-table-scroll">

                    <table class="ad-appointments-table">

                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Customer & Vehicle</th>
                                <th>Concern</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var appointment in Model.TodayAppointments)
                            {
                                var appointmentStatusClass =
                                    appointment.Status switch
                                    {
                                        "Completed" => "ad-status-green",
                                        "Confirmed" => "ad-status-green",
                                        "Rescheduled" => "ad-status-orange",
                                        "Cancelled" => "ad-status-red",
                                        _ => "ad-status-blue"
                                    };

                                <tr>

                                    <td>
                                        <strong>
                                            @appointment.AppointmentDate.ToString("hh:mm tt")
                                        </strong>
                                    </td>

                                    <td>

                                        <a asp-controller="Appointments"
                                           asp-action="Details"
                                           asp-route-id="@appointment.AppointmentId"
                                           class="ad-customer-name">
                                            @appointment.CustomerName
                                        </a>

                                        <span class="ad-subtext">
                                            @appointment.VehicleInfo
                                            @if (!string.IsNullOrWhiteSpace(appointment.PlateNumber))
                                            {
                                                <text> · @appointment.PlateNumber</text>
                                            }
                                        </span>

                                    </td>

                                    <td>
                                        @appointment.Concern
                                    </td>

                                    <td>

                                        <span class="ad-status @appointmentStatusClass">
                                            @appointment.Status
                                        </span>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="ad-empty">
                    No appointments scheduled for today.
                    <br /><br />

                    <a asp-controller="Appointments"
                       asp-action="Create"
                       class="ad-link">
                        + Schedule an appointment
                    </a>
                </div>
            }

        </div>


        <div class="ad-card">

            <div class="ad-card-head">

                <div class="ad-card-title">

                    <h2>
                        Repair Job Status
                    </h2>

                    <p>
                        Current repair operations distribution.
                    </p>

                </div>

                <a asp-controller="JobOrders"
                   asp-action="Index"
                   class="ad-link">
                    View Repair Job Orders <svg class="ad-arrow-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>

            </div>

            <div class="ad-job-body">

                <div class="ad-pipeline-header">

                    <span>
                        Active jobs pipeline
                    </span>

                    <span>
                        @Model.TotalJobCount total jobs
                    </span>

                </div>

                <div class="ad-pipeline">

                    <div class="ad-pipeline-open"
                         style="width:@openPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                    </div>

                    <div class="ad-pipeline-progress"
                         style="width:@progressPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                    </div>

                    <div class="ad-pipeline-completed"
                         style="width:@completedPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                    </div>

                </div>

                <div class="ad-pipeline-legend">

                    <span>
                        <span class="ad-dot" style="background:#94a3b8;"></span>
                        Open (@Model.OpenJobCount)
                    </span>

                    <span>
                        <span class="ad-dot" style="background:#3b82f6;"></span>
                        In Progress (@Model.InProgressJobCount)
                    </span>

                    <span>
                        <span class="ad-dot" style="background:#10b981;"></span>
                        Completed (@Model.CompletedJobCount)
                    </span>

                </div>

                <div class="ad-job-list">

                    @if (Model.RecentJobs.Any())
                    {
                        @foreach (var job in Model.RecentJobs.Take(3))
                        {
                            var jobStatusClass =
                                job.Status switch
                                {
                                    "Completed" => "ad-status-green",
                                    "In Progress" => "ad-status-blue",
                                    "Open" => "ad-status-orange",
                                    "Cancelled" => "ad-status-red",
                                    _ => "ad-status-purple"
                                };

                            <a asp-controller="JobOrders"
                               asp-action="Details"
                               asp-route-id="@job.JobOrderId"
                               class="ad-job-row">

                                <div class="ad-job-id">
                                    JOB<br />
                                    @job.JobOrderId
                                </div>

                                <div>

                                    <div class="ad-job-name">
                                        @job.VehicleMake @job.VehicleModel
                                    </div>

                                    <span class="ad-job-description">
                                        @(job.Description ?? "No repair description")
                                    </span>

                                </div>

                                <span class="ad-status @jobStatusClass">
                                    @job.Status
                                </span>

                            </a>
                        }
                    }
                    else
                    {
                        <div class="ad-empty">
                            No repair job records available.
                        </div>
                    }

                </div>

            </div>

        </div>

    </section>


    <!-- Inventory, billing, follow-ups -->
    <section class="ad-three-column">

        <div class="ad-card">

            <div class="ad-card-head">

                <div class="ad-card-title">
                    <h2>Inventory Snapshot</h2>
                    <p>Current parts inventory position.</p>
                </div>

            </div>

            <div class="ad-panel-body">

                <div class="ad-inventory-value">

                    <span>
                        Estimated Inventory Value
                    </span>

                    <strong>
                        ₱@Model.InventoryValue.ToString("N2")
                    </strong>

                </div>

                <div class="ad-mini-grid">

                    <div class="ad-mini-stat">

                        <span>Total Parts</span>

                        <strong>
                            @Model.TotalPartCount
                        </strong>

                    </div>

                    <div class="ad-mini-stat">

                        <span>Stock Quantity</span>

                        <strong>
                            @Model.TotalStockQuantity
                        </strong>

                    </div>

                    <div class="ad-mini-stat">

                        <span>Low Stock</span>

                        <strong>
                            @Model.LowStockAlertCount
                        </strong>

                    </div>

                    <div class="ad-mini-stat">

                        <span>Suppliers</span>

                        <strong>
                            View
                        </strong>

                    </div>

                </div>

                <a asp-controller="Parts"
                   asp-action="Index"
                   class="ad-footer-link">
                    View Parts Inventory <svg class="ad-arrow-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>

            </div>

        </div>


        <div class="ad-card">

            <div class="ad-card-head">

                <div class="ad-card-title">
                    <h2>Billing & Payments</h2>
                    <p>Live financial collection position.</p>
                </div>

            </div>

            <div class="ad-panel-body">

                <div class="ad-billing-ring">

                    <div class="ad-billing-ring-inner">

                        <div>

                            <strong>
                                @Model.CollectionRate.ToString("0.0")%
                            </strong>

                            <span>
                                Collection Rate
                            </span>

                        </div>

                    </div>

                </div>

                <div class="ad-financial-row">

                    <span>
                        Total Paid
                    </span>

                    <strong>
                        ₱@Model.TotalPaid.ToString("N2")
                    </strong>

                </div>

                <div class="ad-financial-row">

                    <span>
                        Outstanding
                    </span>

                    <strong>
                        ₱@Model.OutstandingAmount.ToString("N2")
                    </strong>

                </div>

                <div class="ad-financial-row">

                    <span>
                        Total Billed
                    </span>

                    <strong>
                        ₱@Model.TotalRevenue.ToString("N2")
                    </strong>

                </div>

                <a asp-controller="Billings"
                   asp-action="Index"
                   class="ad-footer-link">
                    View Billing & Payments <svg class="ad-arrow-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>

            </div>

        </div>


        <div class="ad-card">

            <div class="ad-card-head">

                <div class="ad-card-title">

                    <h2>
                        Customer Follow-ups
                    </h2>

                    <p>
                        Customer care queue from the AutoFlow CRM module.
                    </p>

                </div>

                <span class="ad-status ad-status-orange">
                    @Model.FollowUps.Count due
                </span>

            </div>

            <div class="ad-panel-body">

                <div class="ad-follow-list">

                    @if (Model.FollowUps.Any())
                    {
                        @foreach (var followUp in Model.FollowUps.Take(4))
                        {
                            <div class="ad-follow-item">

                                <div class="ad-follow-top">

                                    <strong>
                                        @followUp.CustomerName
                                    </strong>

                                    <span class="ad-status ad-status-purple">
                                        @followUp.Status
                                    </span>

                                </div>

                                <span>
                                    @followUp.VehicleInfo
                                </span>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="ad-empty">
                            No customer follow-ups are currently due.
                        </div>
                    }

                </div>

                <a asp-controller="CustomerFollowUps"
                   asp-action="Index"
                   class="ad-footer-link">
                    View CRM Follow-ups <svg class="ad-arrow-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>

            </div>

        </div>

    </section>


    <!-- Activity and reports -->
    <section class="ad-bottom-grid">

        <div class="ad-card">

            <div class="ad-card-head">

                <div class="ad-card-title">

                    <h2>
                        Recent Record Activity
                    </h2>

                    <p>
                        Latest real updates from appointments, repairs and inventory.
                    </p>

                </div>

                <div class="ad-live">
                    <span class="ad-live-dot"></span>
                    Connected modules
                </div>

            </div>

            <div class="ad-activity-list">

                @if (Model.RecentActivities.Any())
                {
                    @foreach (var activity in Model.RecentActivities)
                    {
                        <div class="ad-activity">

                            <div class="ad-activity-dot"></div>

                            <div>

                                <strong>
                                    @activity.Title
                                </strong>

                                <p>
                                    @activity.Description
                                </p>

                                <span class="ad-activity-module">
                                    @activity.Module
                                </span>

                            </div>

                            <span class="ad-activity-time">
                                @activity.ActivityDate.ToString("MMM dd · hh:mm tt")
                            </span>

                        </div>
                    }
                }
                else
                {
                    <div class="ad-empty">
                        No recent system records available yet.
                    </div>
                }

            </div>

        </div>


        <div class="ad-card">

            <div class="ad-card-head">

                <div class="ad-card-title">

                    <h2>
                        Reporting Snapshot
                    </h2>

                    <p>
                        Database-driven operational indicators.
                    </p>

                </div>

            </div>

            <div class="ad-report-body">

                <div class="ad-trend-title">
                    Appointments — Last 7 Days
                </div>

                <div class="ad-trend">

                    @foreach (var trend in Model.AppointmentTrend)
                    {
                        var height =
                            Math.Max(
                                3,
                                (int)Math.Round(
                                    trend.Count /
                                    (double)maxTrendCount *
                                    75));

                        <div class="ad-trend-item">

                            <span class="ad-trend-count">
                                @trend.Count
                            </span>

                            <div class="ad-trend-bar"
                                 style="height:@(height)px;">
                            </div>

                            <span class="ad-trend-day">
                                @trend.Date.ToString("ddd")
                            </span>

                        </div>
                    }

                </div>

                <div class="ad-record-grid">

                    <div class="ad-record">

                        <span>Customer Records</span>

                        <strong>
                            @Model.TotalCustomerCount
                        </strong>

                    </div>

                    <div class="ad-record">

                        <span>Vehicle Records</span>

                        <strong>
                            @Model.TotalVehicleCount
                        </strong>

                    </div>

                    <div class="ad-record">

                        <span>Parts Inventory</span>

                        <strong>
                            @Model.TotalPartCount
                        </strong>

                    </div>

                    <div class="ad-record">

                        <span>Service Records</span>

                        <strong>
                            @Model.TotalServiceRecordCount
                        </strong>

                    </div>

                </div>

                <div class="ad-mini-grid">

                    <div class="ad-mini-stat">

                        <span>Next 7 Days</span>

                        <strong>
                            @Model.ScheduledThisWeek
                        </strong>

                    </div>

                    <div class="ad-mini-stat">

                        <span>Completed This Month</span>

                        <strong>
                            @Model.CompletedThisMonth
                        </strong>

                    </div>

                </div>

                <a asp-controller="Reports"
                   asp-action="Index"
                   class="ad-footer-link">
                    Open Reports Workspace
                    <svg class="ad-arrow-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                </a>

            </div>

        </div>

    </section>


    <!-- Bay utilization -->
    <section class="ad-card">

        <div class="ad-panel-body"
             style="display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;">

            <div>

                <div class="ad-card-title">

                    <h2>
                        Service Bay Utilization
                    </h2>

                    <p>
                        Current active repair workload against configured shop capacity.
                    </p>

                </div>

            </div>

            <div style="display:flex;align-items:center;gap:16px;">

                <div style="
                    display:grid;
                    place-items:center;
                    width:66px;
                    height:66px;
                    border-radius:50%;
                    background:conic-gradient(#7c3aed @(bayPercent)%, #ede9fe 0);
                ">

                    <div style="
                        display:grid;
                        place-items:center;
                        width:48px;
                        height:48px;
                        border-radius:50%;
                        background:white;
                        color:#172033;
                        font-size:12px;
                        font-weight:850;
                    ">
                        @bayPercent%
                    </div>

                </div>

                <div>

                    <strong style="display:block;color:#172033;font-size:13px;">
                        @Model.ActiveBayCount of @Model.TotalBays bays occupied
                    </strong>

                    <span style="display:block;margin-top:4px;color:#94a3b8;font-size:10px;">
                        Calculated from Open and In Progress repair jobs
                    </span>

                </div>

            </div>

        </div>

    </section>

</div>