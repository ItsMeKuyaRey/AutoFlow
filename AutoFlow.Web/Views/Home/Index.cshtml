@model AutoFlow.Web.ViewModels.DashboardViewModel
@using AutoFlow.Web.ViewModels

@{
    ViewData["Title"] = "Dashboard";

    var today = DateTime.Now;

    var maxTrendCount = Model.AppointmentTrend.Any()
        ? Math.Max(1, Model.AppointmentTrend.Max(x => x.Count))
        : 1;

    var totalPipelineJobs =
        Model.OpenJobCount +
        Model.InProgressJobCount +
        Model.CompletedJobCount;

    var openPercent =
        totalPipelineJobs > 0
            ? (Model.OpenJobCount * 100m / totalPipelineJobs)
            : 0m;

    var progressPercent =
        totalPipelineJobs > 0
            ? (Model.InProgressJobCount * 100m / totalPipelineJobs)
            : 0m;

    var completedPercent =
        totalPipelineJobs > 0
            ? (Model.CompletedJobCount * 100m / totalPipelineJobs)
            : 0m;

    var bayPercent =
        Model.TotalBays > 0
            ? Math.Min(
                100,
                (int)Math.Round(
                    (double)Model.ActiveBayCount /
                    Model.TotalBays *
                    100))
            : 0;
}

<style>
    .admin-dashboard {
        display: flex;
        flex-direction: column;
        gap: 22px;
        padding-bottom: 40px;
    }

    .admin-dashboard *,
    .admin-dashboard *::before,
    .admin-dashboard *::after {
        box-sizing: border-box;
    }

    .admin-dashboard a {
        text-decoration: none;
    }

    .ad-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 24px;
    }

    .ad-heading h1 {
        margin: 0;
        color: #111827;
        font-size: clamp(26px, 3vw, 34px);
        font-weight: 800;
        letter-spacing: -0.04em;
    }

    .ad-heading p {
        margin: 7px 0 0;
        color: #718096;
        font-size: 14px;
    }

    .ad-heading-meta {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 7px;
        min-width: 170px;
    }

    .ad-date {
        color: #475569;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .ad-live {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #64748b;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .ad-live-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #10b981;
        box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.12);
    }

    .ad-top-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 14px;
    }

    .ad-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 40px;
        padding: 0 16px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background: #ffffff;
        color: #475569;
        font-size: 13px;
        font-weight: 700;
        transition: 0.18s ease;
    }

    .ad-button:hover {
        border-color: #c4b5fd;
        color: #6d28d9;
        transform: translateY(-1px);
    }

    .ad-button-primary {
        border-color: #7c3aed;
        background: linear-gradient(135deg, #7c3aed, #8b5cf6);
        color: #ffffff;
        box-shadow: 0 8px 20px rgba(124, 58, 237, 0.18);
    }

    .ad-button-primary:hover {
        color: #ffffff;
        border-color: #6d28d9;
        box-shadow: 0 10px 24px rgba(124, 58, 237, 0.24);
    }

    .ad-quick-actions {
        position: relative;
    }

    .ad-quick-actions summary {
        list-style: none;
        cursor: pointer;
    }

    .ad-quick-actions summary::-webkit-details-marker {
        display: none;
    }

    .ad-quick-menu {
        position: absolute;
        right: 0;
        top: calc(100% + 8px);
        z-index: 30;
        width: 220px;
        padding: 8px;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: #ffffff;
        box-shadow: 0 18px 50px rgba(15, 23, 42, 0.16);
    }

    .ad-quick-menu a {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border-radius: 8px;
        color: #475569;
        font-size: 12px;
        font-weight: 700;
    }

    .ad-quick-menu a:hover {
        background: #f5f3ff;
        color: #6d28d9;
    }

    .ad-kpi-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 14px;
    }

    .ad-kpi {
        position: relative;
        min-height: 146px;
        padding: 18px;
        overflow: hidden;
        border: 1px solid #e7eaf0;
        border-radius: 14px;
        background: #ffffff;
        box-shadow: 0 3px 12px rgba(15, 23, 42, 0.035);
        color: inherit;
        transition: 0.18s ease;
    }

    .ad-kpi:hover {
        border-color: #d8ccff;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.07);
        transform: translateY(-2px);
    }

    .ad-kpi-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .ad-kpi-icon {
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        border-radius: 9px;
        background: #f5f3ff;
        color: #7c3aed;
        font-size: 15px;
        font-weight: 900;
    }

    .ad-kpi-badge {
        padding: 4px 7px;
        border-radius: 999px;
        background: #f5f3ff;
        color: #7c3aed;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: 0.07em;
        text-transform: uppercase;
    }

    .ad-kpi-label {
        margin-top: 17px;
        color: #64748b;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .ad-kpi-value {
        margin-top: 4px;
        color: #111827;
        font-size: 27px;
        font-weight: 850;
        letter-spacing: -0.035em;
    }

    .ad-kpi-note {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 6px;
        color: #94a3b8;
        font-size: 9px;
        font-weight: 650;
    }

    .ad-note-positive {
        color: #10b981;
    }

    .ad-note-danger {
        color: #ef4444;
    }

    .ad-card {
        border: 1px solid #e7eaf0;
        border-radius: 15px;
        background: #ffffff;
        box-shadow: 0 3px 14px rgba(15, 23, 42, 0.035);
    }

    .ad-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 18px 20px;
        border-bottom: 1px solid #f0f2f5;
    }

    .ad-card-title h2 {
        margin: 0;
        color: #172033;
        font-size: 15px;
        font-weight: 800;
    }

    .ad-card-title p {
        margin: 4px 0 0;
        color: #94a3b8;
        font-size: 10px;
    }

    .ad-link {
        color: #7c3aed;
        font-size: 10px;
        font-weight: 800;
    }

    .ad-link:hover {
        color: #5b21b6;
    }

    .ad-workflow {
        padding: 22px 20px 24px;
    }

    .ad-workflow-grid {
        display: grid;
        grid-template-columns: repeat(8, minmax(92px, 1fr));
        align-items: stretch;
        gap: 8px;
    }

    .ad-flow-node {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: 0;
        padding: 8px 4px;
        color: #334155;
        text-align: center;
    }

    .ad-flow-node:not(:last-child)::after {
        content: "";
        position: absolute;
        top: 27px;
        left: calc(50% + 25px);
        width: calc(100% - 42px);
        height: 1px;
        background: #ddd6fe;
    }

    .ad-flow-icon {
        position: relative;
        z-index: 2;
        display: grid;
        place-items: center;
        width: 42px;
        height: 42px;
        border: 1px solid #e5e7eb;
        border-radius: 11px;
        background: #ffffff;
        color: #64748b;
        font-size: 16px;
        transition: 0.18s ease;
    }

    a.ad-flow-node:hover .ad-flow-icon {
        border-color: #a78bfa;
        background: #7c3aed;
        color: #ffffff;
        transform: translateY(-2px);
    }

    .ad-flow-count {
        margin-top: 9px;
        color: #0f172a;
        font-size: 11px;
        font-weight: 850;
    }

    .ad-flow-label {
        margin-top: 3px;
        color: #94a3b8;
        font-size: 7px;
        font-weight: 850;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .ad-flow-action {
        margin-top: 11px;
        color: #334155;
        font-size: 10px;
        font-weight: 700;
    }

    .ad-flow-disabled {
        opacity: 0.58;
    }

    .ad-flow-disabled .ad-flow-action {
        color: #94a3b8;
    }

    .ad-two-column {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(340px, 0.9fr);
        gap: 16px;
    }

    .ad-appointments-table {
        width: 100%;
        border-collapse: collapse;
    }

    .ad-appointments-table th {
        padding: 11px 18px;
        border-bottom: 1px solid #eef1f5;
        color: #94a3b8;
        font-size: 8px;
        font-weight: 850;
        letter-spacing: 0.08em;
        text-align: left;
        text-transform: uppercase;
    }

    .ad-appointments-table td {
        padding: 13px 18px;
        border-bottom: 1px solid #f2f4f7;
        color: #475569;
        font-size: 11px;
        vertical-align: middle;
    }

    .ad-appointments-table tr:last-child td {
        border-bottom: 0;
    }

    .ad-customer-name {
        color: #111827;
        font-weight: 800;
    }

    .ad-subtext {
        display: block;
        margin-top: 2px;
        color: #94a3b8;
        font-size: 9px;
    }

    .ad-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 4px 8px;
        border-radius: 999px;
        font-size: 8px;
        font-weight: 850;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .ad-status-blue {
        background: #eff6ff;
        color: #2563eb;
    }

    .ad-status-green {
        background: #ecfdf5;
        color: #059669;
    }

    .ad-status-orange {
        background: #fff7ed;
        color: #ea580c;
    }

    .ad-status-red {
        background: #fef2f2;
        color: #dc2626;
    }

    .ad-status-purple {
        background: #f5f3ff;
        color: #7c3aed;
    }

    .ad-empty {
        padding: 32px 20px;
        color: #94a3b8;
        font-size: 11px;
        text-align: center;
    }

    .ad-job-body {
        padding: 18px 20px 20px;
    }

    .ad-pipeline-header {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 10px;
        color: #94a3b8;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .ad-pipeline {
        display: flex;
        height: 7px;
        overflow: hidden;
        border-radius: 999px;
        background: #f1f5f9;
    }

    .ad-pipeline-open {
        background: #94a3b8;
    }

    .ad-pipeline-progress {
        background: #3b82f6;
    }

    .ad-pipeline-completed {
        background: #10b981;
    }

    .ad-pipeline-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 10px;
        color: #64748b;
        font-size: 9px;
        font-weight: 700;
    }

    .ad-dot {
        display: inline-block;
        width: 6px;
        height: 6px;
        margin-right: 4px;
        border-radius: 50%;
    }

    .ad-job-list {
        display: flex;
        flex-direction: column;
        gap: 9px;
        margin-top: 18px;
    }

    .ad-job-row {
        display: grid;
        grid-template-columns: 46px minmax(0, 1fr) auto;
        align-items: center;
        gap: 11px;
        padding: 10px;
        border: 1px solid #edf0f4;
        border-radius: 10px;
        background: #fafbfc;
        color: inherit;
        transition: 0.18s ease;
    }

    .ad-job-row:hover {
        border-color: #d8ccff;
        background: #ffffff;
        transform: translateX(2px);
    }

    .ad-job-id {
        padding: 6px 4px;
        border-radius: 7px;
        background: #ffffff;
        color: #64748b;
        font-size: 8px;
        font-weight: 850;
        text-align: center;
    }

    .ad-job-name {
        color: #172033;
        font-size: 10px;
        font-weight: 800;
    }

    .ad-job-description {
        display: block;
        margin-top: 2px;
        overflow: hidden;
        color: #94a3b8;
        font-size: 9px;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .ad-three-column {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
    }

    .ad-panel-body {
        padding: 18px 20px 20px;
    }

    .ad-inventory-value {
        padding: 18px;
        border-radius: 12px;
        background: linear-gradient(135deg, #8b5cf6, #7c3aed);
        color: #ffffff;
        box-shadow: 0 12px 28px rgba(124, 58, 237, 0.18);
    }

    .ad-inventory-value span {
        display: block;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: 0.09em;
        opacity: 0.8;
        text-transform: uppercase;
    }

    .ad-inventory-value strong {
        display: block;
        margin-top: 7px;
        font-size: 23px;
        font-weight: 850;
    }

    .ad-mini-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        margin-top: 12px;
    }

    .ad-mini-stat {
        padding: 12px;
        border: 1px solid #edf0f4;
        border-radius: 10px;
        background: #fafbfc;
    }

    .ad-mini-stat span {
        display: block;
        color: #94a3b8;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .ad-mini-stat strong {
        display: block;
        margin-top: 5px;
        color: #172033;
        font-size: 18px;
        font-weight: 850;
    }

    .ad-billing-ring {
        display: grid;
        place-items: center;
        width: 116px;
        height: 116px;
        margin: 4px auto 18px;
        border-radius: 50%;
        background:
            conic-gradient(
                #10b981 calc(@Model.CollectionRate * 1%),
                #f59e0b 0
            );
    }

    .ad-billing-ring-inner {
        display: grid;
        place-items: center;
        width: 78px;
        height: 78px;
        border-radius: 50%;
        background: #ffffff;
        text-align: center;
    }

    .ad-billing-ring-inner strong {
        color: #172033;
        font-size: 18px;
        font-weight: 850;
    }

    .ad-billing-ring-inner span {
        color: #94a3b8;
        font-size: 7px;
        font-weight: 800;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .ad-financial-row {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        padding: 10px 0;
        border-top: 1px solid #eef1f5;
        color: #64748b;
        font-size: 10px;
    }

    .ad-financial-row strong {
        color: #172033;
    }

    .ad-follow-list {
        display: flex;
        flex-direction: column;
        gap: 9px;
    }

    .ad-follow-item {
        padding: 11px;
        border: 1px solid #eee9ff;
        border-left: 3px solid #8b5cf6;
        border-radius: 9px;
        background: #fcfbff;
    }

    .ad-follow-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .ad-follow-item strong {
        color: #172033;
        font-size: 10px;
    }

    .ad-follow-item span {
        display: block;
        margin-top: 3px;
        color: #94a3b8;
        font-size: 9px;
    }

    .ad-bottom-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) minmax(310px, 0.6fr);
        gap: 16px;
    }

    .ad-activity-list {
        position: relative;
        padding: 18px 20px 22px;
    }

    .ad-activity-list::before {
        content: "";
        position: absolute;
        top: 27px;
        bottom: 28px;
        left: 29px;
        width: 1px;
        background: #ebe7ff;
    }

    .ad-activity {
        position: relative;
        display: grid;
        grid-template-columns: 20px minmax(0, 1fr) auto;
        gap: 11px;
        padding: 9px 0;
    }

    .ad-activity-dot {
        position: relative;
        z-index: 2;
        width: 12px;
        height: 12px;
        margin-top: 3px;
        border: 3px solid #ffffff;
        border-radius: 50%;
        background: #8b5cf6;
        box-shadow: 0 0 0 1px #ddd6fe;
    }

    .ad-activity strong {
        display: block;
        color: #172033;
        font-size: 10px;
    }

    .ad-activity p {
        margin: 3px 0 0;
        color: #64748b;
        font-size: 9px;
    }

    .ad-activity-module {
        display: inline-flex;
        margin-top: 6px;
        padding: 3px 6px;
        border-radius: 5px;
        background: #f5f3ff;
        color: #7c3aed;
        font-size: 7px;
        font-weight: 850;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .ad-activity-time {
        color: #94a3b8;
        font-size: 8px;
        white-space: nowrap;
    }

    .ad-report-body {
        padding: 18px 20px 20px;
    }

    .ad-trend-title {
        color: #94a3b8;
        font-size: 8px;
        font-weight: 850;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .ad-trend {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 6px;
        height: 110px;
        margin-top: 14px;
        padding-top: 8px;
        border-bottom: 1px solid #eef1f5;
    }

    .ad-trend-item {
        display: flex;
        flex: 1;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
        height: 100%;
        gap: 5px;
    }

    .ad-trend-count {
        color: #64748b;
        font-size: 7px;
        font-weight: 700;
    }

    .ad-trend-bar {
        width: min(18px, 70%);
        min-height: 3px;
        border-radius: 5px 5px 0 0;
        background: linear-gradient(180deg, #8b5cf6, #7c3aed);
    }

    .ad-trend-day {
        color: #94a3b8;
        font-size: 7px;
        font-weight: 700;
    }

    .ad-record-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
        margin-top: 18px;
    }

    .ad-record {
        padding: 10px;
        border: 1px solid #edf0f4;
        border-radius: 9px;
        background: #fafbfc;
    }

    .ad-record span {
        display: block;
        color: #94a3b8;
        font-size: 7px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .ad-record strong {
        display: block;
        margin-top: 4px;
        color: #172033;
        font-size: 15px;
        font-weight: 850;
    }

    .ad-footer-link {
        display: block;
        margin-top: 16px;
        color: #7c3aed;
        font-size: 9px;
        font-weight: 850;
        text-align: center;
        text-transform: uppercase;
    }

    @@media (max-width: 1280px) {
        .ad-kpi-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .ad-workflow-grid {
            grid-template-columns: repeat(4, minmax(120px, 1fr));
        }

        .ad-flow-node:nth-child(4)::after {
            display: none;
        }
    }

    @@media (max-width: 980px) {
        .ad-two-column,
        .ad-three-column,
        .ad-bottom-grid {
            grid-template-columns: 1fr;
        }

        .ad-kpi-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 680px) {
        .ad-header {
            flex-direction: column;
        }

        .ad-heading-meta {
            align-items: flex-start;
        }

        .ad-top-actions {
            flex-wrap: wrap;
        }

        .ad-kpi-grid {
            grid-template-columns: 1fr;
        }

        .ad-workflow-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .ad-flow-node::after {
            display: none !important;
        }

        .ad-card-head {
            align-items: flex-start;
            flex-direction: column;
        }

        .ad-appointments-table {
            min-width: 650px;
        }

        .ad-table-scroll {
            overflow-x: auto;
        }
    }

    /* Premium Dashboard 2026 — scoped to Home/Index only */
    .admin-dashboard {
        gap: 20px;
        max-width: 1560px;
        margin: 0 auto;
    }

    .ad-hero {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1.02fr) minmax(520px, .98fr);
        min-height: 310px;
        overflow: hidden;
        border: 1px solid rgba(226, 232, 240, .95);
        border-radius: 22px;
        background:
            radial-gradient(circle at 0% 0%, rgba(124, 58, 237, .12), transparent 42%),
            linear-gradient(135deg, #ffffff 0%, #fbfbff 48%, #f5f3ff 100%);
        box-shadow:
