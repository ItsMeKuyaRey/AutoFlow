            </div>

            <div class="ad-report-body">

                <div class="ad-trend-title">
                    Appointments — Last 7 Days
                </div>

                <div class="ad-trend">

                    @foreach (var trend in Model.AppointmentTrend)
                    {
                        var height =
                            Math.Max(
                                3,
                                (int)Math.Round(
                                    trend.Count /
                                    (double)maxTrendCount *
                                    75));

                        <div class="ad-trend-item">

                            <span class="ad-trend-count">
                                @trend.Count
                            </span>

                            <div class="ad-trend-bar"
                                 style="height:@(height)px;">
                            </div>

                            <span class="ad-trend-day">
                                @trend.Date.ToString("ddd")
                            </span>

                        </div>
                    }

                </div>

                <div class="ad-record-grid">

                    <div class="ad-record">

                        <span>Customer Records</span>

