@model AutoFlow.Web.ViewModels.DashboardViewModel
@using AutoFlow.Web.ViewModels

@{
    ViewData["Title"] = "Dashboard";

    var today = DateTime.Now;

    var maxTrendCount = Model.AppointmentTrend.Any()
        ? Math.Max(1, Model.AppointmentTrend.Max(x => x.Count))
        : 1;

    var totalPipelineJobs =
        Model.OpenJobCount +
        Model.InProgressJobCount +
        Model.CompletedJobCount;

    var openPercent =
        totalPipelineJobs > 0
            ? (Model.OpenJobCount * 100m / totalPipelineJobs)
            : 0m;

    var progressPercent =
        totalPipelineJobs > 0
            ? (Model.InProgressJobCount * 100m / totalPipelineJobs)
            : 0m;

    var completedPercent =
        totalPipelineJobs > 0
            ? (Model.CompletedJobCount * 100m / totalPipelineJobs)
            : 0m;

    var bayPercent =
        Model.TotalBays > 0
            ? Math.Min(
                100,
                (int)Math.Round(
                    (double)Model.ActiveBayCount /
                    Model.TotalBays *
                    100))
            : 0;
}

