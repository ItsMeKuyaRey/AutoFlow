@model AutoFlow.Web.Models.Appointment

@{
    ViewData["Title"] = "Appointment Details";
    var customerName = Model.Customer == null
        ? "—"
        : $"{Model.Customer.FirstName} {Model.Customer.LastName}".Trim();
    var vehicleTitle = Model.Vehicle == null
        ? "—"
        : $"{Model.Vehicle.Make} {Model.Vehicle.Model}".Trim()
          + (string.IsNullOrWhiteSpace(Model.Vehicle.PlateNumber) ? "" : $" ({Model.Vehicle.PlateNumber})");
    var vehicleSub = Model.Vehicle == null
        ? ""
        : string.Join(" · ", new[] {
            Model.Vehicle.Color,
            Model.Vehicle.Year?.ToString() is string y && !string.IsNullOrEmpty(y) ? y + " Model" : null
          }.Where(x => !string.IsNullOrWhiteSpace(x)));
    var status = Model.Status ?? "Scheduled";
    var statusKey = status.ToLowerInvariant().Replace(" ", "-");

    var customerInitials = Model.Customer == null
        ? "?"
        : string.Concat(
            new[] { Model.Customer.FirstName, Model.Customer.LastName }
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Select(x => x!.Trim()[0]))
            .ToUpperInvariant();

    var vehicleInitials = Model.Vehicle == null
        ? "V"
        : string.Concat(
            new[] { Model.Vehicle.Make, Model.Vehicle.Model }
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Select(x => x!.Trim()[0]))
            .ToUpperInvariant();

    // Keep a visual image in every appointment profile slot even when the
    // linked Customer/Vehicle record has no uploaded ImageUrl yet.
    var customerFallbackSvg = $"data:image/svg+xml;utf8,{Uri.EscapeDataString($"<svg xmlns='http://www.w3.org/2000/svg' width='88' height='88' viewBox='0 0 88 88'><rect width='88' height='88' rx='18' fill='#ede9fe'/><circle cx='44' cy='34' r='13' fill='none' stroke='#6d28d9' stroke-width='5'/><path d='M20 70c3-13 12-20 24-20s21 7 24 20' fill='none' stroke='#6d28d9' stroke-width='5' stroke-linecap='round'/></svg>")}";
    var vehicleFallbackSvg = $"data:image/svg+xml;utf8,{Uri.EscapeDataString($"<svg xmlns='http://www.w3.org/2000/svg' width='88' height='88' viewBox='0 0 88 88'><rect width='88' height='88' rx='18' fill='#ede9fe'/><path d='M18 50l7-19c1-4 4-6 8-6h22c4 0 7 2 8 6l7 19v13H18z' fill='none' stroke='#6d28d9' stroke-width='5' stroke-linejoin='round'/><circle cx='29' cy='64' r='5' fill='#6d28d9'/><circle cx='59' cy='64' r='5' fill='#6d28d9'/><path d='M26 45h36' stroke='#6d28d9' stroke-width='5' stroke-linecap='round'/></svg>")}";
}

<style>
.af-drawer-page{position:fixed;inset:0;z-index:10000;display:flex;justify-content:flex-end}
.af-drawer-backdrop{position:absolute;inset:0;background:rgba(15,23,42,.40);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px)}
.af-drawer{
    position:relative;width:min(480px,100vw);height:100%;
    background:#ffffff;box-shadow:-20px 0 50px rgba(15,23,42,.18);
    display:flex;flex-direction:column;
    animation:afDrawerSlide .24s cubic-bezier(.22,1,.36,1);
}
@@keyframes afDrawerSlide{from{transform:translateX(100%);opacity:.6}to{transform:translateX(0);opacity:1}}
.af-drawer-head{
    display:flex;align-items:flex-start;justify-content:space-between;
    padding:28px 28px 20px;border-bottom:1px solid #eef0f4;flex-shrink:0;
}
.af-drawer-head h2{margin:0;font-size:22px;font-weight:700;color:#0f172a;letter-spacing:-.03em}
.af-drawer-head p{margin:6px 0 0;font-size:13px;color:#64748b;font-weight:500}
.af-drawer-x{
    width:36px;height:36px;border:none;border-radius:10px;
    background:#f1f5f9;color:#475569;font-size:20px;line-height:1;cursor:pointer;
    display:grid;place-items:center;
}
.af-drawer-x:hover{background:#e2e8f0;color:#0f172a}
.af-drawer-body{flex:1;overflow-y:auto;padding:24px 28px}
.af-profile-link{
    display:flex;align-items:center;gap:14px;position:relative;
    padding:14px;margin-bottom:12px;
    border:1px solid #ede9fe;border-radius:14px;
    background:linear-gradient(135deg,#faf8ff,#f5f3ff);
    color:inherit;text-decoration:none;
    transition:border-color .15s,box-shadow .15s,transform .12s;
}
.af-profile-link:hover{
    border-color:#c4b5fd;box-shadow:0 8px 22px rgba(124,58,237,.10);
    transform:translateY(-1px);
}
.af-profile-avatar{
    width:48px !important;height:48px !important;min-width:48px !important;min-height:48px !important;
    max-width:48px !important;max-height:48px !important;flex:0 0 48px !important;
    border-radius:10px;overflow:hidden;
    display:flex;align-items:center;justify-content:center;
    background:#f1f3f6;color:#6d28d9;
    font-size:15px;font-weight:800;letter-spacing:.02em;
    border:1px solid #e8ebf0;
    aspect-ratio:1 / 1 !important;
    box-sizing:border-box;
}
.af-profile-avatar.customer-avatar{
    border-radius:50%;
    border-color:#e4ddfb;
    background:#ede9fe;
}
.af-profile-avatar.vehicle-avatar{
    border-radius:10px;
    background:#f1f3f6;
}
.af-profile-avatar img{
    display:block !important;width:100% !important;height:100% !important;
    min-width:100% !important;min-height:100% !important;
    max-width:none !important;max-height:none !important;
    object-fit:cover !important;object-position:center center !important;
    background:#fff;
}
.af-profile-avatar.customer-avatar img,
.af-profile-avatar.vehicle-avatar img{
    width:100% !important;height:100% !important;
    object-fit:cover !important;object-position:center center !important;
}
.af-profile-meta{min-width:0;flex:1}
.af-profile-meta .af-detail-v{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.af-profile-meta .af-detail-s{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.af-detail-k{
    font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;
    color:#94a3b8;margin-bottom:4px;
}
.af-detail-v{font-size:15px;font-weight:700;color:#0f172a;line-height:1.35}
.af-detail-s{font-size:12px;color:#64748b;margin-top:3px;font-weight:500}
.af-detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}
.af-detail-box{
    padding:14px 16px;border:1px solid #eef0f4;border-radius:14px;background:#fff;
}
.af-detail-block{
    padding:16px;margin-bottom:12px;
    border:1px solid #eef0f4;border-radius:14px;background:#fff;
}
.af-detail-note{
    font-size:13px;color:#334155;line-height:1.55;font-weight:500;
    white-space:pre-wrap;
}
.af-status-badge{
    display:inline-flex;align-items:center;gap:7px;
    height:32px;padding:0 14px;border-radius:999px;
    font-size:12px;font-weight:800;letter-spacing:.02em;
}
.af-status-badge::before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor}
.af-status-badge.scheduled{background:#f5f3ff;color:#6d28d9}
.af-status-badge.confirmed{background:#ecfdf5;color:#047857}
.af-status-badge.completed{background:#eff6ff;color:#1d4ed8}
.af-status-badge.in-progress{background:#fff7ed;color:#c2410c}
.af-status-badge.cancelled{background:#fef2f2;color:#b91c1c}
.af-drawer-foot{
    flex-shrink:0;display:flex;justify-content:flex-end;gap:10px;
    padding:16px 28px 24px;border-top:1px solid #eef0f4;background:#fff;
}
.af-btn{
    height:44px;padding:0 20px;border-radius:12px;
    font-size:13px;font-weight:700;cursor:pointer;border:none;
    display:inline-flex;align-items:center;gap:8px;
    text-decoration:none;transition:transform .12s,background .15s;
}
.af-btn-ghost{background:#fff;color:#475569;border:1.5px solid #e2e8f0}
.af-btn-ghost:hover{background:#f8fafc}
.af-btn-dark{background:#0f172a;color:#fff;box-shadow:0 8px 18px rgba(15,23,42,.18)}
.af-btn-dark:hover{background:#1e293b;transform:translateY(-1px);color:#fff}
.af-btn svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
@@media(max-width:560px){.af-drawer{width:100%}.af-detail-grid{grid-template-columns:1fr}}
</style>

<div class="af-drawer-page appointment-details-page">
    <div class="af-drawer-backdrop appointment-details-backdrop" data-appointment-close></div>

    <section class="af-drawer appointment-details-drawer" role="dialog" aria-modal="true">
        <div class="af-drawer-head">
            <div>
                <h2>Appointment Details</h2>
                <p>Review the scheduled service appointment.</p>
            </div>
            <button type="button" class="af-drawer-x" data-appointment-close aria-label="Close">&times;</button>
        </div>

        <div class="af-drawer-body">
            @if (Model.Customer != null)
            {
                <a asp-controller="Customers"
                   asp-action="Details"
                   asp-route-id="@Model.Customer.CustomerId"
                   class="af-profile-link"
                   aria-label="View customer profile for @customerName">
                    <div class="af-profile-avatar customer-avatar">
                        <img src="@(string.IsNullOrWhiteSpace(Model.Customer.ImageUrl) ? customerFallbackSvg : Model.Customer.ImageUrl)"
                             alt="@customerName"
                             onerror="this.onerror=null;this.src='@customerFallbackSvg'" />
                    </div>
                    <div class="af-profile-meta">
                        <div class="af-detail-k">Customer Profile</div>
                        <div class="af-detail-v">@customerName</div>
                        <div class="af-detail-s">Customer ID #@Model.Customer.CustomerId · @(string.IsNullOrWhiteSpace(Model.Customer.Phone) ? "No phone" : Model.Customer.Phone)</div>
                    </div>
                </a>
            }
            else
            {
                <div class="af-profile-link" aria-disabled="true">
                    <div class="af-profile-avatar">?</div>
                    <div class="af-profile-meta">
                        <div class="af-detail-k">Customer Profile</div>
                        <div class="af-detail-v">Customer not available</div>
                    </div>
                </div>
            }

            @if (Model.Vehicle != null)
            {
                <a asp-controller="Vehicles"
                   asp-action="Details"
                   asp-route-id="@Model.Vehicle.VehicleId"
                   class="af-profile-link"
                   aria-label="View vehicle profile for @vehicleTitle">
                    <div class="af-profile-avatar vehicle-avatar">
                        <img src="@(string.IsNullOrWhiteSpace(Model.Vehicle.ImageUrl) ? vehicleFallbackSvg : Model.Vehicle.ImageUrl)"
                             alt="@vehicleTitle"
                             onerror="this.onerror=null;this.src='@vehicleFallbackSvg'" />
                    </div>
                    <div class="af-profile-meta">
                        <div class="af-detail-k">Vehicle Profile</div>
                        <div class="af-detail-v">@vehicleTitle</div>
                        <div class="af-detail-s">Vehicle ID #@Model.Vehicle.VehicleId · @(string.IsNullOrWhiteSpace(vehicleSub) ? (string.IsNullOrWhiteSpace(Model.Vehicle.VIN) ? "No VIN" : Model.Vehicle.VIN) : vehicleSub)</div>
                    </div>
                </a>
            }
            else
            {
                <div class="af-profile-link" aria-disabled="true">
                    <div class="af-profile-avatar">V</div>
                    <div class="af-profile-meta">
                        <div class="af-detail-k">Vehicle Profile</div>
                        <div class="af-detail-v">Vehicle not available</div>
                    </div>
                </div>
            }

            <div class="af-detail-grid">
                <div class="af-detail-box">
                    <div class="af-detail-k">Scheduled Date</div>
                    <div class="af-detail-v" style="font-size:14px">@Model.AppointmentDate.ToString("MMMM d, yyyy")</div>
                </div>
                <div class="af-detail-box">
                    <div class="af-detail-k">Scheduled Time</div>
                    <div class="af-detail-v" style="font-size:14px">@Model.AppointmentDate.ToString("h:mm tt")</div>
                </div>
            </div>

            <div class="af-detail-block">
                <div class="af-detail-k">Service Reason</div>
                <div class="af-detail-note">@(string.IsNullOrWhiteSpace(Model.Reason) ? "—" : Model.Reason)</div>
            </div>

            <div class="af-detail-block">
                <div class="af-detail-k">Notes</div>
                <div class="af-detail-note">@(string.IsNullOrWhiteSpace(Model.Notes) ? "—" : Model.Notes)</div>
            </div>

            <div class="af-detail-block">
                <div class="af-detail-k">Current Status</div>
                <div style="margin-top:8px">
                    <span class="af-status-badge @statusKey">@status</span>
                </div>
            </div>
        </div>

        <div class="af-drawer-foot">
            <button type="button" class="af-btn af-btn-ghost" data-appointment-close>Close</button>
            <a asp-action="Edit" asp-route-id="@Model.AppointmentId" class="af-btn af-btn-dark">
                <svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                Edit Appointment
            </a>
        </div>
    </section>
</div>
