@model AutoFlow.Web.Models.Appointment

@{
    ViewData["Title"] = "Delete Appointment";
}

<div class="page-header">
    <div>
        <h1>Delete Appointment</h1>
        <p>Are you sure you want to delete this appointment?</p>
    </div>
</div>

<div class="af-card" style="max-width: 620px; padding: 28px;">
    <div class="alert alert-warning mb-4">
        This action cannot be undone.
    </div>

    <dl class="row mb-4">
        <dt class="col-sm-4 text-muted">Date</dt>
        <dd class="col-sm-8 fw-semibold">@Model.AppointmentDate.ToString("MMM dd, yyyy hh:mm tt")</dd>

        <dt class="col-sm-4 text-muted">Vehicle</dt>
        <dd class="col-sm-8">
            @if (Model.Vehicle != null)
            {
                @($"{Model.Vehicle.PlateNumber} — {Model.Vehicle.Make} {Model.Vehicle.Model}")
            }
            else
            {
                <span>—</span>
            }
        </dd>

        <dt class="col-sm-4 text-muted">Status</dt>
        <dd class="col-sm-8">@Model.Status</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="AppointmentId" />
        <div class="d-flex gap-2">
            <button type="submit" class="af-button" style="background:#dc2626; color:white;">Delete Appointment</button>
            <a asp-action="Index" class="af-button af-button-secondary">Cancel</a>
        </div>
    </form>
</div>