@model AutoFlow.Web.Models.ServiceRecord

@{
    ViewData["Title"] = "Delete Service Record";

    var vehicleName = Model.Vehicle == null
        ? "Vehicle unavailable"
        : $"{Model.Vehicle.Make} {Model.Vehicle.Model}";
}

<style>
    .af-page {
        max-width: 850px;
        margin: 0 auto;
    }

    .af-breadcrumb {
        font-size: 13px;
        color: #8a94a6;
        margin-bottom: 8px;
    }

    .af-breadcrumb a {
        color: #6f42c1;
        text-decoration: none;
        font-weight: 600;
    }

    .af-card {
        background: #fff;
        border: 1px solid #e9edf3;
        border-radius: 16px;
        box-shadow: 0 8px 28px rgba(31, 41, 55, 0.06);
        overflow: hidden;
    }

    .af-warning {
        background: #fff7ed;
        border-bottom: 1px solid #fed7aa;
        padding: 22px 26px;
        display: flex;
        gap: 14px;
        align-items: flex-start;
    }

    .af-warning-icon {
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        border-radius: 12px;
        background: #ffedd5;
        color: #ea580c;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .af-warning h1 {
        margin: 0;
        font-size: 20px;
        font-weight: 800;
        color: #7c2d12;
    }

    .af-warning p {
        margin: 5px 0 0;
        color: #9a5a35;
        font-size: 13px;
        line-height: 1.55;
    }

    .af-body {
        padding: 28px 26px;
    }

    .af-record {
        border: 1px solid #e9edf3;
        border-radius: 13px;
        padding: 20px;
    }

    .af-title {
        font-size: 20px;
        font-weight: 800;
        color: #202b3c;
        margin-bottom: 4px;
    }

    .af-id {
        color: #8a94a6;
        font-size: 12px;
    }

    .af-info {
        margin-top: 22px;
    }

    .af-label {
        color: #9aa3b2;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .07em;
        margin-bottom: 5px;
    }

    .af-value {
        color: #394458;
        font-size: 14px;
        font-weight: 650;
    }

    .af-danger-note {
        background: #fff4f4;
        border: 1px solid #f5d4d4;
        border-radius: 10px;
        padding: 13px 15px;
        color: #a94442;
        font-size: 13px;
        line-height: 1.5;
        margin-top: 20px;
    }

    .af-actions {
        border-top: 1px solid #edf0f4;
        padding: 20px 26px;
        display: flex;
        justify-content: space-between;
        gap: 12px;
    }

    .af-btn {
        border-radius: 9px;
        padding: 10px 17px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        border: 1px solid transparent;
    }

    .af-btn-secondary {
        background: #fff;
        border-color: #dfe4eb;
        color: #596579;
    }

    .af-btn-danger {
        background: #dc3545;
        color: #fff;
        border-color: #dc3545;
    }

    .af-btn-danger:hover {
        background: #bb2d3b;
        color: #fff;
    }
</style>

<div class="container-fluid py-4">
    <div class="af-page">

        <div class="af-breadcrumb">
            <a asp-action="Index">Service History</a>
            <span> / Delete Record</span>
        </div>

        <div class="af-card">

            <div class="af-warning">

                <div class="af-warning-icon">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>

                <div>
                    <h1>Delete Service Record?</h1>

                    <p>
                        This action will permanently remove this service
                        history record from AutoFlow.
                    </p>
                </div>

            </div>

            <div class="af-body">

                <div class="af-record">

                    <div class="af-title">
                        @vehicleName
                    </div>

                    <div class="af-id">
                        Service Record #@Model.ServiceRecordId
                    </div>

                    <div class="row g-4 af-info">

                        <div class="col-md-6">
                            <div class="af-label">Plate Number</div>
                            <div class="af-value">
                                @(Model.Vehicle?.PlateNumber ?? "Unavailable")
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="af-label">Service Date</div>
                            <div class="af-value">
                                @Model.ServiceDate.ToString("MMM dd, yyyy • hh:mm tt")
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="af-label">Mileage</div>
                            <div class="af-value">
                                @(Model.Mileage.HasValue
                                    ? $"{Model.Mileage.Value:N0} km"
                                    : "—")
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="af-label">Status</div>
                            <div class="af-value">
                                @(string.IsNullOrWhiteSpace(Model.Status)
                                    ? "Unknown"
                                    : Model.Status)
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="af-label">Complaint</div>
                            <div class="af-value">
                                @(string.IsNullOrWhiteSpace(Model.Complaint)
                                    ? "No complaint recorded."
                                    : Model.Complaint)
                            </div>
                        </div>

                    </div>

                </div>

                <div class="af-danger-note">
                    <i class="bi bi-exclamation-circle me-1"></i>
                    Deleting a service history record removes this historical
                    entry from the system. Make sure this record is no longer
                    required before continuing.
                </div>

            </div>

            <div class="af-actions">

                <a asp-action="Index"
                   class="af-btn af-btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>
                    Cancel
                </a>

                <form asp-action="Delete"
                      method="post"
                      class="m-0">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           asp-for="ServiceRecordId" />

                    <button type="submit"
                            class="af-btn af-btn-danger">
                        <i class="bi bi-trash3 me-1"></i>
                        Delete Record
                    </button>

                </form>

            </div>

        </div>

    </div>
</div>