@model AutoFlow.Web.Models.ServiceRecord

@{
    ViewData["Title"] = "Service Record Details";

    var status = Model.Status ?? "Unknown";

    var statusClass =
        status.Equals("Completed", StringComparison.OrdinalIgnoreCase)
            ? "completed"
            : status.Equals("In Progress", StringComparison.OrdinalIgnoreCase)
                ? "progress"
                : status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase)
                    ? "cancelled"
                    : "default";

    var vehicleName = Model.Vehicle == null
        ? "Vehicle unavailable"
        : $"{Model.Vehicle.Make} {Model.Vehicle.Model}";
}

<style>
    .af-page {
        max-width: 1180px;
        margin: 0 auto;
    }

    .af-breadcrumb {
        font-size: 13px;
        color: #8a94a6;
        margin-bottom: 8px;
    }

    .af-breadcrumb a {
        color: #6f42c1;
        text-decoration: none;
        font-weight: 600;
    }

    .af-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 26px;
    }

    .af-title {
        font-size: 28px;
        font-weight: 800;
        color: #182235;
        margin: 0;
    }

    .af-subtitle {
        margin: 7px 0 0;
        color: #7c8798;
        font-size: 14px;
    }

    .af-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 13px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 800;
    }

    .af-status.completed {
        background: #eaf8ef;
        color: #20804a;
    }

    .af-status.progress {
        background: #f1eafe;
        color: #6f42c1;
    }

    .af-status.cancelled {
        background: #fff0f0;
        color: #b42318;
    }

    .af-status.default {
        background: #f2f4f7;
        color: #687386;
    }

    .af-card {
        background: #fff;
        border: 1px solid #e9edf3;
        border-radius: 16px;
        box-shadow: 0 8px 28px rgba(31, 41, 55, 0.06);
        overflow: hidden;
        margin-bottom: 20px;
    }

    .af-card-header {
        padding: 22px 26px;
        border-bottom: 1px solid #edf0f4;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .af-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: #f1eafe;
        color: #6f42c1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
    }

    .af-card-title {
        margin: 0;
        font-size: 17px;
        font-weight: 750;
        color: #202b3c;
    }

    .af-card-description {
        margin: 3px 0 0;
        color: #8a94a6;
        font-size: 13px;
    }

    .af-body {
        padding: 26px;
    }

    .af-info-item {
        min-height: 68px;
    }

    .af-label {
        font-size: 11px;
        font-weight: 800;
        color: #9aa3b2;
        text-transform: uppercase;
        letter-spacing: .06em;
        margin-bottom: 5px;
    }

    .af-value {
        color: #293447;
        font-size: 14px;
        font-weight: 650;
    }

    .af-vehicle {
        background: #faf9ff;
        border: 1px solid #eee9fa;
        border-radius: 12px;
        padding: 18px;
    }

    .af-vehicle-name {
        font-size: 18px;
        font-weight: 800;
        color: #252f40;
    }

    .af-plate {
        display: inline-block;
        margin-top: 7px;
        padding: 5px 9px;
        border-radius: 6px;
        background: #fff;
        border: 1px solid #ddd8ed;
        color: #6f42c1;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .04em;
    }

    .af-text {
        background: #fafbfc;
        border: 1px solid #edf0f4;
        border-radius: 11px;
        padding: 17px;
        color: #596579;
        font-size: 14px;
        line-height: 1.65;
        min-height: 80px;
        white-space: pre-wrap;
    }

    .af-actions {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-top: 22px;
    }

    .af-btn {
        border-radius: 9px;
        padding: 10px 17px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        border: 1px solid transparent;
    }

    .af-btn-secondary {
        background: #fff;
        border-color: #dfe4eb;
        color: #596579;
    }

    .af-btn-primary {
        background: #6f42c1;
        color: #fff;
    }

    .af-btn-primary:hover {
        background: #5f35ad;
        color: #fff;
    }
</style>

<div class="container-fluid py-4">
    <div class="af-page">

        <div class="af-breadcrumb">
            <a asp-action="Index">Service History</a>
            <span> / Record Details</span>
        </div>

        <div class="af-header">
            <div>
                <h1 class="af-title">Service Record</h1>
                <p class="af-subtitle">
                    Record #@Model.ServiceRecordId
                </p>
            </div>

            <div class="af-status @statusClass">
                <span>●</span>
                @status
            </div>
        </div>

        <div class="row g-4">

            <div class="col-lg-8">

                <div class="af-card">

                    <div class="af-card-header">
                        <div class="af-icon">
                            <i class="bi bi-car-front"></i>
                        </div>

                        <div>
                            <h2 class="af-card-title">
                                Vehicle & Service
                            </h2>
                            <p class="af-card-description">
                                Vehicle associated with this service record.
                            </p>
                        </div>
                    </div>

                    <div class="af-body">

                        <div class="af-vehicle mb-4">

                            <div class="af-vehicle-name">
                                @vehicleName
                            </div>

                            @if (Model.Vehicle != null)
                            {
                                <div class="af-plate">
                                    @Model.Vehicle.PlateNumber
                                </div>
                            }

                        </div>

                        <div class="row g-4">

                            <div class="col-md-6 af-info-item">
                                <div class="af-label">Service Date</div>
                                <div class="af-value">
                                    @Model.ServiceDate.ToString("MMM dd, yyyy • hh:mm tt")
                                </div>
                            </div>

                            <div class="col-md-6 af-info-item">
                                <div class="af-label">Mileage</div>
                                <div class="af-value">
                                    @(Model.Mileage.HasValue
                                        ? $"{Model.Mileage.Value:N0} km"
                                        : "—")
                                </div>
                            </div>

                            <div class="col-md-6 af-info-item">
                                <div class="af-label">Status</div>
                                <div class="af-value">
                                    @status
                                </div>
                            </div>

                            <div class="col-md-6 af-info-item">
                                <div class="af-label">Service Record ID</div>
                                <div class="af-value">
                                    #@Model.ServiceRecordId
                                </div>
                            </div>

                        </div>

                    </div>
                </div>

                <div class="af-card">

                    <div class="af-card-header">
                        <div class="af-icon">
                            <i class="bi bi-clipboard2-pulse"></i>
                        </div>

                        <div>
                            <h2 class="af-card-title">
                                Service Findings
                            </h2>
                            <p class="af-card-description">
                                Customer complaint and service diagnosis.
                            </p>
                        </div>
                    </div>

                    <div class="af-body">

                        <div class="row g-4">

                            <div class="col-md-6">
                                <div class="af-label">Customer Complaint</div>
                                <div class="af-text">
                                    @(string.IsNullOrWhiteSpace(Model.Complaint)
                                        ? "No complaint recorded."
                                        : Model.Complaint)
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="af-label">Diagnosis</div>
                                <div class="af-text">
                                    @(string.IsNullOrWhiteSpace(Model.Diagnosis)
                                        ? "No diagnosis recorded."
                                        : Model.Diagnosis)
                                </div>
                            </div>

                        </div>

                    </div>
                </div>

                <div class="af-card">

                    <div class="af-card-header">
                        <div class="af-icon">
                            <i class="bi bi-journal-text"></i>
                        </div>

                        <div>
                            <h2 class="af-card-title">Notes</h2>
                            <p class="af-card-description">
                                Additional information about the service.
                            </p>
                        </div>
                    </div>

                    <div class="af-body">

                        <div class="af-text">
                            @(string.IsNullOrWhiteSpace(Model.Notes)
                                ? "No additional notes recorded."
                                : Model.Notes)
                        </div>

                    </div>
                </div>

            </div>

            <div class="col-lg-4">

                <div class="af-card">

                    <div class="af-card-header">
                        <div class="af-icon">
                            <i class="bi bi-clock-history"></i>
                        </div>

                        <div>
                            <h2 class="af-card-title">History Record</h2>
                            <p class="af-card-description">
                                Service tracking information.
                            </p>
                        </div>
                    </div>

                    <div class="af-body">

                        <div class="af-info-item">
                            <div class="af-label">Record Number</div>
                            <div class="af-value">
                                #@Model.ServiceRecordId
                            </div>
                        </div>

                        <div class="af-info-item">
                            <div class="af-label">Vehicle</div>
                            <div class="af-value">
                                @(Model.Vehicle?.PlateNumber ?? "Unavailable")
                            </div>
                        </div>

                        <div class="af-info-item">
                            <div class="af-label">Service Status</div>
                            <div class="af-value">
                                @status
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="af-actions">

            <a asp-action="Index"
               class="af-btn af-btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back to History
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.ServiceRecordId"
               class="af-btn af-btn-primary">
                <i class="bi bi-pencil me-1"></i>
                Edit Record
            </a>

        </div>

    </div>
</div>