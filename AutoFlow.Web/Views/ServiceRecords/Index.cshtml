@model IEnumerable<AutoFlow.Web.Models.ServiceRecord>

@{
    ViewData["Title"] = "Service History";

    var records = Model.ToList();

    var completedCount = records.Count(r => r.Status == "Completed");
    var inProgressCount = records.Count(r => r.Status == "In Progress");
    var cancelledCount = records.Count(r => r.Status == "Cancelled");
}

<style>
    .history-page {
        max-width: 1500px;
        margin: 0 auto;
        padding: 32px 28px 50px;
    }

    .history-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #7b8190;
        font-size: 13px;
        margin-bottom: 20px;
    }

    .history-breadcrumb i {
        font-size: 11px;
    }

    .history-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 25px;
    }

    .history-header h1 {
        font-size: 30px;
        font-weight: 800;
        color: #202431;
        margin: 0 0 7px;
        letter-spacing: -.5px;
    }

    .history-header p {
        color: #7b8190;
        font-size: 14px;
        margin: 0;
    }

    .history-add-btn {
        background: #7043c1;
        border-color: #7043c1;
        color: #fff;
        border-radius: 10px;
        padding: 10px 17px;
        font-weight: 700;
        font-size: 13px;
        white-space: nowrap;
    }

    .history-add-btn:hover {
        background: #5d35a6;
        border-color: #5d35a6;
        color: #fff;
    }

    .history-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
        margin-bottom: 22px;
    }

    .history-stat {
        background: #fff;
        border: 1px solid #ececf1;
        border-radius: 14px;
        padding: 18px;
        box-shadow: 0 4px 16px rgba(30, 25, 50, .04);
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .history-stat-icon {
        width: 43px;
        height: 43px;
        border-radius: 12px;
        background: #f1ebff;
        color: #7043c1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
        flex-shrink: 0;
    }

    .history-stat-icon.success {
        background: #eaf8ef;
        color: #27834a;
    }

    .history-stat-icon.warning {
        background: #fff6df;
        color: #a36a00;
    }

    .history-stat-icon.danger {
        background: #fff0f2;
        color: #c03952;
    }

    .history-stat-label {
        color: #858b98;
        font-size: 10px;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: .05em;
        margin-bottom: 3px;
    }

    .history-stat-value {
        color: #252936;
        font-size: 21px;
        font-weight: 800;
    }

    .history-card {
        background: #fff;
        border: 1px solid #ececf1;
        border-radius: 16px;
        box-shadow: 0 5px 20px rgba(30, 25, 50, .05);
        overflow: hidden;
    }

    .history-card-header {
        padding: 20px 22px;
        border-bottom: 1px solid #eeeeF2;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .history-card-title {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .history-card-title i {
        color: #7043c1;
        font-size: 18px;
    }

    .history-card-title h2 {
        font-size: 16px;
        font-weight: 750;
        color: #292e39;
        margin: 0;
    }

    .history-count {
        background: #f3effc;
        color: #7043c1;
        border-radius: 999px;
        padding: 5px 10px;
        font-size: 10px;
        font-weight: 750;
    }

    .history-table {
        margin: 0;
    }

    .history-table thead th {
        background: #fafafd;
        color: #777e8b;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .06em;
        padding: 14px 17px;
        border-bottom: 1px solid #ececf1;
        white-space: nowrap;
    }

    .history-table tbody td {
        padding: 16px 17px;
        border-color: #f0f0f3;
        color: #464c58;
        font-size: 13px;
        vertical-align: middle;
    }

    .history-table tbody tr:hover {
        background: #fcfbff;
    }

    .vehicle-block {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .vehicle-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: #f1ebff;
        color: #7043c1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        flex-shrink: 0;
    }

    .vehicle-name {
        color: #292e39;
        font-weight: 750;
        font-size: 13px;
    }

    .vehicle-plate {
        color: #9297a2;
        font-size: 10px;
        margin-top: 2px;
    }

    .history-date {
        color: #4c525e;
        font-weight: 650;
        white-space: nowrap;
    }

    .history-mileage {
        font-weight: 650;
        color: #4c525e;
    }

    .history-muted {
        color: #a0a5ae;
    }

    .history-text {
        max-width: 200px;
        line-height: 1.45;
        color: #555b67;
    }

    .history-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 6px 10px;
        font-size: 10px;
        font-weight: 750;
        white-space: nowrap;
    }

    .history-status.completed {
        color: #27834a;
        background: #eaf8ef;
    }

    .history-status.progress {
        color: #956300;
        background: #fff6df;
    }

    .history-status.cancelled {
        color: #c03952;
        background: #fff0f2;
    }

    .history-status.default {
        color: #68707d;
        background: #f1f2f5;
    }

    .history-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    .history-actions {
        display: flex;
        justify-content: flex-end;
        gap: 5px;
        white-space: nowrap;
    }

    .history-action {
        height: 34px;
        min-width: 34px;
        padding: 0 9px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        font-size: 11px;
        font-weight: 700;
        text-decoration: none;
    }

    .history-action.view {
        color: #69717e;
        border: 1px solid #dfe2e8;
        background: #fff;
    }

    .history-action.edit {
        color: #7043c1;
        border: 1px solid #ded2f5;
        background: #faf8ff;
    }

    .history-action.delete {
        color: #c03952;
        border: 1px solid #f0cbd2;
        background: #fff8f9;
    }

    .history-empty {
        text-align: center;
        padding: 75px 20px;
    }

    .history-empty-icon {
        width: 68px;
        height: 68px;
        border-radius: 18px;
        background: #f1ebff;
        color: #7043c1;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 17px;
        font-size: 28px;
    }

    .history-empty h3 {
        color: #292e39;
        font-size: 19px;
        font-weight: 750;
        margin-bottom: 7px;
    }

    .history-empty p {
        color: #858b98;
        font-size: 13px;
        max-width: 470px;
        margin: 0 auto 20px;
        line-height: 1.6;
    }

    @@media (max-width: 1100px) {
        .history-stats {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 900px) {
        .history-header {
            flex-direction: column;
        }

        .history-add-btn {
            width: 100%;
        }
    }

    @@media (max-width: 700px) {
        .history-page {
            padding: 22px 16px 40px;
        }

        .history-stats {
            grid-template-columns: 1fr;
        }

        .history-table thead {
            display: none;
        }

        .history-table tbody tr {
            display: block;
            padding: 14px 16px;
            border-bottom: 1px solid #ececf1;
        }

        .history-table tbody td {
            display: block;
            padding: 6px 0;
            border: 0;
        }

        .history-actions {
            justify-content: flex-start;
            margin-top: 7px;
        }
    }
</style>

<div class="history-page">

    <div class="history-breadcrumb">
        <i class="bi bi-clock-history"></i>
        <span>Operations</span>
        <i class="bi bi-chevron-right"></i>
        <span>Service History</span>
    </div>

    <div class="history-header">

        <div>
            <h1>Service History</h1>
            <p>Review completed and ongoing service records for customer vehicles.</p>
        </div>

        <a asp-action="Create"
           class="btn history-add-btn">
            <i class="bi bi-plus-lg me-1"></i>
            New Service Record
        </a>

    </div>

    <div class="history-stats">

        <div class="history-stat">
            <div class="history-stat-icon">
                <i class="bi bi-clock-history"></i>
            </div>

            <div>
                <div class="history-stat-label">Total Records</div>
                <div class="history-stat-value">@records.Count</div>
            </div>
        </div>

        <div class="history-stat">
            <div class="history-stat-icon success">
                <i class="bi bi-check-circle"></i>
            </div>

            <div>
                <div class="history-stat-label">Completed</div>
                <div class="history-stat-value">@completedCount</div>
            </div>
        </div>

        <div class="history-stat">
            <div class="history-stat-icon warning">
                <i class="bi bi-wrench-adjustable"></i>
            </div>

            <div>
                <div class="history-stat-label">In Progress</div>
                <div class="history-stat-value">@inProgressCount</div>
            </div>
        </div>

        <div class="history-stat">
            <div class="history-stat-icon danger">
                <i class="bi bi-x-circle"></i>
            </div>

            <div>
                <div class="history-stat-label">Cancelled</div>
                <div class="history-stat-value">@cancelledCount</div>
            </div>
        </div>

    </div>

    <div class="history-card">

        <div class="history-card-header">

            <div class="history-card-title">
                <i class="bi bi-journal-text"></i>
                <h2>Service Records</h2>
            </div>

            <span class="history-count">
                @records.Count record@(records.Count == 1 ? "" : "s")
            </span>

        </div>

        @if (!records.Any())
        {
            <div class="history-empty">

                <div class="history-empty-icon">
                    <i class="bi bi-journal-medical"></i>
                </div>

                <h3>No Service History Yet</h3>

                <p>
                    Service history will appear here once service records are
                    created for customer vehicles. Create the first record to
                    begin tracking maintenance and repair history.
                </p>

                <a asp-action="Create"
                   class="btn history-add-btn">
                    <i class="bi bi-plus-lg me-1"></i>
                    Create First Service Record
                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table history-table align-middle">

                    <thead>
                        <tr>
                            <th>Vehicle</th>
                            <th>Service Date</th>
                            <th>Mileage</th>
                            <th>Complaint</th>
                            <th>Diagnosis</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                    @foreach (var item in records)
                    {
                        var statusClass = item.Status switch
                        {
                            "Completed" => "completed",
                            "In Progress" => "progress",
                            "Cancelled" => "cancelled",
                            _ => "default"
                        };

                        <tr>

                            <td>

                                <div class="vehicle-block">

                                    <div class="vehicle-icon">
                                        <i class="bi bi-car-front"></i>
                                    </div>

                                    <div>

                                        @if (item.Vehicle != null)
                                        {
                                            <div class="vehicle-name">
                                                @item.Vehicle.Make @item.Vehicle.Model
                                            </div>

                                            <div class="vehicle-plate">
                                                <i class="bi bi-credit-card-2-front me-1"></i>
                                                @item.Vehicle.PlateNumber
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="vehicle-name history-muted">
                                                Vehicle unavailable
                                            </div>
                                        }

                                    </div>

                                </div>

                            </td>

                            <td>
                                <div class="history-date">
                                    <i class="bi bi-calendar3 me-1"></i>
                                    @item.ServiceDate.ToLocalTime().ToString("MMM dd, yyyy")
                                </div>
                            </td>

                            <td>

                                @if (item.Mileage.HasValue)
                                {
                                    <div class="history-mileage">
                                        @item.Mileage.Value.ToString("N0")
                                    </div>
                                }
                                else
                                {
                                    <span class="history-muted">—</span>
                                }

                            </td>

                            <td>

                                @if (!string.IsNullOrWhiteSpace(item.Complaint))
                                {
                                    <div class="history-text">
                                        @item.Complaint
                                    </div>
                                }
                                else
                                {
                                    <span class="history-muted">No complaint recorded</span>
                                }

                            </td>

                            <td>

                                @if (!string.IsNullOrWhiteSpace(item.Diagnosis))
                                {
                                    <div class="history-text">
                                        @item.Diagnosis
                                    </div>
                                }
                                else
                                {
                                    <span class="history-muted">No diagnosis recorded</span>
                                }

                            </td>

                            <td>

                                <span class="history-status @statusClass">

                                    <span class="history-dot"></span>

                                    @item.Status

                                </span>

                            </td>

                            <td>

                                <div class="history-actions">

                                    <a asp-action="Details"
                                       asp-route-id="@item.ServiceRecordId"
                                       class="history-action view"
                                       title="View service record">
                                        <i class="bi bi-eye"></i>
                                        <span>View</span>
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.ServiceRecordId"
                                       class="history-action edit"
                                       title="Edit service record">
                                        <i class="bi bi-pencil"></i>
                                        <span>Edit</span>
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.ServiceRecordId"
                                       class="history-action delete"
                                       title="Delete service record">
                                        <i class="bi bi-trash3"></i>
                                        <span>Delete</span>
                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>