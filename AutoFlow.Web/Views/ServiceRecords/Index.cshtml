@model AutoFlow.Web.ViewModels.ServiceHistoryPageViewModel

@{
    ViewData["Title"] = "Service History";

    var records = Model.Records;
    var archivedRecords = Model.ArchivedRecords;
    var totalRecords = records.Count;
    var completedCount = records.Count(r => r.Status.Equals("Completed", StringComparison.OrdinalIgnoreCase));
    var vehiclesServiced = records.Select(r => r.ServiceRecord.VehicleId).Distinct().Count();
    var latestService = records.FirstOrDefault();

    string QueryUrl(string? targetOpen = null, int? targetId = null) =>
        Url.Action("Index", "ServiceRecords", new
        {
            open = string.IsNullOrWhiteSpace(targetOpen) ? null : targetOpen,
            id = targetId
        }) ?? "/ServiceRecords/Index";

    string StatusClass(string? status) =>
        status?.ToLowerInvariant() switch
        {
            "completed" => "completed",
            "archived" => "archived",
            _ => "default"
        };

    string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "—";
        return string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpperInvariant();
    }
}

<style>
    .history-page { max-width: 1500px; margin: 0 auto; padding: 32px 28px 50px; }
    .history-breadcrumb { display:flex; align-items:center; gap:8px; color:#7b8190; font-size:13px; margin-bottom:20px; }
    .history-breadcrumb i { font-size:11px; }
    .history-header { display:flex; justify-content:space-between; align-items:flex-start; gap:20px; margin-bottom:25px; }
    .history-header h1 { font-size:30px; font-weight:800; color:#202431; margin:0 0 7px; letter-spacing:-.5px; }
    .history-header p { color:#7b8190; font-size:14px; margin:0; }
    .history-header-actions { display:flex; align-items:center; justify-content:flex-end; gap:9px; flex-wrap:wrap; }
    .history-archive-btn { min-height:40px; border-radius:9px; padding:0 13px; font-size:11px; font-weight:750; white-space:nowrap; display:inline-flex; align-items:center; justify-content:center; gap:7px; border:1px solid #dfe3ea; background:#fff; color:#596273; cursor:pointer; }
    .history-archive-btn:hover { border-color:#cfc4fb; background:#faf9ff; color:#7544f5; }
    .history-header-count { min-width:20px; height:20px; display:inline-flex; align-items:center; justify-content:center; padding:0 5px; border-radius:999px; background:#f0f2f6; color:#737b8b; font-size:9px; font-weight:800; }

    .history-auto-note { display:flex; align-items:flex-start; gap:11px; padding:13px 15px; margin-bottom:20px; border:1px solid #e7ddff; border-radius:12px; background:#faf8ff; color:#5f46a8; font-size:12px; line-height:1.45; }
    .history-auto-note i { font-size:15px; margin-top:1px; }
    .history-auto-note strong { color:#4d3694; }

    .history-stats { display:grid; grid-template-columns:repeat(4,1fr); gap:15px; margin-bottom:22px; }
    .history-stat { background:#fff; border:1px solid #ececf1; border-radius:14px; padding:18px; box-shadow:0 4px 16px rgba(30,25,50,.04); display:flex; align-items:center; gap:13px; }
    .history-stat-icon { width:43px; height:43px; border-radius:12px; background:#f1ebff; color:#7043c1; display:flex; align-items:center; justify-content:center; font-size:19px; flex-shrink:0; }
    .history-stat-icon.success { background:#eaf8ef; color:#27834a; }
    .history-stat-icon.info { background:#edf7ff; color:#087fb7; }
    .history-stat-icon.warning { background:#fff6df; color:#b77900; }
