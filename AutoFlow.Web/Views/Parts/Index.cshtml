@model IEnumerable<AutoFlow.Web.Models.Part>

@{
    ViewData["Title"] = "Parts Inventory";

    var parts = Model.ToList();

    var suppliers = ViewData["SupplierOptions"] as IEnumerable<string>
        ?? Enumerable.Empty<string>();

    var supplierSelectList = ViewData["SupplierId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList
        ?? new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>());

    var totalParts = parts.Count;
    var activePartsCount = parts.Count(p => !p.IsArchived);
    var archivedPartsCount = parts.Count(p => p.IsArchived);
    var archivedParts = parts.Where(p => p.IsArchived).ToList();

    var notification = TempData["PartNotification"]?.ToString();
    var notificationError = TempData["PartNotificationError"]?.ToString();
}

