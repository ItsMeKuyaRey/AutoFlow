@model IEnumerable<AutoFlow.Web.Models.Part>

@{
    ViewData["Title"] = "Parts Inventory";

    var parts = Model.ToList();
    var totalParts = parts.Count;
    var totalStock = parts.Sum(p => p.StockQuantity);
    var lowStockCount = parts.Count(p => p.StockQuantity > 0 && p.StockQuantity <= 5);
    var outOfStockCount = parts.Count(p => p.StockQuantity <= 0);
}

<style>
    .parts-page {
        max-width: 1500px;
        margin: 0 auto;
    }

    .parts-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        color: #8b92a3;
        font-size: 12px;
        font-weight: 650;
    }

    .parts-breadcrumb .current {
        color: #7544f5;
    }

    .parts-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 25px;
    }

    .parts-title {
        margin: 0;
        color: #171b26;
        font-size: 30px;
        font-weight: 800;
        letter-spacing: -0.8px;
    }

    .parts-subtitle {
        margin: 7px 0 0;
        color: #858c9d;
        font-size: 13px;
    }

    .parts-header-right {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .parts-live {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #687082;
        font-size: 11px;
        font-weight: 650;
    }

    .parts-live-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #18b981;
        box-shadow: 0 0 0 4px #e8faf3;
    }

    .parts-add-button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 15px;
        border: 0;
        border-radius: 9px;
        background: #7544f5;
        color: #ffffff;
        font-size: 12px;
        font-weight: 750;
        text-decoration: none;
        box-shadow: 0 5px 14px rgba(117, 68, 245, 0.18);
        transition: all 0.18s ease;
    }

    .parts-add-button:hover {
        background: #6336dc;
        color: #ffffff;
        transform: translateY(-1px);
    }

    .parts-summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 22px;
    }

    .parts-summary-card {
        position: relative;
        min-height: 132px;
        padding: 19px;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e5e8ee;
        border-radius: 13px;
        box-shadow: 0 2px 8px rgba(24, 31, 45, 0.025);
    }

    .parts-summary-card::after {
        content: "";
        position: absolute;
        right: -25px;
        bottom: -30px;
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: #f8f5ff;
    }

    .parts-card-top {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .parts-card-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: #f0ebff;
        color: #7544f5;
        font-size: 17px;
    }

    .parts-card-label {
        position: relative;
        z-index: 1;
        margin-top: 13px;
        color: #777f91;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }

    .parts-card-value {
        position: relative;
        z-index: 1;
        margin-top: 4px;
        color: #171b26;
        font-size: 25px;
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    .parts-card-note {
        position: relative;
        z-index: 1;
        margin-top: 4px;
        color: #9aa1af;
        font-size: 10px;
    }

    .parts-card-alert .parts-card-icon {
        background: #fff5e8;
        color: #c97916;
    }

    .parts-card-danger .parts-card-icon {
        background: #fff0f1;
        color: #dc5962;
    }

    .parts-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 13px 16px;
        margin-bottom: 18px;
        background: #ffffff;
        border: 1px solid #e5e8ee;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(24, 31, 45, 0.025);
    }

    .parts-toolbar-title {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #303746;
        font-size: 12px;
        font-weight: 750;
    }

    .parts-toolbar-title i {
        color: #7544f5;
        font-size: 14px;
    }

    .parts-toolbar-note {
        color: #959cab;
        font-size: 10px;
    }

    .parts-panel {
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e5e8ee;
        border-radius: 13px;
        box-shadow: 0 2px 8px rgba(24, 31, 45, 0.025);
    }

    .parts-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 19px 20px;
        border-bottom: 1px solid #edf0f4;
    }

    .parts-panel-title {
        margin: 0;
        color: #1b2030;
        font-size: 15px;
        font-weight: 800;
    }

    .parts-panel-subtitle {
        margin-top: 4px;
        color: #9299a8;
        font-size: 11px;
    }

    .parts-count-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 9px;
        border-radius: 7px;
        background: #f1edff;
        color: #7544f5;
        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .parts-table-wrap {
        overflow-x: auto;
    }

    .parts-table {
        width: 100%;
        border-collapse: collapse;
    }

    .parts-table th {
        padding: 11px 20px;
        background: #fafbfc;
        color: #8a91a0;
        font-size: 9px;
        font-weight: 800;
        text-align: left;
        text-transform: uppercase;
        letter-spacing: 0.65px;
        white-space: nowrap;
    }

    .parts-table td {
        padding: 15px 20px;
        border-top: 1px solid #eef0f4;
        color: #3e4656;
        font-size: 12px;
        vertical-align: middle;
    }

    .parts-table tr:hover td {
        background: #fcfbff;
    }

    .part-identity {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .part-avatar {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #f3efff;
        color: #7544f5;
        font-size: 15px;
    }

    .part-name {
        color: #1c2230;
        font-weight: 750;
    }

    .part-number {
        margin-top: 3px;
        color: #959cab;
        font-size: 10px;
    }

    .supplier-name {
        color: #4e5666;
        font-weight: 600;
    }

    .muted-value {
        color: #a0a6b2;
    }

    .part-price {
        color: #1c2230;
        font-weight: 750;
        white-space: nowrap;
    }

    .stock-cell {
        min-width: 150px;
    }

    .stock-number {
        margin-bottom: 5px;
        color: #303746;
        font-size: 11px;
        font-weight: 750;
    }

    .stock-track {
        width: 100%;
        max-width: 110px;
        height: 5px;
        overflow: hidden;
        border-radius: 99px;
        background: #edf0f4;
    }

    .stock-fill {
        height: 100%;
        border-radius: inherit;
        background: #7544f5;
    }

    .stock-fill.low {
        background: #e6a23c;
    }

    .stock-fill.empty {
        background: #dc5962;
        width: 3px !important;
    }

    .stock-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-top: 6px;
        padding: 4px 7px;
        border-radius: 6px;
        font-size: 8px;
        font-weight: 800;
        white-space: nowrap;
    }

    .stock-good {
        background: #e9faf3;
        color: #14966a;
    }

    .stock-low {
        background: #fff5e8;
        color: #c97916;
    }

    .stock-empty {
        background: #fff0f1;
        color: #dc5962;
    }

    .part-actions {
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }

    .part-action {
        min-width: 72px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 0 9px;
        border-radius: 7px;
        background: #ffffff;
        font-size: 10px;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.18s ease;
    }

    .part-action.edit {
        border: 1px solid #ddd5ff;
        color: #7544f5;
    }

    .part-action.delete {
        border: 1px solid #f2d7da;
        color: #dc5962;
    }

    .part-action.edit:hover {
        background: #f5f2ff;
        transform: translateY(-1px);
    }

    .part-action.delete:hover {
        background: #fff5f6;
        transform: translateY(-1px);
    }

    .parts-empty {
        padding: 65px 20px;
        text-align: center;
    }

    .parts-empty-icon {
        width: 52px;
        height: 52px;
        margin: 0 auto 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: #f3efff;
        color: #7544f5;
        font-size: 21px;
    }

    .parts-empty-title {
        color: #4d5565;
        font-size: 14px;
        font-weight: 750;
    }

    .parts-empty-text {
        max-width: 420px;
        margin: 6px auto 0;
        color: #a0a6b2;
        font-size: 11px;
        line-height: 1.55;
    }

    @@media (max-width: 1100px) {
        .parts-summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 720px) {
        .parts-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .parts-header-right {
            width: 100%;
            justify-content: space-between;
        }

        .parts-summary-grid {
            grid-template-columns: 1fr;
        }

        .parts-toolbar {
            align-items: flex-start;
            flex-direction: column;
        }

        .parts-table th,
        .parts-table td {
            padding-left: 13px;
            padding-right: 13px;
        }

        .part-action {
            min-width: 34px;
            width: 34px;
            padding: 0;
        }

        .part-action span {
            display: none;
        }
    }
</style>

<div class="parts-page">

    <div class="parts-breadcrumb">
        <span>Inventory</span>
        <span>/</span>
        <span class="current">Parts Inventory</span>
    </div>

    <div class="parts-header">

        <div>
            <h1 class="parts-title">Parts Inventory</h1>

            <p class="parts-subtitle">
                Monitor parts stock, pricing, suppliers, and availability.
            </p>
        </div>

        <div class="parts-header-right">

            <div class="parts-live">
                <span class="parts-live-dot"></span>
                Live inventory
            </div>

            <a asp-action="Create" class="parts-add-button">
                <i class="bi bi-plus-lg"></i>
                Add Part
            </a>

        </div>

    </div>

    <div class="parts-summary-grid">

        <div class="parts-summary-card">

            <div class="parts-card-top">
                <div class="parts-card-icon">
                    <i class="bi bi-box-seam"></i>
                </div>
            </div>

            <div class="parts-card-label">
                Parts Items
            </div>

            <div class="parts-card-value">
                @totalParts
            </div>

            <div class="parts-card-note">
                Registered inventory items
            </div>

        </div>

        <div class="parts-summary-card">

            <div class="parts-card-top">
                <div class="parts-card-icon">
                    <i class="bi bi-stack"></i>
                </div>
            </div>

            <div class="parts-card-label">
                Total Stock
            </div>

            <div class="parts-card-value">
                @totalStock.ToString("N0")
            </div>

            <div class="parts-card-note">
                Units currently recorded
            </div>

        </div>

        <div class="parts-summary-card parts-card-alert">

            <div class="parts-card-top">
                <div class="parts-card-icon">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
            </div>

            <div class="parts-card-label">
                Low Stock
            </div>

            <div class="parts-card-value">
                @lowStockCount
            </div>

            <div class="parts-card-note">
                Items with 1–5 units
            </div>

        </div>

        <div class="parts-summary-card parts-card-danger">

            <div class="parts-card-top">
                <div class="parts-card-icon">
                    <i class="bi bi-x-circle"></i>
                </div>
            </div>

            <div class="parts-card-label">
                Out of Stock
            </div>

            <div class="parts-card-value">
                @outOfStockCount
            </div>

            <div class="parts-card-note">
                Items requiring replenishment
            </div>

        </div>

    </div>

    <div class="parts-toolbar">

        <div class="parts-toolbar-title">
            <i class="bi bi-clipboard-data"></i>
            Inventory Overview
        </div>

        <div class="parts-toolbar-note">
            Review stock levels before assigning parts to repair jobs.
        </div>

    </div>

    <section class="parts-panel">

        <div class="parts-panel-header">

            <div>
                <h2 class="parts-panel-title">
                    Inventory Items
                </h2>

                <div class="parts-panel-subtitle">
                    Current parts, suppliers, pricing, and stock levels.
                </div>
            </div>

            <span class="parts-count-badge">
                <i class="bi bi-box"></i>
                @totalParts items
            </span>

        </div>

        @if (!parts.Any())
        {
            <div class="parts-empty">

                <div class="parts-empty-icon">
                    <i class="bi bi-box-seam"></i>
                </div>

                <div class="parts-empty-title">
                    No Parts Found
                </div>

                <div class="parts-empty-text">
                    There are currently no parts in inventory.
                    Add a part to begin managing your available stock.
                </div>

                <div class="mt-3">

                    <a asp-action="Create" class="parts-add-button">
                        <i class="bi bi-plus-lg"></i>
                        Add Your First Part
                    </a>

                </div>

            </div>
        }
        else
        {
            <div class="parts-table-wrap">

                <table class="parts-table">

                    <thead>
                        <tr>
                            <th>Part</th>
                            <th>Supplier</th>
                            <th>Unit Price</th>
                            <th>Stock Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                    @foreach (var item in parts)
                    {
                        var stockPercent = Math.Min(item.StockQuantity * 10, 100);

                        <tr>

                            <td>

                                <div class="part-identity">

                                    <div class="part-avatar">
                                        <i class="bi bi-gear-wide-connected"></i>
                                    </div>

                                    <div>
                                        <div class="part-name">
                                            @item.Name
                                        </div>

                                        <div class="part-number">
                                            @(item.PartNumber ?? "No part number")
                                        </div>
                                    </div>

                                </div>

                            </td>

                            <td>

                                @if (item.Supplier != null)
                                {
                                    <span class="supplier-name">
                                        @item.Supplier.Name
                                    </span>
                                }
                                else
                                {
                                    <span class="muted-value">
                                        No supplier assigned
                                    </span>
                                }

                            </td>

                            <td>
                                <span class="part-price">
                                    @item.UnitPrice.ToString("C")
                                </span>
                            </td>

                            <td class="stock-cell">

                                <div class="stock-number">
                                    @item.StockQuantity units
                                </div>

                                <div class="stock-track">

                                    @if (item.StockQuantity <= 0)
                                    {
                                        <div class="stock-fill empty"></div>
                                    }
                                    else if (item.StockQuantity <= 5)
                                    {
                                        <div class="stock-fill low"
                                             style="width:@Math.Max(stockPercent, 12)%;">
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="stock-fill"
                                             style="width:@Math.Max(stockPercent, 25)%;">
                                        </div>
                                    }

                                </div>

                                @if (item.StockQuantity <= 0)
                                {
                                    <span class="stock-badge stock-empty">
                                        <i class="bi bi-x-circle-fill"></i>
                                        Out of Stock
                                    </span>
                                }
                                else if (item.StockQuantity <= 5)
                                {
                                    <span class="stock-badge stock-low">
                                        <i class="bi bi-exclamation-circle-fill"></i>
                                        Low Stock
                                    </span>
                                }
                                else
                                {
                                    <span class="stock-badge stock-good">
                                        <i class="bi bi-check-circle-fill"></i>
                                        Available
                                    </span>
                                }

                            </td>

                            <td class="text-end">

                                <div class="part-actions">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.PartId"
                                       class="part-action edit"
                                       title="Edit Part">

                                        <i class="bi bi-pencil-square"></i>
                                        <span>Edit</span>

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.PartId"
                                       class="part-action delete"
                                       title="Delete Part">

                                        <i class="bi bi-trash3"></i>
                                        <span>Delete</span>

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>
        }

    </section>

</div>