@model IEnumerable<AutoFlow.Web.Models.Part>
@{
    ViewData["Title"] = "Parts Inventory";
}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Parts Inventory</h1>
            <p class="text-muted mb-0">
                Manage parts stock, pricing, and availability.
            </p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            Add Part
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">
                <h4 class="fw-semibold">No Parts Found</h4>
                <p class="text-muted">
                    There are currently no parts in inventory.
                </p>
                <a asp-action="Create" class="btn btn-primary">
                    Add Your First Part
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Part Number</th>
                                <th>Supplier</th>
                                <th>Unit Price</th>
                                <th>Stock</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.Name</td>
                                    <td>@(item.PartNumber ?? "—")</td>
                                    <td>
                                        @if (item.Supplier != null)
                                        {
                                            <span>@item.Supplier.Name</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>@item.UnitPrice.ToString("C")</td>
                                    <td>
                                        @if (item.StockQuantity <= 5)
                                        {
                                            <span class="badge bg-danger">@item.StockQuantity low</span>
                                        }
                                        else
                                        {
                                            <span>@item.StockQuantity</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.PartId"
                                               class="btn btn-sm btn-outline-primary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.PartId"
                                               class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
